<%# views/errors/403.ejs — Access Denied page %>

<div class="min-h-[60vh] flex flex-col items-center justify-center text-center gap-6 px-4">
  <div class="w-20 h-20 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
    <i class="fa-solid fa-lock text-red-400 text-3xl"></i>
  </div>

  <div>
    <div class="text-red-400 text-xs font-bold uppercase tracking-widest mb-2">HTTP 403 — Forbidden</div>
    <h1 class="text-3xl font-bold text-white mb-2">ไม่มีสิทธิ์เข้าถึง</h1>
    <p class="text-slate-400 text-sm max-w-md mx-auto">
      บัญชีของคุณ (<strong class="text-slate-300"><%= user?.role || 'unknown' %></strong>)
      ไม่มีสิทธิ์ดำเนินการนี้
    </p>
    <% if (typeof requiredRoles !== 'undefined' && requiredRoles?.length > 0) { %>
    <p class="text-slate-600 text-xs mt-2">
      ต้องมี role: <span class="text-slate-400 font-mono"><%= requiredRoles.join(' / ') %></span>
    </p>
    <% } %>
  </div>

  <div class="flex gap-3">
    <a href="javascript:history.back()"
      class="px-5 py-2.5 rounded-xl border border-white/10 text-slate-400 hover:text-white text-sm transition-all">
      <i class="fa-solid fa-arrow-left mr-2"></i>กลับ
    </a>
    <a href="/dashboard"
      class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white text-sm font-semibold hover:shadow-amber-500/25 hover:shadow-lg transition-all">
      <i class="fa-solid fa-house mr-2"></i>หน้าหลัก
    </a>
  </div>
</div>
