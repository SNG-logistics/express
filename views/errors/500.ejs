<%# views/errors/500.ejs — Internal Server Error page %>

<div class="min-h-[60vh] flex flex-col items-center justify-center text-center gap-6 px-4">
  <div class="w-20 h-20 rounded-2xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
    <i class="fa-solid fa-triangle-exclamation text-red-400 text-3xl"></i>
  </div>

  <div>
    <div class="text-red-400 text-xs font-bold uppercase tracking-widest mb-2">HTTP 500 — Internal Server Error</div>
    <h1 class="text-3xl font-bold text-white mb-2">เกิดข้อผิดพลาดภายในระบบ</h1>
    <p class="text-slate-400 text-sm max-w-md mx-auto">
      ระบบพบปัญหาที่ไม่คาดคิด กรุณาลองใหม่อีกครั้ง
      หากปัญหายังคงอยู่ กรุณาแจ้งผู้ดูแลระบบ
    </p>
    <% if (typeof message !== 'undefined' && message && process.env.NODE_ENV !== 'production') { %>
    <p class="text-slate-600 text-xs font-mono mt-3 max-w-lg mx-auto break-all">
      <%= message %>
    </p>
    <% } %>
  </div>

  <div class="flex gap-3">
    <button onclick="window.location.reload()"
      class="px-5 py-2.5 rounded-xl border border-white/10 text-slate-400 hover:text-white text-sm transition-all">
      <i class="fa-solid fa-rotate-right mr-2"></i>ลองใหม่
    </button>
    <a href="/dashboard"
      class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-red-500 to-rose-600 text-white text-sm font-semibold hover:shadow-red-500/25 hover:shadow-lg transition-all">
      <i class="fa-solid fa-house mr-2"></i>หน้าหลัก
    </a>
  </div>
</div>
