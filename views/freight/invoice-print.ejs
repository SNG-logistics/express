<%# views/freight/invoice-print.ejs — ใบเรียกเก็บเงิน / Tax Invoice %>
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <title>ใบเรียกเก็บเงิน <%= booking.invoice_no %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Sarabun', sans-serif; background: #f8fafc; color: #0f172a; }
    .page { max-width: 800px; margin: 20px auto; background: white; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-radius: 8px; }
    @media print {
      @page { size: A4; margin: 0; }
      body { background: white; }
      .page { margin: 0; box-shadow: none; border-radius: 0; padding: 24mm 18mm; }
      .no-print { display: none !important; }
    }
    .doc-header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 24px; border-bottom: 3px solid #10b981; margin-bottom: 28px; }
    .logo-box { width: 56px; height: 56px; background: #ecfdf5; border: 2px solid #6ee7b7; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; color: #10b981; }
    .company-name { font-size: 1.5rem; font-weight: 800; color: #0f172a; letter-spacing: -0.3px; }
    .company-sub { font-size: 0.75rem; color: #64748b; margin-top: 2px; }
    .doc-meta { text-align: right; }
    .doc-type { font-size: 1.75rem; font-weight: 800; color: #10b981; }
    .doc-no { font-size: 0.9rem; font-weight: 600; color: #475569; margin-top: 4px; }
    .doc-date { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }
    .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
    .party-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; }
    .party-box.to { border-color: #10b981; background: #f0fdf4; }
    .party-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; margin-bottom: 8px; }
    .party-name { font-size: 1.05rem; font-weight: 700; color: #0f172a; }
    .party-info { font-size: 0.82rem; color: #475569; margin-top: 4px; line-height: 1.6; }
    .items-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    .items-table th { background: #065f46; color: white; padding: 10px 14px; text-align: left; font-size: 0.78rem; font-weight: 600; }
    .items-table th:last-child, .items-table td:last-child { text-align: right; }
    .items-table td { padding: 12px 14px; font-size: 0.88rem; border-bottom: 1px solid #f1f5f9; color: #374151; }
    .totals { display: flex; justify-content: flex-end; }
    .totals-box { width: 280px; }
    .total-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 0.88rem; color: #475569; }
    .total-row.grand { border-top: 2px solid #0f172a; margin-top: 6px; padding-top: 10px; font-size: 1.1rem; font-weight: 800; color: #0f172a; }
    .total-row.grand .amount { color: #10b981; }
    .payment-status-box { margin-top: 20px; padding: 16px; border-radius: 8px; border: 2px solid; }
    .payment-status-box.paid { background: #f0fdf4; border-color: #10b981; }
    .payment-status-box.unpaid { background: #fef2f2; border-color: #f87171; }
    .sig-row { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 48px; }
    .sig-box { border-top: 1px solid #cbd5e1; padding-top: 8px; }
    .sig-label { font-size: 0.75rem; color: #94a3b8; }
    .sig-name { font-size: 0.85rem; font-weight: 600; color: #475569; margin-top: 32px; }
    .print-bar { text-align: right; margin-bottom: 20px; }
  </style>
</head>
<body>
<%
  function fmtNum(n) { return Number(n || 0).toLocaleString('th-TH', { minimumFractionDigits: 2 }); }
  function fmtDate(d) {
    if (!d) return '–';
    return new Date(d).toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' });
  }
  const isPaid = booking.payment_status === 'PAID';
  const remaining = Number(booking.grand_total_thb) - Number(booking.paid_amount_thb || 0);
%>
<div class="no-print print-bar">
  <button onclick="window.print()" style="background:#10b981; color:white; border:none; padding:10px 20px; border-radius:8px; font-weight:700; cursor:pointer;">🖨 พิมพ์ใบเรียกเก็บเงิน</button>
  <button onclick="window.close()" style="margin-left:8px; background:#64748b; color:white; border:none; padding:10px 16px; border-radius:8px; font-weight:700; cursor:pointer;">✕ ปิด</button>
</div>

<div class="page">

  <div class="doc-header">
    <div style="display:flex; align-items:center; gap:12px;">
      <div class="logo-box">S</div>
      <div>
        <div class="company-name">SNG EXPRESS</div>
        <div class="company-sub">บริษัทขนส่ง ไทย-ลาว | Tel: 020 5555 5555</div>
        <div class="company-sub">Line: @snglogistics</div>
      </div>
    </div>
    <div class="doc-meta">
      <div class="doc-type">ใบเรียกเก็บเงิน</div>
      <div class="doc-type" style="font-size:1rem;">INVOICE</div>
      <div class="doc-no">เลขที่: <strong><%= booking.invoice_no %></strong></div>
      <div class="doc-date">วันที่: <%= fmtDate(booking.invoice_issued_at || new Date()) %></div>
      <% if (booking.due_date) { %>
      <div class="doc-date" style="color:#f87171; margin-top:4px; font-weight:600;">ครบกำหนด: <%= fmtDate(booking.due_date) %></div>
      <% } %>
      <div class="doc-date" style="margin-top:4px; color:#10b981;">อ้างอิง: <%= booking.booking_no %></div>
    </div>
  </div>

  <div class="parties">
    <div class="party-box">
      <div class="party-label">เรียกเก็บจาก (From)</div>
      <div class="party-name">SNG Express Co., Ltd.</div>
      <div class="party-info">บริษัทขนส่งสินค้าไทย-ลาว<br>Tel: 020 5555 5555</div>
    </div>
    <div class="party-box to">
      <div class="party-label">ลูกค้า (Bill To)</div>
      <div class="party-name"><%= booking.partner_name %></div>
      <div class="party-info">
        ผู้ติดต่อ: <%= booking.contact_name %><br>
        <% if (booking.partner_phone) { %>โทร: <%= booking.partner_phone %><br><% } %>
        <% if (booking.partner_tax_id) { %>เลขผู้เสียภาษี: <%= booking.partner_tax_id %><% } %>
      </div>
    </div>
  </div>

  <table class="items-table">
    <thead>
      <tr>
        <th style="width:36px">#</th>
        <th>รายการ</th>
        <th style="width:80px; text-align:center">จำนวน</th>
        <th style="width:120px; text-align:right">ราคาต่อหน่วย</th>
        <th style="width:120px">ยอดรวม</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="color:#94a3b8">1</td>
        <td>
          <strong>ค่าบริการขนส่งสินค้าฝากส่ง — <%= booking.unit_label || booking.unit_type %></strong>
          <% if (booking.cargo_description) { %>
          <div style="font-size:0.78rem; color:#94a3b8; margin-top:2px;"><%= booking.cargo_description %></div>
          <% } %>
          <% if (booking.dim_l_cm) { %>
          <div style="font-size:0.78rem; color:#94a3b8; margin-top:2px;">ขนาด: <%= booking.dim_w_cm %>×<%= booking.dim_l_cm %>×<%= booking.dim_h_cm %> ซม.</div>
          <% } %>
          <div style="font-size:0.78rem; color:#64748b; margin-top:4px;">
            เส้นทาง: <%= booking.direction === 'TH_TO_LA' ? 'ไทย → ลาว' : 'ลาว → ไทย' %>
            <% if (booking.trip_no) { %> · ทริป <%= booking.trip_no %><% } %>
          </div>
        </td>
        <td style="text-align:center; font-weight:600"><%= booking.quantity %></td>
        <td style="text-align:right">฿<%= fmtNum(booking.unit_price_thb) %></td>
        <td style="text-align:right; font-weight:600">฿<%= fmtNum(Number(booking.unit_price_thb) * Number(booking.quantity)) %></td>
      </tr>
    </tbody>
  </table>

  <div class="totals">
    <div class="totals-box">
      <% if (Number(booking.discount_thb) > 0) { %>
      <div class="total-row"><span>ส่วนลด</span><span>-฿<%= fmtNum(booking.discount_thb) %></span></div>
      <% } %>
      <% if (Number(booking.vat_amount_thb) > 0) { %>
      <div class="total-row"><span>VAT <%= booking.vat_pct %>%</span><span>+฿<%= fmtNum(booking.vat_amount_thb) %></span></div>
      <% } %>
      <div class="total-row grand">
        <span>ยอดสุทธิ</span><span class="amount">฿<%= fmtNum(booking.grand_total_thb) %></span>
      </div>
    </div>
  </div>

  <%# Payment Status %>
  <div class="payment-status-box <%= isPaid ? 'paid' : 'unpaid' %>" style="margin-top:24px;">
    <% if (isPaid) { %>
    <div style="color:#065f46; font-weight:800; font-size:1rem;">✅ ชำระเงินแล้ว (PAID)</div>
    <div style="color:#047857; font-size:0.85rem; margin-top:4px;">
      ชำระแล้ว ฿<%= fmtNum(booking.paid_amount_thb) %>
      <% if (booking.payment_ref) { %> · อ้างอิง: <%= booking.payment_ref %><% } %>
      <% if (booking.paid_at) { %> · <%= fmtDate(booking.paid_at) %><% } %>
    </div>
    <% } else { %>
    <div style="color:#b91c1c; font-weight:800; font-size:1rem;">⚠️ ยังค้างชำระ (UNPAID)</div>
    <div style="color:#dc2626; font-size:0.85rem; margin-top:4px;">
      ยอดค้าง: <strong>฿<%= fmtNum(remaining) %></strong>
      <% if (booking.paid_amount_thb > 0) { %> (ชำระแล้วบางส่วน ฿<%= fmtNum(booking.paid_amount_thb) %>)<% } %>
    </div>
    <div style="color:#ef4444; font-size:0.82rem; margin-top:8px;">
      กรุณาโอนเงินมาที่ธนาคาร: _____________________ สาขา _________ เลขที่บัญชี ___________________
    </div>
    <% } %>
  </div>

  <div class="sig-row" style="margin-top: 40px;">
    <div class="sig-box">
      <div class="sig-label">ผู้รับใบเรียกเก็บเงิน</div>
      <div class="sig-name">ลงชื่อ ..................................</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">( <%= booking.contact_name %> )</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">วันที่ .......................................</div>
    </div>
    <div class="sig-box">
      <div class="sig-label">ผู้รับชำระเงิน SNG Express</div>
      <div class="sig-name">ลงชื่อ ..................................</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">( ........................... )</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">วันที่ .......................................</div>
    </div>
  </div>
</div>
</body>
</html>
