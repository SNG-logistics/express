<%# views/freight/quote-print.ejs — ใบเสนอราคา (พิมพ์ได้) %>
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <title>ใบเสนอราคา <%= booking.quote_no %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Sarabun', sans-serif; background: #f8fafc; color: #0f172a; }
    .page { max-width: 800px; margin: 20px auto; background: white; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-radius: 8px; }
    @media print {
      @page { size: A4; margin: 0; }
      body { background: white; }
      .page { margin: 0; box-shadow: none; border-radius: 0; padding: 24mm 18mm; }
      .no-print { display: none !important; }
    }

    /* Header */
    .doc-header { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 24px; border-bottom: 3px solid #f59e0b; margin-bottom: 28px; }
    .company-logo { display: flex; align-items: center; gap: 12px; }
    .logo-box { width: 56px; height: 56px; background: #fff7ed; border: 2px solid #fed7aa; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; color: #f59e0b; }
    .company-name { font-size: 1.5rem; font-weight: 800; color: #0f172a; letter-spacing: -0.3px; }
    .company-sub { font-size: 0.75rem; color: #64748b; margin-top: 2px; }
    .doc-meta { text-align: right; }
    .doc-type { font-size: 1.75rem; font-weight: 800; color: #f59e0b; line-height: 1; }
    .doc-no { font-size: 0.9rem; font-weight: 600; color: #475569; margin-top: 4px; }
    .doc-date { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }

    /* Parties */
    .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
    .party-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; }
    .party-box.to { border-color: #fbbf24; background: #fffbeb; }
    .party-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; margin-bottom: 8px; }
    .party-name { font-size: 1.05rem; font-weight: 700; color: #0f172a; }
    .party-info { font-size: 0.82rem; color: #475569; margin-top: 4px; line-height: 1.6; }

    /* Table */
    .items-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    .items-table th { background: #1e293b; color: white; padding: 10px 14px; text-align: left; font-size: 0.78rem; font-weight: 600; }
    .items-table th:last-child, .items-table td:last-child { text-align: right; }
    .items-table td { padding: 12px 14px; font-size: 0.88rem; border-bottom: 1px solid #f1f5f9; color: #374151; }
    .items-table tr:last-child td { border-bottom: none; }
    .items-table tbody tr:hover { background: #fafafa; }

    /* Totals */
    .totals { display: flex; justify-content: flex-end; }
    .totals-box { width: 280px; }
    .total-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 0.88rem; color: #475569; }
    .total-row.grand { border-top: 2px solid #0f172a; margin-top: 6px; padding-top: 10px; font-size: 1.1rem; font-weight: 800; color: #0f172a; }
    .total-row.grand .amount { color: #f59e0b; }

    /* Notes */
    .notes-section { margin-top: 32px; padding-top: 20px; border-top: 1px dashed #e2e8f0; }
    .notes-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #94a3b8; margin-bottom: 8px; }
    .notes-text { font-size: 0.85rem; color: #475569; line-height: 1.7; }

    /* Signatures */
    .sig-row { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 48px; }
    .sig-box { border-top: 1px solid #cbd5e1; padding-top: 8px; }
    .sig-label { font-size: 0.75rem; color: #94a3b8; }
    .sig-name { font-size: 0.85rem; font-weight: 600; color: #475569; margin-top: 32px; }

    /* Print button */
    .print-bar { text-align: right; margin-bottom: 20px; }
    .print-btn { background: #f59e0b; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 14px; }
  </style>
</head>
<body>
<%
  function fmtNum(n) { return Number(n || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function fmtDate(d) {
    if (!d) return '–';
    return new Date(d).toLocaleDateString('th-TH', { day: 'numeric', month: 'long', year: 'numeric' });
  }
%>
<div class="no-print print-bar">
  <button class="print-btn" onclick="window.print()"><i>🖨</i> พิมพ์ใบเสนอราคา</button>
  <button onclick="window.close()" style="margin-left:8px; background:#64748b; color:white; border:none; padding:10px 16px; border-radius:8px; font-weight:700; cursor:pointer;">✕ ปิด</button>
</div>

<div class="page">

  <%# Header %>
  <div class="doc-header">
    <div class="company-logo">
        <img src="<%= company.company_logo_la || company.company_logo || '/images/snglogo.png' %>" alt="SNG Logo" style="width:40px; height:40px; object-fit:contain; flex-shrink:0;">
        <div>
            <div class="company-name" style="font-size: 1.25rem;"><%= company.company_name_la || company.company_name || 'SNG CO,PREHENSIVE SERVICE CO.,LTD' %></div>
            <div class="company-sub">บริษัทขนส่ง ไทย-ลาว | Tel: <%= company.company_phone_la || '020 8889 8888' %></div>
            <% if (company.company_tax_id_la) { %>
                <div class="company-sub">เลขเสียภาษี/TIN: <%= company.company_tax_id_la %></div>
            <% } %>
        </div>
    </div>
    <div class="doc-meta">
      <div class="doc-type">ใบเสนอราคา</div>
      <div class="doc-type" style="font-size:1rem;">QUOTATION</div>
      <div class="doc-no">เลขที่: <strong><%= booking.quote_no %></strong></div>
      <div class="doc-date">วันที่: <%= fmtDate(booking.quote_issued_at || new Date()) %></div>
      <div class="doc-date" style="margin-top:4px; color:#f59e0b;">อ้างอิง: <%= booking.booking_no %></div>
    </div>
  </div>

  <%# Parties %>
  <div class="parties">
    <div class="party-box">
      <div class="party-label">ผู้เสนอราคา (Seller)</div>
      <div class="party-name"><%= company.company_name_la || company.company_name || 'SNG CO,PREHENSIVE SERVICE CO.,LTD' %></div>
      <div class="party-info">
        บริษัทขนส่งสินค้าไทย-ลาว<br>
        Tel: <%= company.company_phone_la || '020 8889 8888' %><br>
        TIN/เลขภาษี: <%= company.company_tax_id_la || '804052456000' %>
      </div>
    </div>
    <div class="party-box to">
      <div class="party-label">เสนอให้แก่ (Bill To)</div>
      <div class="party-name"><%= booking.partner_name %></div>
      <div class="party-info">
        ผู้ติดต่อ: <%= booking.contact_name %><br>
        <% if (booking.partner_phone) { %>โทร: <%= booking.partner_phone %><br><% } %>
        <% if (booking.partner_tax_id) { %>เลขผู้เสียภาษี: <%= booking.partner_tax_id %><% } %>
      </div>
    </div>
  </div>

  <%# Items Table %>
  <table class="items-table">
    <thead>
      <tr>
        <th style="width:36px">#</th>
        <th>รายการ</th>
        <th style="width:80px; text-align:center">จำนวน</th>
        <th style="width:120px; text-align:right">ราคาต่อหน่วย</th>
        <th style="width:120px">ยอดรวม</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="color:#94a3b8">1</td>
        <td>
          <strong><%= booking.unit_label || booking.unit_type %></strong> —
          ค่าบริการขนส่งสินค้าฝากส่ง
          <% if (booking.dim_l_cm) { %>
          <div style="font-size:0.78rem; color:#94a3b8; margin-top:2px;">
            ขนาด: <%= booking.dim_w_cm %>×<%= booking.dim_l_cm %>×<%= booking.dim_h_cm %> ซม.
          </div>
          <% } %>
          <% if (booking.cargo_description) { %>
          <div style="font-size:0.78rem; color:#94a3b8; margin-top:2px;">
            รายละเอียด: <%= booking.cargo_description %>
          </div>
          <% } %>
          <div style="font-size:0.78rem; color:#64748b; margin-top:4px;">
            เส้นทาง: <%= booking.direction === 'TH_TO_LA' ? 'ไทย → ลาว' : 'ลาว → ไทย' %>
            <% if (booking.trip_no) { %> · ทริป <%= booking.trip_no %><% } %>
          </div>
        </td>
        <td style="text-align:center; font-weight:600"><%= booking.quantity %></td>
        <td style="text-align:right">฿<%= fmtNum(booking.unit_price_thb) %></td>
        <td style="text-align:right; font-weight:600">฿<%= fmtNum(Number(booking.unit_price_thb) * Number(booking.quantity)) %></td>
      </tr>
    </tbody>
  </table>

  <%# Totals %>
  <div class="totals">
    <div class="totals-box">
      <% if (Number(booking.discount_thb) > 0) { %>
      <div class="total-row">
        <span>ส่วนลด</span>
        <span>-฿<%= fmtNum(booking.discount_thb) %></span>
      </div>
      <% } %>
      <% if (Number(booking.vat_amount_thb) > 0) { %>
      <div class="total-row">
        <span>VAT <%= booking.vat_pct %>%</span>
        <span>฿<%= fmtNum(booking.vat_amount_thb) %></span>
      </div>
      <% } %>
      <div class="total-row grand">
        <span>ยอดสุทธิ</span>
        <span class="amount">฿<%= fmtNum(booking.grand_total_thb) %></span>
      </div>
      <div style="font-size:0.75rem; color:#94a3b8; margin-top:8px; text-align:right;">
        การชำระ: <%= booking.payment_type === 'CREDIT' ? 'เครดิต ' + (booking.credit_days || 30) + ' วัน' : 'ชำระล่วงหน้า' %>
      </div>
    </div>
  </div>

  <%# Notes %>
  <% if (booking.special_notes) { %>
  <div class="notes-section">
    <div class="notes-title">หมายเหตุ / เงื่อนไข</div>
    <div class="notes-text"><%= booking.special_notes %></div>
  </div>
  <% } %>
  <div class="notes-section" style="<%= booking.special_notes ? 'border-top:none; margin-top:12px;' : '' %>">
    <div class="notes-title">เงื่อนไขทั่วไป</div>
    <div class="notes-text">
      1. ราคาข้างต้นยังไม่รวมค่าภาษีศุลกากร (ถ้ามี)<br>
      2. ใบเสนอราคานี้มีผลภายใน 30 วันนับจากวันที่ออกเอกสาร<br>
      3. บริษัทฯ ขอสงวนสิทธิ์เปลี่ยนแปลงราคาโดยแจ้งล่วงหน้า
    </div>
  </div>

  <%# Signatures %>
  <div class="sig-row">
    <div class="sig-box">
      <div class="sig-label">ผู้รับใบเสนอราคา</div>
      <div class="sig-name">ลงชื่อ ..................................</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">( <%= booking.contact_name %> )</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">วันที่ .......................................</div>
    </div>
    <div class="sig-box">
      <div class="sig-label">ผู้มีอำนาจลงนาม SNG Express</div>
      <div class="sig-name">ลงชื่อ ..................................</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">( ........................... )</div>
      <div style="font-size:0.78rem; color:#94a3b8; margin-top:4px;">วันที่ .......................................</div>
    </div>
  </div>

</div>
</body>
</html>
