<%# views/freight/partners.ejs — รายการร้านฝากส่ง %>
<div class="space-y-6" x-data="{ showModal: false, editId: null, editData: {} }">

  <%# Header %>
  <div class="flex items-center gap-4">
    <a href="/freight" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all">
      <i class="fa-solid fa-arrow-left text-sm"></i>
    </a>
    <div class="flex-1">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-handshake text-amber-400"></i> ร้านฝากส่ง — พาร์ทเนอร์
      </h2>
      <p class="text-slate-400 text-xs mt-0.5">จัดการข้อมูลร้านค้า/บริษัทที่ฝากส่งสินค้าประจำ</p>
    </div>
    <button @click="showModal = true; editId = null; editData = {}"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-white text-sm font-bold">
      <i class="fa-solid fa-plus text-xs"></i> เพิ่มร้านค้าใหม่
    </button>
  </div>

  <%# Partners Grid %>
  <% if (partners.length === 0) { %>
  <div class="glass-panel-dark rounded-2xl p-12 text-center border border-white/8">
    <i class="fa-solid fa-handshake text-5xl text-slate-700 mb-4 block"></i>
    <div class="text-slate-500 font-semibold">ยังไม่มีพาร์ทเนอร์ กดเพิ่มร้านค้าใหม่ด้านบน</div>
  </div>
  <% } %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% partners.forEach(p => { %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8 hover:border-amber-500/20 transition-all">
      <div class="flex items-start justify-between mb-3">
        <div>
          <div class="font-bold text-white text-base leading-tight"><%= p.company_name %></div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5"><%= p.partner_code %></div>
        </div>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full
          <%= p.status === 'active' ? 'bg-emerald-500/15 text-emerald-400' : 'bg-red-500/15 text-red-400' %>">
          <%= p.status === 'active' ? 'ใช้งาน' : 'ปิดใช้' %>
        </span>
      </div>

      <div class="space-y-1.5 text-xs text-slate-400 mb-4">
        <div><i class="fa-solid fa-user w-4 text-slate-600"></i> <%= p.contact_name %></div>
        <% if (p.phone) { %><div><i class="fa-solid fa-phone w-4 text-slate-600"></i> <%= p.phone %></div><% } %>
        <% if (p.business_type) { %><div><i class="fa-solid fa-tag w-4 text-slate-600"></i> <%= p.business_type %></div><% } %>
        <% if (p.credit_days > 0) { %>
        <div><i class="fa-solid fa-credit-card w-4 text-indigo-500"></i>
          <span class="text-indigo-400">เครดิต <%= p.credit_days %> วัน (วงเงิน ฿<%= Number(p.credit_limit_thb).toLocaleString() %>)</span>
        </div>
        <% } %>
      </div>

      <div class="grid grid-cols-2 gap-2 text-center bg-white/3 rounded-xl p-3 mb-3">
        <div>
          <div class="text-[10px] text-slate-500">รายการทั้งหมด</div>
          <div class="text-white font-bold"><%= p.total_bookings || 0 %></div>
        </div>
        <div>
          <div class="text-[10px] text-slate-500">รายได้รวม</div>
          <div class="text-emerald-400 font-bold">฿<%= Number(p.total_revenue || 0).toLocaleString() %></div>
        </div>
        <% if (p.outstanding_credit > 0) { %>
        <div class="col-span-2">
          <div class="text-[10px] text-red-400">ค้างชำระ ฿<%= Number(p.outstanding_credit).toLocaleString() %></div>
        </div>
        <% } %>
      </div>

      <div class="flex gap-2">
        <a href="/freight?partner_id=<%= p.id %>"
           class="flex-1 py-2 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white text-xs font-semibold text-center transition-all">
          <i class="fa-solid fa-list mr-1"></i> รายการจอง
        </a>
        <button @click="editId = <%= p.id %>; editData = <%- JSON.stringify({
          company_name: p.company_name, contact_name: p.contact_name,
          phone: p.phone || '', line_id: p.line_id || '', email: p.email || '',
          address: p.address || '', tax_id: p.tax_id || '',
          business_type: p.business_type || '', default_unit: p.default_unit,
          credit_days: p.credit_days, credit_limit_thb: p.credit_limit_thb,
          status: p.status, notes: p.notes || ''
        }) %>; showModal = true"
                class="px-3 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 hover:bg-amber-500/20 text-xs font-semibold transition-all">
          <i class="fa-solid fa-pen-to-square"></i>
        </button>
      </div>
    </div>
    <% }); %>
  </div>

  <%# Modal — Add/Edit %>
  <div x-show="showModal" x-cloak
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
    <div class="bg-slate-900 border border-white/10 rounded-2xl w-full max-w-lg shadow-2xl"
         @click.stop>
      <div class="flex items-center justify-between px-6 py-4 border-b border-white/8">
        <h3 class="text-white font-bold flex items-center gap-2">
          <i class="fa-solid fa-handshake text-amber-400"></i>
          <span x-text="editId ? 'แก้ไขพาร์ทเนอร์' : 'เพิ่มร้านค้าใหม่'"></span>
        </h3>
        <button @click="showModal = false" class="text-slate-500 hover:text-white transition-all">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form :action="editId ? '/freight/partners/' + editId : '/freight/partners'" method="POST" class="p-6 space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">ชื่อร้าน / บริษัท *</label>
            <input type="text" name="company_name" :value="editData.company_name || ''" required
                   class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50 placeholder-slate-600" placeholder="ชื่อร้านค้า">
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">ชื่อผู้ติดต่อ *</label>
            <input type="text" name="contact_name" :value="editData.contact_name || ''" required
                   class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50" placeholder="คุณ...">
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">เบอร์โทร</label>
            <input type="text" name="phone" :value="editData.phone || ''"
                   class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50" placeholder="08x-xxx-xxxx">
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">ประเภทสินค้า</label>
            <input type="text" name="business_type" :value="editData.business_type || ''"
                   class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50" placeholder="เช่น เสื้อผ้า, อาหาร">
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">หน่วยปกติ</label>
            <select name="default_unit" class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none">
              <option value="BOX" :selected="editData.default_unit === 'BOX'">BOX กล่อง</option>
              <option value="SACK" :selected="editData.default_unit === 'SACK'">SACK กระสอบ</option>
              <option value="PALLET" :selected="editData.default_unit === 'PALLET'">PALLET พาเลต</option>
              <option value="BULK" :selected="editData.default_unit === 'BULK'">BULK เหมา</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">วันเครดิต (0 = ชำระก่อน)</label>
            <input type="number" name="credit_days" :value="editData.credit_days ?? 0" min="0"
                   class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50">
          </div>
          <div>
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">วงเงินเครดิต (บาท)</label>
            <input type="number" name="credit_limit_thb" :value="editData.credit_limit_thb || 0" min="0"
                   class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50">
          </div>
          <div x-show="editId">
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">สถานะ</label>
            <select name="status" class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none">
              <option value="active" :selected="editData.status === 'active'">ใช้งาน</option>
              <option value="inactive" :selected="editData.status === 'inactive'">ปิดใช้งาน</option>
              <option value="suspended" :selected="editData.status === 'suspended'">ระงับ</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="block text-[10px] text-slate-400 uppercase font-bold mb-1">หมายเหตุ</label>
            <textarea name="notes" rows="2" :placeholder="editData.notes || 'หมายเหตุ...'"
                      class="w-full px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm focus:outline-none focus:border-amber-400/50"></textarea>
          </div>
        </div>

        <div class="flex gap-3 justify-end pt-2">
          <button type="button" @click="showModal = false"
                  class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-slate-300 text-sm font-semibold">ยกเลิก</button>
          <button type="submit"
                  class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-white text-sm font-bold">
            <i class="fa-solid fa-floppy-disk mr-1.5"></i>
            <span x-text="editId ? 'บันทึกการแก้ไข' : 'เพิ่มพาร์ทเนอร์'"></span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
