<%# views/branches/new.ejs — Create Branch %>

<div class="max-w-2xl mx-auto" x-data="branchForm()">
  <div class="flex items-center gap-3 mb-6">
    <a href="/branches" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all">
      <i class="fa-solid fa-arrow-left text-sm"></i>
    </a>
    <div>
      <h2 class="text-2xl font-bold text-white">เพิ่มสาขาใหม่</h2>
      <p class="text-slate-400 text-sm">จุดกระจายสินค้า Last-mile ในลาว</p>
    </div>
  </div>

  <form action="/branches" method="POST" class="space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Basic Info -->
    <div class="glass-panel-dark p-5 space-y-4">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-shop text-amber-400"></i> ข้อมูลสาขา
      </h3>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            รหัสสาขา <span class="text-red-400">*</span>
          </label>
          <input type="text" name="branch_code" required
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500/50 text-sm font-mono uppercase"
            placeholder="LA-VTE-001" value="<%= draft?.branch_code || '' %>">
          <p class="text-slate-600 text-xs mt-1">ประเทศ-จังหวัด-ลำดับ</p>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            ชื่อสาขา <span class="text-red-400">*</span>
          </label>
          <input type="text" name="name" required
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500/50 text-sm"
            placeholder="เช่น สาขาวัดจันทร์" value="<%= draft?.name || '' %>">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">
            ชื่อเจ้าของ / ผู้ดำเนินการ <span class="text-red-400">*</span>
          </label>
          <input type="text" name="operator_name" required
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500/50 text-sm"
            placeholder="ชื่อ-นามสกุล" value="<%= draft?.operator_name || '' %>">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">เบอร์โทร</label>
          <input type="text" name="phone"
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500/50 text-sm"
            placeholder="020-XXXXXXXX" value="<%= draft?.phone || '' %>">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">แขวง (จังหวัด)</label>
          <select name="province" class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white focus:outline-none focus:border-amber-500/50 text-sm">
            <option value="">-- เลือกแขวง --</option>
            <option value="เวียงจันทน์" <%= draft?.province==='เวียงจันทน์'?'selected':'' %>>เวียงจันทน์ (Vientiane)</option>
            <option value="สะหวันนะเขต" <%= draft?.province==='สะหวันนะเขต'?'selected':'' %>>สะหวันนะเขต</option>
            <option value="หลวงพระบาง" <%= draft?.province==='หลวงพระบาง'?'selected':'' %>>หลวงพระบาง</option>
            <option value="ปากเซ" <%= draft?.province==='ปากเซ'?'selected':'' %>>ปากเซ (Champasak)</option>
            <option value="ท่าแขก" <%= draft?.province==='ท่าแขก'?'selected':'' %>>ท่าแขก (Khammuane)</option>
            <option value="อื่นๆ" <%= draft?.province==='อื่นๆ'?'selected':'' %>>อื่นๆ</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">เมือง (อำเภอ)</label>
          <input type="text" name="district"
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white placeholder-slate-600 focus:outline-none focus:border-amber-500/50 text-sm"
            placeholder="เช่น ไซทานี" value="<%= draft?.district || '' %>">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">ที่อยู่</label>
        <textarea name="address" rows="2"
          class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500/50 text-sm resize-none"
          placeholder="บ้านเลขที่, ถนน..."><%= draft?.address || '' %></textarea>
      </div>
    </div>

    <!-- GPS Location -->
    <div class="glass-panel-dark p-5 space-y-4">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-map-location-dot text-cyan-400"></i>
        พิกัด GPS สาขา
        <span class="text-slate-500 text-xs font-normal">(สำหรับ auto-assign orders)</span>
      </h3>
      <%- include('_plus_code', {
        lat: draft?.lat || '', lng: draft?.lng || '',
        code: draft?.plus_code || '',
        plusCode: null,
        accent: 'cyan',
      }) %>
    </div>

    <!-- Zone + Fees -->
    <div class="glass-panel-dark p-5 space-y-4">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-circle-nodes text-purple-400"></i>
        Zone รัศมีและค่าส่ง (LAK)
      </h3>

      <div class="grid grid-cols-3 gap-3">
        <!-- Zone A -->
        <div class="p-3 rounded-xl bg-emerald-500/8 border border-emerald-500/15 space-y-2">
          <div class="text-emerald-400 text-xs font-bold">ZONE A</div>
          <div>
            <label class="block text-slate-500 text-[10px] mb-1">รัศมี (กม.)</label>
            <input type="number" name="zone_a_km" step="0.5" min="1" max="20"
              class="w-full px-3 py-1.5 rounded-lg border border-emerald-500/20 bg-black/20 text-white text-sm text-center"
              value="<%= draft?.zone_a_km || 5 %>">
          </div>
          <div>
            <label class="block text-slate-500 text-[10px] mb-1">ค่าส่ง (LAK)</label>
            <input type="number" name="fee_zone_a" step="1000" min="0"
              class="w-full px-3 py-1.5 rounded-lg border border-emerald-500/20 bg-black/20 text-white text-sm text-center"
              value="<%= draft?.fee_zone_a || 15000 %>">
          </div>
        </div>

        <!-- Zone B -->
        <div class="p-3 rounded-xl bg-cyan-500/8 border border-cyan-500/15 space-y-2">
          <div class="text-cyan-400 text-xs font-bold">ZONE B</div>
          <div>
            <label class="block text-slate-500 text-[10px] mb-1">รัศมี (กม.)</label>
            <input type="number" name="zone_b_km" step="0.5" min="1" max="30"
              class="w-full px-3 py-1.5 rounded-lg border border-cyan-500/20 bg-black/20 text-white text-sm text-center"
              value="<%= draft?.zone_b_km || 10 %>">
          </div>
          <div>
            <label class="block text-slate-500 text-[10px] mb-1">ค่าส่ง (LAK)</label>
            <input type="number" name="fee_zone_b" step="1000" min="0"
              class="w-full px-3 py-1.5 rounded-lg border border-cyan-500/20 bg-black/20 text-white text-sm text-center"
              value="<%= draft?.fee_zone_b || 25000 %>">
          </div>
        </div>

        <!-- Zone C -->
        <div class="p-3 rounded-xl bg-purple-500/8 border border-purple-500/15 space-y-2">
          <div class="text-purple-400 text-xs font-bold">ZONE C</div>
          <div>
            <label class="block text-slate-500 text-[10px] mb-1">รัศมี (กม.)</label>
            <input type="number" name="zone_c_km" step="0.5" min="1" max="50"
              class="w-full px-3 py-1.5 rounded-lg border border-purple-500/20 bg-black/20 text-white text-sm text-center"
              value="<%= draft?.zone_c_km || 15 %>">
          </div>
          <div>
            <label class="block text-slate-500 text-[10px] mb-1">ค่าส่ง (LAK)</label>
            <input type="number" name="fee_zone_c" step="1000" min="0"
              class="w-full px-3 py-1.5 rounded-lg border border-purple-500/20 bg-black/20 text-white text-sm text-center"
              value="<%= draft?.fee_zone_c || 40000 %>">
          </div>
        </div>
      </div>
    </div>

    <!-- Revenue Split -->
    <div class="glass-panel-dark p-5 space-y-4">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-chart-pie text-amber-400"></i>
        แผนแบ่งรายได้
      </h3>

      <div class="grid grid-cols-3 gap-3 mb-4">
        <label :class="splitPlan==='A' ? 'border-amber-500/40 bg-amber-500/10' : 'border-white/10 bg-white/3'"
               class="p-3 rounded-xl border cursor-pointer hover:brightness-125 transition-all">
          <input type="radio" name="split_plan" value="A" x-model="splitPlan" class="sr-only">
          <div class="text-amber-400 font-bold text-sm mb-1">Plan A</div>
          <div class="text-white text-xs">Fixed</div>
          <div class="text-slate-400 text-[10px] mt-1">Branch 70% / Hub 30%</div>
          <div class="text-slate-500 text-[10px]">เหมาะกับนักธุรกิจใหม่</div>
        </label>
        <label :class="splitPlan==='B' ? 'border-cyan-500/40 bg-cyan-500/10' : 'border-white/10 bg-white/3'"
               class="p-3 rounded-xl border cursor-pointer hover:brightness-125 transition-all">
          <input type="radio" name="split_plan" value="B" x-model="splitPlan" class="sr-only">
          <div class="text-cyan-400 font-bold text-sm mb-1">Plan B</div>
          <div class="text-white text-xs">Share + Rider</div>
          <div class="text-slate-400 text-[10px] mt-1">Branch 55% / Hub 25% / Rider 20%</div>
          <div class="text-slate-500 text-[10px]">สาขาขนาดกลาง</div>
        </label>
        <label :class="splitPlan==='C' ? 'border-purple-500/40 bg-purple-500/10' : 'border-white/10 bg-white/3'"
               class="p-3 rounded-xl border cursor-pointer hover:brightness-125 transition-all">
          <input type="radio" name="split_plan" value="C" x-model="splitPlan" class="sr-only">
          <div class="text-purple-400 font-bold text-sm mb-1">Plan C</div>
          <div class="text-white text-xs">Volume Bonus</div>
          <div class="text-slate-400 text-[10px] mt-1">Branch 50–70% ขึ้นอยู่กับปริมาณ</div>
          <div class="text-slate-500 text-[10px]">สาขา > 200 order/เดือน</div>
        </label>
      </div>

      <!-- Custom split -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Hub ได้ (%)</label>
          <input type="number" name="split_hub_pct" step="1" min="0" max="100"
            x-model.number="hubPct" @input="branchPct = 100 - hubPct"
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white focus:outline-none text-sm text-center"
            value="<%= draft?.split_hub_pct || 30 %>">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Branch ได้ (%)</label>
          <input type="number" name="split_branch_pct" step="1" min="0" max="100"
            x-model.number="branchPct" @input="hubPct = 100 - branchPct"
            class="w-full px-4 py-2.5 rounded-xl border border-white/10 bg-white/5 text-white focus:outline-none text-sm text-center"
            value="<%= draft?.split_branch_pct || 70 %>">
        </div>
      </div>
      <div :class="Math.abs(hubPct + branchPct - 100) > 0.1 ? 'text-red-400' : 'text-emerald-400'"
           class="text-xs flex items-center gap-1">
        <i :class="Math.abs(hubPct + branchPct - 100) > 0.1 ? 'fa-triangle-exclamation' : 'fa-circle-check'" class="fa-solid"></i>
        รวมทั้งหมด: <span x-text="(hubPct + branchPct).toFixed(1)"></span>%
        <span x-show="Math.abs(hubPct + branchPct - 100) < 0.1" class="text-emerald-400">(ถูกต้อง)</span>
        <span x-show="Math.abs(hubPct + branchPct - 100) > 0.1" class="text-red-400">(ต้องเท่ากับ 100%)</span>
      </div>
    </div>

    <!-- Submit -->
    <div class="flex justify-end gap-3">
      <a href="/branches" class="px-5 py-2.5 rounded-xl border border-white/10 text-slate-400 hover:text-white transition-all text-sm">ยกเลิก</a>
      <button type="submit" :disabled="Math.abs(hubPct + branchPct - 100) > 0.1"
        :class="Math.abs(hubPct + branchPct - 100) > 0.1 ? 'opacity-50 cursor-not-allowed from-slate-600 to-slate-700' : 'from-amber-500 to-orange-600 hover:shadow-amber-500/25 hover:shadow-lg'"
        class="px-8 py-2.5 bg-gradient-to-r text-white font-semibold rounded-xl transition-all text-sm flex items-center gap-2">
        <i class="fa-solid fa-plus"></i> สร้างสาขา
      </button>
    </div>
  </form>
</div>

<script>
function branchForm() {
  return {
    splitPlan: '<%= draft?.split_plan || "A" %>',
    hubPct: <%= draft?.split_hub_pct || 30 %>,
    branchPct: <%= draft?.split_branch_pct || 70 %>,
  };
}
</script>
