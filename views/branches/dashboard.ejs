<%# views/branches/dashboard.ejs — Branch Operator Portal %>

<div class="space-y-5">

  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <div class="text-amber-400 text-xs font-bold uppercase tracking-widest mb-1">
        <i class="fa-solid fa-shop mr-1.5"></i>
        <%= branch.branch_code %> — สาขาของคุณ
      </div>
      <h2 class="text-2xl font-bold text-white"><%= branch.name %></h2>
      <p class="text-slate-400 text-sm"><%= branch.district %>, <%= branch.province %></p>
    </div>
    <div class="text-right">
      <div class="text-emerald-400 font-bold text-xl">
        <%- Number(stats.month_earn || 0).toLocaleString() %> LAK
      </div>
      <div class="text-slate-500 text-xs">รายได้เดือนนี้ (ส่วนสาขา)</div>
    </div>
  </div>

  <!-- KPI row -->
  <div class="grid grid-cols-4 gap-3">
    <div class="glass-panel-dark p-3 text-center">
      <div class="text-amber-400 font-bold text-2xl"><%= stats.pending || 0 %></div>
      <div class="text-slate-400 text-xs">รอ assign</div>
    </div>
    <div class="glass-panel-dark p-3 text-center">
      <div class="text-blue-400 font-bold text-2xl"><%= (stats.assigned || 0) + (stats.picked_up || 0) %></div>
      <div class="text-slate-400 text-xs">กำลังส่ง</div>
    </div>
    <div class="glass-panel-dark p-3 text-center">
      <div class="text-emerald-400 font-bold text-2xl"><%= stats.today_delivered || 0 %></div>
      <div class="text-slate-400 text-xs">ส่งสำเร็จวันนี้</div>
    </div>
    <div class="glass-panel-dark p-3 text-center border border-amber-500/20">
      <div class="text-white font-bold text-sm"><%= Number(stats.month_earn || 0).toLocaleString() %></div>
      <div class="text-amber-400 text-xs">LAK เดือนนี้</div>
    </div>
  </div>

  <!-- Delivery Queue -->
  <div class="glass-panel-dark p-5">
    <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
      <i class="fa-solid fa-inbox text-amber-400"></i>
      คิวงานรอดำเนินการ
      <% if (queue.filter(q=>q.status==='PENDING').length > 0) { %>
      <span class="ml-auto px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 text-xs font-bold">
        <%= queue.filter(q=>q.status==='PENDING').length %> ใหม่
      </span>
      <% } %>
    </h3>

    <% if (!queue || queue.length === 0) { %>
    <div class="flex flex-col items-center gap-2 py-8 text-slate-500">
      <i class="fa-solid fa-circle-check text-3xl text-emerald-500/40"></i>
      <span>ไม่มีงานค้างในขณะนี้ 🎉</span>
    </div>
    <% } else { %>
    <div class="space-y-3">
      <% queue.forEach(delivery => {
        const isNew = delivery.status === 'PENDING';
        const isAssigned = delivery.status === 'ASSIGNED';
        const isPickedUp = delivery.status === 'PICKED_UP';
        const zoneColor = {A:'emerald',B:'cyan',C:'purple',X:'slate'}[delivery.zone] || 'slate';
      %>
      <div class="flex items-start gap-3 p-3 rounded-xl border <%= isNew ? 'bg-amber-500/5 border-amber-500/15' : 'bg-white/3 border-white/8' %>">
        <!-- Zone badge -->
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-<%= zoneColor %>-500/15 flex flex-col items-center justify-center">
          <div class="text-<%= zoneColor %>-400 text-xs font-bold">Zone</div>
          <div class="text-<%= zoneColor %>-300 font-bold text-lg"><%= delivery.zone %></div>
        </div>

        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <a href="/orders/<%= delivery.order_id %>" class="text-white font-bold text-sm hover:text-cyan-400 transition-colors">
              <%= delivery.job_no %>
            </a>
            <% if (delivery.cod_amount > 0) { %>
            <span class="px-1.5 py-0.5 rounded-full bg-amber-500/20 text-amber-400 text-[10px] font-bold">
              COD <%=  Number(delivery.cod_amount).toLocaleString() %>฿
            </span>
            <% } %>
          </div>
          <div class="text-slate-300 text-sm"><%= delivery.receiver_name || '–' %></div>
          <div class="text-slate-500 text-xs"><%= delivery.receiver_phone || '' %> | <%= delivery.receiver_address || '' %></div>
          <div class="text-xs mt-1">
            <span class="<%= isNew ? 'text-amber-400' : isAssigned ? 'text-blue-400' : 'text-cyan-400' %>">
              <%= isNew ? '⏳ รอมอบหมายไรเดอร์' : isAssigned ? '🛵 ไรเดอร์รับแล้ว' : '🚀 กำลังนำส่ง' %>
            </span>
          </div>
        </div>

        <!-- Action: Assign rider (PENDING only) -->
        <% if (isNew && riders.filter(r=>r.status!=='inactive').length > 0) { %>
        <div class="flex-shrink-0" x-data="{ open: false }">
          <button @click="open=!open"
            class="px-3 py-2 text-xs font-semibold rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 hover:bg-amber-500/30 transition-all flex items-center gap-1.5">
            <i class="fa-solid fa-user-plus"></i> มอบหมาย
          </button>
          <!-- Rider dropdown -->
          <div x-show="open" @click.outside="open=false"
               class="absolute z-50 mt-1 w-44 bg-slate-900 border border-white/10 rounded-xl shadow-xl overflow-hidden">
            <% riders.filter(r=>r.status!=='inactive').forEach(rider => { %>
            <form action="/branch/deliveries/<%= delivery.id %>/assign" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="rider_id" value="<%= rider.id %>">
              <button type="submit" class="w-full px-3 py-2.5 hover:bg-white/5 transition-colors text-left flex items-center gap-2">
                <span class="w-2 h-2 rounded-full flex-shrink-0 <%= rider.status==='active' ? 'bg-emerald-400' : 'bg-amber-400' %>"></span>
                <div>
                  <div class="text-white text-xs font-medium"><%= rider.name %></div>
                  <div class="text-slate-500 text-[10px]"><%= rider.vehicle_type %> | <%= rider.status==='active'?'ว่าง':'กำลังส่ง' %></div>
                </div>
              </button>
            </form>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Action: Mark Delivered (ASSIGNED/PICKED_UP) -->
        <% if (isAssigned || isPickedUp) { %>
        <button onclick="showDeliverModal(<%= delivery.id %>, <%= Number(delivery.cod_amount || 0) %>)"
          class="flex-shrink-0 px-3 py-2 text-xs font-semibold rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/30 transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-circle-check"></i> ส่งแล้ว
        </button>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Riders Status -->
  <div class="glass-panel-dark p-5">
    <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
      <i class="fa-solid fa-motorcycle text-blue-400"></i>
      ทีมไรเดอร์
    </h3>
    <% if (!riders || riders.length === 0) { %>
    <div class="text-slate-500 text-sm text-center py-4">
      ยังไม่มีไรเดอร์ — <a href="/branches/<%= branch.id %>" class="text-amber-400 hover:text-amber-300">เพิ่มไรเดอร์</a>
    </div>
    <% } else { %>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      <% riders.forEach(rider => { %>
      <div class="flex items-center gap-2.5 p-3 rounded-xl bg-white/3 border border-white/8">
        <div class="w-9 h-9 rounded-full bg-blue-500/15 flex items-center justify-center flex-shrink-0">
          <i class="fa-solid fa-person-biking text-blue-400 text-sm"></i>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-white text-sm font-medium truncate"><%= rider.name %></div>
          <div class="text-slate-500 text-xs"><%= rider.phone %></div>
        </div>
        <span class="w-2.5 h-2.5 rounded-full flex-shrink-0 <%= rider.status==='active' ? 'bg-emerald-400' : rider.status==='busy' ? 'bg-amber-400 animate-pulse' : 'bg-slate-500' %>"></span>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<!-- Deliver Modal -->
<div id="deliverModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden">
  <div class="glass-panel-dark p-6 w-full max-w-sm mx-4">
    <h3 class="text-white font-bold text-lg mb-4"><i class="fa-solid fa-circle-check text-emerald-400 mr-2"></i>ยืนยันการส่ง</h3>
    <form id="deliverForm" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="space-y-3">
        <div>
          <label class="text-xs text-slate-400 mb-1 block">ชื่อผู้รับจริง</label>
          <input type="text" name="recipient_name" placeholder="ชื่อ-นามสกุล ผู้รับ" required maxlength="120"
            class="w-full px-3 py-2 rounded-xl border border-white/10 bg-white/5 text-white text-sm focus:outline-none focus:border-emerald-500/50">
        </div>
        <div>
          <label class="text-xs text-slate-400 mb-1 block">รูปหลักฐาน (ถ่ายหน้าบ้าน)</label>
          <input type="file" name="proof_image" accept="image/*" capture="environment" required
            class="w-full px-3 py-2 rounded-xl border border-white/10 bg-white/5 text-slate-400 text-xs file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:bg-emerald-500/20 file:text-emerald-400">
        </div>
        <div id="codConfirmGroup" class="hidden">
          <label class="text-xs text-amber-400 mb-1 block">ยืนยันยอด COD ที่รับจริง: <span id="codExpected"></span></label>
          <input id="codCollectedAmount" type="number" name="cod_collected_amount" min="0" step="0.01"
            placeholder="กรอกยอด COD ให้ตรงกับยอดที่เรียกเก็บ"
            class="w-full px-3 py-2 rounded-xl border border-amber-500/30 bg-amber-500/5 text-white text-sm focus:outline-none focus:border-amber-400">
        </div>
        <div>
          <label class="text-xs text-slate-400 mb-1 block">หมายเหตุ (ถ้ามี)</label>
          <input type="text" name="notes" placeholder="เช่น ฝากไว้ที่เพื่อนบ้าน"
            class="w-full px-3 py-2 rounded-xl border border-white/10 bg-white/5 text-white text-sm focus:outline-none">
        </div>
        <div class="flex gap-2 pt-2">
          <button type="button" onclick="document.getElementById('deliverModal').classList.add('hidden')"
            class="flex-1 py-2 rounded-xl border border-white/10 text-slate-400 hover:text-white text-sm transition-all">
            ยกเลิก
          </button>
          <button type="submit" class="flex-1 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-sm font-semibold hover:shadow-emerald-500/25 hover:shadow-lg transition-all">
            <i class="fa-solid fa-check mr-1"></i> ยืนยันส่งแล้ว
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
function showDeliverModal(deliveryId, codAmount) {
  document.getElementById('deliverForm').action = `/branch/deliveries/${deliveryId}/deliver`;
  const codGroup = document.getElementById('codConfirmGroup');
  const codInput = document.getElementById('codCollectedAmount');
  const expected = Number(codAmount || 0);
  codGroup.classList.toggle('hidden', expected <= 0);
  codInput.required = expected > 0;
  codInput.value = '';
  document.getElementById('codExpected').textContent = expected.toLocaleString();
  document.getElementById('deliverModal').classList.remove('hidden');
}
</script>
