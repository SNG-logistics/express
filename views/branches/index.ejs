<%# views/branches/index.ejs — Admin: Branch List %>

<div class="space-y-5">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-white">
        สาขา<span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500">ย่อย</span>
      </h2>
      <p class="text-slate-400 text-sm mt-0.5">จุดกระจายสินค้า Last-mile ในลาว</p>
    </div>
    <a href="/branches/new" class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-600 text-white text-sm font-semibold rounded-xl hover:shadow-lg hover:shadow-amber-500/25 transition-all">
      <i class="fa-solid fa-plus"></i> เพิ่มสาขา
    </a>
  </div>

  <!-- Stats row -->
  <div class="grid grid-cols-3 gap-4">
    <div class="glass-panel-dark p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-500/15 flex items-center justify-center">
        <i class="fa-solid fa-shop text-amber-400"></i>
      </div>
      <div>
        <div class="text-white font-bold text-lg"><%= branches.length %></div>
        <div class="text-slate-400 text-xs">สาขาทั้งหมด</div>
      </div>
    </div>
    <div class="glass-panel-dark p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/15 flex items-center justify-center">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
      </div>
      <div>
        <div class="text-white font-bold text-lg"><%= branches.filter(b=>b.status==='active').length %></div>
        <div class="text-slate-400 text-xs">กำลังเปิดให้บริการ</div>
      </div>
    </div>
    <div class="glass-panel-dark p-4 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-blue-500/15 flex items-center justify-center">
        <i class="fa-solid fa-motorcycle text-blue-400"></i>
      </div>
      <div>
        <div class="text-white font-bold text-lg"><%= branches.reduce((s,b)=>s+(b.rider_count||0),0) %></div>
        <div class="text-slate-400 text-xs">ไรเดอร์ทั้งหมด</div>
      </div>
    </div>
  </div>

  <!-- Branch Cards Grid -->
  <% if (!branches || branches.length === 0) { %>
  <div class="glass-panel-dark p-12 flex flex-col items-center gap-3 text-slate-500">
    <i class="fa-solid fa-shop text-4xl opacity-30"></i>
    <p class="text-lg">ยังไม่มีสาขา</p>
    <a href="/branches/new" class="text-amber-400 text-sm hover:text-amber-300">+ เพิ่มสาขาแรก</a>
  </div>
  <% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% branches.forEach(branch => {
      const statusClass = branch.status === 'active'
        ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/25'
        : branch.status === 'suspended'
          ? 'bg-red-500/15 text-red-400 border-red-500/25'
          : 'bg-slate-500/15 text-slate-400 border-slate-500/25';
      const statusLabel = branch.status === 'active' ? 'เปิดบริการ' : branch.status === 'suspended' ? 'ระงับ' : 'ปิดชั่วคราว';
    %>
    <a href="/branches/<%= branch.id %>" class="glass-panel-dark p-5 hover:brightness-125 transition-all block group border border-white/0 hover:border-amber-500/20">
      <div class="flex items-start justify-between mb-3">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-mono text-amber-400/80"><%= branch.branch_code %></span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= statusClass %>"><%= statusLabel %></span>
          </div>
          <div class="text-white font-bold text-base"><%= branch.name %></div>
          <div class="text-slate-400 text-sm"><%= branch.operator_name %></div>
        </div>
        <span class="px-2 py-1 rounded-lg bg-white/5 text-slate-400 text-xs font-bold">Plan <%= branch.split_plan %></span>
      </div>

      <div class="text-slate-500 text-xs mb-3">
        <i class="fa-solid fa-location-dot mr-1.5 text-amber-400/60"></i>
        <%= branch.district ? branch.district + ', ' : '' %><%= branch.province || '–' %>
      </div>

      <!-- Zone pills -->
      <div class="flex gap-1.5 mb-4">
        <span class="px-2 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 text-[10px] font-bold">
          A ≤ <%= branch.zone_a_km %>กม.
        </span>
        <span class="px-2 py-1 rounded-lg bg-cyan-500/10 text-cyan-400 text-[10px] font-bold">
          B ≤ <%= branch.zone_b_km %>กม.
        </span>
        <span class="px-2 py-1 rounded-lg bg-purple-500/10 text-purple-400 text-[10px] font-bold">
          C ≤ <%= branch.zone_c_km %>กม.
        </span>
      </div>

      <div class="flex items-center justify-between border-t border-white/8 pt-3">
        <div class="flex items-center gap-3 text-xs text-slate-400">
          <span><i class="fa-solid fa-motorcycle mr-1 text-blue-400/70"></i><%= branch.rider_count %> ไรเดอร์</span>
          <% if (branch.pending_count > 0) { %>
          <span class="text-amber-400 font-semibold"><i class="fa-solid fa-clock mr-1"></i><%= branch.pending_count %> รอส่ง</span>
          <% } %>
        </div>
        <div class="text-amber-400/70 text-xs">Hub <%= branch.split_hub_pct %>% / Branch <%= branch.split_branch_pct %>%</div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>
