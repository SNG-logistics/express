                                <div>
                                    <span class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">💬 ประวัติแชทลูกค้า CRM (CRM Chats)</span>
                                    <p class="text-xs text-slate-500 mt-1">ลบประวัติการแชท Omnichannel และเคสเปิดตั๋วติดต่อของลูกค้า</p>
                                </div>
                            </label>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 pt-2">
                            <input type="password" name="admin_password" required placeholder="ใส่รหัสผ่านแอดมินเพื่อยืนยัน"
                                class="w-full sm:w-64 bg-slate-900 border border-red-500/30 rounded-xl px-4 py-2.5 text-white text-sm focus:ring-red-500 focus:border-red-500 placeholder-slate-600">
                            <button type="submit"
                                class="w-full sm:w-auto px-6 py-2.5 bg-red-600/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/50 hover:border-red-600 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all">
                                <i class="fa-solid fa-trash-can"></i> ยืนยันล้างข้อมูลที่เลือก
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <% } %>

</div>

<script>
// ── Logo preview (ใช้ได้ทั้ง TH และ LA) ─────────────────────────
function previewLogo(input, suffix) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    const label = document.getElementById('file-label-' + suffix);
    if (label) label.textContent = file.name;
    const reader = new FileReader();
    reader.onload = (e) => {
        const img  = document.getElementById('logo-preview-' + suffix);
        const ph   = document.getElementById('logo-ph-' + suffix);
        if (img) { img.src = e.target.result; img.classList.remove('hidden'); }
        if (ph)  ph.classList.add('hidden');
    };
    reader.readAsDataURL(file);
}

// ── Tab switching ─────────────────────────────────────────────────
function switchOfficeTab(target) {
    // Panels
    document.querySelectorAll('.office-panel').forEach(p => p.classList.remove('active-panel'));
    const panel = document.getElementById('panel-' + target);
    if (panel) panel.classList.add('active-panel');
    // Tabs
    document.querySelectorAll('.office-tab').forEach(t => t.classList.remove('active-tab'));
    const tab = document.getElementById('tab-' + target);
    if (tab) tab.classList.add('active-tab');
    // Remember tab in sessionStorage
    sessionStorage.setItem('officeTab', target);
}

// Restore last active tab on page load
document.addEventListener('DOMContentLoaded', () => {
    const saved = sessionStorage.getItem('officeTab');
    if (saved === 'la') switchOfficeTab('la');
});
</script>


