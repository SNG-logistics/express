<div class="max-w-7xl mx-auto animate-fade-in">
    <div class="flex flex-col md:flex-row items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                <span class="bg-indigo-500 w-1.5 h-8 rounded-full inline-block"></span>
                ตั้งค่าราคาขนส่ง (Shipping Rates)
            </h1>
            <p class="text-slate-400 mt-2 ml-6 text-sm">กำหนดราคาขนส่งตามน้ำหนักสำหรับคำนวณอัตโนมัติ</p>
        </div>
    </div>

    <% if (success) { %>
        <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 text-emerald-200 border border-emerald-500/20 flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-circle-check"></i>
            <%= success %>
        </div>
        <% } %>
    <% if (flashError) { %>
        <div class="mb-6 p-4 rounded-xl bg-red-500/10 text-red-200 border border-red-500/20 flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-circle-xmark"></i>
            <%= flashError %>
        </div>
    <% } %>

    <%- include('_panel_rates', { rates, csrfToken }) %>

    <%# ═══════════════════ EXCHANGE RATE MANAGER ════════════════════ %>
    <div id="fx" class="mt-12 space-y-6">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
            <h2 class="text-xl font-black text-white">อัตราแลกเปลี่ยน (Exchange Rate)</h2>
        </div>
        <%- include('_panel_fx', { fxRates, csrfToken }) %>
    </div>

    <%# ═══════════════════ HOME BANNER + CONTENT LINKS ═════════════════════ %>
    <div id="banner" class="mt-16 space-y-4">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
            <h2 class="text-xl font-black text-white">หน้าแรกลูกค้า / ໜ້າທຳອິດລູກຄ້າ</h2>
        </div>
        <%- include('_panel_banner', { company, csrfToken }) %>
    </div>

    <%# ═══════════════════ COMPANY PROFILE (ADMIN ONLY) ════════════════════ %>
    <% if (user && ['owner','admin'].includes(user.role)) { %>
    <div id="company" class="mt-16 space-y-6">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-violet-500 rounded-full"></div>
            <h2 class="text-xl font-black text-white">
                ข้อมูลบริษัท / ຂໍ້ມູນບໍລິສັດ
            </h2>
            <span class="text-slate-500 text-sm font-normal">— ตั้งค่าออฟฟิสไทย & ລາວ</span>
        </div>
        <%- include('_panel_company', { user, company, csrfToken }) %>
    </div>
    <% } %>

    <%# ═══════════════════ DANGER ZONE (ADMIN ONLY) ════════════════════ %>
    <% if (user && ['owner','admin'].includes(user.role)) { %>
    <div class="mt-16 space-y-6">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-red-500 rounded-full"></div>
            <h2 class="text-xl font-black text-white">พื้นที่อันตราย (Danger Zone)</h2>
        </div>

        <div class="glass-panel-dark rounded-3xl p-6 md:p-8 border border-red-500/30 bg-red-500/5 relative overflow-hidden">
            <!-- Warning Background Pattern -->
            <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: repeating-linear-gradient(45deg, #ef4444 25%, transparent 25%, transparent 75%, #ef4444 75%, #ef4444), repeating-linear-gradient(45deg, #ef4444 25%, transparent 25%, transparent 75%, #ef4444 75%, #ef4444); background-position: 0 0, 20px 20px; background-size: 40px 40px;"></div>

            <div class="relative z-10 flex flex-col gap-6">
                <div>
                    <h3 class="text-lg font-bold text-red-400 flex items-center gap-2 mb-2">
                        <i class="fa-solid fa-triangle-exclamation"></i> ล้างข้อมูลการทดสอบระบบ (Clear Test Data)
                    </h3>
                    <p class="text-sm text-slate-400 max-w-2xl leading-relaxed">
                        เลือกหัวข้อข้อมูลทดสอบที่ต้องการเคลียร์ออกจากระบบ ข้อมูลจะถูกลบอย่างถาวรและไม่สามารถกู้คืนได้ (แนะนำให้ใช้ล้างข้อมูลหลังจากการทดสอบระบบเสร็จสิ้นแล้วเท่านั้น)
                    </p>
                </div>

                <div class="w-full">
                    <form action="/settings/clear-test-data" method="post" class="space-y-5" onsubmit="return confirm('คำเตือนขั้นสูงสุด: ข้อมูลที่ท่านเลือกจะถูกลบออกจากฐานข้อมูลอย่างถาวร ยืนยันใช่หรือไม่?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <!-- Checkboxes list -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-black/25 p-5 rounded-2xl border border-white/5">
                            <label class="flex items-start gap-3 cursor-pointer group">
                                <input type="checkbox" name="clear_orders" value="1" checked
                                       class="mt-1 w-4 h-4 rounded border-slate-700 text-red-600 bg-slate-900 focus:ring-red-500">
                                <div>
                                    <span class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">📦 ข้อมูลออเดอร์ (Orders)</span>
                                    <p class="text-xs text-slate-500 mt-1">ลบออเดอร์, ประวัติสถานะพัสดุ และธงสกรีนพัสดุ</p>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 cursor-pointer group">
                                <input type="checkbox" name="clear_trips" value="1" checked
                                       class="mt-1 w-4 h-4 rounded border-slate-700 text-red-600 bg-slate-900 focus:ring-red-500">
                                <div>
                                    <span class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">🚛 ข้อมูลรอบรถ (Trips)</span>
                                    <p class="text-xs text-slate-500 mt-1">ลบรอบเดินรถ และการจัดสรรสินค้าในเที่ยววิ่ง</p>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 cursor-pointer group">
                                <input type="checkbox" name="clear_payments" value="1"
                                       class="mt-1 w-4 h-4 rounded border-slate-700 text-red-600 bg-slate-900 focus:ring-red-500">
                                <div>
                                    <span class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">💰 ยอดเงินชำระของออเดอร์ &amp; COD</span>
                                    <p class="text-xs text-slate-500 mt-1">ลบรายการรับเงินค่าส่ง และยอดเคลียร์บิลปลายทาง COD</p>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 cursor-pointer group">
                                <input type="checkbox" name="clear_expenses" value="1"
                                       class="mt-1 w-4 h-4 rounded border-slate-700 text-red-600 bg-slate-900 focus:ring-red-500">
                                <div>
                                    <span class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">💸 ยอดเงินรายจ่าย (Expenses)</span>
                                    <p class="text-xs text-slate-500 mt-1">ลบรายจ่ายรอบรถ (OPEX), รายจ่ายบริษัท และเงินลงทุน (CAPEX)</p>
                                </div>
                            </label>

                            <label class="flex items-start gap-3 cursor-pointer group md:col-span-2 border-t border-white/5 pt-4 mt-2">
                                <input type="checkbox" name="clear_crm" value="1"
                                       class="mt-1 w-4 h-4 rounded border-slate-700 text-red-600 bg-slate-900 focus:ring-red-500">
                                <div>
                                    <span class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">💬 ประวัติแชทลูกค้า CRM (CRM Chats)</span>
                                    <p class="text-xs text-slate-500 mt-1">ลบประวัติการแชท Omnichannel และเคสเปิดตั๋วติดต่อของลูกค้า</p>
                                </div>
                            </label>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-3 pt-2">
                            <input type="password" name="admin_password" required placeholder="ใส่รหัสผ่านแอดมินเพื่อยืนยัน"
                                class="w-full sm:w-64 bg-slate-900 border border-red-500/30 rounded-xl px-4 py-2.5 text-white text-sm focus:ring-red-500 focus:border-red-500 placeholder-slate-600">
                            <button type="submit"
                                class="w-full sm:w-auto px-6 py-2.5 bg-red-600/20 hover:bg-red-600 text-red-400 hover:text-white border border-red-500/50 hover:border-red-600 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all">
                                <i class="fa-solid fa-trash-can"></i> ยืนยันล้างข้อมูลที่เลือก
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <% } %>

</div>
