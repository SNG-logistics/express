<div class="max-w-7xl mx-auto animate-fade-in">
    <div class="flex flex-col md:flex-row items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                <span class="bg-indigo-500 w-1.5 h-8 rounded-full inline-block"></span>
                ตั้งค่าราคาขนส่ง (Shipping Rates)
            </h1>
            <p class="text-slate-400 mt-2 ml-6 text-sm">กำหนดราคาขนส่งตามน้ำหนักสำหรับคำนวณอัตโนมัติ</p>
        </div>
    </div>

    <% if (success) { %>
        <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 text-emerald-200 border border-emerald-500/20 flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-circle-check"></i>
            <%= success %>
        </div>
        <% } %>
    <% if (flashError) { %>
        <div class="mb-6 p-4 rounded-xl bg-red-500/10 text-red-200 border border-red-500/20 flex items-center gap-3 animate-fade-in">
            <i class="fa-solid fa-circle-xmark"></i>
            <%= flashError %>
        </div>
    <% } %>

            <div class="grid lg:grid-cols-3 gap-8">
                <!-- Form Section -->
                <div class="lg:col-span-1">
                    <div class="glass-panel-dark rounded-3xl p-6 border border-white/5 sticky top-24">
                        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                            <i class="fa-solid fa-plus-circle text-amber-500"></i> เพิ่มเรทราคาใหม่
                        </h3>

                        <form action="/settings/rates" method="post" class="space-y-5">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div>
                                <label
                                    class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">ชื่อรายการ</label>
                                <input type="text" name="name" required placeholder="Ex. 1-5 Kg"
                                    class="w-full bg-slate-900/50 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500">
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">ขนาดไม่เกิน
                                        (cm)</label>
                                    <input type="number" step="1" name="max_dimension" required placeholder="W+L+H"
                                        class="w-full bg-slate-900/50 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500">
                                    <p class="text-[10px] text-slate-500 mt-1">ผลรวม กว้าง+ยาว+สูง</p>
                                </div>
                                <div>
                                    <label
                                        class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">น้ำหนักไม่เกิน
                                        (Kg)</label>
                                    <input type="number" step="0.01" name="max_weight" required placeholder="10.00"
                                        class="w-full bg-slate-900/50 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">ราคา
                                    (THB)</label>
                                <div class="relative">
                                    <span class="absolute left-4 top-3 text-slate-500">฿</span>
                                    <input type="number" step="0.01" name="price" required placeholder="150.00"
                                        class="w-full bg-slate-900/50 border border-slate-700 rounded-xl pl-8 pr-4 py-3 text-white focus:ring-emerald-500 focus:border-emerald-500 font-bold text-emerald-400">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                                    ราคาเพิ่มต่อกิโลกรัม (THB/Kg)
                                </label>
                                <input type="number" step="0.01" min="0" name="price_per_kg" value="0"
                                    class="w-full bg-slate-900/50 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-emerald-500 focus:border-emerald-500">
                            </div>

                            <button type="submit"
                                class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold shadow-lg shadow-indigo-900/20 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-save"></i> บันทึก
                            </button>
                        </form>
                    </div>
                </div>

                <!-- List Section -->
                <div class="lg:col-span-2">
                    <div class="glass-panel-dark rounded-3xl overflow-hidden border border-white/5 shadow-2xl">
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm text-left">
                                <thead class="text-xs text-slate-400 uppercase bg-black/20 border-b border-white/5">
                                    <tr>
                                        <th class="px-6 py-4 font-bold">ชื่อรายการ</th>
                                        <th class="px-6 py-4 font-bold text-center">ขนาด (cm)</th>
                                        <th class="px-6 py-4 font-bold text-center">น้ำหนัก (Kg)</th>
                                        <th class="px-6 py-4 font-bold text-right">ราคา</th>
                                        <th class="px-6 py-4 font-bold text-right">ต่อ กก.</th>
                                        <th class="px-6 py-4 font-bold text-right">จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-white/5 text-slate-300">
                                    <% if (rates.length===0) { %>
                                        <tr>
                                            <td colspan="6" class="px-6 py-12 text-center text-slate-500">
                                                <i class="fa-solid fa-scale-unbalanced text-4xl mb-3 opacity-20"></i>
                                                <p>ยังไม่มีเรทราคา</p>
                                            </td>
                                        </tr>
                                        <% } %>

                                            <% rates.forEach((rate)=> { %>
                                                <tr class="hover:bg-white/5 transition-colors">
                                                    <td class="px-6 py-4 font-bold text-white">
                                                        <%= rate.name %>
                                                    </td>
                                                    <td class="px-6 py-4 text-center font-mono text-xs">
                                                        <= <%=Number(rate.max_dimension) %>
                                                    </td>
                                                    <td class="px-6 py-4 text-center font-mono text-xs">
                                                        <= <%=Number(rate.max_weight) %>
                                                    </td>
                                                    <td
                                                        class="px-6 py-4 text-right font-mono font-bold text-emerald-400">
                                                        ฿<%= Number(rate.price).toLocaleString() %>
                                                    </td>
                                                    <td class="px-6 py-4 text-right font-mono text-xs text-emerald-300">
                                                        ฿<%= Number(rate.price_per_kg || 0).toLocaleString() %>
                                                    </td>
                                                    <td class="px-6 py-4 text-right">
                                                        <form action="/settings/rates/<%= rate.id %>/delete"
                                                            method="post"
                                                            onsubmit="return confirm('ยืนยันลบรายการนี้?');">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button
                                                                class="text-slate-500 hover:text-red-400 transition-colors">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

    <%# ═══════════════════ EXCHANGE RATE MANAGER ════════════════════ %>
    <div id="fx" class="mt-12 space-y-6">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
            <h2 class="text-xl font-black text-white">อัตราแลกเปลี่ยน (Exchange Rate)</h2>
        </div>

        <%
          const latestThbLak = fxRates.find(r => r.pair === 'THB_LAK');
          const latestUsdThb = fxRates.find(r => r.pair === 'USD_THB');
          const fxThbLakHistory = fxRates.filter(r => r.pair === 'THB_LAK').slice(0, 10);
          const fxUsdThbHistory = fxRates.filter(r => r.pair === 'USD_THB').slice(0, 10);
        %>

        <!-- 2-column: THB_LAK | USD_THB -->
        <div class="grid lg:grid-cols-2 gap-6">

            <!-- ── THB → LAK ─────────────────────────────── -->
            <div class="glass-panel-dark rounded-3xl p-6 border border-amber-500/20 bg-amber-500/5">
                <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span>🇹🇭→🇱🇦</span> <i class="fa-solid fa-coins"></i> THB → LAK
                </div>
                <% if (latestThbLak) { %>
                    <div class="text-4xl font-black text-white font-mono">
                        <%= Number(latestThbLak.rate).toLocaleString('th', {maximumFractionDigits: 0}) %>
                        <span class="text-lg text-amber-400 font-bold">LAK</span>
                    </div>
                    <div class="text-slate-400 text-sm mt-1">= 1 THB</div>
                    <div class="mt-2 text-xs text-slate-500">
                        <i class="fa-solid fa-clock"></i>
                        อัปเดตโดย <strong class="text-slate-400"><%= latestThbLak.set_by_name || 'ระบบ' %></strong>
                        · <%= new Date(latestThbLak.created_at).toLocaleDateString('th-TH', {day:'numeric',month:'short',year:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
                    </div>
                <% } else { %>
                    <div class="text-slate-500 text-lg mt-2">ยังไม่มีข้อมูล</div>
                <% } %>

                <div class="mt-5 border-t border-white/5 pt-5">
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">ตั้งอัตราใหม่</h4>
                    <form action="/settings/exchange-rate" method="post" class="space-y-3">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="pair" value="THB_LAK">
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">อัตรา (LAK ต่อ 1 THB)</label>
                            <div class="relative">
                                <input type="number" step="1" name="rate" required placeholder="<%= latestThbLak ? Number(latestThbLak.rate).toFixed(0) : '580' %>"
                                    class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white text-xl font-bold font-mono focus:ring-amber-500 focus:border-amber-500 pr-16">
                                <span class="absolute right-4 top-3 text-amber-400 font-bold text-sm">LAK</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">หมายเหตุ (Optional)</label>
                            <input type="text" name="note" placeholder="เช่น ราคาตลาด 18 เม.ย."
                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white text-sm focus:ring-amber-500 focus:border-amber-500">
                        </div>
                        <button type="submit"
                            class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-black rounded-xl font-black text-sm flex items-center justify-center gap-2 transition-all">
                            <i class="fa-solid fa-save"></i> บันทึกอัตราใหม่
                        </button>
                    </form>

                    <!-- Mini history -->
                    <% if (fxThbLakHistory.length > 0) { %>
                    <div class="mt-4 space-y-1.5">
                        <p class="text-[10px] text-slate-600 uppercase tracking-wider font-bold">ประวัติล่าสุด</p>
                        <% fxThbLakHistory.forEach((fx, i) => { %>
                        <div class="flex items-center justify-between text-xs <%= i===0 ? 'text-white font-bold' : 'text-slate-500' %>">
                            <span><%= new Date(fx.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit'}) %></span>
                            <span class="font-mono"><%= Number(fx.rate).toLocaleString() %> LAK/THB</span>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- ── USD → THB ─────────────────────────────── -->
            <div class="glass-panel-dark rounded-3xl p-6 border border-blue-500/20 bg-blue-500/5">
                <div class="text-xs font-bold text-blue-400 uppercase tracking-wider mb-3 flex items-center gap-2">
                    <span>🇺🇸→🇹🇭</span> <i class="fa-solid fa-dollar-sign"></i> USD → THB
                </div>
                <% if (latestUsdThb) { %>
                    <div class="text-4xl font-black text-white font-mono">
                        <%= Number(latestUsdThb.rate).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                        <span class="text-lg text-blue-400 font-bold">THB</span>
                    </div>
                    <div class="text-slate-400 text-sm mt-1">= 1 USD</div>
                    <div class="mt-2 text-xs text-slate-500">
                        <i class="fa-solid fa-clock"></i>
                        อัปเดตโดย <strong class="text-slate-400"><%= latestUsdThb.set_by_name || 'ระบบ' %></strong>
                        · <%= new Date(latestUsdThb.created_at).toLocaleDateString('th-TH', {day:'numeric',month:'short',year:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
                    </div>
                <% } else { %>
                    <div class="text-slate-500 text-base mt-2 flex items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation text-amber-500"></i> ยังไม่ได้ตั้งค่า — ระบบใช้ค่าเริ่มต้น 36 THB/USD
                    </div>
                <% } %>

                <div class="mt-5 border-t border-white/5 pt-5">
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">ตั้งอัตราใหม่</h4>
                    <form action="/settings/exchange-rate" method="post" class="space-y-3">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="pair" value="USD_THB">
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">อัตรา (THB ต่อ 1 USD)</label>
                            <div class="relative">
                                <input type="number" step="0.01" name="rate" required placeholder="<%= latestUsdThb ? Number(latestUsdThb.rate).toFixed(2) : '36.00' %>"
                                    class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white text-xl font-bold font-mono focus:ring-blue-500 focus:border-blue-500 pr-16">
                                <span class="absolute right-4 top-3 text-blue-400 font-bold text-sm">THB</span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">หมายเหตุ (Optional)</label>
                            <input type="text" name="note" placeholder="เช่น BoT rate 22 พ.ค."
                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-2.5 text-white text-sm focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <button type="submit"
                            class="w-full py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-black text-sm flex items-center justify-center gap-2 transition-all">
                            <i class="fa-solid fa-save"></i> บันทึกอัตรา USD
                        </button>
                    </form>

                    <!-- Mini history -->
                    <% if (fxUsdThbHistory.length > 0) { %>
                    <div class="mt-4 space-y-1.5">
                        <p class="text-[10px] text-slate-600 uppercase tracking-wider font-bold">ประวัติล่าสุด</p>
                        <% fxUsdThbHistory.forEach((fx, i) => { %>
                        <div class="flex items-center justify-between text-xs <%= i===0 ? 'text-white font-bold' : 'text-slate-500' %>">
                            <span><%= new Date(fx.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit'}) %></span>
                            <span class="font-mono"><%= Number(fx.rate).toFixed(2) %> THB/USD</span>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Full history table -->
        <div class="glass-panel-dark rounded-3xl overflow-hidden border border-white/5">
            <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between">
                <h4 class="font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-chart-line text-amber-400"></i> ประวัติอัตราแลกเปลี่ยนทั้งหมด
                </h4>
                <span class="text-xs text-slate-500">แสดง 20 รายการล่าสุด</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="text-xs text-slate-500 uppercase bg-black/20 border-b border-white/5">
                        <tr>
                            <th class="px-5 py-3">คู่เงิน</th>
                            <th class="px-5 py-3 text-right">อัตรา</th>
                            <th class="px-5 py-3">หมายเหตุ</th>
                            <th class="px-5 py-3">ตั้งโดย</th>
                            <th class="px-5 py-3">วันที่</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 text-slate-300">
                        <% if (fxRates.length === 0) { %>
                        <tr>
                            <td colspan="5" class="px-5 py-10 text-center text-slate-600">
                                <i class="fa-solid fa-coins text-3xl mb-2 opacity-20"></i>
                                <p>ยังไม่มีประวัติ</p>
                            </td>
                        </tr>
                        <% } %>
                        <% fxRates.forEach((fx) => { %>
                        <tr class="hover:bg-white/5 transition-colors">
                            <td class="px-5 py-3">
                                <% if (fx.pair === 'USD_THB') { %>
                                    <span class="px-2 py-0.5 rounded-lg bg-blue-500/10 text-blue-400 text-xs font-bold font-mono">USD_THB</span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 rounded-lg bg-amber-500/10 text-amber-400 text-xs font-bold font-mono"><%= fx.pair %></span>
                                <% } %>
                            </td>
                            <td class="px-5 py-3 text-right font-mono font-bold text-white">
                                <%= Number(fx.rate).toLocaleString('en-US', {maximumFractionDigits: 2}) %>
                                <span class="text-slate-500 text-xs font-normal">
                                    <%= fx.pair === 'USD_THB' ? 'THB/USD' : 'LAK/THB' %>
                                </span>
                            </td>
                            <td class="px-5 py-3 text-slate-400 text-xs max-w-[120px] truncate"><%= fx.note || '—' %></td>
                            <td class="px-5 py-3 text-slate-400 text-xs"><%= fx.set_by_name || '—' %></td>
                            <td class="px-5 py-3 text-slate-500 text-xs font-mono">
                                <%= new Date(fx.created_at).toLocaleDateString('th-TH', {day:'numeric',month:'short',year:'2-digit',hour:'2-digit',minute:'2-digit'}) %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>



    <%# ═══════════════════ HOME BANNER + CONTENT LINKS ═════════════════════ %>
    <div id="banner" class="mt-16 space-y-4">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
            <h2 class="text-xl font-black text-white">หน้าแรกลูกค้า / ໜ້າທຳອິດລູກຄ້າ</h2>
        </div>

        <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
            <h3 class="text-sm font-bold text-white mb-1">แบนเนอร์หน้าแรก</h3>
            <p class="text-slate-500 text-xs mb-4 leading-relaxed">
                รูปสัดส่วน <strong class="text-slate-300">6:9</strong> (แนวตั้ง) เช่น 1200×1800 px ·
                กดแล้วพาไปหน้าสินค้าออนไลน์ · ถ้าไม่ใส่รูป หน้าแรกจะไม่แสดงส่วนนี้เลย
            </p>

            <div class="flex flex-wrap items-start gap-5">
                <div class="shrink-0">
                    <% if (company.home_banner_path) { %>
                    <img src="<%= company.home_banner_path %>" alt="แบนเนอร์ปัจจุบัน"
                         class="w-28 rounded-xl border border-white/10" style="aspect-ratio: 6/9; object-fit: cover;">
                    <% } else { %>
                    <div class="w-28 rounded-xl border border-dashed border-white/15 grid place-items-center text-slate-600"
                         style="aspect-ratio: 6/9;">
                        <span class="text-[10px]">ยังไม่มีรูป</span>
                    </div>
                    <% } %>
                </div>

                <div class="flex-1 min-w-[14rem] space-y-3">
                    <form action="/settings/home-banner" method="post" enctype="multipart/form-data"
                          class="flex flex-wrap items-end gap-2">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <label class="flex flex-col gap-1 flex-1 min-w-[10rem]">
                            <span class="text-[10px] font-bold text-slate-500 uppercase">เลือกรูป (สูงสุด 5MB)</span>
                            <input type="file" name="banner_file" accept="image/*" required
                                   class="text-slate-400 text-xs">
                        </label>
                        <button type="submit"
                                class="bg-amber-500 hover:bg-amber-400 text-slate-900 rounded-xl px-4 py-2 text-xs font-bold">
                            <i class="fa-solid fa-upload"></i> อัปโหลด
                        </button>
                    </form>

                    <% if (company.home_banner_path) { %>
                    <form action="/settings/home-banner/remove" method="post"
                          onsubmit="return confirm('เอาแบนเนอร์ออกจากหน้าแรก?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit"
                                class="bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-red-400 rounded-xl px-3 py-1.5 text-xs font-bold">
                            <i class="fa-solid fa-trash"></i> เอาแบนเนอร์ออก
                        </button>
                    </form>
                    <% } %>

                    <div class="flex flex-wrap gap-2 pt-2 border-t border-white/5">
                        <a href="/settings/prohibited"
                           class="bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 rounded-xl px-3 py-1.5 text-xs font-bold">
                            <i class="fa-solid fa-ban mr-1"></i> ของที่รับ / ไม่รับ
                        </a>
                        <a href="/settings/testimonials"
                           class="bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 rounded-xl px-3 py-1.5 text-xs font-bold">
                            <i class="fa-solid fa-camera mr-1"></i> หลักฐานจากลูกค้า
                        </a>
                        <a href="/admin/products"
