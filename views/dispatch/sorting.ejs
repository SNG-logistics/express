<div class="max-w-7xl mx-auto space-y-6" x-data="sortingApp()">

  <%# Header %>
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-white flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-indigo-500/15 border border-indigo-500/25">
          <i class="fa-solid fa-layer-group text-indigo-400"></i>
        </div>
        ศูนย์คัดแยก (Sorting Board)
      </h2>
      <p class="text-slate-400 text-sm mt-1">ออเดอร์ที่อยู่ระหว่างรอการส่งต่อทั้งหมดในคลัง (แยกตามแขวง)</p>
    </div>
    
    <%# Action Toolbar (sticky in the future) %>
    <div class="flex items-center gap-3" x-show="selectedOrders.length > 0" x-cloak x-transition>
      <div class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white font-mono text-sm self-stretch flex items-center">
        เลือก <span x-text="selectedOrders.length" class="mx-1 font-bold text-indigo-400"></span> รายการ
      </div>
      <button @click="openModal('branch')" class="btn hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-semibold px-4 py-2 rounded-xl flex items-center gap-2 transition-all">
        <i class="fa-solid fa-store"></i> ส่งสาขา
      </button>
      <button @click="openModal('carrier')" class="btn hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 font-semibold px-4 py-2 rounded-xl flex items-center gap-2 transition-all">
        <i class="fa-solid fa-truck-fast"></i> ขนส่งพาร์ทเนอร์
      </button>
    </div>
  </div>

  <% if (Object.keys(provinceGroups).length === 0) { %>
    <div class="glass-panel-dark rounded-3xl p-12 text-center border border-white/5">
      <div class="w-20 h-20 mx-auto rounded-2xl bg-white/5 flex items-center justify-center mb-6">
        <i class="fa-solid fa-box-open text-3xl text-slate-500"></i>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">ไม่มีออเดอร์ตกค้าง</h3>
      <p class="text-slate-400">ไม่พบออเดอร์ในสถานะรับลงคลังปลายทางปัจจุบัน</p>
    </div>
  <% } else { %>
    <% Object.entries(provinceGroups).forEach(([province, list]) => { %>
      <div class="glass-panel-dark rounded-2xl border border-white/8 overflow-hidden mb-6">
        <%# Group Header %>
        <div class="flex items-center justify-between px-6 py-4 border-b border-white/6 bg-white/[0.02]">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-indigo-500/15 border border-indigo-500/25 text-indigo-400 flex flex-col items-center justify-center font-bold text-xs">
              <%= list.length %>
            </span>
            <h3 class="text-lg font-bold text-white"><%= province %></h3>
          </div>
          <button @click="toggleGroup('<%= province %>')" class="text-xs text-slate-400 hover:text-white px-3 py-1.5 rounded-lg border border-white/10 hover:bg-white/5 transition-all">
            เลือกทั้งหมด
          </button>
        </div>

        <%# Table %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="text-slate-400 text-xs uppercase bg-white/[0.01] border-b border-white/5">
              <tr>
                <th class="px-6 py-3 w-12 text-center">เลือก</th>
                <th class="px-6 py-3">Job No</th>
                <th class="px-6 py-3">ผู้รับ</th>
                <th class="px-6 py-3">เบอร์ติดต่อ</th>
                <th class="px-6 py-3">เมือง / สาขา</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300">
              <% list.forEach(o => { %>
                <tr class="hover:bg-white/[0.02] transition-colors cursor-pointer" @click="toggleOrder('<%= o.id %>')" :class="selectedOrders.includes('<%= o.id %>') ? 'bg-indigo-500/5' : ''">
                  <td class="px-6 py-4 text-center">
                    <div class="w-5 h-5 rounded border border-white/20 flex items-center justify-center transition-all"
                         :class="selectedOrders.includes('<%= o.id %>') ? 'bg-indigo-500 border-indigo-400 text-white' : 'bg-white/5'">
                      <i class="fa-solid fa-check text-xs" x-show="selectedOrders.includes('<%= o.id %>')"></i>
                    </div>
                  </td>
                  <td class="px-6 py-4 font-mono font-bold text-white"><%= o.job_no %></td>
                  <td class="px-6 py-4"><%= o.receiver_name %></td>
                  <td class="px-6 py-4"><%= o.receiver_phone %></td>
                  <td class="px-6 py-4"><%= o.receiver_city || '–' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
  <% } %>

  <%# Modal - Branch Assign %>
  <div x-show="modalType === 'branch'" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm" @click="modalType = null" x-transition.opacity></div>
    <div class="glass-panel-dark relative w-full max-w-md rounded-3xl border border-white/10 shadow-2xl overflow-hidden"
         x-show="modalType === 'branch'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100">
      
      <div class="px-6 py-5 border-b border-white/5 text-emerald-400 flex items-center gap-3">
        <i class="fa-solid fa-store text-xl"></i>
        <h3 class="text-lg font-bold text-white">ส่งต่อสาขาย่อย (Branch)</h3>
      </div>
      
      <form action="/dispatch/assign" method="POST" class="p-6 space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="dispatchType" value="BRANCH_PICKUP">
        
        <%# Injected selected order IDs %>
        <template x-for="id in selectedOrders" :key="id">
          <input type="hidden" name="orderIds" :value="id">
        </template>
        
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">ระบุสาขาปลายทาง *</label>
          <select name="branchId" required class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white pr-10 focus:outline-none focus:border-emerald-500 transition-colors">
            <option value="">-- เลือกสาขา --</option>
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>">[<%= b.branch_code %>] <%= b.name %></option>
            <% }) %>
          </select>
        </div>
        
        <div class="flex gap-3 pt-2">
          <button type="button" @click="modalType = null" class="flex-1 py-3 rounded-xl border border-white/10 text-slate-300 font-semibold hover:bg-white/5 transition-all">ยกเลิก</button>
          <button type="submit" class="flex-1 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold transition-all shadow-lg shadow-emerald-500/20">ยืนยัน Dispatch</button>
        </div>
      </form>
    </div>
  </div>

  <%# Modal - Carrier Assign %>
  <div x-show="modalType === 'carrier'" x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/80 backdrop-blur-sm" @click="modalType = null" x-transition.opacity></div>
    <div class="glass-panel-dark relative w-full max-w-md rounded-3xl border border-white/10 shadow-2xl overflow-hidden"
         x-show="modalType === 'carrier'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100">
      
      <div class="px-6 py-5 border-b border-white/5 text-blue-400 flex items-center gap-3">
        <i class="fa-solid fa-truck-fast text-xl"></i>
        <h3 class="text-lg font-bold text-white">ส่งบริษัทขนส่ง (Partner Carrier)</h3>
      </div>
      
      <form action="/dispatch/assign" method="POST" class="p-6 space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="dispatchType" value="PARTNER_CARRIER">
        
        <template x-for="id in selectedOrders" :key="id">
          <input type="hidden" name="orderIds" :value="id">
        </template>
        
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">เลือกขนส่ง *</label>
          <select name="carrierId" required class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white pr-10 focus:outline-none focus:border-blue-500 transition-colors">
            <option value="">-- เลือกบริษัทขนส่ง --</option>
            <% carriers.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">Tracking No. (ถ้ามี)</label>
          <input type="text" name="trackingNo" class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white font-mono placeholder-slate-500 focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ex. LP123456">
          <p class="text-xs text-slate-500 mt-2"><i class="fa-solid fa-info-circle"></i> ถ้าส่งหลายชิ้นพร้อมกัน และใช้เลข Tracking เดียวสามารถกรอกได้เลย</p>
        </div>
        
        <div class="flex gap-3 pt-2">
          <button type="button" @click="modalType = null" class="flex-1 py-3 rounded-xl border border-white/10 text-slate-300 font-semibold hover:bg-white/5 transition-all">ยกเลิก</button>
          <button type="submit" class="flex-1 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold transition-all shadow-lg shadow-blue-500/20">ยืนยัน Dispatch</button>
        </div>
      </form>
    </div>
  </div>

</div>

<script>
// Data from server
const PROVINCE_GROUPS = <%- JSON.stringify(provinceGroups) %>;

window.sortingApp = function() {
  return {
    selectedOrders: [],
    modalType: null, // 'branch' or 'carrier'
    
    toggleOrder(id) {
      const idx = this.selectedOrders.indexOf(id);
      if (idx > -1) {
        this.selectedOrders.splice(idx, 1);
      } else {
        this.selectedOrders.push(id);
      }
    },
    
    toggleGroup(province) {
      if (!PROVINCE_GROUPS[province]) return;
      const idsInGroup = PROVINCE_GROUPS[province].map(o => String(o.id));
      // check if all are selected
      const allSelected = idsInGroup.every(id => this.selectedOrders.includes(id));
      if (allSelected) {
        // remove them
        this.selectedOrders = this.selectedOrders.filter(id => !idsInGroup.includes(id));
      } else {
        // add missing
        idsInGroup.forEach(id => {
          if (!this.selectedOrders.includes(id)) this.selectedOrders.push(id);
        });
      }
    },

    openModal(type) {
      if (this.selectedOrders.length === 0) return;
      this.modalType = type;
    }
  }
}
</script>
