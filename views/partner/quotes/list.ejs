<%# Partner — Quote List %>
<div class="max-w-6xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-black text-white flex items-center gap-3">
        <span class="bg-amber-500 w-1.5 h-7 rounded-full"></span>
        ใบเสนอราคา Partner
      </h1>
      <p class="text-slate-500 text-sm mt-1 ml-5">สร้างและจัดการใบเสนอราคาสินค้าออนไลน์</p>
    </div>
    <a href="/partner/quotes/new"
      class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 text-black font-bold rounded-xl text-sm shadow-lg shadow-amber-900/20 hover:shadow-amber-500/30 transition-all">
      <i class="fa-solid fa-plus"></i> สร้างใบเสนอราคา
    </a>
  </div>

  <%# Filter Bar %>
  <form method="get" class="flex flex-wrap gap-3 mb-6">
    <input type="text" name="q" value="<%= q %>" placeholder="ค้นหาสินค้า, เลขที่, ชื่อลูกค้า..."
      class="flex-1 min-w-48 bg-slate-900/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white text-sm focus:ring-amber-500 focus:border-amber-500 placeholder-slate-600">
    <select name="status" class="bg-slate-900/50 border border-slate-700 rounded-xl px-4 py-2.5 text-white text-sm focus:ring-amber-500 focus:border-amber-500">
      <option value="">สถานะทั้งหมด</option>
      <option value="draft"    <%= status==='draft'    ? 'selected' : '' %>>Draft</option>
      <option value="sent"     <%= status==='sent'     ? 'selected' : '' %>>Sent</option>
      <option value="accepted" <%= status==='accepted' ? 'selected' : '' %>>Accepted</option>
      <option value="ordered"  <%= status==='ordered'  ? 'selected' : '' %>>Ordered</option>
      <option value="cancelled"<%= status==='cancelled'? 'selected' : '' %>>Cancelled</option>
    </select>
    <button type="submit" class="px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-slate-300 text-sm hover:text-white transition-colors">
      <i class="fa-solid fa-search"></i>
    </button>
  </form>

  <%# Table %>
  <div class="glass-panel-dark rounded-2xl overflow-hidden border border-white/5">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="text-xs text-slate-500 uppercase bg-black/20 border-b border-white/5">
          <tr>
            <th class="px-5 py-3">เลขที่</th>
            <th class="px-5 py-3">สินค้า</th>
            <th class="px-5 py-3">สาขา</th>
            <th class="px-5 py-3 text-right">ยอดรวม (LAK)</th>
            <th class="px-5 py-3 text-center">สถานะ</th>
            <th class="px-5 py-3">วันที่</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-300">
          <% if (quotes.length === 0) { %>
          <tr><td colspan="7" class="py-12 text-center text-slate-600">
            <i class="fa-solid fa-file-invoice text-3xl mb-2 opacity-20"></i><p>ยังไม่มีใบเสนอราคา</p>
          </td></tr>
          <% } %>
          <% quotes.forEach(q => { %>
          <%
            const statusMap = {
              draft:     { cls:'bg-slate-500/10 text-slate-400 border-slate-500/20',     label:'Draft' },
              sent:      { cls:'bg-blue-500/10 text-blue-400 border-blue-500/20',         label:'ส่งแล้ว' },
              accepted:  { cls:'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',label:'ยืนยัน' },
              ordered:   { cls:'bg-amber-500/10 text-amber-400 border-amber-500/20',      label:'สั่งแล้ว' },
              cancelled: { cls:'bg-red-500/10 text-red-400 border-red-500/20',            label:'ยกเลิก' },
            };
            const s = statusMap[q.status] || statusMap.draft;
          %>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="px-5 py-3 font-mono text-xs text-slate-400"><%= q.quote_no %></td>
            <td class="px-5 py-3">
              <div class="font-semibold text-white max-w-[200px] truncate"><%= q.product_name %></div>
              <% if (q.customer_name) { %><div class="text-[11px] text-slate-500"><%= q.customer_name %></div><% } %>
            </td>
            <td class="px-5 py-3 text-slate-400 text-xs"><%= q.branch_name || '—' %></td>
            <td class="px-5 py-3 text-right font-mono font-bold text-amber-400">
              <%= Number(q.total_lak).toLocaleString('th') %> ₭
            </td>
            <td class="px-5 py-3 text-center">
              <span class="inline-flex px-2 py-0.5 rounded-lg border text-[11px] font-bold <%= s.cls %>"><%= s.label %></span>
            </td>
            <td class="px-5 py-3 text-slate-500 text-xs font-mono">
              <%= new Date(q.created_at).toLocaleDateString('th-TH', {day:'numeric',month:'short',year:'2-digit'}) %>
            </td>
            <td class="px-5 py-3">
              <a href="/partner/quotes/<%= q.id %>" class="text-slate-500 hover:text-amber-400 transition-colors text-lg">
                <i class="fa-solid fa-chevron-right"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
