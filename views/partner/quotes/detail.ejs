<%# Partner — Quote Detail + Breakdown %>
<%
  const statusMap = {
    draft:     { cls:'text-slate-400 bg-slate-500/10 border-slate-500/20',      label:'Draft',   icon:'fa-pencil' },
    sent:      { cls:'text-blue-400 bg-blue-500/10 border-blue-500/20',          label:'Sent',    icon:'fa-paper-plane' },
    accepted:  { cls:'text-emerald-400 bg-emerald-500/10 border-emerald-500/20', label:'Accepted',icon:'fa-circle-check' },
    ordered:   { cls:'text-amber-400 bg-amber-500/10 border-amber-500/20',       label:'Ordered', icon:'fa-shopping-cart' },
    cancelled: { cls:'text-red-400 bg-red-500/10 border-red-500/20',             label:'Cancelled',icon:'fa-ban' },
  };
  const s = statusMap[quote.status] || statusMap.draft;

  const productThb  = Number(quote.product_price_thb) || 0;
  const shippingThb = Number(quote.shipping_th_thb) || 0;
  const subtotalThb = productThb + shippingThb;
  const rate        = Number(quote.exchange_rate) || 200;
  const spread      = Number(quote.fx_spread_pct) || 0;
  const effectiveRate = rate * (1 + spread / 100);
  const productLak  = Math.ceil(subtotalThb * effectiveRate);
  const sngLak      = Number(quote.sng_shipping_lak) || 0;
  const serviceLak  = Number(quote.service_fee_lak) || 0;
  const totalLak    = Number(quote.total_lak) || 0;
%>

<div class="max-w-4xl mx-auto">
  <%# Header %>
  <div class="flex flex-wrap items-center gap-3 mb-6">
    <a href="/partner/quotes" class="text-slate-500 hover:text-white">
      <i class="fa-solid fa-arrow-left"></i>
    </a>
    <div class="flex-1">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-xl font-black text-white font-mono"><%= quote.quote_no %></h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border text-xs font-bold <%= s.cls %>">
          <i class="fa-solid <%= s.icon %>"></i> <%= s.label %>
        </span>
      </div>
      <p class="text-slate-500 text-sm mt-0.5">
        สร้างโดย <span class="text-slate-400"><%= quote.creator || '—' %></span>
        · <%= new Date(quote.created_at).toLocaleDateString('th-TH', {weekday:'short',day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
      </p>
    </div>
    <%# Status update form %>
    <form action="/partner/quotes/<%= quote.id %>/status" method="post" class="flex items-center gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <select name="status" class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white text-sm">
        <option value="draft"    <%= quote.status==='draft'    ?'selected':'' %>>Draft</option>
        <option value="sent"     <%= quote.status==='sent'     ?'selected':'' %>>Sent</option>
        <option value="accepted" <%= quote.status==='accepted' ?'selected':'' %>>Accepted</option>
        <option value="ordered"  <%= quote.status==='ordered'  ?'selected':'' %>>Ordered</option>
        <option value="cancelled"<%= quote.status==='cancelled'?'selected':'' %>>Cancelled</option>
      </select>
      <button type="submit" class="px-3 py-2 bg-slate-800 border border-slate-700 rounded-xl text-slate-300 text-sm hover:text-white">
        บันทึก
      </button>
    </form>
  </div>

  <div class="grid md:grid-cols-3 gap-5">
    <%# Left: Info %>
    <div class="md:col-span-2 space-y-5">

      <%# สินค้า %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
        <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-4">สินค้า</div>
        <div class="text-lg font-bold text-white mb-2"><%= quote.product_name %></div>
        <% if (quote.product_url) { %>
        <a href="<%= quote.product_url %>" target="_blank"
          class="inline-flex items-center gap-1.5 text-sm text-blue-400 hover:text-blue-300 transition-colors break-all">
          <i class="fa-solid fa-link text-xs"></i>
          <span class="underline"><%= quote.product_url.length > 60 ? quote.product_url.substring(0,60)+'…' : quote.product_url %></span>
        </a>
        <% } %>
        <div class="mt-4 grid grid-cols-3 gap-4 text-sm">
          <div>
            <div class="text-slate-500 text-xs mb-0.5">ราคาสินค้า</div>
            <div class="font-bold text-white font-mono">฿<%= productThb.toLocaleString('th', {minimumFractionDigits:2}) %></div>
          </div>
          <div>
            <div class="text-slate-500 text-xs mb-0.5">ค่าส่งในไทย</div>
            <div class="font-bold text-white font-mono">฿<%= shippingThb.toLocaleString('th', {minimumFractionDigits:2}) %></div>
          </div>
          <div>
            <div class="text-slate-500 text-xs mb-0.5">น้ำหนัก</div>
            <div class="font-bold text-white font-mono"><%= Number(quote.weight_kg).toFixed(2) %> kg</div>
          </div>
        </div>
      </div>

      <%# Cost Breakdown %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
        <div class="text-xs font-bold text-cyan-400 uppercase tracking-wider mb-4">Breakdown ราคา</div>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-400">ราคาสินค้า + ค่าส่งในไทย</span>
            <span class="font-mono text-white">฿<%= subtotalThb.toLocaleString('th', {minimumFractionDigits:2}) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">อัตราแลกเปลี่ยน (base)</span>
            <span class="font-mono text-cyan-400"><%= rate.toLocaleString('th') %> LAK/THB</span>
          </div>
          <% if (spread > 0) { %>
          <div class="flex justify-between">
            <span class="text-slate-400">Spread (<%= spread %>%)</span>
            <span class="font-mono text-cyan-400">+<%= spread %>% → <%= effectiveRate.toFixed(2) %> LAK/THB</span>
          </div>
          <% } %>
          <div class="flex justify-between bg-slate-900/50 rounded-lg px-3 py-2">
            <span class="text-white font-semibold">ยอดสินค้า (LAK)</span>
            <span class="font-mono font-bold text-white"><%= productLak.toLocaleString('th') %> ₭</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">ค่าขนส่ง SNG</span>
            <span class="font-mono text-emerald-400">+ <%= sngLak.toLocaleString('th') %> ₭</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">ค่าบริการ Partner</span>
            <span class="font-mono text-amber-400">+ <%= serviceLak.toLocaleString('th') %> ₭</span>
          </div>
          <div class="border-t border-white/10 pt-3 flex justify-between">
            <span class="font-black text-white">ยอดรวมที่ลูกค้าจ่าย</span>
            <span class="font-black font-mono text-amber-400 text-xl"><%= totalLak.toLocaleString('th') %> ₭</span>
          </div>
        </div>
      </div>

      <% if (quote.note) { %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">หมายเหตุ</div>
        <p class="text-slate-300 text-sm"><%= quote.note %></p>
      </div>
      <% } %>
    </div>

    <%# Right: Customer + Action %>
    <div class="space-y-5">
      <%# ยอดรวมใหญ่ %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-amber-500/20 bg-amber-500/5 text-center">
        <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-2">ยอดที่ลูกค้าจ่าย</div>
        <div class="text-4xl font-black text-white font-mono leading-none">
          <%= Math.ceil(totalLak).toLocaleString('th') %>
        </div>
        <div class="text-amber-400 font-bold mt-1">₭ (ກີບ)</div>
      </div>

      <%# ลูกค้า %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
        <div class="text-xs font-bold text-purple-400 uppercase tracking-wider mb-3">ลูกค้า</div>
        <div class="space-y-2 text-sm">
          <% if (quote.customer_name) { %>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-user text-slate-600 w-4"></i>
            <span class="text-white"><%= quote.customer_name %></span>
          </div>
          <% } %>
          <% if (quote.customer_phone) { %>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-phone text-slate-600 w-4"></i>
            <span class="text-white font-mono"><%= quote.customer_phone %></span>
          </div>
          <% } %>
          <% if (quote.customer_address) { %>
          <div class="flex items-start gap-2">
            <i class="fa-solid fa-location-dot text-slate-600 w-4 mt-0.5"></i>
            <span class="text-slate-400 text-xs"><%= quote.customer_address %></span>
          </div>
          <% } %>
          <% if (!quote.customer_name && !quote.customer_phone && !quote.customer_address) { %>
          <p class="text-slate-600 text-xs">ยังไม่ระบุข้อมูลลูกค้า</p>
          <% } %>
        </div>
      </div>

      <% if (quote.branch_name) { %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">สาขา</div>
        <div class="text-white font-semibold"><%= quote.branch_name %></div>
      </div>
      <% } %>

      <%# Share block %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/5">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">แชร์ให้ลูกค้า</div>
        <div class="space-y-2">
          <button onclick="copyQuote()" class="w-full flex items-center justify-center gap-2 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-slate-300 text-sm hover:text-white transition-colors">
            <i class="fa-solid fa-copy"></i> คัดลอกข้อความ
          </button>
          <a href="/partner/quotes/<%= quote.id %>/print" target="_blank" class="w-full flex items-center justify-center gap-2 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-sm transition-colors shadow-lg shadow-amber-600/20">
            <i class="fa-solid fa-print"></i> พิมพ์ใบเสนอราคา (Print / PDF)
          </a>
        </div>
      </div>

      <%# Part 1 -> Part 2 Trigger %>
      <% if (quote.status === 'ordered' || quote.status === 'accepted') { %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-emerald-500/30 bg-emerald-500/5">
        <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-3">รับของเข้าโกดัง (สร้างบิลขนส่ง)</div>
        <p class="text-xs text-slate-400 mb-4">ดึงข้อมูลลูกค้าและสินค้าไปสร้างออเดอร์ขนส่งไทย-ลาว (ต้องระบุน้ำหนักจริง)</p>
        <a href="/orders/new?quote_id=<%= quote.id %>" class="w-full flex items-center justify-center gap-2 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold transition-colors">
          <i class="fa-solid fa-box-open"></i> สร้างออเดอร์ขนส่ง
        </a>
      </div>
      <% } %>

    </div>
  </div>
</div>

<script>
function copyQuote() {
  const text = `ใบเสนอราคา <%= quote.quote_no %>
สินค้า: <%= quote.product_name %>
-------------------------------
ยอดรวม: <%= Math.ceil(totalLak).toLocaleString('th') %> ₭ (ກີບ)
  - ยอดสินค้า: <%= productLak.toLocaleString('th') %> ₭
  - ค่าขนส่ง:  <%= sngLak.toLocaleString('th') %> ₭
  - ค่าบริการ: <%= serviceLak.toLocaleString('th') %> ₭
-------------------------------
SNG Express — ขนส่งไทย-ลาว`;
  navigator.clipboard.writeText(text).then(() => alert('คัดลอกสำเร็จ!'));
}
</script>
