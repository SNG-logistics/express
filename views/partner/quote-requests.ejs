<%# Partner — Public Quote Request Queue (จากพอร์ทัลสมาชิก) %>
<div class="max-w-6xl mx-auto">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-black text-white flex items-center gap-3">
        <span class="bg-amber-500 w-1.5 h-7 rounded-full"></span>
        คำขอเช็คราคาสินค้า
      </h1>
      <p class="text-slate-500 text-sm mt-1 ml-5">ลูกค้าสมาชิกส่งคำขอจากเว็บ — กดแปลงเป็นใบเสนอราคา</p>
    </div>
    <div class="flex items-center gap-2">
      <button id="quoteAlertSoundToggle" type="button"
        class="flex items-center gap-2 px-4 py-2.5 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-300 text-sm hover:bg-amber-500/20 transition-colors">
        <i class="fa-solid fa-volume-xmark"></i>
        <span>เปิดเสียงแจ้งเตือน</span>
      </button>
      <a href="/partner/quote-requests"
        class="flex items-center gap-2 px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-slate-300 text-sm hover:text-white transition-colors">
        <i class="fa-solid fa-rotate"></i> รีเฟรช
      </a>
    </div>
  </div>

  <section id="quoteRequestAlerts" class="space-y-3 mb-5" aria-live="polite" aria-relevant="additions"></section>

  <div class="glass-panel-dark rounded-2xl overflow-hidden border border-white/5">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="text-xs text-slate-500 uppercase bg-black/20 border-b border-white/5">
          <tr>
            <th class="px-5 py-3">สินค้า</th>
            <th class="px-5 py-3">ลูกค้า</th>
            <th class="px-5 py-3 text-center">จำนวน</th>
            <th class="px-5 py-3">สถานะ</th>
            <th class="px-5 py-3">วันที่</th>
            <th class="px-5 py-3 text-right">จัดการ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-300">
          <% if (requests.length === 0) { %>
          <tr><td colspan="6" class="py-12 text-center text-slate-600">
            <i class="fa-solid fa-inbox text-3xl mb-2 opacity-20"></i><p>ยังไม่มีคำขอเช็คราคา</p>
          </td></tr>
          <% } %>
          <% requests.forEach(request => {
            const statusMap = {
              new:         { cls:'bg-amber-500/10 text-amber-400 border-amber-500/20',  label:'ใหม่' },
              in_progress: { cls:'bg-blue-500/10 text-blue-400 border-blue-500/20',     label:'กำลังทำ' },
              quoted:      { cls:'bg-emerald-500/10 text-emerald-400 border-emerald-500/20', label:'มีใบเสนอราคา' },
              closed:      { cls:'bg-slate-500/10 text-slate-400 border-slate-500/20',  label:'ปิด' },
            };
            const st = statusMap[request.status] || statusMap.new;
            const memberName = request.first_name
              ? `${request.first_name} ${request.last_name || ''}`.trim()
              : '—';
            const memberPhone = request.phone_display || request.phone || '—';
          %>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="px-5 py-3">
              <div class="font-semibold text-white max-w-[260px] truncate"><%= request.product_name %></div>
              <% if (request.product_url) { %>
              <a href="<%= request.product_url %>" target="_blank" rel="noopener" class="text-[11px] text-amber-400 hover:text-amber-300">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> ลิงก์สินค้า
              </a>
              <% } %>
              <% if (request.note) { %>
              <div class="text-[11px] text-slate-500 max-w-[260px] truncate mt-0.5"><%= request.note %></div>
              <% } %>
            </td>
            <td class="px-5 py-3">
              <div class="text-slate-300"><%= memberName %></div>
              <div class="text-[11px] text-slate-500"><i class="fa-brands fa-whatsapp" style="color:#25D366; margin-right:3px;"></i><%= memberPhone %></div>
            </td>
            <td class="px-5 py-3 text-center"><%= request.desired_qty %></td>
            <td class="px-5 py-3">
              <span class="inline-flex px-2 py-0.5 rounded-lg border text-[11px] font-bold <%= st.cls %>"><%= st.label %></span>
            </td>
            <td class="px-5 py-3 text-slate-500 text-xs font-mono">
              <%= new Date(request.created_at).toLocaleDateString('th-TH', {day:'numeric',month:'short',year:'2-digit'}) %>
            </td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <% if (request.status === 'quoted' && request.linked_quotation_id) { %>
              <a href="/partner/quotes/<%= request.linked_quotation_id %>" class="text-emerald-400 hover:text-emerald-300 text-xs font-semibold mr-3">
                <i class="fa-solid fa-file-invoice"></i> ดูใบเสนอราคา
              </a>
              <% } else { %>
              <a href="/partner/quote-requests/<%= request.id %>/convert"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gradient-to-r from-amber-500 to-orange-500 text-black font-bold rounded-lg text-xs hover:shadow-amber-500/30 transition-all">
                <i class="fa-solid fa-calculator"></i> สร้างใบเสนอราคา
              </a>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (() => {
    const alerts = document.getElementById('quoteRequestAlerts');
    const soundToggle = document.getElementById('quoteAlertSoundToggle');
    const knownRequestIds = new Set(<%- JSON.stringify(requests.map(request => String(request.id))) %>);
    let soundEnabled = false;
    let audioContext;
    let polling = false;

    function playAlertSound() {
      if (!soundEnabled) return;
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;
      audioContext ||= new AudioContextClass();
      const now = audioContext.currentTime;

      [0, 0.22].forEach((delay, index) => {
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = index ? 880 : 660;
        gain.gain.setValueAtTime(0.0001, now + delay);
        gain.gain.exponentialRampToValueAtTime(0.16, now + delay + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + delay + 0.18);
        oscillator.connect(gain).connect(audioContext.destination);
        oscillator.start(now + delay);
        oscillator.stop(now + delay + 0.19);
      });
    }

    function customerLabel(request) {
      const name = [request.first_name, request.last_name].filter(Boolean).join(' ').trim();
      return name || request.phone_display || request.phone || 'ลูกค้าใหม่';
    }

    function showRequestAlert(request) {
      const productName = request.product_name || 'สินค้าไม่ได้ระบุชื่อ';
      const quantity = Math.max(1, Number(request.desired_qty) || 1);
      const card = document.createElement('article');
      card.className = 'rounded-2xl border border-amber-400/40 bg-amber-500/10 p-4 shadow-lg shadow-amber-500/5';
      card.innerHTML = `
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <p class="text-xs font-bold tracking-wider text-amber-300">คำขอเช็คราคาใหม่</p>
            <p class="mt-1 font-bold text-white" data-alert-product></p>
            <p class="mt-1 text-sm text-slate-300" data-alert-customer></p>
            <p class="mt-1 text-xs text-slate-400" data-alert-note></p>
          </div>
          <a class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-amber-400 px-4 py-2.5 text-sm font-bold text-slate-950 hover:bg-amber-300" data-alert-action>
            <i class="fa-solid fa-file-invoice-dollar"></i> จัดทำใบเสนอราคา
          </a>
        </div>`;

      card.querySelector('[data-alert-product]').textContent = `ลูกค้าต้องการ: ${productName} × ${quantity}`;
      card.querySelector('[data-alert-customer]').textContent = `ลูกค้า: ${customerLabel(request)}`;
      const note = card.querySelector('[data-alert-note]');
      if (request.note) {
        note.textContent = `หมายเหตุ: ${request.note}`;
      } else {
        note.remove();
      }
      card.querySelector('[data-alert-action]').href = `/partner/quote-requests/${encodeURIComponent(request.id)}/convert`;
      alerts.prepend(card);
    }

    async function pollPendingRequests() {
      if (polling || document.hidden) return;
      polling = true;
      try {
        const response = await fetch('/partner/api/quote-requests/pending', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        });
        if (!response.ok) throw new Error(`Request alert polling failed: ${response.status}`);

        const payload = await response.json();
        const newRequests = (Array.isArray(payload.requests) ? payload.requests : [])
          .filter((request) => !knownRequestIds.has(String(request.id)))
          .sort((first, second) => new Date(first.created_at) - new Date(second.created_at));

        newRequests.forEach((request) => {
          knownRequestIds.add(String(request.id));
          showRequestAlert(request);
        });
        if (newRequests.length) playAlertSound();
      } catch (error) {
        console.warn('[Quote request alerts]', error);
      } finally {
        polling = false;
      }
    }

    soundToggle.addEventListener('click', () => {
      soundEnabled = true;
      soundToggle.innerHTML = '<i class="fa-solid fa-volume-high"></i><span>เปิดเสียงแล้ว</span>';
      playAlertSound();
    });

    setInterval(pollPendingRequests, 15000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) pollPendingRequests();
    });
  })();
</script>
