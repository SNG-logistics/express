<div class="max-w-7xl mx-auto animate-fade-in">
  <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
    <div>
      <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
        <span class="bg-blue-500 w-1.5 h-8 rounded-full inline-block"></span>
        Customs Queue
      </h1>
      <p class="text-slate-400 mt-2 ml-6 text-sm">ออเดอร์รอพิธีศุลกากร &amp; ดำเนินการ</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="glass-panel-dark px-4 py-2 rounded-xl text-center">
        <div class="text-[10px] text-slate-500 uppercase">รอ (HOLD)</div>
        <div class="text-blue-400 font-bold text-lg"><%= pending.length %></div>
      </div>
      <div class="glass-panel-dark px-4 py-2 rounded-xl text-center">
        <div class="text-[10px] text-slate-500 uppercase">ผ่านเดือนนี้</div>
        <div class="text-emerald-400 font-bold text-lg"><%= clearedThisMonth || 0 %></div>
      </div>
      <div class="glass-panel-dark px-4 py-2 rounded-xl text-center">
        <div class="text-[10px] text-slate-500 uppercase">ถูกกักเดือนนี้</div>
        <div class="text-red-400 font-bold text-lg"><%= rejectedThisMonth || 0 %></div>
      </div>
    </div>
  </div>

  <% if (error) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-500/10 text-red-200 border border-red-500/20 flex items-center gap-3">
      <i class="fa-solid fa-circle-exclamation text-xl"></i>
      <%= error %>
    </div>
  <% } %>

  <div class="glass-panel-dark rounded-2xl overflow-hidden">
    <div class="p-5 border-b border-white/8 flex items-center justify-between">
      <div class="text-sm font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-stamp text-blue-400"></i>
        รายการออเดอร์ที่ต้องผ่านพิธีศุลกากร
      </div>
      <span class="px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-slate-400 text-xs">
        <%= pending.length %> รายการ
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm table-premium text-left">
        <thead class="text-xs text-slate-400 uppercase bg-black/20 border-b border-white/5">
          <tr>
            <th class="px-5 py-3 font-semibold tracking-wider">Job No</th>
            <th class="px-5 py-3 font-semibold tracking-wider">ผู้ส่ง → ผู้รับ</th>
            <th class="px-5 py-3 font-semibold tracking-wider">สถานะ</th>
            <th class="px-5 py-3 font-semibold tracking-wider text-center">เวลารอ</th>
            <th class="px-5 py-3 font-semibold tracking-wider text-right">ดำเนินการ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-300">
          <% if (!pending || pending.length === 0) { %>
          <tr>
            <td colspan="5" class="py-14 text-center text-slate-600">
              <i class="fa-solid fa-clipboard-check text-4xl mb-3 opacity-15"></i>
              <div class="text-sm">ไม่มีออเดอร์รอพิธีศุลกากร</div>
            </td>
          </tr>
          <% } %>
          <% (pending || []).forEach(o => {
               const hrs = o.hours_held || 0;
               const hrsColor = hrs > 72 ? 'text-red-400 animate-pulse' : hrs > 24 ? 'text-amber-400' : 'text-slate-400';
               const statusColors = {
                 CROSSING_BORDER:   'text-purple-400 bg-purple-400/10 border-purple-400/20',
                 ARRIVED_BORDER_WH: 'text-cyan-400 bg-cyan-400/10 border-cyan-400/20',
                 CUSTOMS_HOLD:      'text-orange-400 bg-orange-400/10 border-orange-400/20',
               };
               const sc = statusColors[o.status] || 'text-slate-400 bg-slate-500/10 border-slate-500/20';
             %>
          <tr class="hover:bg-white/3 transition-colors">
            <td class="px-5 py-3">
              <a href="/customs/<%= o.id %>" class="font-mono font-bold text-sm text-white hover:text-blue-300 transition-colors">
                <%= o.job_no %>
              </a>
              <div class="text-[10px] text-slate-500 mt-0.5">
                <%= o.direction === 'TH_TO_LA' ? '🇹🇭→🇱🇦' : '🇱🇦→🇹🇭' %>
              </div>
            </td>
            <td class="px-5 py-3">
              <div class="text-sm text-slate-300"><%= o.sender_name %></div>
              <div class="text-xs text-slate-500">→ <%= o.receiver_name %></div>
            </td>
            <td class="px-5 py-3">
              <span class="px-2 py-1 rounded-lg border text-[10px] font-bold uppercase <%= sc %>">
                <%= o.status %>
              </span>
            </td>
            <td class="px-5 py-3 text-center">
              <span class="text-sm font-mono font-bold <%= hrsColor %>">
                <%= hrs > 0 ? hrs + 'h' : '–' %>
              </span>
            </td>
            <td class="px-5 py-3 text-right">
              <% if (o.status === 'CUSTOMS_HOLD') { %>
                <div class="flex items-center justify-end gap-2">
                  <% if (can.customsClear) { %>
                  <form action="/customs/<%= o.id %>/clear" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 hover:bg-emerald-500/20 text-xs font-bold transition-all flex items-center gap-1">
                      <i class="fa-solid fa-check"></i> ผ่าน
                    </button>
                  </form>
                  <% } %>
                  <% if (can.customsClear) { %>
                  <form action="/customs/<%= o.id %>/reject" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="reason" value="ศุลกากรไม่อนุมัติ">
                    <button class="px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 hover:bg-red-500/20 text-xs font-bold transition-all flex items-center gap-1">
                      <i class="fa-solid fa-xmark"></i> กัก
                    </button>
                  </form>
                  <% } %>
                </div>
              <% } else { %>
                <a href="/customs/<%= o.id %>" class="text-blue-400 hover:text-blue-300 text-xs transition-colors">
                  <i class="fa-solid fa-arrow-right"></i> ดำเนินการ
                </a>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>