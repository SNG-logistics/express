<%#
  views/orders/detail.ejs — Order Detail v2
  Data from: ordersController.detail()
  Variables: order, logs, payments, notifications, codSettlement, customsHoldLog, orderFlags, flash, user, can
%>
<%
  // ─── Helpers ─────────────────────────────────────────────────────────────
  const notificationItems = typeof notifications !== 'undefined' ? notifications : [];
  function fmtBaht(n) {
    return '฿' + Number(n || 0).toLocaleString('th-TH');
  }
  function fmtDate(d) {
    if (!d) return '–';
    return new Date(d).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short' });
  }
  function hoursAgo(h) {
    if (h == null) return '–';
    if (h <  1)  return 'เพิ่งเข้ามา';
    if (h < 24)  return h + ' ชม. ที่แล้ว';
    return Math.floor(h / 24) + ' วัน ' + (h % 24) + ' ชม. ที่แล้ว';
  }
  function ageColor(h, warn, crit) {
    if (h == null) return 'text-slate-500';
    if (h >= crit) return 'text-red-400';
    if (h >= warn) return 'text-amber-400';
    return 'text-emerald-400';
  }

  // ─── Status labels & colors ───────────────────────────────────────────────
  const STATUS_LABELS = {
    'NEW'              : { th: 'ออเดอร์ใหม่',       color: 'blue'   },
    'RECEIVED_WH_TH'  : { th: 'รับที่คลังไทย',      color: 'orange' },
    'RECEIVED_WH_LA'  : { th: 'รับที่คลังลาว',      color: 'orange' },
    'ON_TRUCK'        : { th: 'ขึ้นรถแล้ว',           color: 'violet' },
    'ON_TRUCK_BORDER' : { th: 'ขึ้นรถมุ่งหน้าแดน',   color: 'violet' },
    'CROSSING_BORDER' : { th: 'กำลังข้ามแดน',        color: 'violet' },
    'ARRIVED_BORDER_WH':{ th: 'ถึงด่านปลายทาง',     color: 'cyan'   },
    'CUSTOMS_HOLD'    : { th: 'รอศุลกากร',           color: 'amber'  },
    'CUSTOMS_CLEARED' : { th: 'ผ่านศุลกากร',         color: 'emerald'},
    'CUSTOMS_REJECTED': { th: 'ศุลกากรปฏิเสธ',      color: 'red'    },
    'AT_DEST_WH'      : { th: 'ถึงคลังปลายทาง',      color: 'cyan'   },
    'BRANCH_TRANSFER' : { th: 'โอนสาขา',             color: 'indigo' },
    'BRANCH_RECEIVED' : { th: 'สาขารับแล้ว',         color: 'indigo' },
    'RIDER_ASSIGNED'  : { th: 'มอบให้ไรเดอร์',       color: 'blue'   },
    'RIDER_ACCEPTED'  : { th: 'ไรเดอร์รับงานแล้ว',    color: 'blue'   },
    'OUT_FOR_DELIVERY': { th: 'กำลังส่ง',             color: 'blue'   },
    'DELIVERED'       : { th: 'ส่งสำเร็จ',            color: 'emerald'},
    'DELIVERY_FAILED' : { th: 'ส่งไม่สำเร็จ',        color: 'red'    },
    'COD_COLLECTED'   : { th: 'เก็บเงิน COD แล้ว',   color: 'cyan'   },
    'COD_REMITTED'    : { th: 'โอน COD แล้ว',        color: 'emerald'},
    'RETURN_TO_SENDER': { th: 'คืนผู้ส่ง',            color: 'slate'  },
    'CLOSED'          : { th: 'ปิดงานแล้ว',           color: 'slate'  },
    'CANCELLED'       : { th: 'ยกเลิก',               color: 'red'    },
  };
  const COL = {
    blue:   'bg-blue-500/15 text-blue-300 border-blue-500/25',
    orange: 'bg-orange-500/15 text-orange-300 border-orange-500/25',
    violet: 'bg-violet-500/15 text-violet-300 border-violet-500/25',
    cyan:   'bg-cyan-500/15 text-cyan-300 border-cyan-500/25',
    amber:  'bg-amber-500/15 text-amber-300 border-amber-500/25',
    emerald:'bg-emerald-500/15 text-emerald-300 border-emerald-500/25',
    red:    'bg-red-500/15 text-red-300 border-red-500/25',
    indigo: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/25',
    slate:  'bg-slate-500/15 text-slate-400 border-slate-500/25',
  };

  const statusMeta  = STATUS_LABELS[order.status] || { th: order.status, color: 'slate' };
  const statusCss   = COL[statusMeta.color];
  const isTH2LA     = order.direction === 'TH_TO_LA';
  const isLocked    = ['CLOSED','CANCELLED'].includes(order.status);
  const hasCOD      = Number(order.cod_amount || 0) > 0;
  const hasCustoms  = !!order.requires_customs;
  const hasTrip     = !!order.trip_id;

  // Exception thresholds
  const ageHours    = Number(order.hours_since_update || 0);
  const createdHrs  = Number(order.hours_since_created || 0);
  const customsHeld = Number(customsHoldLog?.hours_held || 0);
  const codHours    = Number(codSettlement?.hours_since_collected || 0);

  const exceptions = [];
  if (order.status === 'DELIVERY_FAILED') {
    exceptions.push({ type: 'red', icon: 'fa-circle-xmark',
      text: `ส่งไม่สำเร็จ ครั้งที่ ${order.fail_count || 1}${order.fail_reason ? ' — ' + order.fail_reason : ''}` });
  }
  if (order.status === 'OUT_FOR_DELIVERY' && ageHours >= 24) {
    exceptions.push({ type: 'amber', icon: 'fa-clock',
      text: `กำลังส่งมาแล้ว ${hoursAgo(ageHours)} — เกิน SLA 24 ชม.` });
  }
  if (order.status === 'CUSTOMS_HOLD' && customsHeld >= 72) {
    exceptions.push({ type: 'red', icon: 'fa-stamp',
      text: `ค้างศุลกากร ${customsHeld} ชม. — เกิน SLA 72 ชม.` });
  }
  if (order.status === 'COD_COLLECTED' && codHours >= 72) {
    exceptions.push({ type: 'amber', icon: 'fa-coins',
      text: `COD รอโอน ${codHours} ชม. — เกิน SLA 72 ชม.` });
  }
  if (order.status === 'NEW' && createdHrs >= 24) {
    exceptions.push({ type: 'amber', icon: 'fa-inbox',
      text: `ยังไม่ได้รับเข้าคลัง ${createdHrs} ชม. — เกิน SLA 24 ชม.` });
  }

  // Role gating (can is also passed from controller, but keep local for quick template use)
  const role = user?.role || '';
  const isAdmin    = ['admin','manager'].includes(role);
  const isFinance  = ['admin','manager','finance'].includes(role);
  const isTH_WH    = ['admin','manager','warehouse_th','thai_warehouse'].includes(role);
  const isLA_WH    = ['admin','manager','warehouse_la','lao_warehouse'].includes(role);

  const isDispatch = ['admin','manager','dispatcher'].includes(role);

  const canEdit    = !isLocked && ['NEW','RECEIVED_WH_TH','RECEIVED_WH_LA'].includes(order.status) && isAdmin;
  const canReceive = !isLocked && order.status === 'NEW' &&
    ((isTH2LA && isTH_WH) || (!isTH2LA && isLA_WH));
  const canDeliver = !isLocked && ['AT_DEST_WH'].includes(order.status) && (isLA_WH || isAdmin);
  const canClose   = !isLocked && ['DELIVERED','COD_COLLECTED'].includes(order.status) && isAdmin;
  const canReturn  = !isLocked && ['DELIVERY_FAILED'].includes(order.status) && isDispatch;
  const canAddPayment = !isLocked && isFinance;
  const canDelPayment = !isLocked && isAdmin;

  // Screening helpers
  const SCREENING_META = {
    PENDING:           { label: 'รอตรวจ',              css: 'bg-slate-500/15 text-slate-400 border-slate-500/25',   icon: 'fa-hourglass-half' },
    PASSED:            { label: 'ผ่านการคัดกรอง',       css: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/25', icon: 'fa-circle-check' },
    CUSTOMS_REQUIRED:  { label: 'ต้องผ่านศุลกากร',      css: 'bg-amber-500/15 text-amber-400 border-amber-500/25',   icon: 'fa-stamp'          },
    REJECTED:          { label: 'ปฏิเสธสินค้า',          css: 'bg-red-500/15 text-red-400 border-red-500/25',         icon: 'fa-circle-xmark'   },
  };
  const FLAG_META = {
    PROHIBITED:        { label: 'สินค้าต้องห้าม',        css: 'bg-red-500/15 text-red-400 border-red-500/25',         icon: 'fa-ban'              },
    CUSTOMS_REQUIRED:  { label: 'ต้องแจ้งศุลกากร',       css: 'bg-amber-500/15 text-amber-400 border-amber-500/25',   icon: 'fa-stamp'            },
    OVERSIZE:          { label: 'เกินขนาด',               css: 'bg-orange-500/15 text-orange-400 border-orange-500/25',icon: 'fa-up-right-and-down-left-from-center' },
    OVERWEIGHT:        { label: 'เกินน้ำหนัก',            css: 'bg-orange-500/15 text-orange-400 border-orange-500/25',icon: 'fa-weight-hanging'   },
    FRAGILE:           { label: 'แตกหักง่าย',             css: 'bg-blue-500/15 text-blue-400 border-blue-500/25',      icon: 'fa-wine-glass-crack' },
    HIGH_VALUE:        { label: 'มูลค่าสูง',              css: 'bg-violet-500/15 text-violet-400 border-violet-500/25',icon: 'fa-gem'              },
  };
  const screenMeta   = SCREENING_META[order.screening_status] || SCREENING_META.PENDING;
  const hasScreening = !!order.screening_status && order.screening_status !== 'PENDING';
  const hasFlags     = orderFlags && orderFlags.length > 0;
  const openFlags    = orderFlags ? orderFlags.filter(f => !f.resolved) : [];
%>

<div class="max-w-7xl mx-auto space-y-5" x-data="{ showFailModal: false, showDeliverModal: false }">

<%# ═══════════════════════ A. HERO HEADER ════════════════════════════ %>
<div class="glass-panel-dark rounded-2xl p-6 border border-white/8 relative overflow-hidden">
  <div class="absolute right-6 top-6 opacity-5 pointer-events-none">
    <i class="fa-solid fa-box-open text-8xl text-indigo-400"></i>
  </div>
  <div class="relative flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">

    <%# Left: Job info %>
    <div class="space-y-3 min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest
          <%= isTH2LA ? 'bg-indigo-500/15 text-indigo-300 border border-indigo-500/25' : 'bg-amber-500/15 text-amber-300 border border-amber-500/25' %>">
          <%= isTH2LA ? '🇹🇭 TH → LA 🇱🇦' : '🇱🇦 LA → TH 🇹🇭' %>
        </span>
        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest border <%= statusCss %>">
          <%= statusMeta.th %>
        </span>
        <% if (isLocked) { %>
        <span class="flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] bg-slate-700/50 text-slate-500 border border-slate-600/30">
          <i class="fa-solid fa-lock text-[9px]"></i> ล็อค
        </span>
        <% } %>
      </div>
      <h1 class="text-4xl font-black text-white tracking-tight font-mono"><%= order.job_no %></h1>
      <div class="flex flex-wrap items-center gap-4 text-[11px] text-slate-500">
        <span><i class="fa-regular fa-calendar mr-1"></i><%= fmtDate(order.created_at) %></span>
        <span class="<%= ageColor(createdHrs, 24, 72) %>">
          <i class="fa-regular fa-clock mr-1"></i><%= hoursAgo(createdHrs) %>
        </span>
        <span><i class="fa-solid fa-tag mr-1 text-slate-600"></i><%= order.service_type || 'General' %></span>
        <% if (hasCustoms) { %>
        <span class="text-blue-400"><i class="fa-solid fa-shield-halved mr-1"></i>ต้องผ่านศุลกากร</span>
        <% } %>
      </div>

      <%# Action buttons row %>
      <div class="flex flex-wrap gap-2 pt-1">
        <a href="/orders/<%= order.id %>/sticker?lang=th" target="_blank"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 text-xs font-bold hover:bg-cyan-500/30 transition-all">
          <i class="fa-solid fa-receipt text-xs"></i> ปะหน้า (TH)
        </a>
        <a href="/orders/<%= order.id %>/sticker?lang=la" target="_blank"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 text-xs font-bold hover:bg-indigo-500/30 transition-all">
          <i class="fa-solid fa-receipt text-xs"></i> ปะหน้า (LA)
        </a>
        <a href="/orders/<%= order.id %>/waybill" target="_blank"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-xs hover:bg-white/10 transition-all">
          <i class="fa-solid fa-print text-xs"></i> Waybill (A4)
        </a>
        <% if (canEdit) { %>
        <a href="/orders/<%= order.id %>/edit"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 text-xs hover:bg-white/10 transition-all">
          <i class="fa-solid fa-pen text-xs"></i> แก้ไข
        </a>
        <% } %>
        <a href="/orders" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-400 text-xs hover:bg-white/10 transition-all">
          <i class="fa-solid fa-arrow-left text-xs"></i> รายการ
        </a>
      </div>
    </div>

    <%# Right: Primary action (contextual) %>
    <div class="flex flex-col gap-2 flex-shrink-0">
      <% if (canReceive) { %>
      <form action="/orders/<%= order.id %>/receive" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-blue-600 text-white text-sm font-bold hover:shadow-indigo-500/25 hover:shadow-lg transition-all flex items-center gap-2">
          <i class="fa-solid fa-inbox"></i> รับเข้าคลัง
        </button>
      </form>
      <% } else if (order.status === 'ON_TRUCK' && isDispatch) { %>
      <form action="/orders/<%= order.id %>/crossing" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 text-white text-sm font-bold hover:shadow-amber-500/25 hover:shadow-lg transition-all flex items-center gap-2">
          <i class="fa-solid fa-truck-moving"></i> เริ่มข้ามแดน
        </button>
      </form>
      <% } else if (order.status === 'CROSSING_BORDER' && isDispatch) { %>
      <form action="/orders/<%= order.id %>/arrived-border" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-sm font-bold hover:shadow-emerald-500/25 hover:shadow-lg transition-all flex items-center gap-2">
          <i class="fa-solid fa-flag-checkered"></i> ถึงด่านปลายทาง
        </button>
      </form>
      <% } else if (order.status === 'ARRIVED_BORDER_WH' && (isLA_WH || isAdmin)) { %>
      <form action="/orders/<%= order.id %>/arrived-dest" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-blue-600 text-white text-sm font-bold hover:shadow-indigo-500/25 hover:shadow-lg transition-all flex items-center gap-2">
          <i class="fa-solid fa-warehouse"></i> ถึงโกดังปลาย
        </button>
      </form>
      <% } else if (canDeliver) { %>
      <form action="/orders/<%= order.id %>/delivery" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-blue-500 to-cyan-600 text-white text-sm font-bold hover:shadow-blue-500/25 hover:shadow-lg transition-all flex items-center gap-2">
          <i class="fa-solid fa-motorcycle"></i> ออกส่งพัสดุ
        </button>
      </form>
      <% } else if (order.status === 'OUT_FOR_DELIVERY' && (isLA_WH || isAdmin)) { %>
      <div class="flex flex-col gap-2">
        <button type="button" onclick="document.getElementById('deliverModal').style.display='flex'" class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-green-600 text-white text-sm font-bold hover:shadow-emerald-500/25 hover:shadow-lg transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-check-double"></i> ส่งสำเร็จ
        </button>
        <button type="button" onclick="document.getElementById('failModal').style.display='flex'" class="w-full px-6 py-3 rounded-xl bg-slate-700 border border-slate-600 text-red-300 text-sm font-bold hover:bg-slate-600 transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-triangle-exclamation"></i> ส่งไม่สำเร็จ
        </button>
      </div>

      <% } else if (canReturn) { %>
      <div class="flex gap-2">
        <form action="/orders/<%= order.id %>/delivery" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="px-4 py-3 rounded-xl bg-blue-500/15 border border-blue-500/25 text-blue-300 text-sm font-semibold hover:bg-blue-500/25 transition-all text-xs">
            <i class="fa-solid fa-redo"></i> ส่งใหม่
          </button>
        </form>
        <form action="/orders/<%= order.id %>/return" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="px-4 py-3 rounded-xl bg-slate-700/50 border border-white/10 text-slate-300 text-sm font-semibold hover:bg-slate-600/50 transition-all text-xs">
            <i class="fa-solid fa-reply"></i> คืนผู้ส่ง
          </button>
        </form>
      </div>
      <% } else if (canClose) { %>
      <form action="/orders/<%= order.id %>/close" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-full px-6 py-3 rounded-xl bg-slate-700 border border-slate-600 text-white text-sm font-bold hover:bg-slate-600 transition-all flex items-center gap-2">
          <i class="fa-solid fa-lock"></i> ปิดงาน
        </button>
      </form>
      <% } else if (isLocked) { %>
      <div class="px-4 py-3 rounded-xl bg-slate-800/60 border border-slate-700/50 text-slate-500 text-xs flex items-center gap-2">
        <i class="fa-solid fa-lock"></i> <%= statusMeta.th %> — ล็อค
      </div>
      <% } %>
    </div>

  </div>
</div>

<%# ═══════════════════ B. EXCEPTION STRIP ════════════════════════════ %>
<% if (exceptions.length > 0) { %>
<div class="space-y-2">
  <% exceptions.forEach(ex => { %>
  <div class="flex items-center gap-3 px-4 py-3 rounded-xl
    <%= ex.type === 'red' ? 'bg-red-500/10 border border-red-500/20' : 'bg-amber-500/10 border border-amber-500/20' %>">
    <i class="fa-solid <%= ex.icon %> <%= ex.type === 'red' ? 'text-red-400' : 'text-amber-400' %> flex-shrink-0"></i>
    <span class="<%= ex.type === 'red' ? 'text-red-300' : 'text-amber-300' %> text-sm font-medium"><%= ex.text %></span>
  </div>
  <% }) %>
</div>
<% } %>

<%# ═══════════════════ B.2 ORDER FLAGS STRIP ════════════════════════════ %>
<% if (hasFlags) { %>
<div class="space-y-2 mt-4 mb-4">
  <% orderFlags.forEach(f => {
       const m = FLAG_META[f.flag_type] || { label: f.flag_type, css: 'bg-slate-500/10 border-slate-500/20 text-slate-300', icon: 'fa-flag' };
  %>
  <div class="flex items-center justify-between px-4 py-3 rounded-xl border <%= m.css %> <%= f.resolved ? 'opacity-50 grayscale' : '' %>">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center">
        <i class="fa-solid <%= m.icon %> flex-shrink-0"></i>
      </div>
      <div>
        <span class="text-sm font-bold"><%= m.label %> <%= f.resolved ? '(เคลียร์แล้ว)' : '' %></span>
        <% if (f.description) { %>
          <span class="text-xs opacity-80 block lg:inline lg:ml-2"><%= f.description %></span>
        <% } %>
      </div>
    </div>
    
    <% if (!f.resolved && can.resolveFlag) { %>
    <form action="/orders/<%= order.id %>/flags/<%= f.id %>/resolve" method="POST" class="flex-shrink-0" onsubmit="return confirm('ยืนยันว่าทำการเคลียร์ (แก้ไข/ปรับปรุง) ปัญหานี้เรียบร้อยแล้ว?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 transition-all text-sm font-bold backdrop-blur-sm flex items-center gap-1">
        <i class="fa-solid fa-check"></i> เคลียร์
      </button>
    </form>
    <% } %>
  </div>
  <% }) %>
</div>
<% } %>

<%# Flash message %>
<% if (flash) { %>
<div class="px-4 py-3 rounded-xl text-sm
  <%= flash.type === 'error' ? 'bg-red-500/10 border border-red-500/20 text-red-300' : 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-300' %>">
  <i class="fa-solid <%= flash.type === 'error' ? 'fa-circle-xmark' : 'fa-circle-check' %> mr-2"></i><%= flash.message %>
</div>
<% } %>

<%# ═══════════════════ C. KPI CARDS ══════════════════════════════════ %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

  <%# Freight cost %>
  <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-8 h-8 rounded-lg bg-indigo-500/15 flex items-center justify-center">
        <i class="fa-solid fa-coins text-indigo-400 text-sm"></i>
      </div>
      <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">ค่าขนส่ง</span>
    </div>
    <% if (can.viewRevenue) { %>
    <div class="text-2xl font-black text-white"><%= fmtBaht(order.price_amount) %></div>
    <div class="text-[10px] text-slate-600 mt-1"><%= order.price_currency || 'THB' %></div>
    <% } else { %>
    <div class="text-slate-600 text-sm">–</div>
    <% } %>
  </div>

  <%# COD %>
  <div class="glass-panel-dark rounded-2xl p-5 border border-white/8 <%= hasCOD ? 'border-emerald-500/20' : '' %>">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-8 h-8 rounded-lg <%= hasCOD ? 'bg-emerald-500/15' : 'bg-slate-700/50' %> flex items-center justify-center">
        <i class="fa-solid fa-hand-holding-dollar <%= hasCOD ? 'text-emerald-400' : 'text-slate-600' %> text-sm"></i>
      </div>
      <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">COD</span>
    </div>
    <div class="text-2xl font-black <%= hasCOD ? 'text-emerald-400' : 'text-slate-600' %>">
      <%= hasCOD ? fmtBaht(order.cod_amount) : 'ไม่มี' %>
    </div>
    <% if (hasCOD && codSettlement) { %>
    <div class="text-[10px] text-emerald-600 mt-1">
      <%= codSettlement.status === 'REMITTED' ? '✓ โอนแล้ว' : codSettlement.status === 'COLLECTED' ? '✓ เก็บแล้ว' : 'รอเก็บ' %>
    </div>
    <% } %>
  </div>

  <%# Weight / Size %>
  <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-8 h-8 rounded-lg bg-amber-500/15 flex items-center justify-center">
        <i class="fa-solid fa-scale-balanced text-amber-400 text-sm"></i>
      </div>
      <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">น้ำหนัก</span>
    </div>
    <div class="text-2xl font-black text-white">
      <%= order.declared_weight || '–' %><span class="text-sm text-slate-500 ml-1">kg</span>
    </div>
    <div class="text-[10px] text-slate-600 mt-1 font-mono"><%= order.declared_size || '–' %></div>
  </div>

  <%# Service type %>
  <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-8 h-8 rounded-lg bg-blue-500/15 flex items-center justify-center">
        <i class="fa-solid fa-truck text-blue-400 text-sm"></i>
      </div>
      <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">บริการ</span>
    </div>
    <div class="text-lg font-bold text-white uppercase"><%= order.service_type || 'General' %></div>
    <% if (hasCustoms) { %>
    <div class="mt-1.5">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
        <i class="fa-solid fa-shield-halved text-[9px]"></i> Customs
      </span>
    </div>
    <% } %>
  </div>
</div>

<%# ═══════════════════ D. MAIN BODY ══════════════════════════════════ %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <%# ── LEFT COL (2/3) ─────────────────────────────────────────────── %>
  <div class="lg:col-span-2 space-y-5">

    <%# Sender / Receiver %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
        <i class="fa-solid fa-users text-indigo-400"></i> ผู้ส่ง / ผู้รับ
      </h3>
      <div class="grid md:grid-cols-2 gap-4">

        <%# Sender %>
        <div class="bg-white/4 rounded-xl p-4 border border-white/6 relative">
          <div class="absolute -top-2.5 left-3 px-2 py-0.5 bg-slate-800 rounded text-[9px] font-bold text-slate-400 uppercase border border-slate-700">
            ผู้ส่ง
          </div>
          <div class="mt-1 space-y-1">
            <p class="font-bold text-white text-sm"><%= order.sender_name || '–' %></p>
            <% if (order.sender_phone) { %>
            <a href="tel:<%= order.sender_phone %>" class="flex items-center gap-1.5 text-xs text-cyan-400 hover:text-cyan-300">
              <i class="fa-solid fa-phone text-[10px]"></i> <%= order.sender_phone %>
            </a>
            <% } %>
            <% if (order.sender_address) { %>
            <p class="text-[11px] text-slate-500 leading-relaxed border-t border-white/5 pt-2 mt-2"><%= order.sender_address %></p>
            <% } %>
            <% if (order.sender_cid) { %>
            <a href="/customers/<%= order.sender_cid %>" class="text-[10px] text-indigo-400 hover:text-indigo-300">ดูข้อมูล →</a>
            <% } %>
          </div>
        </div>

        <%# Receiver %>
        <div class="bg-white/4 rounded-xl p-4 border border-white/6 relative">
          <div class="absolute -top-2.5 left-3 px-2 py-0.5 bg-slate-800 rounded text-[9px] font-bold text-slate-400 uppercase border border-slate-700">
            ผู้รับ
          </div>
          <div class="mt-1 space-y-1">
            <p class="font-bold text-white text-sm"><%= order.receiver_name || '–' %></p>
            <% if (order.receiver_phone) { %>
            <a href="tel:<%= order.receiver_phone %>" class="flex items-center gap-1.5 text-xs text-cyan-400 hover:text-cyan-300">
              <i class="fa-solid fa-phone text-[10px]"></i> <%= order.receiver_phone %>
            </a>
            <% } %>
            <% if (order.receiver_address) { %>
            <p class="text-[11px] text-slate-500 leading-relaxed border-t border-white/5 pt-2 mt-2"><%= order.receiver_address %></p>
            <% } %>
            <% if (order.receiver_cid) { %>
            <a href="/customers/<%= order.receiver_cid %>" class="text-[10px] text-indigo-400 hover:text-indigo-300">ดูข้อมูล →</a>
            <% } %>
          </div>
        </div>
        </div>
      </div>
    </div>

    <%# Intake Photos %>
    <% if (order.intake_photos) { %>
      <% 
        let photos = [];
        try {
          photos = typeof order.intake_photos === 'string' ? JSON.parse(order.intake_photos) : order.intake_photos;
        } catch(e) {}
      %>
      <% if (photos && photos.length > 0) { %>
      <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
        <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
          <i class="fa-solid fa-camera text-slate-400"></i> รูปถ่ายสินค้าตอนรับเข้า
          <span class="text-xs text-slate-500 font-mono"><%= photos.length %>รูป</span>
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-3">
          <% photos.forEach(url => { %>
            <a href="<%= url %>" target="_blank" class="block aspect-square rounded-xl overflow-hidden border border-white/10 hover:border-blue-500/50 transition-colors">
              <img src="<%= url %>" alt="Intake Photo" class="w-full h-full object-cover">
            </a>
          <% }) %>
        </div>
      </div>
      <% } %>
    <% } %>

    <%# Trip Assignment %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
        <i class="fa-solid fa-truck text-blue-400"></i> รอบรถที่มอบหมาย
      </h3>
      <% if (hasTrip) { %>
      <a href="/trips/<%= order.trip_id %>" class="flex items-center justify-between p-4 rounded-xl bg-blue-500/8 border border-blue-500/15 hover:bg-blue-500/15 transition-all group">
        <div class="flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-blue-500/15 flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-truck text-blue-400"></i>
          </div>
          <div>
            <div class="text-white font-mono font-bold text-sm"><%= order.trip_no %></div>
            <div class="text-slate-400 text-xs">
              <%= order.driver_name || '–' %>
              <% if (order.vehicle_no) { %> · <%= order.vehicle_no %><% } %>
            </div>
            <div class="text-slate-500 text-[10px] mt-0.5">
              <%= order.origin_border || '–' %> → <%= order.dest_border || '–' %>
              <% if (order.trip_date) { %> · <%= fmtDate(order.trip_date) %><% } %>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <% const tm = STATUS_LABELS[order.trip_status]; %>
          <% if (tm) { %>
          <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border <%= COL[tm.color] %>"><%= tm.th %></span>
          <% } %>
          <i class="fa-solid fa-arrow-right text-slate-600 group-hover:text-slate-400 transition-colors"></i>
        </div>
      </a>

      <% } else { %>
      <div class="flex items-center justify-between p-4 rounded-xl bg-white/3 border border-dashed border-white/10">
        <div class="flex items-center gap-3 text-slate-500">
          <i class="fa-solid fa-truck text-slate-600"></i>
          <span class="text-sm">ยังไม่ได้รับมอบหมายรอบรถ</span>
        </div>
        <% if (isDispatch) { %>
        <a href="/trips" class="text-xs text-blue-400 hover:text-blue-300">จัดส่ง →</a>
        <% } %>
      </div>
      <% } %>
    </div>

    <%# Customs Panel (conditional) %>
    <% if (hasCustoms) { %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8 <%= order.status === 'CUSTOMS_HOLD' ? 'border-amber-500/25' : '' %>">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
        <i class="fa-solid fa-stamp text-amber-400"></i> ศุลกากร
        <% if (order.status === 'CUSTOMS_HOLD') { %>
        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-500/15 text-amber-400 border border-amber-500/25">รอดำเนินการ</span>
        <% } else if (order.status === 'CUSTOMS_CLEARED') { %>
        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/25">ผ่านแล้ว</span>
        <% } else if (order.status === 'CUSTOMS_REJECTED') { %>
        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-red-500/15 text-red-400 border border-red-500/25">ปฏิเสธ</span>
        <% } %>
      </h3>
      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">มูลค่าประกาศ</div>
          <div class="text-white font-semibold"><%= order.declared_value ? fmtBaht(order.declared_value) : '–' %></div>
        </div>
        <% if (customsHoldLog) { %>
        <div>
          <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ค้างมา</div>
          <div class="font-semibold <%= ageColor(customsHeld, 24, 72) %>"><%= hoursAgo(customsHeld) %></div>
        </div>
        <% } %>
      </div>
      <% if (can.manageCustoms) { %>
      <div class="mt-3 pt-3 border-t border-white/6">
        <a href="/customs?order=<%= order.id %>" class="text-xs text-amber-400 hover:text-amber-300">จัดการศุลกากร →</a>
      </div>
      <% } %>
    </div>
    <% } %>

    <%# ─── Screening Status Panel ─────────────────────────────────── %>
    <% if (hasScreening) { %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8
      <%= order.screening_status === 'REJECTED' ? 'border-red-500/25' : order.screening_status === 'CUSTOMS_REQUIRED' ? 'border-amber-500/20' : order.screening_status === 'PASSED' ? 'border-emerald-500/15' : '' %>">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-white font-semibold text-sm flex items-center gap-2">
          <i class="fa-solid fa-shield-check text-blue-400"></i> การคัดกรองสินค้า
        </h3>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase tracking-widest border <%= screenMeta.css %>">
          <i class="fa-solid <%= screenMeta.icon %> text-[9px]"></i>
          <%= screenMeta.label %>
        </span>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <% if (order.screened_at) { %>
        <div>
          <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">วันที่ตรวจ</div>
          <div class="text-white font-mono text-xs"><%= fmtDate(order.screened_at) %></div>
        </div>
        <% } %>
        <% if (order.screening_note) { %>
        <div class="<%= order.screened_at ? '' : 'col-span-2' %>">
          <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">หมายเหตุ</div>
          <div class="text-slate-300 text-xs leading-relaxed"><%= order.screening_note %></div>
        </div>
        <% } %>
      </div>

      <% if (order.screening_status === 'PASSED' && !order.sticker_printed_at) { %>
      <div class="mt-3 pt-3 border-t border-white/6 flex gap-2">
        <a href="/orders/<%= order.id %>/sticker?lang=th" target="_blank"
           class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-cyan-500/15 border border-cyan-500/25 text-cyan-300 text-xs font-bold hover:bg-cyan-500/25 transition-all">
          <i class="fa-solid fa-receipt"></i> พิมพ์ Sticker (TH)
        </a>
        <a href="/orders/<%= order.id %>/sticker?lang=la" target="_blank"
           class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-indigo-500/15 border border-indigo-500/25 text-indigo-300 text-xs font-bold hover:bg-indigo-500/25 transition-all">
          <i class="fa-solid fa-receipt"></i> พิมพ์ Sticker (LA)
        </a>
      </div>
      <% } else if (order.screening_status === 'PASSED' && order.sticker_printed_at) { %>
      <div class="mt-3 pt-3 border-t border-white/6 flex items-center gap-2 text-emerald-500 text-[11px]">
        <i class="fa-solid fa-circle-check"></i>
        พิมพ์ Sticker แล้ว · <%= fmtDate(order.sticker_printed_at) %>
      </div>
      <% } else if (order.screening_status === 'CUSTOMS_REQUIRED' && can.manageCustoms) { %>
      <div class="mt-3 pt-3 border-t border-white/6">
        <a href="/customs?order=<%= order.id %>" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-amber-500/15 border border-amber-500/25 text-amber-300 text-xs font-bold hover:bg-amber-500/25 transition-all">
          <i class="fa-solid fa-stamp"></i> สร้างเอกสารศุลกากร
        </a>
      </div>
      <% } %>
    </div>
    <% } %>

    <%# ─── Order Flags Panel ─────────────────────────────────────── %>
    <% if (hasFlags) { %>
    <div class="glass-panel-dark rounded-2xl border border-white/8 overflow-hidden
      <%= openFlags.length > 0 ? 'border-red-500/20' : '' %>">
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/6">
        <h3 class="text-white font-semibold text-sm flex items-center gap-2">
          <i class="fa-solid fa-flag text-red-400"></i> Order Flags
          <% if (openFlags.length > 0) { %>
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-red-500 text-white text-[9px] font-black">
            <%= openFlags.length %>
          </span>
          <% } else { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] bg-emerald-500/15 text-emerald-400 border border-emerald-500/25">
            <i class="fa-solid fa-circle-check text-[9px]"></i> แก้ไขแล้ว
          </span>
          <% } %>
        </h3>
        <span class="text-[10px] text-slate-500 font-mono"><%= orderFlags.length %> flags</span>
      </div>

      <div class="divide-y divide-white/5">
        <% orderFlags.forEach(flag => {
             const fm = FLAG_META[flag.flag_type] || { label: flag.flag_type, css: 'bg-slate-500/15 text-slate-400 border-slate-500/25', icon: 'fa-flag' };
        %>
        <div class="flex items-start justify-between px-5 py-4 <%= flag.resolved ? 'opacity-50' : '' %>">
          <div class="flex items-start gap-3 min-w-0">
            <div class="w-8 h-8 rounded-lg flex-shrink-0 flex items-center justify-center mt-0.5
              <%= flag.resolved ? 'bg-slate-700/50' : fm.css.split(' ')[0] %>">
              <i class="fa-solid <%= fm.icon %> text-sm <%= flag.resolved ? 'text-slate-600' : fm.css.split(' ')[1] %>"></i>
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold border
                  <%= flag.resolved ? 'bg-slate-700/30 text-slate-500 border-slate-600/30' : fm.css %>">
                  <i class="fa-solid <%= fm.icon %> text-[9px]"></i>
                  <%= fm.label %>
                </span>
                <% if (flag.resolved) { %>
                <span class="text-[10px] text-emerald-600 flex items-center gap-1">
                  <i class="fa-solid fa-circle-check"></i> แก้ไขแล้ว
                </span>
                <% } %>
              </div>
              <% if (flag.description) { %>
              <div class="text-xs text-slate-400 mt-1.5 leading-relaxed"><%= flag.description %></div>
              <% } %>
              <div class="flex items-center gap-3 mt-1.5 text-[10px] text-slate-600">
                <% if (flag.flagged_by_name) { %>
                <span><i class="fa-solid fa-user mr-1"></i><%= flag.flagged_by_name %></span>
                <% } %>
                <% if (flag.flagged_at) { %>
                <span><i class="fa-regular fa-clock mr-1"></i><%= fmtDate(flag.flagged_at) %></span>
                <% } %>
              </div>
            </div>
          </div>

          <% if (!flag.resolved && can.resolveFlag) { %>
          <form action="/orders/<%= order.id %>/flags/<%= flag.id %>/resolve" method="post" class="flex-shrink-0 ml-3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit"
              class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-400 text-[10px] font-semibold hover:bg-emerald-500/15 hover:text-emerald-400 hover:border-emerald-500/25 transition-all"
              onclick="return confirm('ยืนยันแก้ไข flag นี้?')">
              <i class="fa-solid fa-check mr-1"></i>แก้ไข
            </button>
          </form>
          <% } %>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <%# COD State Panel (conditional) %>
    <% if (hasCOD) { %>
    <%
      const codStep  = codSettlement?.status || 'PENDING';
      const steps = [
        { key: 'PENDING',   label: 'รอเก็บ',        icon: 'fa-clock',                 color: 'amber'   },
        { key: 'COLLECTED', label: 'เก็บแล้ว รอโอน', icon: 'fa-hand-holding-dollar',   color: 'cyan'    },
        { key: 'REMITTED',  label: 'โอนแล้ว',        icon: 'fa-circle-check',           color: 'emerald' },
      ];
      const activeIdx = steps.findIndex(s => s.key === codStep);
    %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8 <%= codStep === 'PENDING' ? 'border-amber-500/15' : '' %>">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-white font-semibold text-sm flex items-center gap-2">
          <i class="fa-solid fa-coins text-amber-400"></i> COD
          <span class="text-amber-400 font-mono font-bold"><%= fmtBaht(order.cod_amount) %></span>
        </h3>
        <% if (isFinance && can.viewFinancials) { %>
        <a href="/cod" class="text-[10px] text-amber-400 hover:text-amber-300">จัดการ →</a>
        <% } %>
      </div>

      <div class="flex items-stretch gap-0">
        <% steps.forEach((step, i) => {
             const isActive  = i === activeIdx;
             const isDone    = i < activeIdx;
        %>
        <div class="flex-1 relative">
          <div class="p-3 rounded-xl border transition-all
            <%= isActive ? `bg-${step.color}-500/15 border-${step.color}-500/30` : isDone ? 'bg-white/4 border-white/8' : 'bg-white/2 border-white/5 opacity-40' %>">
            <div class="flex items-center gap-2 mb-1">
              <i class="fa-solid <%= step.icon %> text-xs
                <%= isActive ? `text-${step.color}-400` : isDone ? 'text-emerald-400' : 'text-slate-600' %>"></i>
              <span class="text-[10px] font-bold
                <%= isActive ? `text-${step.color}-400` : isDone ? 'text-slate-400' : 'text-slate-600' %>">
                <%= step.label %>
              </span>
            </div>
            <% if (isActive && i === 1 && codSettlement?.collected_at) { %>
            <div class="text-[9px] text-slate-500 mt-0.5"><%= fmtDate(codSettlement.collected_at) %></div>
            <% } %>
            <% if (isDone && i === 2 && codSettlement?.remitted_at) { %>
            <div class="text-[9px] text-slate-500 mt-0.5"><%= fmtDate(codSettlement.remitted_at) %></div>
            <% } %>
          </div>
          <% if (i < steps.length - 1) { %>
          <div class="absolute top-1/2 -right-2 -translate-y-1/2 text-slate-700 text-[10px] z-10">
            <i class="fa-solid fa-chevron-right"></i>
          </div>
          <% } %>
        </div>
        <% if (i < steps.length - 1) { %><div class="w-4"></div><% } %>
        <% }) %>
      </div>
    </div>
    <% } %>

    <%# Payments / Expenses %>
    <div class="glass-panel-dark rounded-2xl border border-white/8 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/6">
        <h3 class="text-white font-semibold text-sm flex items-center gap-2">
          <i class="fa-solid fa-receipt text-emerald-400"></i> ค่าใช้จ่าย / Payments
        </h3>
        <% if (can.viewRevenue) { %>
        <span class="text-xs text-slate-500">
          รวม: <span class="text-emerald-400 font-bold">
            <%= fmtBaht(payments.reduce((s, p) => s + Number(p.amount || 0), 0)) %>
          </span>
        </span>
        <% } %>
      </div>

      <% if (payments && payments.length > 0) { %>
      <div class="divide-y divide-white/5">
        <% payments.forEach(p => { %>
        <div class="flex items-center justify-between px-5 py-3 hover:bg-white/3 transition-all group">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center flex-shrink-0">
              <i class="fa-solid fa-money-bill text-emerald-400 text-sm"></i>
            </div>
            <div>
              <div class="text-white text-sm font-semibold"><%= p.type.toUpperCase() %></div>
              <div class="text-slate-500 text-[10px]"><%= fmtDate(p.created_at) %><% if (p.note) { %> · <%= p.note %><% } %></div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-emerald-400 font-bold font-mono text-sm"><%= fmtBaht(p.amount) %></span>
            <% if (canDelPayment) { %>
            <form action="/orders/<%= order.id %>/payments/<%= p.id %>/delete" method="post"
              onsubmit="return confirm('ลบรายการนี้?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="w-6 h-6 flex items-center justify-center rounded text-slate-700 hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all">
                <i class="fa-solid fa-trash text-[10px]"></i>
              </button>
            </form>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="px-5 py-8 text-center text-slate-600 text-sm">
        <i class="fa-solid fa-receipt text-2xl opacity-30 mb-2 block"></i>
        ยังไม่มีค่าใช้จ่าย
      </div>
      <% } %>

      <% if (canAddPayment) { %>
      <form action="/orders/<%= order.id %>/payments" method="post" class="px-5 py-4 bg-white/2 border-t border-white/6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3">เพิ่มค่าใช้จ่าย</p>
        <div class="grid grid-cols-3 gap-3 mb-3">
          <div>
            <label class="block text-[10px] text-slate-600 mb-1">ประเภท</label>
            <select name="type" class="w-full bg-slate-800 text-white text-xs rounded-lg border border-slate-700 px-3 py-2 focus:ring-1 focus:ring-emerald-500 focus:outline-none">
              <option value="fee">Fee</option>
              <option value="freight">Freight</option>
              <option value="customs">Customs</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] text-slate-600 mb-1">จำนวน (฿)</label>
            <input type="number" name="amount" step="0.01" required placeholder="0.00"
              class="w-full bg-slate-800 text-white text-xs rounded-lg border border-slate-700 px-3 py-2 focus:ring-1 focus:ring-emerald-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-[10px] text-slate-600 mb-1">หมายเหตุ</label>
            <input type="text" name="note" placeholder="Optional"
              class="w-full bg-slate-800 text-white text-xs rounded-lg border border-slate-700 px-3 py-2 focus:ring-1 focus:ring-emerald-500 focus:outline-none">
          </div>
        </div>
        <button type="submit" class="px-4 py-1.5 rounded-lg bg-emerald-500/15 border border-emerald-500/25 text-emerald-400 text-xs font-bold hover:bg-emerald-500/25 transition-all">
          <i class="fa-solid fa-plus mr-1"></i>เพิ่ม
        </button>
      </form>
      <% } %>
    </div>

    <%# Image attachment %>
    <% if (order.image_path) { %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-4">
        <i class="fa-solid fa-camera text-slate-400"></i> รูปภาพ
      </h3>
      <img src="<%= order.image_path %>" alt="Parcel"
        class="w-full max-h-64 object-contain rounded-xl cursor-pointer hover:opacity-90 transition-opacity bg-black/20"
        onclick="window.open(this.src,'_blank')">
    </div>
    <% } %>

    <%# Notes %>
    <% if (order.notes) { %>
    <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2 mb-3">
        <i class="fa-solid fa-note-sticky text-slate-400"></i> หมายเหตุ
      </h3>
      <p class="text-slate-400 text-sm leading-relaxed whitespace-pre-wrap"><%= order.notes %></p>
    </div>
    <% } %>

  </div><%# /left col %>

  <%# ── RIGHT COL (1/3): Timeline ──────────────────────────────────── %>
  <div class="glass-panel-dark rounded-2xl p-5 border border-white/8 h-fit">
    <div class="mb-6 pb-5 border-b border-white/8">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-white font-semibold text-sm flex items-center gap-2">
          <i class="fa-brands fa-whatsapp text-emerald-400"></i> ข้อความลูกค้า
        </h3>
        <span class="text-[10px] text-slate-500"><%= notificationItems.length %> รายการ</span>
      </div>
      <% if (notificationItems.length === 0) { %>
        <p class="text-xs text-slate-600">ยังไม่มีข้อความจากการเปลี่ยนสถานะ</p>
      <% } else { %>
        <div class="space-y-2 max-h-52 overflow-y-auto">
          <% notificationItems.forEach(item => { %>
            <div class="rounded-lg border border-white/5 bg-white/3 px-3 py-2 text-xs">
              <div class="flex justify-between gap-2">
                <span class="text-slate-300"><%= item.event_type.replace('ORDER_STATUS:', '') %></span>
                <span class="font-semibold <%= item.status === 'SENT' ? 'text-emerald-400' : item.status === 'FAILED' ? 'text-red-400' : item.status === 'SKIPPED' ? 'text-slate-500' : 'text-amber-400' %>"><%= item.status %></span>
              </div>
              <div class="text-[10px] text-slate-600 mt-1">ครั้งที่ <%= item.attempts %> · <%= item.sent_at || item.created_at %></div>
              <% if (item.last_error) { %><div class="text-[10px] text-red-400/80 mt-1"><%= item.last_error %></div><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-timeline text-slate-400"></i> ประวัติสถานะ
      </h3>
      <span class="text-[10px] text-slate-500 font-mono"><%= logs.length %> รายการ</span>
    </div>

    <% if (logs.length === 0) { %>
    <div class="text-center py-8 text-slate-600 text-sm">
      <i class="fa-solid fa-timeline text-2xl opacity-30 mb-2 block"></i>
      ยังไม่มีประวัติ
    </div>
    <% } else { %>
    <div class="relative pl-4 border-l border-slate-800 space-y-5 max-h-[700px] overflow-y-auto pr-2">
      <% logs.forEach((log, i) => {
           const sm = STATUS_LABELS[log.to_status] || { th: log.to_status, color: 'slate' };
           const dotCss = i === 0 ? `bg-${sm.color}-400` : 'bg-slate-700 border border-slate-600';
      %>
      <div class="relative">
        <div class="absolute -left-[21px] top-1.5 w-3 h-3 rounded-full <%= dotCss %>"></div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-sm font-bold text-white"><%= sm.th %></span>
            <% if (log.from_status) { %>
            <span class="text-[9px] text-slate-600">← <%= STATUS_LABELS[log.from_status]?.th || log.from_status %></span>
            <% } %>
          </div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5"><%= fmtDate(log.action_at) %></div>
          <% if (log.username) { %>
          <div class="text-[10px] text-slate-600 mt-0.5">
            โดย <%= log.username %><% if (log.action_role) { %> · <span class="text-slate-700"><%= log.action_role %></span><% } %>
          </div>
          <% } %>
          <% if (log.note) { %>
          <div class="mt-1.5 text-[11px] text-slate-400 bg-white/4 rounded-lg px-3 py-2 border border-white/5 italic">
            "<%= log.note %>"
          </div>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

</div><%# /grid %>

</div><%# /max-w-7xl %>

<%# ═══════════════════ DELIVERED MODAL (POD) ════════════════════════════ %>
<div id="deliverModal" style="display:none;" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" onclick="if(event.target===this)this.style.display='none'">
  <div class="bg-slate-900 border border-slate-700/50 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden mt-[10vh]">
    <div class="p-5 border-b border-white/5 flex items-center justify-between bg-emerald-900/30">
      <h3 class="text-white font-bold flex items-center gap-2">
        <i class="fa-solid fa-check-double text-emerald-400"></i> ยืนยันส่งสำเร็จ
      </h3>
      <button onclick="document.getElementById('deliverModal').style.display='none'" class="text-slate-400 hover:text-white transition-colors">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form action="/orders/<%= order.id %>/delivered" method="post" enctype="multipart/form-data" class="p-5 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-xs font-medium text-slate-400 mb-1">ชื่อผู้รับของ</label>
        <input type="text" name="recipient_name" required placeholder="กรอกชื่อคนรับ" class="w-full bg-slate-800 border border-slate-700/80 rounded-xl px-4 py-3 text-white text-sm outline-none focus:border-emerald-500 transition-colors">
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-400 mb-2">อัปโหลดภาพหลักฐานการจัดส่ง (POD) <span class="text-red-400">*</span></label>
        <input type="file" name="pod_image" accept="image/*" capture="environment" required class="w-full text-sm text-slate-400
          file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0
          file:text-sm file:font-semibold file:bg-emerald-500/20 file:text-emerald-400
          hover:file:bg-emerald-500/30 transition-colors cursor-pointer bg-slate-800 border border-slate-700/80 rounded-xl p-2 outline-none">
      </div>

      <div class="flex gap-3 pt-4 border-t border-white/5">
        <button type="button" onclick="document.getElementById('deliverModal').style.display='none'" class="flex-1 py-3 px-4 rounded-xl bg-slate-800 text-slate-300 font-bold hover:bg-slate-700 transition">ยกเลิก</button>
        <button type="submit" class="flex-1 py-3 px-4 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-bold hover:bg-emerald-500/30 transition">✅ ยืนยันจัดส่งสำเร็จ</button>
      </div>
    </form>
  </div>
</div>

<%# ═══════════════════ DELIVERY FAILURE MODAL ════════════════════════════ %>
<div id="failModal" style="display:none;" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" onclick="if(event.target===this)this.style.display='none'">
  <div class="bg-slate-900 border border-slate-700/50 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden mt-[10vh]">
    <div class="p-5 border-b border-white/5 flex items-center justify-between bg-slate-800/50">
      <h3 class="text-white font-bold flex items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation text-red-400"></i> สาเหตุที่จัดส่งไม่สำเร็จ
      </h3>
      <button onclick="document.getElementById('failModal').style.display='none'" class="text-slate-400 hover:text-white transition-colors">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <form action="/orders/<%= order.id %>/delivery-failed" method="post" class="p-5 space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-2">ระบุสาเหตุหลัก *</label>
        <select name="fail_reason" required class="w-full bg-slate-800 border border-slate-700/80 rounded-xl px-4 py-3 text-white text-sm focus:border-red-500 outline-none transition-colors">
          <option value="">-- เลือกสาเหตุ --</option>
          <option value="NOT_AT_HOME">ลูกค้าไม่อยู่รับ</option>
          <option value="WRONG_ADDRESS">ที่อยู่ไม่ถูกต้อง</option>
          <option value="REFUSED">ลูกค้าปฏิเสธการรับ</option>
          <option value="DAMAGED">สินค้าเสียหาย</option>
          <option value="COD_REJECTED">ปฏิเสธจ่าย COD</option>
          <option value="RIDER_STUCK">ไรเดอร์ค้างงาน — แอดมินจัดการ</option>
          <option value="OTHER">อื่นๆ</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-400 mb-2">บันทึกเพิ่มเติม</label>
        <input type="text" name="fail_note" placeholder="รายละเอียด..." class="w-full bg-slate-800 border border-slate-700/80 rounded-xl px-4 py-3 text-white text-sm focus:border-red-500 outline-none transition-colors">
      </div>
      <div class="flex gap-3 pt-4 border-t border-white/5">
        <button type="button" onclick="document.getElementById('failModal').style.display='none'" class="flex-1 py-3 px-4 rounded-xl bg-slate-800 text-slate-300 font-bold hover:bg-slate-700 transition">ยกเลิก</button>
        <button type="submit" class="flex-1 py-3 px-4 rounded-xl bg-red-500/20 text-red-400 border border-red-500/30 font-bold hover:bg-red-500/30 transition">❌ ยืนยันไม่สำเร็จ</button>
      </div>
    </form>
  </div>
</div>
