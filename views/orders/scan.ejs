<%#
  views/orders/scan.ejs — Quick Scan Mode
  Data: recentScans[], user
%>
<%
  const STATUS_LABELS = {
    'NEW':'ใหม่','RECEIVED_WH_TH':'รับคลังไทย','RECEIVED_WH_LA':'รับคลังลาว',
    'ON_TRUCK':'ขึ้นรถ','CROSSING_BORDER':'ข้ามแดน','CUSTOMS_HOLD':'รอศุลกากร',
    'CUSTOMS_CLEARED':'ผ่านศุลกากร','ARRIVED_BORDER_WH':'ถึงด่าน','AT_DEST_WH':'คลังปลายทาง',
    'OUT_FOR_DELIVERY':'กำลังส่ง','DELIVERED':'ส่งสำเร็จ','DELIVERY_FAILED':'ส่งไม่สำเร็จ',
    'COD_COLLECTED':'เก็บ COD','COD_REMITTED':'โอน COD','CLOSED':'ปิดงาน',
    'BRANCH_TRANSFER':'ส่งต่อสาขา','BRANCH_RECEIVED':'สาขารับ','RIDER_ASSIGNED':'มอบหมายไรเดอร์',
    'RETURN_TO_SENDER':'คืนผู้ส่ง','CUSTOMS_REJECTED':'ศุลกากรปฏิเสธ',
  };
  const STATUS_COLORS = {
    'NEW':'bg-slate-500/15 text-slate-300 border-slate-500/20',
    'RECEIVED_WH_TH':'bg-blue-500/15 text-blue-300 border-blue-500/20',
    'RECEIVED_WH_LA':'bg-blue-500/15 text-blue-300 border-blue-500/20',
    'ON_TRUCK':'bg-indigo-500/15 text-indigo-300 border-indigo-500/20',
    'CROSSING_BORDER':'bg-purple-500/15 text-purple-300 border-purple-500/20',
    'CUSTOMS_HOLD':'bg-amber-500/15 text-amber-300 border-amber-500/20',
    'AT_DEST_WH':'bg-teal-500/15 text-teal-300 border-teal-500/20',
    'OUT_FOR_DELIVERY':'bg-cyan-500/15 text-cyan-300 border-cyan-500/20',
    'DELIVERED':'bg-emerald-500/15 text-emerald-300 border-emerald-500/20',
    'DELIVERY_FAILED':'bg-red-500/15 text-red-300 border-red-500/20',
    'CLOSED':'bg-slate-600/15 text-slate-400 border-slate-600/20',
  };
%>

<div class="max-w-3xl mx-auto space-y-5" 
     x-data="quickScanApp()" 
     x-init="init()"
     @keydown.window="handleGlobalKeydown($event)">

  <%# Header %>
  <div class="flex items-center gap-3">
    <a href="/scanner" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all">
      <i class="fa-solid fa-arrow-left text-sm"></i>
    </a>
    <div class="flex-1">
      <h2 class="text-xl font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-bolt text-cyan-400"></i> สแกนด่วน
      </h2>
      <p class="text-slate-400 text-xs mt-0.5">สแกน Job No. เพื่อดูสถานะ หรืออัปเดตทันที</p>
    </div>
  </div>

  <%# Scan Input %>
  <div class="glass-panel-dark rounded-2xl p-5 border border-white/8">
    <div class="relative">
      <i class="fa-solid fa-barcode absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-xl"></i>
      <input type="text"
        x-ref="scanInput"
        x-model="query"
        @keydown.enter.prevent="scan()"
        :disabled="loading"
        class="w-full pl-14 pr-28 py-4 rounded-xl bg-white/5 border-2 border-cyan-500/40 text-white text-lg font-mono placeholder-slate-600 focus:outline-none focus:border-cyan-400/70 transition-all"
        placeholder="SNG-YYMMDD-XXXX"
        autocomplete="off" autofocus>
      <button @click="scan()" :disabled="loading || !query.trim()"
        class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-2.5 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 text-white text-sm font-semibold disabled:opacity-40 transition-all">
        <template x-if="loading"><i class="fa-solid fa-spinner fa-spin"></i></template>
        <template x-if="!loading"><span><i class="fa-solid fa-search mr-1"></i>สแกน</span></template>
      </button>
    </div>
    <div x-show="scanError" x-cloak class="mt-3 flex items-center gap-2 p-3 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm">
      <i class="fa-solid fa-circle-xmark"></i>
      <span x-text="scanError"></span>
    </div>

    <div class="mt-4 flex flex-col sm:flex-row gap-3">
      <button @click="toggleCamera()" type="button"
        class="flex-1 px-4 py-3 rounded-xl border border-white/10 hover:bg-white/5 text-slate-300 font-semibold text-sm transition-all flex items-center justify-center gap-2">
        <i class="fa-solid fa-camera text-slate-400"></i>
        <span x-text="cameraActive ? 'ปิดกล้องสแกน' : 'สแกนด้วยกล้องมือถือ'"></span>
      </button>
    </div>

    <%# Camera Reader Container %>
    <div x-show="cameraActive" x-collapse class="mt-4">
      <div class="p-2 bg-black rounded-xl overflow-hidden border border-white/10 relative">
        <div id="qr-reader" class="w-full"></div>
        <div class="absolute inset-0 border-2 border-cyan-500/50 rounded-xl pointer-events-none animate-pulse" x-show="cameraActive"></div>
      </div>
    </div>
  </div>

  <audio id="beep-sound" preload="auto">
    <source src="data:audio/mp3;base64," type="audio/mpeg">
  </audio>

  <%# ── Order Result Card ──────────────────────────────────────────────────── %>
  <div x-show="order" x-cloak
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       class="glass-panel-dark rounded-2xl overflow-hidden border border-cyan-500/20">

    <%# Header %>
    <div class="flex items-center justify-between px-5 py-4 border-b border-white/6 bg-cyan-500/5">
      <div>
        <div class="font-mono font-black text-white text-xl" x-text="order?.job_no"></div>
        <div class="text-slate-400 text-xs mt-0.5" x-text="order?.direction === 'TH_TO_LA' ? '🇹🇭 ไทย → ลาว 🇱🇦' : '🇱🇦 ลาว → ไทย 🇹🇭'"></div>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-3 py-1.5 rounded-lg text-xs font-bold border"
            :class="statusColor(order?.status)"
            x-text="statusTH(order?.status)"></span>
      </div>
    </div>

    <%# Info Grid %>
    <div class="px-5 py-4 grid grid-cols-2 sm:grid-cols-4 gap-4 border-b border-white/5">
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ผู้ส่ง</div>
        <div class="text-white font-semibold text-sm" x-text="order?.sender_name || '–'"></div>
        <div class="text-slate-500 text-xs" x-text="order?.sender_phone || ''"></div>
      </div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ผู้รับ</div>
        <div class="text-white font-semibold text-sm" x-text="order?.receiver_name || '–'"></div>
        <div class="text-slate-500 text-xs" x-text="order?.receiver_phone || ''"></div>
      </div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">น้ำหนัก</div>
        <div class="text-white font-semibold text-sm" x-text="order?.declared_weight ? order.declared_weight + ' กก.' : '–'"></div>
        <div x-show="order?.actual_weight" class="text-amber-400 text-xs" x-text="'จริง: ' + order?.actual_weight + ' กก.'"></div>
      </div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ค่าขนส่ง / COD</div>
        <div class="text-emerald-400 font-bold text-sm" x-text="'฿' + Number(order?.price_amount || 0).toLocaleString()"></div>
        <div x-show="order?.cod_amount > 0" class="text-amber-400 text-xs font-bold" x-text="'COD ฿' + Number(order?.cod_amount).toLocaleString()"></div>
      </div>
    </div>

    <%# Tags row %>
    <div class="px-5 py-3 border-b border-white/5 flex flex-wrap gap-2">
      <template x-if="order?.source_type">
        <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">
          <i class="fa-solid fa-tag mr-1 text-slate-500"></i><span x-text="order?.source_type"></span>
        </span>
      </template>
      <template x-if="order?.is_fragile">
        <span class="text-[10px] px-2 py-0.5 rounded bg-red-500/10 border border-red-500/20 text-red-300">
          <i class="fa-solid fa-wine-glass-crack mr-1"></i>FRAGILE
        </span>
      </template>
      <template x-if="order?.requires_customs">
        <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/20 text-amber-300">
          <i class="fa-solid fa-stamp mr-1"></i>ศุลกากร
        </span>
      </template>
      <template x-if="order?.screening_status">
        <span class="text-[10px] px-2 py-0.5 rounded border"
              :class="order?.screening_status === 'PASSED' ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-300'
                     : order?.screening_status === 'REJECTED' ? 'bg-red-500/10 border-red-500/20 text-red-300'
                     : 'bg-slate-500/10 border-slate-500/20 text-slate-300'">
          <i class="fa-solid fa-shield mr-1"></i>คัดกรอง: <span x-text="order?.screening_status"></span>
        </span>
      </template>
      <template x-if="order?.sticker_printed_at">
        <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-300">
          <i class="fa-solid fa-print mr-1"></i>พิมพ์แล้ว
        </span>
      </template>
      <template x-if="order?.item_description">
        <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300 max-w-xs truncate">
          <i class="fa-solid fa-box-open mr-1 text-slate-500"></i><span x-text="order?.item_description?.substring(0,50)"></span>
        </span>
      </template>
    </div>

    <%# Action Buttons %>
    <div class="px-5 py-4 space-y-3">
      <div class="text-[10px] text-slate-500 uppercase font-bold mb-2">การดำเนินการ</div>
      <div class="flex flex-wrap gap-2">
        <a :href="'/orders/' + order?.id"
           class="px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white text-xs font-semibold transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-eye"></i> ดูรายละเอียด
        </a>
        <a :href="'/orders/' + order?.id + '/sticker'" target="_blank"
           class="px-3 py-2 rounded-lg bg-purple-500/10 border border-purple-500/20 text-purple-300 hover:bg-purple-500/20 text-xs font-semibold transition-all flex items-center gap-1.5">
          <i class="fa-solid fa-print"></i> พิมพ์สติ๊กเกอร์
        </a>
        <template x-for="ns in nextStatuses" :key="ns.value">
          <button @click="updateStatus(ns.value)"
            :disabled="updating"
            class="px-3 py-2 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 disabled:opacity-40"
            :class="ns.color">
            <i :class="ns.icon"></i>
            <span x-text="ns.label"></span>
          </button>
        </template>
      </div>
    </div>
  </div>

  <%# ── Recent Activity ──────────────────────────────────────────────────── %>
  <div class="glass-panel-dark rounded-2xl overflow-hidden border border-white/8">
    <div class="flex items-center justify-between px-5 py-4 border-b border-white/6">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-clock-rotate-left text-slate-400"></i> ล่าสุด
      </h3>
    </div>
    <% if (recentScans && recentScans.length > 0) { %>
    <div class="divide-y divide-white/5 max-h-72 overflow-y-auto">
      <% recentScans.forEach(s => { %>
      <button onclick="quickLoad('<%= s.job_no %>')"
        class="w-full flex items-center justify-between px-5 py-3 hover:bg-white/5 transition-colors text-left group">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
            <i class="fa-solid fa-box text-slate-500 text-xs"></i>
          </div>
          <div>
            <div class="font-mono font-bold text-white text-sm"><%= s.job_no %></div>
            <div class="text-slate-500 text-[11px]"><%= s.sender_name %> → <%= s.receiver_name %></div>
          </div>
        </div>
        <span class="text-[10px] px-2 py-0.5 rounded border
          <%= STATUS_COLORS[s.status] || 'bg-slate-500/15 text-slate-300 border-slate-500/20' %>">
          <%= STATUS_LABELS[s.status] || s.status %>
        </span>
      </button>
      <% }); %>
    </div>
    <% } else { %>
    <div class="px-5 py-8 text-center text-slate-600 text-sm">ไม่มีข้อมูล</div>
    <% } %>
  </div>

  <%# Toast %>
  <div x-show="toast" x-cloak x-transition
       :class="toast?.type === 'error' ? 'bg-red-500/20 border-red-500/40 text-red-300' : 'bg-emerald-500/20 border-emerald-500/40 text-emerald-300'"
       class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-5 py-3 rounded-2xl border font-semibold shadow-xl backdrop-blur-lg text-sm">
    <i class="fa-solid" :class="toast?.type === 'error' ? 'fa-circle-xmark' : 'fa-circle-check'"></i>
    <span x-text="toast?.msg"></span>
  </div>

</div>

<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
const CSRF_TOKEN = '<%= csrfToken %>';
const STATUS_TH_MAP = <%- JSON.stringify(STATUS_LABELS) %>;
const STATUS_COLOR_MAP = <%- JSON.stringify(STATUS_COLORS) %>;

const TRANSITION_MAP = {
  'NEW':              [{ value:'RECEIVED_WH_TH', label:'รับเข้าคลังไทย', icon:'fa-solid fa-warehouse', color:'bg-blue-500/15 border border-blue-500/25 text-blue-300 hover:bg-blue-500/25' },
                       { value:'RECEIVED_WH_LA', label:'รับเข้าคลังลาว', icon:'fa-solid fa-warehouse', color:'bg-blue-500/15 border border-blue-500/25 text-blue-300 hover:bg-blue-500/25' }],
  'RECEIVED_WH_TH':  [{ value:'ON_TRUCK', label:'ขึ้นรถ', icon:'fa-solid fa-truck', color:'bg-indigo-500/15 border border-indigo-500/25 text-indigo-300 hover:bg-indigo-500/25' }],
  'RECEIVED_WH_LA':  [{ value:'ON_TRUCK', label:'ขึ้นรถ', icon:'fa-solid fa-truck', color:'bg-indigo-500/15 border border-indigo-500/25 text-indigo-300 hover:bg-indigo-500/25' }],
  'ON_TRUCK':         [{ value:'CROSSING_BORDER', label:'ข้ามแดน', icon:'fa-solid fa-road', color:'bg-purple-500/15 border border-purple-500/25 text-purple-300 hover:bg-purple-500/25' }],
  'CROSSING_BORDER':  [{ value:'ARRIVED_BORDER_WH', label:'ถึงด่าน', icon:'fa-solid fa-flag-checkered', color:'bg-teal-500/15 border border-teal-500/25 text-teal-300 hover:bg-teal-500/25' },
                       { value:'CUSTOMS_HOLD', label:'ติดศุลกากร', icon:'fa-solid fa-gavel', color:'bg-amber-500/15 border border-amber-500/25 text-amber-300 hover:bg-amber-500/25' }],
  'ARRIVED_BORDER_WH':[{ value:'AT_DEST_WH', label:'ถึงคลังปลายทาง', icon:'fa-solid fa-building', color:'bg-teal-500/15 border border-teal-500/25 text-teal-300 hover:bg-teal-500/25' }],
  'AT_DEST_WH':       [{ value:'OUT_FOR_DELIVERY', label:'ออกจัดส่ง', icon:'fa-solid fa-motorcycle', color:'bg-cyan-500/15 border border-cyan-500/25 text-cyan-300 hover:bg-cyan-500/25' }],
  'OUT_FOR_DELIVERY': [{ value:'DELIVERED', label:'ส่งสำเร็จ', icon:'fa-solid fa-check-double', color:'bg-emerald-500/15 border border-emerald-500/25 text-emerald-300 hover:bg-emerald-500/25' },
                       { value:'DELIVERY_FAILED', label:'ส่งไม่สำเร็จ', icon:'fa-solid fa-xmark', color:'bg-red-500/15 border border-red-500/25 text-red-300 hover:bg-red-500/25' }],
};

function quickLoad(jobNo) {
  const el = document.querySelector('[x-ref="scanInput"]');
  if (el && el._x_dataStack) {
    const data = el._x_dataStack[0];
    data.query = jobNo;
    data.scan();
  }
}

function quickScanApp() {
  return {
    query: '',
    order: null,
    loading: false,
    updating: false,
    scanError: null,
    cameraActive: false,
    html5QrcodeScanner: null,
    barcodeBuffer: '',
    lastKeyTime: 0,

    get nextStatuses() {
      if (!this.order) return [];
      return TRANSITION_MAP[this.order.status] || [];
    },

    statusTH(s) { return STATUS_TH_MAP[s] || s || '–'; },
    statusColor(s) { return STATUS_COLOR_MAP[s] || 'bg-slate-500/15 text-slate-300 border-slate-500/20'; },

    init() {
      this.$nextTick(() => this.$refs.scanInput?.focus());
    },

    handleGlobalKeydown(e) {
      // Ignore if typing in an input other than our scanInput
      if (e.target.tagName === 'INPUT' && e.target !== this.$refs.scanInput && e.target.type !== 'radio' && e.target.type !== 'checkbox') return;
      if (e.target.tagName === 'TEXTAREA') return;

      const currentTime = new Date().getTime();
      
      // If time since last key is > 50ms, reset buffer (human typing is slower)
      if (currentTime - this.lastKeyTime > 50) {
        this.barcodeBuffer = '';
      }
      this.lastKeyTime = currentTime;

      // Enter key marks end of scan
      if (e.key === 'Enter') {
        if (this.barcodeBuffer.length > 3) {
          e.preventDefault();
          this.query = this.barcodeBuffer;
          this.barcodeBuffer = '';
          this.scan();
        }
        return;
      }

      // Append printable characters to buffer
      if (e.key.length === 1 && !e.ctrlKey && !e.altKey && !e.metaKey) {
        this.barcodeBuffer += e.key;
      }
    },

    toggleCamera() {
      if (this.cameraActive) {
        this.stopCamera();
      } else {
        this.startCamera();
      }
    },

    startCamera() {
      this.cameraActive = true;
      this.$nextTick(() => {
        if (!this.html5QrcodeScanner) {
          this.html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: { width: 300, height: 150 }, supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA] }, false);
        }
        this.html5QrcodeScanner.render((decodedText, decodedResult) => {
          // Success Callback
          const beep = document.getElementById('beep-sound');
          if (beep) beep.play().catch(()=>{});
          
          this.stopCamera();
          this.query = decodedText;
          this.scan();
        }, (err) => {
          // Ignore frequent errors during scan
        });
      });
    },

    stopCamera() {
      this.cameraActive = false;
      if (this.html5QrcodeScanner) {
        this.html5QrcodeScanner.clear().catch(err => console.error("Failed to clear scanner", err));
      }
    },

    async scan() {
      const q = this.query.trim();
      if (!q) return;
      this.loading = true;
      this.scanError = null;
      this.order = null;
      try {
        const res = await fetch('/scanner/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify({ barcode: q }),
        });
        const data = await res.json();
        if (data.success) {
          this.order = data.order;
        } else {
          this.scanError = data.message || 'ไม่พบพัสดุ';
        }
      } catch {
        this.scanError = 'เกิดข้อผิดพลาดในการเชื่อมต่อ';
      } finally {
        this.loading = false;
      }
    },

    async updateStatus(newStatus) {
      if (!this.order || this.updating) return;
      this.updating = true;
      try {
        const res = await fetch(`/scanner/update/${this.order.id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify({ status: newStatus }),
        });
        const data = await res.json();
        if (data.success) {
          this.showToast({ type: 'ok', msg: '✅ ' + this.order.job_no + ' → ' + this.statusTH(newStatus) });
          setTimeout(() => this.scan(), 800);
        } else {
          this.showToast({ type: 'error', msg: data.message });
        }
      } catch {
        this.showToast({ type: 'error', msg: 'เกิดข้อผิดพลาด' });
      } finally {
        this.updating = false;
      }
    },

    showToast(t) {
      this.toast = t;
      setTimeout(() => { this.toast = null; }, 3500);
    },
  };
}
</script>