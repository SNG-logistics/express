<!DOCTYPE html>
<html lang="lo">
<head>
    <meta charset="utf-8">
    <title>SNG Waybill A4 <%= order.job_no %></title>
    <!-- Fonts: Sarabun, Prompt, Noto Sans Lao -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { font-family: 'Prompt', 'Noto Sans Lao', sans-serif; background-color: #f1f5f9; color: #0f172a; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .a4-page { width: 210mm; min-height: 297mm; background: white; padding: 15mm; box-shadow: 0 10px 25px rgba(0,0,0,0.1); position: relative; margin: 0 auto; }
        @media print {
            @page { size: A4 portrait; margin: 0; }
            body { background: white; padding: 0; display: block; }
            .a4-page { width: 100%; height: 100%; min-height: 100vh; box-shadow: none; padding: 15mm; page-break-after: always; }
            .no-print { display: none !important; }
        }
        .barcode-bar { height: 60px; width: 100%; }
        /* To ensure printing background colors */
        * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    </style>
</head>
<body>

    <!-- Floating Tools -->
    <div class="fixed top-6 right-6 no-print z-50 flex flex-col gap-3">
        <button onclick="window.print()" class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-xl shadow-lg font-bold flex items-center justify-center gap-2 transition-all">
            <i class="fa-solid fa-print"></i> ພິມ (Print A4)
        </button>
        <button onclick="window.close()" class="bg-gray-800 hover:bg-gray-900 text-white px-6 py-3 rounded-xl shadow-lg font-bold flex items-center justify-center gap-2 transition-all">
            <i class="fa-solid fa-xmark"></i> ປິດ (Close)
        </button>
    </div>

    <!-- The A4 Waybill Paper -->
    <div class="a4-page flex flex-col">

        <!-- Header -->
        <div class="flex justify-between items-start border-b-2 border-red-600 pb-2 mb-3">
            <div class="flex items-center gap-3">
                <div class="w-16 h-16 flex-shrink-0 rounded-xl overflow-hidden border-2 border-gray-100 shadow-sm">
                    <img src="/images/snglogo.png" alt="SNG Logo" class="w-full h-full object-cover">
                </div>
                <div>
                    <h1 class="font-black text-3xl tracking-tight text-red-600 uppercase">SNG EXPRESS</h1>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mt-0.5">Waybill / ໃບບິນຂົນສົ່ງສິນຄ້າ</p>
                    <p class="text-[10px] text-gray-400 mt-0.5">Line: @snglogistics | Tel: 020 5555 5555</p>
                </div>
            </div>
            <div class="text-right flex flex-col items-end">
                <div class="bg-red-50 text-red-600 font-black text-2xl px-3 py-1.5 rounded-lg border-2 border-red-200 mb-1">
                    <%= order.direction === 'TH_TO_LA' ? 'TH 🇹🇭 ➔ LA 🇱🇦' : 'LA 🇱🇦 ➔ TH 🇹🇭' %>
                </div>
                <div class="text-xs text-gray-500 font-medium">
                    ວັນທີ: <%= new Date(order.created_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </div>
            </div>
        </div>

        <!-- Job No & Barcode Area -->
        <div class="flex justify-between items-center bg-gray-50 p-4 rounded-xl border-2 border-gray-200 mb-4">
            <div>
                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest mb-1">Tracking Number / ເລກພັດສະດຸ</p>
                <h2 class="text-4xl font-black tracking-widest font-mono text-black"><%= order.job_no %></h2>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-56 text-center bg-white p-2 rounded-lg border border-gray-200 shadow-sm">
                    <svg id="barcode" class="w-full h-12"></svg>
                    <p class="text-[9px] text-gray-400 font-medium tracking-widest uppercase mt-0.5">Scan to Track</p>
                </div>
                <div class="bg-white p-1.5 rounded-lg border border-gray-200 shadow-sm flex flex-col items-center">
                    <div id="qrcode"></div>
                    <p class="text-[7px] text-gray-400 font-medium tracking-widest uppercase mt-0.5">QR</p>
                </div>
            </div>
        </div>

        <!-- Sender / Receiver (Side by Side for A4) -->
        <div class="grid grid-cols-2 gap-4 mb-4">
            <!-- Sender -->
            <div class="border-2 border-gray-200 rounded-xl overflow-hidden flex flex-col">
                <div class="bg-gray-100 px-3 py-1.5 border-b-2 border-gray-200 flex items-center gap-2">
                    <i class="fa-solid fa-box-open text-gray-500 text-sm"></i>
                    <span class="text-xs font-bold text-gray-700 uppercase tracking-widest">ຜູ້ສົ່ງ (Sender) / FROM</span>
                </div>
                <div class="p-3 flex-grow bg-white">
                    <div class="text-xl font-bold text-black mb-1"><%= order.sender_name || 'N/A' %></div>
                    <div class="flex items-center gap-2 text-base text-gray-700 font-medium mb-1">
                        <i class="fa-solid fa-phone text-xs bg-gray-200 p-1.5 rounded-full"></i>
                        <%= order.sender_phone || '-' %>
                    </div>
                </div>
            </div>

            <!-- Receiver -->
            <div class="border-2 border-red-600 rounded-xl overflow-hidden flex flex-col shadow-sm">
                <div class="bg-red-50 px-3 py-1.5 border-b-2 border-red-200 flex items-center gap-2">
                    <i class="fa-solid fa-location-dot text-red-500 text-sm"></i>
                    <span class="text-xs font-bold text-red-700 uppercase tracking-widest">ຜູ້ຮັບ (Receiver) / TO</span>
                </div>
                <div class="p-3 flex-grow bg-white">
                    <div class="text-xl font-bold text-black mb-1"><%= order.receiver_name || 'N/A' %></div>
                    <div class="text-sm text-gray-700 mb-2 leading-snug">
                        <%= order.receiver_address || '-' %>
                        <br>
                        <% if (order.receiver_province) { %>
                            <span class="inline-block mt-1 bg-red-100 text-red-800 font-bold px-2 py-0.5 rounded border border-red-200 text-xs">
                                <%= order.receiver_province %>
                            </span>
                        <% } %>
                    </div>
                    <div class="flex items-center gap-2 text-lg font-bold text-red-600 pt-2 border-t border-gray-100 mt-auto">
                        <i class="fa-solid fa-phone text-xs bg-red-100 p-1.5 rounded-full"></i>
                        <%= order.receiver_phone || '-' %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Package Details Table -->
        <div class="mb-4 rounded-xl border-2 border-gray-200 overflow-hidden">
            <div class="bg-gray-800 text-white px-4 py-2 text-xs font-bold uppercase tracking-widest">
                ລາຍລະອຽດພັດສະດຸ / Package Details
            </div>
            <div class="grid grid-cols-4 divide-x-2 divide-gray-200 bg-white border-b-2 border-gray-200 text-center">
                <div class="p-2">
                    <div class="text-[10px] text-gray-500 font-bold uppercase mb-0.5">Service / ບໍລິການ</div>
                    <div class="text-base font-black text-black"><%= order.service_type || 'General' %></div>
                </div>
                <div class="p-2">
                    <div class="text-[10px] text-gray-500 font-bold uppercase mb-0.5">Weight / ນ້ຳໜັກ</div>
                    <div class="text-base font-black text-black"><%= order.actual_weight || order.declared_weight || '-' %> kg</div>
                </div>
                <div class="p-2">
                    <div class="text-[10px] text-gray-500 font-bold uppercase mb-0.5">Size / ຂະໜາດ</div>
                    <div class="text-base font-black text-black"><%= order.actual_size || order.declared_size || '-' %></div>
                </div>
                <div class="p-2">
                    <div class="text-[10px] text-gray-500 font-bold uppercase mb-0.5">Qty / ຈຳນວນ</div>
                    <div class="text-base font-black text-black"><%= order.item_count || '1' %> </div>
                </div>
            </div>
            <div class="p-3 bg-gray-50">
                <div class="text-[10px] text-gray-500 font-bold uppercase mb-1">Description / ລາຍລະອຽດສິນຄ້າ:</div>
                <div class="text-sm font-medium text-gray-800"><%= order.item_description || 'ບໍ່ໄດ້ລະບຸ / Not specified' %></div>
            </div>
        </div>

        <!-- Financial & Flags Side-by-Side -->
        <div class="grid grid-cols-5 gap-4 mb-4">
            <!-- Flags & Info -->
            <div class="col-span-2 flex flex-col gap-3">
                <div class="bg-white border-2 border-gray-200 rounded-xl p-3 flex-grow">
                    <div class="text-[10px] text-gray-500 font-bold uppercase mb-2">Special Instructions</div>
                    <div class="flex flex-wrap gap-2">
                        <% if (order.requires_customs) { %>
                            <div class="bg-gray-800 text-white font-bold px-2 py-1 rounded text-[11px] flex items-center gap-1">
                                <i class="fa-solid fa-file-invoice"></i> ເອກະສານພາສີ (Customs)
                            </div>
                        <% } %>
                        <% if (order.is_fragile) { %>
                            <div class="bg-red-600 text-white font-bold px-2 py-1 rounded text-[11px] flex items-center gap-1">
                                <i class="fa-solid fa-wine-glass"></i> ລະວັງແຕກ (Fragile)
                            </div>
                        <% } %>
                        <% if (!order.requires_customs && !order.is_fragile) { %>
                            <div class="text-gray-400 font-medium text-xs italic">ບໍ່ມີ (None)</div>
                        <% } %>
                    </div>
                </div>
                
                <% if (order.payment_method === 'DESTINATION') { %>
                    <div class="bg-red-50 border-2 border-red-200 rounded-xl p-3 text-center">
                        <div class="text-red-600 font-black text-base">ຄ່າຂົນສົ່ງປາຍທາງ</div>
                        <div class="text-red-500 text-[10px] font-bold uppercase mt-0.5">Pay at Destination</div>
                    </div>
                <% } else { %>
                    <div class="bg-green-50 border-2 border-green-200 rounded-xl p-3 text-center">
                        <div class="text-green-600 font-black text-base">ຈ່າຍແລ້ວ ຈາກຕົ້ນທາງ</div>
                        <div class="text-green-500 text-[10px] font-bold uppercase mt-0.5">Paid at Origin</div>
                    </div>
                <% } %>
            </div>

            <!-- Financial Summary -->
            <div class="col-span-3 border-2 border-gray-800 rounded-xl overflow-hidden flex flex-col">
                <div class="bg-gray-800 text-white px-4 py-1.5 flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-widest">ຄ່າບໍລິການ (Charges)</span>
                    <i class="fa-solid fa-money-bill-wave text-sm"></i>
                </div>
                <div class="p-4 flex-grow flex flex-col justify-center gap-2 bg-white">
                    <div class="flex justify-between items-end border-b border-gray-100 pb-1.5">
                        <span class="text-gray-500 font-bold uppercase text-xs">Delivery Fee (ຄ່າຈັດສົ່ງ)</span>
                        <span class="text-lg font-bold">₭ <%= Number((order.price_amount || 0) * (typeof exchangeRate !== 'undefined' ? exchangeRate : 700)).toLocaleString() %></span>
                    </div>
                    <% if (order.customs && order.customs.amount > 0) { %>
                    <div class="flex justify-between items-end border-b border-gray-100 pb-1.5">
                        <span class="text-gray-500 font-bold uppercase text-xs">Customs (ຄ່າພາສີ)</span>
                        <span class="text-lg font-bold">₭ <%= Number((order.customs.amount) * (typeof exchangeRate !== 'undefined' ? exchangeRate : 700)).toLocaleString() %></span>
                    </div>
                    <% } %>
                    
                    <!-- COD Box inside charges if applicable -->
                    <% if (order.cod_amount > 0) { %>
                    <div class="mt-1 bg-red-50 border-2 border-red-600 p-3 rounded-lg flex justify-between items-center">
                        <div>
                            <div class="text-red-600 font-black text-lg uppercase tracking-widest">COD</div>
                            <div class="text-red-500 text-[9px] font-bold">ຍອດເກັບເງິນປາຍທາງ</div>
                        </div>
                        <div class="text-2xl font-black text-red-600">
                            ₭ <%= Number(order.cod_amount).toLocaleString() %>
                        </div>
                    </div>
                    <% } else { %>
                    <div class="mt-1 flex justify-between items-end pt-1">
                        <span class="text-gray-800 font-black uppercase text-base">Total</span>
                        <span class="text-2xl font-black text-black">₭ <%= Number(((order.price_amount || 0) + (order.customs?.amount || 0)) * (typeof exchangeRate !== 'undefined' ? exchangeRate : 700)).toLocaleString() %></span>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Signatures & Footer -->
        <div class="border-t-2 border-gray-200 pt-4 mt-auto">
            <div class="grid grid-cols-3 gap-6 mb-4">
                <div class="text-center">
                    <div class="border-b border-gray-400 h-10 mb-1"></div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase">ຜູ້ສົ່ງ (Sender Signature)</div>
                </div>
                <div class="text-center">
                    <div class="border-b border-gray-400 h-10 mb-1"></div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase">ຜູ້ຮັບ (Receiver Signature)</div>
                </div>
                <div class="text-center">
                    <div class="border-b border-gray-400 h-10 mb-1"></div>
                    <div class="text-[10px] text-gray-500 font-bold uppercase">ພະນັກງານ (Staff Signature)</div>
                </div>
            </div>
            
            <div class="text-center bg-gray-50 rounded-lg p-2 border border-gray-200">
                <p class="font-bold text-red-600 text-[11px] mb-0.5">ໝາຍເຫດ: ຮັບສິນຄ້າພາຍໃນ 1 ເດືອນ ຫາກບໍ່ມາຮັບພາຍໃນກຳນົດທາງເຮົາຈະບໍ່ຮັບຜິດຊອບ</p>
                <p class="text-[9px] text-gray-500">Note: Please collect package within 1 month. We are not responsible for uncollected items beyond this period.</p>
                <p class="text-[8px] text-gray-400 mt-1">Printed: <%= new Date().toLocaleString('th-TH') %> | SNG Logistics Company Limited</p>
            </div>
        </div>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        JsBarcode("#barcode", "<%= order.job_no %>", {
            format: "CODE128",
            width: 2.5,
            height: 60,
            displayValue: false,
            margin: 0,
            background: "transparent",
            lineColor: "#000"
        });

        new QRCode(document.getElementById("qrcode"), {
            text: "https://sng-logistic.co/track/<%= order.job_no %>",
            width: 50,
            height: 50,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
        });
    </script>
</body>
</html>