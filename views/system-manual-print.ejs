<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  
  <style>
    body {
      font-family: 'Prompt', sans-serif;
      background: white;
      color: black;
      font-size: 11pt;
      line-height: 1.5;
    }
    
    .print-container {
      max-width: 210mm; /* A4 width */
      margin: 0 auto;
      padding: 2cm;
    }
    
    /* Make all sections visible during print */
    .print-section {
      display: block;
      page-break-inside: avoid;
      margin-top: 2rem;
      margin-bottom: 2rem;
    }
    
    .print-section h2 {
      border-bottom: 2px solid #e5e7eb;
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
    }

    .border-l-4 {
      border-left-width: 4px;
      padding: 1rem;
      margin-bottom: 1rem;
      background-color: #f9fafb;
      border-color: #cbd5e1;
    }
    
    @media print {
      body { margin: 0; padding: 0; }
      .print-container { width: 100%; max-width: none; padding: 0; }
      .no-print { display: none !important; }
      @page { margin: 1.5cm; }
    }
  </style>
</head>
<body class="bg-white">

  <!-- Print Control Header (Only visible on screen) -->
  <div class="no-print bg-slate-900 text-white p-4 flex justify-between items-center fixed top-0 left-0 right-0 z-50 shadow-lg">
    <div class="flex items-center gap-3">
      <a href="/system-manual" class="text-slate-400 hover:text-white transition-colors">
        <i class="fa-solid fa-arrow-left"></i> กลับ
      </a>
      <h1 class="font-bold text-lg"><i class="fa-solid fa-file-pdf text-red-400"></i> โหมดพิมพ์คู่มือระบบ (Print Mode)</h1>
    </div>
    <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 px-6 py-2 rounded-lg font-bold flex items-center gap-2 transition-all">
      <i class="fa-solid fa-print"></i> พิมพ์ / Save as PDF
    </button>
  </div>

  <div class="print-container mt-16 print:mt-0">
    
    <!-- Header -->
    <div class="text-center mb-10 border-b-2 border-black pb-6">
      <h1 class="text-3xl font-black text-black">คู่มือการใช้งานระบบ SNG Logistics</h1>
      <p class="text-gray-600 mt-2">เอกสารสำหรับเตรียมความพร้อมและทดสอบระบบของทีมงานทุกแผนก</p>
    </div>

    <!-- WORKFLOW DIAGRAM -->
    <div class="print-section">
      <h2 class="text-2xl font-bold text-indigo-700 flex items-center gap-2">
        <i class="fa-solid fa-diagram-project"></i> แผนผังการทำงาน (Workflow)
      </h2>
      <p class="text-gray-700 mb-4">ภาพรวมการทำงานของระบบ SNG Express แบ่งออกเป็น 2 กระบวนการหลัก: 1) พัสดุย่อยทั่วไป 2) ร้านฝากส่งรายใหญ่</p>
      
      <div class="bg-white p-4 rounded-xl border border-gray-300">
        <div class="mermaid">
          flowchart TD
            %% Styles
            classDef normal fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0f172a;
            classDef freight fill:#f3e8ff,stroke:#7e22ce,stroke-width:2px,color:#0f172a;
            classDef finance fill:#dcfce7,stroke:#15803d,stroke-width:2px,color:#0f172a;

            %% Workflow 1: Normal Parcel
            subgraph Parcel["พัสดุย่อย (C2C / B2C)"]
              P1["สร้างออเดอร์หน้าร้าน<br/>พิมพ์บาร์โค้ด"] ::: normal --> P2["จัดรอบรถ<br/>สแกนพัสดุขึ้นรถ"] ::: normal
              P2 --> P3["รถออกเดินทาง<br/>ผ่านด่านศุลกากร"] ::: normal
              P3 --> P4["ถึงคลังลาว<br/>สแกนรับเข้า"] ::: normal
              P4 --> P5["จัดรถ Last-Mile<br/>สแกนนำส่ง"] ::: normal
              P5 --> P6["ลูกค้าเซ็นรับของ<br/>เก็บเงิน COD"] ::: normal
              P6 --> P7["คนขับส่งเงิน COD<br/>ให้ฝ่ายบัญชี"] ::: finance
            end

            %% Workflow 2: Freight Booking
            subgraph Freight["ร้านฝากส่ง (B2B Freight)"]
              F1["เพิ่มร้านค้าพาร์ทเนอร์"] ::: freight --> F2["สร้างรายการจองพื้นที่<br/>คำนวณปริมาตร/กระสอบ"] ::: freight
              F2 --> F3["ออกใบเสนอราคา<br/>Quotation"] ::: freight
              F3 --> F4["ลูกค้ายืนยัน<br/>ออกใบเรียกเก็บเงิน Invoice"] ::: finance
              F4 --> F5["บันทึกรับเงิน"] ::: finance
              F5 --> F6["โหลดสินค้าขึ้นรถ<br/>เปลี่ยนสถานะ ON_TRUCK"] ::: freight
              F6 --> F7["ส่งมอบสำเร็จ"] ::: freight
            end
        </div>
      </div>
    </div>

    <!-- FREIGHT -->
    <div class="print-section">
      <h2 class="text-2xl font-bold text-purple-700 flex items-center gap-2">
        <i class="fa-solid fa-truck-ramp-box"></i> ระบบร้านฝากส่ง (Freight Partners)
      </h2>
      <p class="text-gray-700 mb-4">กระบวนการรับฝากส่งสินค้าแบบเหมาพื้นที่ หรือแบบกระสอบสำหรับพาร์ทเนอร์</p>
      
      <div class="space-y-4">
        <div class="border-l-4 border-purple-500">
          <h3 class="font-bold text-purple-800 mb-2">ขั้นตอนที่ 1: ลงทะเบียนร้านค้า</h3>
          <ul class="list-decimal list-inside text-sm text-gray-700 space-y-2">
            <li>เข้าเมนู <strong>"ร้านฝากส่ง" -> "รายชื่อร้านค้า/Partner"</strong></li>
            <li>กดปุ่ม <strong>"เพิ่มร้านค้าใหม่"</strong> กรอกข้อมูลชื่อบริษัท, ผู้ติดต่อ, เบอร์โทรศัพท์ และที่อยู่</li>
          </ul>
        </div>
        <div class="border-l-4 border-purple-500">
          <h3 class="font-bold text-purple-800 mb-2">ขั้นตอนที่ 2: สร้างรายการจองพื้นที่ (Booking)</h3>
          <ul class="list-decimal list-inside text-sm text-gray-700 space-y-2">
            <li>เข้าเมนู <strong>"ร้านฝากส่ง" -> "สร้างการจองใหม่"</strong></li>
            <li>เลือกร้านค้าจากระบบ เลือกประเภทหน่วย (กล่อง/กระสอบ/พาเลท)</li>
            <li>ใส่ขนาด (กว้างxยาวxสูง) ระบบจะคำนวณราคาเริ่มต้นให้โดยอัตโนมัติ (แก้ไขราคาตกลงได้)</li>
            <li>เมื่อบันทึก สถานะจะเป็น <strong>"DRAFT" (รอเสนอราคา)</strong></li>
          </ul>
        </div>
        <div class="border-l-4 border-purple-500">
          <h3 class="font-bold text-purple-800 mb-2">ขั้นตอนที่ 3: ออกเอกสารการเงิน</h3>
          <ul class="list-decimal list-inside text-sm text-gray-700 space-y-2">
            <li>ในหน้าหน้ารายละเอียดการจอง กดไอคอน <strong>"ใบเสนอราคา"</strong> เพื่อพิมพ์ PDF ส่งให้ลูกค้า</li>
            <li>เมื่อลูกค้าตกลง ให้เปลี่ยนสถานะเป็น <strong>"CONFIRMED"</strong></li>
            <li>กดไอคอน <strong>"ใบเรียกเก็บเงิน (Invoice)"</strong> เพื่อออกบิลเก็บเงิน</li>
            <li>ฝ่ายบัญชีเข้ามากด <strong>"บันทึกรับเงิน"</strong> (รองรับทั้งชำระล่วงหน้า และ เครดิต)</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- WAREHOUSE -->
    <div class="print-section">
      <h2 class="text-2xl font-bold text-orange-600 flex items-center gap-2">
        <i class="fa-solid fa-warehouse"></i> พนักงานคลังสินค้า (Warehouse TH & LA)
      </h2>
      <p class="text-gray-700 mb-4">รับผิดชอบการรับสินค้าเข้าคลัง และการนำสินค้าขึ้น/ลงจากรถขนส่งด้วยระบบสแกนอัตโนมัติ</p>
      
      <div class="space-y-4">
        <div class="border-l-4 border-orange-500">
          <h3 class="font-bold text-orange-800 mb-2">1. การรับพัสดุ (คลังต้นทาง)</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>เข้าเมนู <strong>"สร้างออเดอร์"</strong> เพื่อบันทึกพัสดุ</li>
            <li>กรอกรายละเอียดผู้ส่ง-ผู้รับ และประเภทบริการ (COD / จ่ายต้นทาง)</li>
            <li>พิมพ์สติ๊กเกอร์บาร์โค้ด และแปะบนพัสดุ</li>
          </ul>
        </div>
        <div class="border-l-4 border-orange-500">
          <h3 class="font-bold text-orange-800 mb-2">2. การสแกนขึ้นรถ (Loading)</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>เข้าเมนู <strong>"สแกน (Scanner)"</strong> ผ่านมือถือหรือคอมพิวเตอร์</li>
            <li>เลือกโหมด "ขึ้นรถ (Load to Truck)"</li>
            <li>ยิงบาร์โค้ดพัสดุ สถานะจะเปลี่ยนเป็น <strong>"ON_TRUCK"</strong> ทันที พร้อมส่งเสียง "ติ๊ด!"</li>
          </ul>
        </div>
        <div class="border-l-4 border-orange-500">
          <h3 class="font-bold text-orange-800 mb-2">3. การรับของเข้าคลังปลายทาง (Unloading)</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>เปิดเมนูสแกนเนอร์ เลือกโหมด "รับเข้าคลังปลายทาง (Receive at Dest)"</li>
            <li>ยิงบาร์โค้ดตอนยกลงจากรถ สถานะจะเปลี่ยนเป็น <strong>"AT_DEST_WH"</strong></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- DISPATCHER -->
    <div class="print-section">
      <h2 class="text-2xl font-bold text-blue-600 flex items-center gap-2">
        <i class="fa-solid fa-truck-fast"></i> ฝ่ายจัดรถ (Dispatcher)
      </h2>
      
      <div class="space-y-4">
        <div class="border-l-4 border-blue-500">
          <h3 class="font-bold text-blue-800 mb-2">1. สร้างรอบรถประจำวัน (Create Trip)</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>เข้าเมนู <strong>"รอบรถขนส่ง (Trips)"</strong> กดปุ่มสร้างรอบรถ</li>
            <li>เลือกทะเบียนรถ และคนขับรถประจำวัน</li>
          </ul>
        </div>
        <div class="border-l-4 border-blue-500">
          <h3 class="font-bold text-blue-800 mb-2">2. จ่ายงาน (Dispatch)</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>มอบหมายออเดอร์เข้าไปในรถ (หรือปล่อยให้คลังสินค้าใช้ปืนสแกนยิงเข้าอัตโนมัติ)</li>
            <li>พิมพ์ <strong>ใบกำกับการขนส่ง (Manifest)</strong> ให้คนขับ</li>
            <li>กดปุ่ม "ออกรถ (Depart)"</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- DRIVER -->
    <div class="print-section">
      <h2 class="text-2xl font-bold text-teal-600 flex items-center gap-2">
        <i class="fa-solid fa-steering-wheel"></i> คนขับรถ (Driver & Last-Mile)
      </h2>
      
      <div class="space-y-4">
        <div class="border-l-4 border-teal-500">
          <h3 class="font-bold text-teal-800 mb-2">1. นำส่งพัสดุ</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>ใช้มือถือสแกนพัสดุโหมด "นำส่งลูกค้า (Deliver)"</li>
            <li>เมื่อถึงหน้าบ้านลูกค้า ใช้กล้องมือถือสแกนบาร์โค้ด เปลี่ยนสถานะเป็น <strong>"DELIVERED"</strong></li>
            <li>หากมีเก็บเงินปลายทาง ระบบจะเด้งเตือนให้เก็บเงินสด <strong>COD</strong> ทันที</li>
          </ul>
        </div>
        <div class="border-l-4 border-teal-500">
          <h3 class="font-bold text-teal-800 mb-2">2. การเบิกจ่าย</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>เข้าเมนู <strong>"บันทึกรายจ่าย"</strong> แนบรูปสลิปเติมน้ำมัน หรือค่าผ่านทาง ส่งตรงถึงฝ่ายบัญชี</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- FINANCE -->
    <div class="print-section">
      <h2 class="text-2xl font-bold text-emerald-600 flex items-center gap-2">
        <i class="fa-solid fa-coins"></i> การเงินและบัญชี (Finance)
      </h2>
      
      <div class="space-y-4">
        <div class="border-l-4 border-emerald-500">
          <h3 class="font-bold text-emerald-800 mb-2">1. เคลียร์ยอด COD (เงินสดปลายทาง)</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>เมื่อคนขับกลับมา เข้าเมนู <strong>"บัญชี COD"</strong></li>
            <li>กด <strong>"รับเงินเข้าระบบ (Remit)"</strong> เพื่อล้างหนี้คนขับ</li>
          </ul>
        </div>
        <div class="border-l-4 border-emerald-500">
          <h3 class="font-bold text-emerald-800 mb-2">2. ควบคุมงบประมาณ</h3>
          <ul class="list-disc list-inside text-sm text-gray-700 space-y-1">
            <li>รับเรื่องเบิกจ่าย (Expenses) ตรวจสอบสลิปน้ำมัน</li>
            <li>บันทึกรับเงินจากร้านฝากส่ง (Freight Invoices) ดูยอดหนี้ค้างชำระเครดิต</li>
          </ul>
        </div>
      </div>
    </div>

  </div>

  <!-- Mermaid JS for Flowchart -->
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ 
      startOnLoad: true, 
      theme: 'base',
      themeVariables: {
        fontFamily: 'Prompt, sans-serif',
        primaryColor: '#e0f2fe',
        primaryBorderColor: '#0284c7',
        primaryTextColor: '#0f172a',
      }
    });
    
    // Auto-trigger print when requested
    if (window.location.search.includes('autoPrint=true')) {
        setTimeout(() => {
            window.print();
        }, 1500); // Wait for mermaid to render
    }
  </script>
</body>
</html>
