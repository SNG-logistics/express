<%# views/crm/reports.ejs — Advanced CRM Reports with Chart.js %>
<link rel="stylesheet" href="/css/crm.css">

<%
const d = reportData || {};
const kpi = d.kpi || {};
const slaCompliance = d.sla && d.sla.total > 0
  ? Math.round((d.sla.compliant / d.sla.total) * 100)
  : null;

const caseTypeTh = {
  TRACKING_ISSUE:'ติดตามพัสดุ', DELAYED_DELIVERY:'สินค้าล่าช้า',
  CHANGE_ADDRESS:'เปลี่ยนที่อยู่', COD_ISSUE:'ปัญหา COD',
  MISSING_ITEM:'ของหาย', DAMAGED_ITEM:'สินค้าเสียหาย',
  PRODUCT_INQUIRY:'สอบถามสินค้า', PAYMENT_ISSUE:'ปัญหาชำระเงิน', OTHER:'อื่น ๆ',
};
%>

<div class="crm-page" style="height:auto;">
  <div class="crm-header">
    <div class="crm-header-icon"><i class="fa-solid fa-chart-line"></i></div>
    <h1>รายงาน CRM</h1>
    <span style="font-size:0.75rem;color:#64748b;margin-left:6px;align-self:center;">
      <%= d.start %> — <%= d.end %>
    </span>
    <div style="margin-left:auto;">
      <form method="GET" action="/crm/reports" style="display:flex;gap:8px;align-items:center;">
        <input type="date" name="start" value="<%= d.start %>"
               class="crm-search-input" style="width:140px;padding:6px 10px;">
        <span style="color:#64748b;font-size:0.8rem;">ถึง</span>
        <input type="date" name="end" value="<%= d.end %>"
               class="crm-search-input" style="width:140px;padding:6px 10px;">
        <button type="submit" class="btn-crm btn-crm-primary btn-crm-sm">
          <i class="fa-solid fa-filter"></i> กรอง
        </button>
      </form>
    </div>
  </div>

  <%- include('_subnav') %>

  <%# KPI Summary Row %>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;padding:0 24px 20px;">
    <%
    const kpiCards = [
      { icon:'fa-comments', label:'บทสนทนาทั้งหมด', value: kpi.total_conversations||0, color:'#818cf8' },
      { icon:'fa-folder-open', label:'กำลังดำเนินการ', value: kpi.open||0, color:'#34d399' },
      { icon:'fa-check-circle', label:'แก้ไขแล้ว', value: kpi.resolved||0, color:'#60a5fa' },
      { icon:'fa-clock', label:'avg ตอบแรก (นาที)', value: kpi.avg_first_response_min != null ? kpi.avg_first_response_min : '—', color:'#f59e0b' },
      { icon:'fa-stopwatch', label:'avg แก้ไข (นาที)', value: kpi.avg_resolution_min != null ? kpi.avg_resolution_min : '—', color:'#a78bfa' },
      { icon:'fa-shield-check', label:'SLA Compliance', value: slaCompliance != null ? slaCompliance+'%' : '—', color:slaCompliance >= 80 ? '#34d399' : '#f87171' },
    ];
    %>
    <% kpiCards.forEach(k => { %>
    <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.07);border-radius:14px;padding:18px 16px;display:flex;flex-direction:column;gap:6px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <i class="fa-solid <%= k.icon %>" style="color:<%= k.color %>;font-size:1rem;"></i>
        <span style="font-size:0.68rem;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.06em;"><%= k.label %></span>
      </div>
      <div style="font-size:1.8rem;font-weight:800;color:<%= k.color %>;"><%= k.value %></div>
    </div>
    <% }) %>
  </div>

  <%# Charts Row %>
  <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;padding:0 24px 20px;">

    <%# Daily Trend Chart %>
    <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.07);border-radius:14px;padding:20px;">
      <div style="font-weight:700;color:#f1f5f9;margin-bottom:14px;font-size:0.85rem;">
        <i class="fa-solid fa-chart-line" style="color:#818cf8;"></i>
        บทสนทนาต่อวัน (14 วันล่าสุด)
      </div>
      <canvas id="trendChart" height="200"></canvas>
    </div>

    <%# Channel Volume Pie %>
    <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.07);border-radius:14px;padding:20px;">
      <div style="font-weight:700;color:#f1f5f9;margin-bottom:14px;font-size:0.85rem;">
        <i class="fa-solid fa-chart-pie" style="color:#34d399;"></i>
        ช่องทางที่ใช้งาน
      </div>
      <canvas id="channelChart" height="200"></canvas>
    </div>
  </div>

  <%# Case Types + Tags Row %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:0 24px 20px;">

    <%# Case Type Bar %>
    <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.07);border-radius:14px;padding:20px;">
      <div style="font-weight:700;color:#f1f5f9;margin-bottom:14px;font-size:0.85rem;">
        <i class="fa-solid fa-ticket" style="color:#fb923c;"></i>
        ประเภทเคสที่พบบ่อย
      </div>
      <canvas id="caseTypeChart" height="220"></canvas>
    </div>

    <%# Top Tags %>
    <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.07);border-radius:14px;padding:20px;">
      <div style="font-weight:700;color:#f1f5f9;margin-bottom:14px;font-size:0.85rem;">
        <i class="fa-solid fa-tags" style="color:#a78bfa;"></i>
        แท็กที่ใช้บ่อย
      </div>
      <% if (!d.topTags || d.topTags.length === 0) { %>
      <div style="color:#64748b;font-size:0.8rem;text-align:center;padding:40px 0;">ยังไม่มีข้อมูลแท็ก</div>
      <% } else { %>
      <% d.topTags.forEach((t, i) => { %>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
        <span style="font-size:0.72rem;color:#64748b;min-width:18px;">#<%= i+1 %></span>
        <span style="width:10px;height:10px;border-radius:50%;background:<%= t.tag_color||'#818cf8' %>;flex-shrink:0;"></span>
        <span style="font-size:0.82rem;color:#f1f5f9;flex:1;"><%= t.tag_name %></span>
        <div style="background:rgba(129,140,248,0.12);border-radius:999px;height:6px;flex:2;overflow:hidden;">
          <div style="height:100%;width:<%= Math.min(100,(t.usage_count/(d.topTags[0].usage_count||1))*100) %>%;background:<%= t.tag_color||'#818cf8' %>;border-radius:999px;"></div>
        </div>
        <span style="font-size:0.72rem;font-weight:700;color:#94a3b8;min-width:24px;text-align:right;"><%= t.usage_count %></span>
      </div>
      <% }) %>
      <% } %>
    </div>
  </div>

  <%# Agent Performance Table %>
  <% if (d.agentPerf && d.agentPerf.length > 0) { %>
  <div style="padding:0 24px 40px;">
    <div style="background:#1e293b;border:1px solid rgba(255,255,255,0.07);border-radius:14px;overflow:hidden;">
      <div style="padding:16px 20px;font-weight:700;color:#f1f5f9;font-size:0.85rem;border-bottom:1px solid rgba(255,255,255,0.07);">
        <i class="fa-solid fa-users" style="color:#60a5fa;"></i>
        ประสิทธิภาพทีม
      </div>
      <table class="crm-table">
        <thead>
          <tr>
            <th>เจ้าหน้าที่</th>
            <th>บทสนทนา</th>
            <th>แก้ไขแล้ว</th>
            <th>อัตราสำเร็จ</th>
            <th>avg ตอบแรก</th>
            <th>avg แก้ไข</th>
          </tr>
        </thead>
        <tbody>
          <% d.agentPerf.forEach(a => { %>
          <%
            const rate = a.total_conversations > 0
              ? Math.round((a.resolved / a.total_conversations) * 100)
              : 0;
            const rateColor = rate >= 80 ? '#34d399' : rate >= 50 ? '#f59e0b' : '#f87171';
          %>
          <tr>
            <td style="font-weight:600;"><%= a.agent_name || '—' %></td>
            <td><%= a.total_conversations %></td>
            <td><%= a.resolved || 0 %></td>
            <td>
              <div style="display:flex;align-items:center;gap:6px;">
                <div style="background:rgba(255,255,255,0.06);border-radius:999px;height:5px;width:80px;overflow:hidden;">
                  <div style="height:100%;width:<%= rate %>%;background:<%= rateColor %>;border-radius:999px;"></div>
                </div>
                <span style="color:<%= rateColor %>;font-size:0.75rem;font-weight:700;"><%= rate %>%</span>
              </div>
            </td>
            <td style="color:#94a3b8;font-size:0.78rem;"><%= a.avg_first_response_min != null ? a.avg_first_response_min + ' นาที' : '—' %></td>
            <td style="color:#94a3b8;font-size:0.78rem;"><%= a.avg_resolution_min != null ? a.avg_resolution_min + ' นาที' : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const R = <%- reportJson || '{}' %>;

Chart.defaults.color = '#94a3b8';
Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

// 1. Daily Trend
const trendDays = (R.dailyTrend || []).map(r => r.day ? r.day.toString().slice(5) : '');
const trendTotal = (R.dailyTrend || []).map(r => Number(r.total) || 0);
const trendResolved = (R.dailyTrend || []).map(r => Number(r.resolved) || 0);

new Chart(document.getElementById('trendChart'), {
  type: 'bar',
  data: {
    labels: trendDays,
    datasets: [
      { label: 'บทสนทนาทั้งหมด', data: trendTotal, backgroundColor: 'rgba(129,140,248,0.5)', borderColor: '#818cf8', borderWidth: 1, borderRadius: 4 },
      { label: 'แก้ไขแล้ว', data: trendResolved, backgroundColor: 'rgba(52,211,153,0.4)', borderColor: '#34d399', borderWidth: 1, borderRadius: 4 },
    ]
  },
  options: { responsive:true, plugins:{ legend:{ position:'top' } }, scales:{ x:{ grid:{color:'rgba(255,255,255,0.04)'} }, y:{ beginAtZero:true, grid:{color:'rgba(255,255,255,0.04)'} } } }
});

// 2. Channel Pie
const chLabels = { FACEBOOK:'Facebook', WHATSAPP:'WhatsApp', LINE_OA:'LINE OA' };
const chData = R.channelVolume || [];
new Chart(document.getElementById('channelChart'), {
  type: 'doughnut',
  data: {
    labels: chData.map(c => chLabels[c.channel_type] || c.channel_type),
    datasets: [{
      data: chData.map(c => Number(c.total) || 0),
      backgroundColor: ['rgba(24,119,242,0.7)','rgba(37,211,102,0.7)','rgba(0,185,0,0.7)'],
      borderColor: ['#1877f2','#25d366','#00b900'], borderWidth: 2
    }]
  },
  options: { responsive:true, plugins:{ legend:{ position:'bottom' } }, cutout:'65%' }
});

// 3. Case Types Bar
const ctMap = {TRACKING_ISSUE:'ติดตามพัสดุ',DELAYED_DELIVERY:'ล่าช้า',CHANGE_ADDRESS:'เปลี่ยนที่อยู่',COD_ISSUE:'COD',MISSING_ITEM:'ของหาย',DAMAGED_ITEM:'เสียหาย',PRODUCT_INQUIRY:'สอบถามสินค้า',PAYMENT_ISSUE:'ชำระเงิน',OTHER:'อื่น ๆ'};
const ctData = R.caseTypes || [];
new Chart(document.getElementById('caseTypeChart'), {
  type: 'bar',
  data: {
    labels: ctData.map(c => ctMap[c.case_type] || c.case_type),
    datasets: [{ label: 'จำนวนเคส', data: ctData.map(c => Number(c.total)||0), backgroundColor: 'rgba(251,146,60,0.5)', borderColor:'#fb923c', borderWidth:1, borderRadius:4 }]
  },
  options: { indexAxis:'y', responsive:true, plugins:{ legend:{display:false} }, scales:{ x:{ beginAtZero:true, grid:{color:'rgba(255,255,255,0.04)'} }, y:{ grid:{color:'rgba(255,255,255,0.04)'} } } }
});
</script>
