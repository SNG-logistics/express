<%#
  views/crm/inbox.ejs — Unified Omnichannel Inbox (Redesigned UI/UX)
%>
<link rel="stylesheet" href="/css/crm.css">

<%
const statusTh   = { OPEN:'กำลังดำเนินการ', PENDING:'รอการตอบกลับ', RESOLVED:'แก้ไขแล้ว', CLOSED:'ปิดแล้ว' };
const channelIcon  = { FACEBOOK:'fa-brands fa-facebook', WHATSAPP:'fa-brands fa-whatsapp', LINE_OA:'fa-brands fa-line' };
const channelColor = { FACEBOOK:'#60a5fa', WHATSAPP:'#34d399', LINE_OA:'#4ade80' };
%>

<div class="crm-page" data-crm-conv-id="<%= activeConversation ? activeConversation.id : '' %>">
  <div class="crm-inbox-layout">

    <%# ─── LEFT: Conversation List Panel ────────────────────────────────── %>
    <div class="crm-conv-list-panel">
      
      <!-- Toolbar Header -->
      <div class="crm-conv-list-toolbar">
        <form method="GET" action="/crm/inbox" class="crm-search-form" id="inboxFilterForm">
          <% if (activeConversation) { %>
            <input type="hidden" name="id" value="<%= activeConversation.id %>">
          <% } %>
          <input type="hidden" name="status" id="filterStatusInput" value="<%= filters.status || '' %>">
          <input type="hidden" name="channelType" id="filterChannelInput" value="<%= filters.channelType || filters.channel || '' %>">

          <!-- Search Input -->
          <div class="crm-search-box">
            <i class="fa-solid fa-magnifying-glass crm-search-icon"></i>
            <input type="text" name="search" placeholder="ค้นหาชื่อ / เบอร์ / ข้อความ..." value="<%= filters.search || '' %>" class="crm-search-input">
            <% if (filters.search) { %>
              <a href="/crm/inbox" class="crm-search-clear"><i class="fa-solid fa-xmark"></i></a>
            <% } %>
          </div>

          <!-- Channel Filter Tabs -->
          <div class="crm-channel-tabs">
            <button type="button" onclick="setChannelFilter('')" class="crm-chan-tab <%= !(filters.channelType || filters.channel) ? 'active' : '' %>">
              ทั้งหมด
            </button>
            <button type="button" onclick="setChannelFilter('WHATSAPP')" class="crm-chan-tab wa <%= (filters.channelType || filters.channel) === 'WHATSAPP' ? 'active' : '' %>">
              <i class="fa-brands fa-whatsapp"></i> WA
            </button>
            <button type="button" onclick="setChannelFilter('LINE_OA')" class="crm-chan-tab line <%= (filters.channelType || filters.channel) === 'LINE_OA' ? 'active' : '' %>">
              <i class="fa-brands fa-line"></i> LINE
            </button>
            <button type="button" onclick="setChannelFilter('FACEBOOK')" class="crm-chan-tab fb <%= (filters.channelType || filters.channel) === 'FACEBOOK' ? 'active' : '' %>">
              <i class="fa-brands fa-facebook"></i> FB
            </button>
          </div>

          <!-- Status Filter Chips -->
          <div class="crm-status-chips">
            <button type="button" onclick="setStatusFilter('')" class="crm-chip <%= !(filters.status) ? 'active' : '' %>">
              ทั้งหมด
            </button>
            <button type="button" onclick="setStatusFilter('OPEN')" class="crm-chip open <%= filters.status === 'OPEN' ? 'active' : '' %>">
              🟢 เปิด
            </button>
            <button type="button" onclick="setStatusFilter('PENDING')" class="crm-chip pending <%= filters.status === 'PENDING' ? 'active' : '' %>">
              🟡 รอ
            </button>
            <button type="button" onclick="setStatusFilter('RESOLVED')" class="crm-chip resolved <%= filters.status === 'RESOLVED' ? 'active' : '' %>">
              ✅ เสร็จ
            </button>
          </div>

          <% if (queues && queues.length > 0) { %>
          <div class="crm-queue-select-wrap">
            <select name="queueId" class="crm-queue-select" onchange="this.form.submit()">
              <option value="">— ทุก คิว (Queues) —</option>
              <% queues.forEach(q => { %>
                <option value="<%= q.id %>" <%= (filters.queueId == q.id || filters.queue == q.id) ? 'selected' : '' %>>
                  <%= q.queue_name %>
                </option>
              <% }) %>
            </select>
          </div>
          <% } %>
        </form>
      </div>

      <!-- Conversations Feed -->
      <div class="crm-conv-list" id="convList">
        <% if (!conversations || conversations.length === 0) { %>
        <div class="crm-empty-state">
          <div class="crm-empty-icon"><i class="fa-regular fa-comments"></i></div>
          <p>ไม่พบรายการบทสนทนา</p>
          <small>ลองเปลี่ยนเงื่อนไขค้นหา หรือรอข้อความใหม่จากลูกค้า</small>
        </div>
        <% } %>

        <% (conversations || []).forEach(conv => { %>
        <%
          const isActive = activeConversation && activeConversation.id == conv.id;
          const cIcon  = channelIcon[conv.channel_type]  || 'fa-solid fa-comment';
          const cColor = channelColor[conv.channel_type] || '#94a3b8';
          const timeAgo = conv.last_message_at ? new Date(conv.last_message_at).toLocaleString('th-TH', { hour:'2-digit', minute:'2-digit', day:'numeric', month:'short' }) : '';
          const statusBadgeClass = { OPEN:'crm-badge-open', PENDING:'crm-badge-pending', RESOLVED:'crm-badge-resolved', CLOSED:'crm-badge-closed' }[conv.status] || 'crm-badge-normal';
        %>
        <a href="/crm/inbox/<%= conv.id %>" class="crm-conv-item <%= isActive ? 'active' : '' %>">
          <div class="crm-conv-item-avatar">
            <%= (conv.customer_name || '?').charAt(0).toUpperCase() %>
            <span class="crm-conv-channel-badge" style="background:<%= cColor %>20; color:<%= cColor %>; border-color:<%= cColor %>40;">
              <i class="<%= cIcon %>"></i>
            </span>
          </div>
          <div class="crm-conv-item-body">
            <div class="crm-conv-item-top">
              <span class="crm-conv-name"><%= conv.customer_name || 'ไม่ทราบชื่อ' %></span>
              <span class="crm-conv-time"><%= timeAgo %></span>
            </div>
            
            <% if (conv.customer_phone) { %>
            <div class="crm-conv-phone">
              <i class="fa-solid fa-phone"></i> <%= conv.customer_phone %>
            </div>
            <% } %>

            <div class="crm-conv-preview">
              <% if (conv.unread_count > 0) { %>
                <span class="crm-unread-badge"><%= conv.unread_count %></span>
              <% } %>
              <%= (conv.last_message_text || '').slice(0, 48) || 'เริ่มต้นบทสนทนา...' %>
            </div>

            <div class="crm-conv-meta-pills">
              <span class="crm-badge <%= statusBadgeClass %>"><%= statusTh[conv.status] || conv.status %></span>
              <% if (conv.assigned_agent_name) { %>
                <span class="crm-assigned-agent"><i class="fa-regular fa-user"></i> <%= conv.assigned_agent_name %></span>
              <% } %>
            </div>
          </div>
        </a>
        <% }) %>
      </div>
    </div>


    <%# ─── CENTER: Chat Feed & Window ────────────────────────────────────── %>
    <div class="crm-chat-panel">
      <% if (!activeConversation) { %>
      <div class="crm-empty-state chat-select-prompt">
        <div class="crm-empty-illustration">
          <i class="fa-solid fa-comments"></i>
        </div>
        <h3>เลือกบทสนทนาจากรายการด้านซ้าย</h3>
        <p>เพื่อตอบแชทลูกค้า บันทึกโน้ต หรือจัดการแท็กของเคส</p>
      </div>
      <% } else { %>

      <!-- Chat Header -->
      <div class="crm-chat-header">
        <% 
          const hIcon = channelIcon[activeConversation.channel_type] || 'fa-solid fa-comment';
          const hColor = channelColor[activeConversation.channel_type] || '#94a3b8';
        %>
        <div class="crm-chat-header-avatar">
          <i class="<%= hIcon %>" style="color:<%= hColor %>;"></i>
        </div>

        <div class="crm-chat-header-info">
          <div class="crm-header-title-row">
            <span class="crm-chat-customer-name"><%= activeConversation.customer_name || 'ไม่ทราบชื่อ' %></span>
            <% if (activeConversation.customer_phone) { %>
              <span class="crm-phone-pill">
                <i class="fa-solid fa-phone"></i> <%= activeConversation.customer_phone %>
              </span>
            <% } %>
          </div>
          <div class="crm-chat-header-sub">
            <span class="crm-channel-tag" style="color:<%= hColor %>;"><%= activeConversation.channel_type %></span>
            <span class="crm-dot-sep">•</span>
            <span>เคส #<%= activeConversation.id %></span>
            <% if (activeConversation.subject) { %>
              <span class="crm-dot-sep">•</span>
              <span><%= activeConversation.subject %></span>
            <% } %>
          </div>
        </div>

        <div class="crm-chat-header-actions">
          <% if (can.agentCrm) { %>
          <form method="POST" action="/crm/inbox/<%= activeConversation.id %>/status" class="crm-header-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="status" class="crm-select-sm" onchange="this.form.submit()">
              <% ['OPEN','PENDING','RESOLVED','CLOSED'].forEach(s => { %>
                <option value="<%= s %>" <%= activeConversation.status === s ? 'selected' : '' %>><%= statusTh[s] || s %></option>
              <% }) %>
            </select>
          </form>
          <% } %>

          <% if (can.superviseCrm) { %>
          <form method="POST" action="/crm/inbox/<%= activeConversation.id %>/assign" class="crm-header-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="to_agent_id" class="crm-select-sm">
              <option value="">— มอบหมาย —</option>
              <% (agents || []).forEach(a => { %>
                <option value="<%= a.id %>" <%= activeConversation.assigned_agent_id == a.id ? 'selected' : '' %>><%= a.name %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn-crm btn-crm-primary btn-crm-sm btn-crm-icon" title="บันทึกการมอบหมาย">
              <i class="fa-solid fa-user-check"></i>
            </button>
          </form>
          <% } %>
        </div>
      </div>

      <!-- Messages Stream -->
      <div class="crm-chat-messages" id="chatMessages">
        <% (messages || []).forEach(msg => { %>
        <% 
          const isAgent = msg.sender_type === 'AGENT' || msg.sender_type === 'BOT'; 
          const isNote  = msg.sender_type === 'NOTE';
        %>

        <% if (isNote) { %>
        <div class="crm-note-bubble">
          <div class="crm-note-header">
            <i class="fa-solid fa-lock"></i>
            <span class="crm-note-author"><%= msg.sender_name || 'เจ้าหน้าที่' %> (โน้ตภายใน)</span>
            <span class="crm-note-time"><%= msg.sent_at ? new Date(msg.sent_at).toLocaleString('th-TH', { hour:'2-digit', minute:'2-digit' }) : '' %></span>
          </div>
          <div class="crm-note-body"><%= msg.content_text %></div>
        </div>
        <% } else { %>
        <div class="crm-msg <%= isAgent ? 'agent' : 'customer' %>">
          <div class="crm-msg-bubble">
            <% if (!isAgent) { %>
            <div class="crm-msg-sender-name">
              <% if (activeConversation && activeConversation.customer_phone) { %>
                <i class="fa-solid fa-phone"></i> <%= activeConversation.customer_phone %>
              <% } else { %>
                <%= msg.sender_name %>
              <% } %>
            </div>
            <% } %>
            <div class="crm-msg-text"><%= msg.content_text %></div>
          </div>
          <div class="crm-msg-meta">
            <span><%= msg.sent_at ? new Date(msg.sent_at).toLocaleString('th-TH', { hour:'2-digit', minute:'2-digit' }) : '' %></span>
            <% if (isAgent) { %>
              <span class="crm-meta-dot">•</span>
              <span class="crm-msg-agent-name"><%= msg.sender_name || 'เจ้าหน้าที่' %></span>
            <% } %>
            <% if (!isAgent && activeConversation && activeConversation.customer_phone) { %>
              <span class="crm-meta-dot">•</span>
              <span class="crm-msg-chan-label"><%= activeConversation.channel_type %></span>
            <% } %>
          </div>
        </div>
        <% } %>
        <% }) %>
      </div>

      <!-- Reply & Action Bar -->
      <div class="crm-reply-bar">
        
        <!-- Quick Reply Floating Drawer -->
        <div id="qrPanel" class="crm-qr-panel" style="display:none;">
          <div class="crm-qr-header">
            <span><i class="fa-solid fa-bolt"></i> ตอบด่วน (Quick Reply)</span>
            <button type="button" class="crm-qr-close" onclick="toggleQrPanel()"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="crm-qr-body">
            <% if (quickReplies && quickReplies.length > 0) { %>
              <% quickReplies.forEach(qr => { %>
              <div class="crm-qr-item" onclick="useQuickReply(this.dataset.text)" data-text="<%= qr.content_text.replace(/"/g, '&quot;') %>">
                <div class="crm-qr-top">
                  <% if (qr.shortcut_key) { %><span class="crm-qr-shortcut"><%= qr.shortcut_key %></span><% } %>
                  <span class="crm-qr-title"><%= qr.title %></span>
                </div>
                <div class="crm-qr-preview"><%= qr.content_text.substring(0, 90) %>...</div>
              </div>
              <% }) %>
            <% } else { %>
              <div class="crm-qr-empty">ยังไม่มีรายการ Quick Reply</div>
            <% } %>
          </div>
        </div>

        <!-- Action Toolbar -->
        <div class="crm-reply-top">
          <div class="crm-tab-buttons">
            <button type="button" id="tabReply" onclick="switchTab('reply')" class="btn-crm btn-crm-primary btn-crm-sm">
              <i class="fa-solid fa-reply"></i> ตอบลูกค้า
            </button>
            <button type="button" id="tabNote" onclick="switchTab('note')" class="btn-crm btn-crm-secondary btn-crm-sm">
              <i class="fa-solid fa-lock"></i> โน้ตภายใน
            </button>
            <button type="button" onclick="toggleQrPanel()" class="btn-crm btn-crm-secondary btn-crm-sm">
              <i class="fa-solid fa-bolt"></i> ตอบด่วน
            </button>
          </div>

          <!-- Language Switcher (TH / LA) -->
          <div class="crm-lang-toggle">
            <button type="button" id="btnReplyLangTh" onclick="setReplyLanguage('TH')" class="crm-lang-btn active">TH</button>
            <button type="button" id="btnReplyLangLa" onclick="setReplyLanguage('LA')" class="crm-lang-btn">LA</button>
          </div>

          <!-- AI Suggestion Trigger -->
          <button type="button" onclick="loadSuggestions()" class="btn-crm btn-ai-sparkle btn-crm-sm">
            <i class="fa-solid fa-wand-magic-sparkles"></i> คำแนะนำ AI
          </button>
        </div>

        <!-- AI Suggestion Panel -->
        <div id="suggestPanel" class="crm-suggest-panel" style="display:none;">
          <div class="crm-suggest-title">
            <i class="fa-solid fa-wand-magic-sparkles"></i> คำแนะนำตอบกลับจากระบบ (คลิกเพื่อเลือกใช้งาน)
          </div>
          <div id="suggestList" class="crm-suggest-list">
            <div class="crm-suggest-loading"><i class="fa-solid fa-spinner fa-spin"></i> กำลังวิเคราะห์คำตอบ...</div>
          </div>
        </div>

        <!-- Reply Customer Form -->
        <div id="replySection">
          <form method="POST" action="/crm/inbox/<%= activeConversation.id %>/reply" id="replyForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <textarea name="message_text" id="messageTextarea" class="crm-reply-textarea"
                      placeholder="พิมพ์ข้อความตอบกลับลูกค้า... (พิมพ์ / เพื่อเปิด Quick Reply)"
                      rows="3" onkeydown="handleReplyKeydown(event)"></textarea>
            
            <div class="crm-reply-actions">
              <div class="crm-reply-hints">
                <span class="crm-hint-pill"><kbd>Ctrl</kbd> + <kbd>Enter</kbd> ส่งข้อความ</span>
                <span class="crm-hint-pill"><kbd>/</kbd> ตอบด่วน</span>
              </div>
              <button type="submit" class="btn-crm btn-crm-primary btn-send">
                <i class="fa-solid fa-paper-plane"></i> ส่งข้อความ
              </button>
            </div>
          </form>
        </div>

        <!-- Internal Note Form -->
        <div id="noteSection" style="display:none;">
          <form method="POST" action="/crm/inbox/<%= activeConversation.id %>/note">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <textarea name="note_text" class="crm-reply-textarea note-mode"
                      placeholder="โน้ตภายในทีม — ข้อความนี้เห็นเฉพาะเจ้าหน้าที่ในระบบเท่านั้น..." rows="3"></textarea>
            <div class="crm-reply-actions">
              <span class="crm-note-warning-badge"><i class="fa-solid fa-lock"></i> บันทึกส่วนตัวเฉพาะทีม</span>
              <button type="submit" class="btn-crm btn-note-save">
                <i class="fa-solid fa-sticky-note"></i> บันทึกโน้ต
              </button>
            </div>
          </form>
        </div>

      </div>
      <% } %>
    </div>


    <%# ─── RIGHT: Customer 360 Context Panel ────────────────────────────── %>
    <div class="crm-context-panel">
      <% if (activeConversation) { %>
      
      <!-- Customer Card -->
      <div class="crm-context-section customer-card-section">
        <div class="crm-context-avatar">
          <%= (activeConversation.customer_name || '?').charAt(0).toUpperCase() %>
        </div>
        <div class="crm-context-customer-name"><%= activeConversation.customer_name || 'ไม่ทราบชื่อ' %></div>
        
        <div class="crm-context-type-row">
          <% const ctypes = { LEAD:'crm-badge-normal', CUSTOMER:'crm-badge-open', VIP:'crm-badge-urgent', BLACKLIST:'crm-badge-closed' }; %>
          <span class="crm-badge <%= ctypes[activeConversation.customer_type] || 'crm-badge-normal' %>">
            <%= activeConversation.customer_type || 'CUSTOMER' %>
          </span>
        </div>

        <% if (activeConversation.customer_phone) { %>
        <div class="crm-context-field">
          <span class="field-label"><i class="fa-solid fa-phone"></i> เบอร์โทร</span>
          <span class="field-value"><%= activeConversation.customer_phone %></span>
        </div>
        <% } %>

        <% if (activeConversation.customer_id) { %>
        <a href="/crm/customers/<%= activeConversation.customer_id %>" class="btn-crm btn-crm-secondary btn-full-width">
          <i class="fa-solid fa-id-card"></i> ดูโปรไฟล์ Customer 360
        </a>
        <% } %>
      </div>

      <!-- Tag Management -->
      <div class="crm-context-section">
        <div class="crm-context-section-title">
          <i class="fa-solid fa-tags"></i> แท็กประหมวดเคส (Tags)
        </div>
        <div class="crm-tag-container">
          <% if (convTags && convTags.length > 0) { %>
            <% convTags.forEach(t => { %>
              <span class="crm-tag" style="background:<%= t.tag_color || '#334155' %>25; color:<%= t.tag_color || '#94a3b8' %>; border-color:<%= t.tag_color || '#475569' %>50;">
                <i class="fa-solid fa-tag"></i> <%= t.tag_name %>
              </span>
            <% }) %>
          <% } else { %>
            <div class="crm-no-tags">ยังไม่มีแท็กติดเคส</div>
          <% } %>
        </div>

        <% if (can.agentCrm) { %>
        <form method="POST" action="/crm/inbox/<%= activeConversation.id %>/tag" class="crm-tag-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="tag_id" class="crm-select-sm" style="flex:1;">
            <option value="">+ เพิ่มแท็ก</option>
            <% (tags || []).forEach(t => { %>
              <option value="<%= t.id %>"><%= t.tag_name %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn-crm btn-crm-primary btn-crm-sm btn-crm-icon">
            <i class="fa-solid fa-plus"></i>
          </button>
        </form>
        <% } %>
      </div>

      <!-- Internal Notes Timeline -->
      <div class="crm-context-section">
        <div class="crm-context-section-title">
          <i class="fa-solid fa-lock" style="color:#fbbf24;"></i> โน้ตย่อทีมล่าสุด
        </div>
        <div class="crm-notes-timeline">
          <% if (notes && notes.length > 0) { %>
            <% notes.slice(0, 4).forEach(n => { %>
            <div class="crm-timeline-item">
              <div class="crm-timeline-author"><%= n.user_name || 'ทีม' %></div>
              <div class="crm-timeline-text"><%= n.note_text %></div>
              <div class="crm-timeline-time"><%= n.created_at ? new Date(n.created_at).toLocaleString('th-TH', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) : '' %></div>
            </div>
            <% }) %>
          <% } else { %>
            <div class="crm-no-notes">ยังไม่มีบันทึกโน้ตภายใน</div>
          <% } %>
        </div>
      </div>

      <% } else { %>
      <div class="crm-empty-state chat-select-prompt">
        <div class="crm-empty-icon"><i class="fa-solid fa-user-gear"></i></div>
        <p>เลือกบทสนทนาเพื่อดูบริบทลูกค้า</p>
      </div>
      <% } %>
    </div>

  </div> <!-- Close crm-inbox-layout -->
</div> <!-- Close crm-page -->

<script>
// Filter form helpers
function setStatusFilter(status) {
  document.getElementById('filterStatusInput').value = status;
  document.getElementById('inboxFilterForm').submit();
}
function setChannelFilter(channel) {
  document.getElementById('filterChannelInput').value = channel;
  document.getElementById('inboxFilterForm').submit();
}

const msgContainer = document.getElementById('chatMessages');
if (msgContainer) msgContainer.scrollTop = msgContainer.scrollHeight;

function switchTab(tab) {
  const r = document.getElementById('replySection');
  const n = document.getElementById('noteSection');
  const tr = document.getElementById('tabReply');
  const tn = document.getElementById('tabNote');
  if (tab === 'reply') {
    r.style.display = 'block';
    n.style.display = 'none';
    tr.className = 'btn-crm btn-crm-primary btn-crm-sm';
    tn.className = 'btn-crm btn-crm-secondary btn-crm-sm';
  } else {
    r.style.display = 'none';
    n.style.display = 'block';
    tr.className = 'btn-crm btn-crm-secondary btn-crm-sm';
    tn.className = 'btn-crm btn-crm-primary btn-crm-sm';
  }
}

function useQuickReply(text) {
  const ta = document.getElementById('messageTextarea');
  if (ta) { ta.value = text; ta.focus(); }
  document.getElementById('qrPanel').style.display = 'none';
  switchTab('reply');
}

function handleReplyKeydown(e) {
  if (e.key === '/' && e.target.value === '') {
    e.preventDefault();
    toggleQrPanel();
  }
  if (e.key === 'Escape') {
    document.getElementById('qrPanel').style.display = 'none';
    document.getElementById('suggestPanel').style.display = 'none';
  }
  if (e.ctrlKey && e.key === 'Enter') {
    document.getElementById('replyForm')?.submit();
  }
}

function toggleQrPanel() {
  const p = document.getElementById('qrPanel');
  p.style.display = p.style.display === 'none' ? 'block' : 'none';
}

const CONV_ID = (document.querySelector('[data-crm-conv-id]') || {}).dataset?.crmConvId || '';
let replyLanguage = 'TH';

function setReplyLanguage(lang) {
  replyLanguage = lang;
  const btnTh = document.getElementById('btnReplyLangTh');
  const btnLa = document.getElementById('btnReplyLangLa');
  if (lang === 'TH') {
    btnTh.classList.add('active');
    btnLa.classList.remove('active');
  } else {
    btnLa.classList.add('active');
    btnTh.classList.remove('active');
  }
  const panel = document.getElementById('suggestPanel');
  if (panel && panel.style.display !== 'none') {
    loadSuggestions();
  }
}

async function loadSuggestions() {
  if (!CONV_ID) return;
  const panel = document.getElementById('suggestPanel');
  const list = document.getElementById('suggestList');
  panel.style.display = 'block';
  list.innerHTML = '<div class="crm-suggest-loading"><i class="fa-solid fa-spinner fa-spin"></i> กำลังโหลดคำแนะนำ AI...</div>';
  
  try {
    const res = await fetch('/api/crm/inbox/' + CONV_ID + '/suggestions?lang=' + replyLanguage, { credentials: 'same-origin' });
    const data = await res.json();
    if (!data.ok || !data.suggestions.length) {
      list.innerHTML = '<div class="crm-suggest-empty">ไม่พบคำแนะนำ AI สำหรับบทสนทนานี้</div>';
      return;
    }
    list.innerHTML = data.suggestions.map(s => {
      const preview = s.content_text.length > 120 ? s.content_text.substring(0, 120) + '...' : s.content_text;
      return `<div class="crm-suggest-item" onclick="useSuggestion(this.dataset.text)" data-text="${s.content_text.replace(/"/g, '&quot;')}">
        <div class="crm-suggest-item-title">${s.title}</div>
        <div class="crm-suggest-item-text">${preview}</div>
      </div>`;
    }).join('');
  } catch (err) {
    list.innerHTML = `<div class="crm-suggest-error">เกิดข้อผิดพลาด: ${err.message}</div>`;
  }
}

function useSuggestion(text) {
  const ta = document.getElementById('messageTextarea');
  if (ta) { ta.value = text; ta.focus(); }
  document.getElementById('suggestPanel').style.display = 'none';
  switchTab('reply');
}
</script>

