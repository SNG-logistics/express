<%#
  views/crm/customer-360.ejs — Customer 360 Profile
  Phase 3 — Thai fixed (Node.js write)
%>
<link rel="stylesheet" href="/css/crm.css">

<% // customer, conversations, and cases are passed directly from locals %>

<div style="max-width:900px;margin:0 auto;padding:24px 16px;">

  <%# Header %>
  <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
    <div class="crm-context-avatar" style="width:60px;height:60px;font-size:1.5rem;">
      <%= (customer.full_name||'?').charAt(0).toUpperCase() %>
    </div>
    <div style="flex:1;">
      <h1 style="margin:0;font-size:1.3rem;font-weight:700;color:#f1f5f9;">
        <%= customer.full_name || 'ไม่ทราบชื่อ' %>
      </h1>
      <div style="font-size:0.8rem;color:#64748b;margin-top:3px;">
        <% const ct={LEAD:'crm-badge-normal',CUSTOMER:'crm-badge-open',VIP:'crm-badge-warning',BLACKLIST:'crm-badge-urgent'}; %>
        <span class="crm-badge <%=ct[customer.customer_type]||'crm-badge-normal'%>"><%= customer.customer_type %></span>
        <% if(customer.phone){%> &nbsp;<i class="fa-solid fa-phone" style="color:#60a5fa;"></i> <%=customer.phone%><%}%>
        <% if(customer.email){%> &nbsp;<i class="fa-solid fa-envelope" style="color:#60a5fa;"></i> <%=customer.email%><%}%>
      </div>
    </div>
    <% if(can && can.superviseCrm){ %>
    <a href="/crm/customers" class="btn-crm btn-crm-secondary btn-crm-sm"><i class="fa-solid fa-arrow-left"></i> กลับ</a>
    <%}%>
  </div>

  <%# Grid %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

    <%# Info Card %>
    <div class="crm-context-section" style="grid-column:1/3;">
      <div class="crm-context-section-title"><i class="fa-solid fa-user" style="color:#818cf8;"></i> ข้อมูลเพิ่มเติม</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;font-size:0.8rem;">
        <div class="crm-context-field"><span class="field-label">ชื่อ</span><span class="field-value"><%= customer.full_name||'-' %></span></div>
        <div class="crm-context-field"><span class="field-label">เบอร์โทรศัพท์</span><span class="field-value"><%= customer.phone||'-' %></span></div>
        <div class="crm-context-field"><span class="field-label">อีเมล</span><span class="field-value"><%= customer.email||'-' %></span></div>
        <div class="crm-context-field"><span class="field-label">ที่อยู่</span><span class="field-value" style="grid-column:span 2;"><%= customer.address||'-' %></span></div>
        <div class="crm-context-field"><span class="field-label">หมายเหตุ</span><span class="field-value"><%= customer.note||'-' %></span></div>
        <div class="crm-context-field"><span class="field-label">สมัครเมื่อ</span><span class="field-value"><%= customer.created_at?new Date(customer.created_at).toLocaleDateString('th-TH'):'-' %></span></div>
      </div>
    </div>

    <%# Conversations %>
    <div class="crm-context-section">
      <div class="crm-context-section-title"><i class="fa-solid fa-comments" style="color:#60a5fa;"></i> ประวัติการสนทนา (<%= conversations.length %>)</div>
      <% if(!conversations.length){%>
        <div style="color:#475569;font-size:0.78rem;text-align:center;padding:12px;">ยังไม่มีประวัติการสนทนา</div>
      <%}%>
      <% conversations.slice(0,5).forEach(c=>{%>
      <a href="/crm/inbox/<%=c.id%>" style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid rgba(255,255,255,0.05);text-decoration:none;">
        <div>
          <div style="font-size:0.78rem;color:#e2e8f0;font-weight:600;"><%=c.channel_type%> #<%=c.id%></div>
          <div style="font-size:0.7rem;color:#64748b;margin-top:2px;"><%=(c.last_message_text||'').slice(0,40)%></div>
        </div>
        <span class="crm-badge <%={OPEN:'crm-badge-open',PENDING:'crm-badge-pending',RESOLVED:'crm-badge-resolved'}[c.status]||'crm-badge-normal'%>" style="font-size:0.6rem;"><%=c.status%></span>
      </a>
      <%})%>
    </div>

    <%# Cases %>
    <div class="crm-context-section">
      <div class="crm-context-section-title"><i class="fa-solid fa-folder-open" style="color:#f59e0b;"></i> เคสที่เกี่ยวข้อง (<%= cases.length %>)</div>
      <% if(!cases.length){%>
        <div style="color:#475569;font-size:0.78rem;text-align:center;padding:12px;">ยังไม่มีเคส</div>
      <%}%>
      <% cases.slice(0,5).forEach(cs=>{%>
      <div style="padding:7px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
        <div style="font-size:0.78rem;color:#e2e8f0;font-weight:600;"><%=cs.subject||'ไม่ระบุหัวข้อ'%></div>
        <div style="display:flex;gap:5px;margin-top:3px;">
          <span class="crm-badge crm-badge-normal" style="font-size:0.6rem;"><%=cs.case_type%></span>
          <span class="crm-badge <%={OPEN:'crm-badge-open',RESOLVED:'crm-badge-resolved'}[cs.case_status]||'crm-badge-normal'%>" style="font-size:0.6rem;"><%=cs.case_status%></span>
        </div>
      </div>
      <%})%>
    </div>

  </div>

  <% if(can && can.superviseCrm){ %>
  <!-- Merge Panel (supervisor+) -->
  <div class="crm-context-section" style="margin-top:16px;border:1px solid rgba(239,68,68,0.2);background:rgba(239,68,68,0.04);">
    <div class="crm-context-section-title"><i class="fa-solid fa-code-merge" style="color:#f87171;"></i> รวมบัญชีลูกค้า (Supervisor)</div>
    <p style="font-size:0.78rem;color:#94a3b8;margin-bottom:10px;">
      รวมบัญชีลูกค้าที่ซ้ำซ้อนเข้าด้วยกัน
      — โสดการสนทนาและเคสทั้งหมดไปยังบัญชีหลักแล้วปิดบัญชีที่ผสาน
    </p>
    <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
      <div style="flex:1;min-width:200px;">
        <label style="font-size:0.72rem;color:#94a3b8;display:block;margin-bottom:4px;">ค้นหาบัญชีที่จะให้ถูกรวม</label>
        <input type="text" id="mergeSearch" placeholder="ชื่อหรือเบอร์โทรศัพท์..." class="crm-search-input" oninput="searchMerge(this.value)" style="width:100%;">
        <div id="mergeResults" style="margin-top:4px;font-size:0.78rem;"></div>
      </div>
      <button type="button" id="btnMerge" onclick="doMerge()" disabled
              class="btn-crm" style="background:rgba(239,68,68,0.15);color:#f87171;border:1px solid rgba(239,68,68,0.3);">
        <i class="fa-solid fa-code-merge"></i> รวมเลย
      </button>
    </div>
    <div id="mergeStatus" style="margin-top:8px;font-size:0.78rem;"></div>
  </div>

  <script>
  let mergeTargetId = null;
  const keepId = <%- JSON.stringify(customer.id) %>;

  async function searchMerge(q) {
    if (q.length < 2) { document.getElementById('mergeResults').innerHTML=''; return; }
    const res = await fetch('/api/crm/customers/search?q='+encodeURIComponent(q)+'&exclude='+keepId, {credentials:'same-origin'});
    const data = await res.json();
    const el = document.getElementById('mergeResults');
    if (!data.ok || !data.customers.length) { el.innerHTML='<div style="color:#64748b;">ไม่พบ</div>'; return; }
    el.innerHTML = data.customers.map(c =>
      '<div onclick="selectMerge('+c.id+',''+c.full_name+'')" style="cursor:pointer;padding:5px 8px;border-radius:6px;border:1px solid rgba(255,255,255,0.08);margin-bottom:3px;background:rgba(30,41,59,0.8);">'
      +'<span style="font-weight:600;color:#e2e8f0;">'+c.full_name+'</span>'
      +'<span style="color:#64748b;font-size:0.7rem;margin-left:6px;">'+( c.phone||'' )+'</span>'
      +'</div>'
    ).join('');
  }
  function selectMerge(id, name) {
    mergeTargetId = id;
    document.getElementById('mergeResults').innerHTML =
      '<div style="padding:5px 8px;border-radius:6px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);color:#fca5a5;">'
      + '<i class="fa-solid fa-arrow-right"></i> จะรวม: <strong>' + name + '</strong></div>';
    document.getElementById('btnMerge').disabled = false;
  }
  async function doMerge() {
    if (!mergeTargetId) return;
    if (!confirm('ยืนยันรวมบัญชี? ไม่สามารถย้อนกลับได้')) return;
    const status = document.getElementById('mergeStatus');
    status.innerHTML = '<span style="color:#94a3b8;">กำลังรวม...</span>';
    const res = await fetch('/api/crm/customers/<%- customer.id %>/merge', {
      method:'POST', credentials:'same-origin',
      headers:{'Content-Type':'application/json','X-CSRF-Token':document.querySelector('[name=_csrf]')?.value||''},
      body: JSON.stringify({ mergeId: mergeTargetId })
    });
    const data = await res.json();
    if (data.ok) {
      status.innerHTML='<span style="color:#34d399;">✅ รวมสำเร็จ! กำลังโหลดหน้าใหม่...</span>';
      setTimeout(()=>location.reload(), 1500);
    } else {
      status.innerHTML='<span style="color:#f87171;">✖ ผิดพลาด: '+data.error+'</span>';
    }
  }
  </script>
  <% } %>
</div>
