<%
/* ───── Rider Job List ───── */
const STATUS_LABEL = {
  'RIDER_ASSIGNED':     { label: 'รอรับงาน',   cls: 'bg-yellow-100 text-yellow-800' },
  'RIDER_ACCEPTED':     { label: 'รับงานแล้ว',  cls: 'bg-blue-100 text-blue-800' },
  'OUT_FOR_DELIVERY':   { label: 'กำลังส่ง',    cls: 'bg-orange-100 text-orange-800' },
};
%>
<div class="min-h-screen bg-slate-900 text-white pb-6" style="font-family:'Noto Sans Thai',sans-serif;">

  <%# ── TOP BAR ── %>
  <div style="background:linear-gradient(135deg,#fbbf24,#f59e0b); padding:16px 20px 20px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
      <img src="/images/snglogo.png" style="width:40px;height:40px;border-radius:50%;border:2px solid #fff;" onerror="this.style.display='none'">
      <div style="flex:1;">
        <div style="font-size:18px;font-weight:900;color:#1c1917;line-height:1;">SNG Rider</div>
        <div style="font-size:12px;color:#78350f;font-weight:600;"><%= user.username %> · ไรเดอร์</div>
      </div>
      <button id="status-toggle" data-status="<%= riderStatus %>"
        style="display:flex;align-items:center;gap:6px;border:0;border-radius:99px;padding:6px 12px;font-size:11px;font-weight:800;cursor:pointer;
          background:<%= riderStatus === 'active' ? 'rgba(34,197,94,.25)' : 'rgba(0,0,0,.15)' %>;
          color:<%= riderStatus === 'active' ? '#14532d' : '#1c1917' %>;">
        <span id="status-dot" style="width:8px;height:8px;border-radius:50%;background:<%= riderStatus === 'active' ? '#22c55e' : '#78716c' %>;"></span>
        <span id="status-label"><%= riderStatus === 'active' ? 'ออนไลน์' : 'ออฟไลน์' %></span>
      </button>
      <a href="/logout" style="background:rgba(0,0,0,.15);border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:#1c1917;text-decoration:none;flex-shrink:0;">
        <i class="fa-solid fa-right-from-bracket"></i>
      </a>
    </div>

    <%# KPI strip %>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
      <div style="background:rgba(255,255,255,.2);border-radius:10px;padding:10px;text-align:center;">
        <div style="font-size:22px;font-weight:900;color:#1c1917;"><%= pending %></div>
        <div style="font-size:10px;color:#78350f;font-weight:700;">ค้างอยู่</div>
      </div>
      <div style="background:rgba(255,255,255,.2);border-radius:10px;padding:10px;text-align:center;">
        <div style="font-size:22px;font-weight:900;color:#1c1917;"><%= todayDelivered %></div>
        <div style="font-size:10px;color:#78350f;font-weight:700;">ส่งแล้ววันนี้</div>
      </div>
      <div style="background:rgba(255,255,255,.2);border-radius:10px;padding:10px;text-align:center;">
        <div style="font-size:14px;font-weight:900;color:#1c1917;"><%=Number(todayCOD).toLocaleString()%></div>
        <div style="font-size:10px;color:#78350f;font-weight:700;">COD วันนี้ ฿</div>
      </div>
    </div>
  </div>

  <%# ── OFFERS: งานใหม่ในสาขา (กดรับ) ── %>
  <div style="padding:16px 16px 0;">
    <div id="offers-section" style="<%= (offers && offers.length) ? '' : 'display:none;' %>">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
        <span style="font-size:15px;font-weight:900;color:#fbbf24;">🔔 งานใหม่ในสาขา</span>
        <span id="offers-count" style="font-size:11px;font-weight:800;background:#f59e0b;color:#1c1917;padding:2px 8px;border-radius:99px;"><%= (offers || []).length %></span>
        <span style="font-size:10px;color:#64748b;margin-left:auto;">ใครกดก่อนได้ก่อน</span>
      </div>
      <div id="offers-list" style="display:flex;flex-direction:column;gap:10px;"></div>
    </div>
  </div>

  <%# ── JOB LIST ── %>
  <div style="padding:16px;display:flex;flex-direction:column;gap:10px;">

    <% if (!jobs || jobs.length === 0) { %>
    <div style="text-align:center;padding:60px 20px;color:#64748b;">
      <i class="fa-solid fa-box-open" style="font-size:48px;margin-bottom:12px;display:block;"></i>
      <div style="font-size:16px;font-weight:700;">ไม่มีงานที่ต้องส่ง</div>
      <div style="font-size:13px;margin-top:4px;">รอการมอบหมายงานจากแอดมิน</div>
    </div>
    <% } %>

    <% (jobs || []).forEach(job => {
      const st = STATUS_LABEL[job.status] || { label: job.status, cls: 'bg-slate-100 text-slate-800' };
      const hasCOD = parseFloat(job.cod_amount) > 0;
    %>
    <a href="/rider/job/<%= job.id %>" style="text-decoration:none;">
      <div style="background:#1e293b;border-radius:14px;border:1px solid #334155;overflow:hidden;transition:transform .15s;" onmousedown="this.style.transform='scale(.98)'" onmouseup="this.style.transform=''">

        <%# Header %>
        <div style="background:#0f172a;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;">
          <div style="font-family:monospace;font-size:14px;font-weight:900;color:#fbbf24;"><%= job.job_no %></div>
          <span style="font-size:10px;font-weight:800;padding:3px 10px;border-radius:99px;" class="<%= st.cls %>"><%= st.label %></span>
        </div>

        <%# Body %>
        <div style="padding:12px 14px;display:flex;flex-direction:column;gap:8px;">
          <div style="display:flex;align-items:flex-start;gap:10px;">
            <i class="fa-solid fa-user-check" style="color:#94a3b8;width:16px;margin-top:2px;font-size:12px;flex-shrink:0;"></i>
            <div>
              <div style="font-size:11px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.4px;">ผู้รับ</div>
              <div style="font-size:15px;font-weight:800;color:#f1f5f9;"><%= job.receiver_name_r || job.receiver_name || '—' %></div>
            </div>
          </div>

          <div style="display:flex;align-items:flex-start;gap:10px;">
            <i class="fa-solid fa-location-dot" style="color:#94a3b8;width:16px;margin-top:2px;font-size:12px;flex-shrink:0;"></i>
            <div style="font-size:12px;color:#94a3b8;line-height:1.4;"><%= (job.receiver_address || 'ไม่ระบุที่อยู่').slice(0,80) %></div>
          </div>

          <% if (job.dest_lat && job.dest_lng) { %>
          <div style="display:flex;align-items:center;gap:10px;">
            <i class="fa-solid fa-satellite-dish" style="color:#3b82f6;width:16px;font-size:12px;flex-shrink:0;"></i>
            <div style="font-size:11px;font-weight:800;color:#3b82f6;">มีพิกัด GPS</div>
          </div>
          <% } %>

          <% if (hasCOD) { %>
          <div style="display:flex;align-items:center;gap:10px;">
            <i class="fa-solid fa-money-bill-wave" style="color:#22c55e;width:16px;font-size:12px;flex-shrink:0;"></i>
            <div style="font-size:13px;font-weight:900;color:#22c55e;">COD ฿<%= Number(job.cod_amount).toLocaleString() %></div>
          </div>
          <% } %>
        </div>

        <div style="background:#0f172a;padding:8px 14px;display:flex;align-items:center;justify-content:space-between;">
          <div style="font-size:10px;color:#475569;">
            <i class="fa-solid fa-box"></i> <%= job.item_count || 1 %> ชิ้น
            <% if (job.actual_weight || job.weight_kg) { %> · <%= job.actual_weight || job.weight_kg %> kg<% } %>
          </div>
          <div style="font-size:12px;color:#fbbf24;font-weight:700;">เปิดงาน <i class="fa-solid fa-chevron-right"></i></div>
        </div>
      </div>
    </a>
    <% }) %>
  </div>

  <%# ── BOTTOM NAV ── %>
  <div style="position:fixed;bottom:0;left:0;right:0;background:#1e293b;border-top:1px solid #334155;display:flex;z-index:100;">
    <a href="/rider" style="flex:1;display:flex;flex-direction:column;align-items:center;padding:10px 4px 14px;text-decoration:none;border-top:2px solid #fbbf24;">
      <i class="fa-solid fa-list-check" style="font-size:18px;color:#fbbf24;"></i>
      <span style="font-size:9px;color:#fbbf24;font-weight:700;margin-top:3px;text-transform:uppercase;">งานของฉัน</span>
    </a>
    <a href="/rider/history" style="flex:1;display:flex;flex-direction:column;align-items:center;padding:10px 4px 14px;text-decoration:none;">
      <i class="fa-solid fa-clock-rotate-left" style="font-size:18px;color:#64748b;"></i>
      <span style="font-size:9px;color:#64748b;font-weight:700;margin-top:3px;text-transform:uppercase;">ประวัติ</span>
    </a>
    <a href="/rider/profile" style="flex:1;display:flex;flex-direction:column;align-items:center;padding:10px 4px 14px;text-decoration:none;">
      <i class="fa-solid fa-user-gear" style="font-size:18px;color:#64748b;"></i>
      <span style="font-size:9px;color:#64748b;font-weight:700;margin-top:3px;text-transform:uppercase;">โปรไฟล์</span>
    </a>
    <a href="/logout" style="flex:1;display:flex;flex-direction:column;align-items:center;padding:10px 4px 14px;text-decoration:none;">
      <i class="fa-solid fa-right-from-bracket" style="font-size:18px;color:#64748b;"></i>
      <span style="font-size:9px;color:#64748b;font-weight:700;margin-top:3px;text-transform:uppercase;">ออกจากระบบ</span>
    </a>
  </div>

</div>

<script>
(function () {
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || '';
  const listEl    = document.getElementById('offers-list');
  const sectionEl = document.getElementById('offers-section');
  const countEl   = document.getElementById('offers-count');
  const initialOffers = <%- JSON.stringify(offers || []) %>;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
      ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  }
  function money(n) { const v = Number(n || 0); return v > 0 ? v.toLocaleString('en-US') : null; }

  function cardHtml(o) {
    const cod = money(o.cod_amount);
    const fee = money(o.last_mile_fee);
    return '' +
      '<div style="background:#1e293b;border:1px solid #f59e0b;border-radius:14px;overflow:hidden;">' +
        '<div style="background:#0f172a;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;">' +
          '<span style="font-family:monospace;font-size:14px;font-weight:900;color:#fbbf24;">' + esc(o.job_no) + '</span>' +
          '<span style="font-size:10px;font-weight:800;background:#f59e0b;color:#1c1917;padding:3px 10px;border-radius:99px;">รหัส ' + esc(o.claim_code) + '</span>' +
        '</div>' +
        '<div style="padding:12px 14px;display:flex;flex-direction:column;gap:6px;">' +
          '<div style="font-size:14px;font-weight:800;color:#f1f5f9;"><i class="fa-solid fa-user-check" style="color:#94a3b8;margin-right:6px;"></i>' + esc(o.receiver_name || '—') + '</div>' +
          '<div style="font-size:12px;color:#94a3b8;"><i class="fa-solid fa-location-dot" style="margin-right:6px;"></i>' + esc((o.receiver_address || 'ไม่ระบุที่อยู่').slice(0,80)) + '</div>' +
          (o.dest_lat && o.dest_lng ? '<div style="font-size:11px;font-weight:800;color:#3b82f6;"><i class="fa-solid fa-satellite-dish" style="margin-right:6px;"></i>มีพิกัด GPS</div>' : '') +
          (cod ? '<div style="font-size:13px;font-weight:900;color:#22c55e;"><i class="fa-solid fa-money-bill-wave" style="margin-right:6px;"></i>COD ฿' + cod + '</div>' : '') +
          (fee ? '<div style="font-size:12px;color:#fbbf24;"><i class="fa-solid fa-coins" style="margin-right:6px;"></i>ค่ารอบ ฿' + fee + '</div>' : '') +
        '</div>' +
        '<button data-offer="' + esc(o.id) + '" class="claim-btn" style="width:100%;border:0;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;font-weight:900;font-size:15px;padding:13px;cursor:pointer;">' +
          '<i class="fa-solid fa-hand-pointer" style="margin-right:6px;"></i>กดรับงานนี้' +
        '</button>' +
      '</div>';
  }

  function render(offers) {
    if (!listEl) return;
    if (!offers.length) { sectionEl.style.display = 'none'; return; }
    sectionEl.style.display = '';
    if (countEl) countEl.textContent = offers.length;
    listEl.innerHTML = offers.map(cardHtml).join('');
    listEl.querySelectorAll('.claim-btn').forEach(btn => btn.addEventListener('click', onClaim));
  }

  async function onClaim(e) {
    const btn = e.currentTarget;
    const id = btn.getAttribute('data-offer');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> กำลังรับงาน...';
    try {
      const res = await fetch('/rider/offers/' + id + '/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      });
      const data = await res.json();
      if (data.success) { location.reload(); return; }
      alert(data.message || 'รับงานไม่สำเร็จ');
      refresh();
    } catch (err) {
      alert('เครือข่ายมีปัญหา ลองใหม่อีกครั้ง');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-hand-pointer"></i> กดรับงานนี้';
    }
  }

  async function refresh() {
    try {
      const res = await fetch('/rider/offers', { headers: { 'X-CSRF-Token': CSRF } });
      const data = await res.json();
      if (data.success) render(data.offers || []);
    } catch (_) { /* keep last view on transient errors */ }
  }

  render(initialOffers);
  setInterval(refresh, 15000);

  const toggleBtn = document.getElementById('status-toggle');
  toggleBtn?.addEventListener('click', async () => {
    toggleBtn.disabled = true;
    try {
      const res = await fetch('/rider/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      });
      const data = await res.json();
      if (!data.success) { alert(data.message || 'เปลี่ยนสถานะไม่สำเร็จ'); return; }
      const isActive = data.status === 'active';
      toggleBtn.dataset.status = data.status;
      toggleBtn.style.background = isActive ? 'rgba(34,197,94,.25)' : 'rgba(0,0,0,.15)';
      toggleBtn.style.color = isActive ? '#14532d' : '#1c1917';
      document.getElementById('status-dot').style.background = isActive ? '#22c55e' : '#78716c';
      document.getElementById('status-label').textContent = isActive ? 'ออนไลน์' : 'ออฟไลน์';
    } catch (err) {
      alert('เครือข่ายมีปัญหา ลองใหม่อีกครั้ง');
    } finally {
      toggleBtn.disabled = false;
    }
  });
})();
</script>
