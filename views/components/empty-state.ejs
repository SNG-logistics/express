
<div class="flex flex-col items-center justify-center py-16 px-4 text-center">
  <div class="w-16 h-16 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mb-4">
    <i class="fa-solid <%= icon || 'fa-inbox' %> text-2xl text-slate-500"></i>
  </div>
  <h3 class="text-white font-semibold text-lg mb-1">
    <%= title || 'ไม่มีข้อมูล' %>
  </h3>
  <% if (typeof subtitle !== 'undefined' && subtitle) { %>
  <p class="text-slate-400 text-sm max-w-xs">
    <%= subtitle %>
  </p>
  <% } %>
  <% if (typeof ctaLabel !== 'undefined' && ctaLabel && typeof ctaHref !== 'undefined') { %>
  <a href="<%= ctaHref %>"
     class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 text-white text-sm font-semibold rounded-xl hover:shadow-lg hover:shadow-cyan-500/25 transition-all">
    <%= ctaLabel %>
  </a>
  <% } %>
</div>
