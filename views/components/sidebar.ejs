<%#
  views/components/sidebar.ejs
  Redesigned sidebar:
   - Uses can.* flags (set in app.js) for role gating
   - Uses currentPath (set in app.js) for active detection
   - Bottom user card with role badge
%>

<aside class="sidebar" id="sidebar">

  <%# ── Brand ─────────────────────────────────────────── %>
  <div class="sidebar-brand">
    <a href="/dashboard" class="flex items-center gap-3 no-underline" style="text-decoration:none;">
      <div style="width:42px;height:42px;border-radius:10px;overflow:hidden;flex-shrink:0;
                  box-shadow:0 0 0 2px rgba(255,224,0,0.35),0 4px 16px rgba(255,224,0,0.15);">
        <img src="/images/snglogo.png" alt="SNG Logo"
             style="width:100%;height:100%;object-fit:cover;"
             onerror="this.parentElement.style.background='#FFE000';this.parentElement.innerHTML='<span style=\'font-size:1.375rem;font-weight:900;color:#000;line-height:42px;text-align:center;display:block\'>S</span>'">
      </div>
      <div>
        <div style="color:#fff;font-weight:800;font-size:1rem;line-height:1.1;letter-spacing:0.02em;">
          SNG <span style="color:#FFE000;">EXPRESS</span>
        </div>
        <div style="font-size:0.625rem;color:rgba(255,255,255,0.3);letter-spacing:0.08em;text-transform:uppercase;margin-top:1px;line-height:1.5;">
          🇹🇭 ไทย ⇄ ลาว 🇱🇦
        </div>
      </div>
    </a>
  </div>


  <%# ── Navigation ─────────────────────────────────────── %>
  <nav class="sidebar-nav">

    <%# Section: เมนูหลัก %>
    <div class="sidebar-section-title"><%= t('nav.dashboard') === 'ພາບລວມ' ? 'ເມນູຫຼັກ' : 'เมนูหลัก' %></div>

    <% if (can.viewDashboard) { %>
    <a href="/dashboard"
       class="sidebar-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
      <i class="fa-solid fa-chart-pie"></i>
      <span><%= t('nav.dashboard') %></span>
    </a>
    <% } %>

    <% if (can.viewOrders) { %>
    <a href="/orders"
       class="sidebar-link <%= currentPath.startsWith('/orders') ? 'active' : '' %>">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span><%= t('nav.orders') %></span>
    </a>
    <% } %>

    <% if (can.useScanner) { %>
    <a href="/scanner"
       class="sidebar-link <%= currentPath.startsWith('/scanner') ? 'active' : '' %>">
      <i class="fa-solid fa-qrcode"></i>
      <span><%= t('nav.scanner') %></span>
    </a>
    <% } %>

    <% if (can.viewTrips) { %>
    <a href="/trips"
       class="sidebar-link <%= currentPath.startsWith('/trips') ? 'active' : '' %>">
      <i class="fa-solid fa-truck-fast"></i>
      <span><%= t('nav.trips') %></span>
    </a>
    <% } %>

    <% if (can.manageDispatch) { %>
    <a href="/dispatch/sorting"
       class="sidebar-link <%= currentPath.startsWith('/dispatch') ? 'active' : '' %>">
      <i class="fa-solid fa-layer-group"></i>
      <span>ศูนย์คัดแยก</span>
    </a>
    <% } %>

    <%# Section: การเงิน %>
    <% if (can.viewCod || can.viewCustoms) { %>
    <div class="sidebar-section-title"><%= lang === 'lo' ? 'ການເງິນ / ດ່ານ' : 'การเงิน / ด่าน' %></div>

    <% if (can.viewCod) { %>
    <a href="/cod"
       class="sidebar-link <%= currentPath.startsWith('/cod') ? 'active' : '' %>">
      <i class="fa-solid fa-coins"></i>
      <span><%= t('nav.cod') %></span>
    </a>
    <% } %>

    <% if (can.viewFinancials) { %>
    <a href="/billing"
       class="sidebar-link <%= currentPath.startsWith('/billing') ? 'active' : '' %>">
      <i class="fa-solid fa-file-invoice-dollar"></i>
      <span><%= t('nav.billing') %></span>
    </a>
    <% } %>

    <% if (can.viewCustoms) { %>
    <a href="/customs"
       class="sidebar-link <%= currentPath.startsWith('/customs') ? 'active' : '' %>">
      <i class="fa-solid fa-stamp"></i>
      <span><%= t('nav.customs') %></span>
    </a>
    <% } %>

    <% if (can.viewFinancials) { %>
    <a href="/expenses"
       class="sidebar-link <%= (currentPath.startsWith('/expenses') && !currentPath.includes('/pl')) ? 'active' : '' %>">
      <i class="fa-solid fa-wallet text-amber-400"></i>
      <span>บัญชีรายจ่าย</span>
    </a>
    <a href="/expenses/pl"
       class="sidebar-link <%= currentPath.includes('/expenses/pl') ? 'active' : '' %>">
      <i class="fa-solid fa-chart-line text-emerald-400"></i>
      <span>รายงานกำไร-ขาดทุน</span>
    </a>
    <% } %>
    <% } %>

    <%# Section: จัดการ %>
    <div class="sidebar-section-title"><%= lang === 'lo' ? 'ຈັດການ' : 'จัดการ' %></div>

    <% if (can.viewCustomers) { %>
    <a href="/customers"
       class="sidebar-link <%= currentPath.startsWith('/customers') ? 'active' : '' %>">
      <i class="fa-solid fa-users"></i>
      <span><%= t('nav.customers') %></span>
    </a>
    <% } %>

    <%# ── CRM ลูกค้า Section ────────────────────────────────── %>
    <% if (can.viewCrm) { %>
    <div class="sidebar-section-title" style="margin-top:4px;"
         title="Omnichannel CRM">
      <%= lang === 'lo' ? 'CRM ລູກຄ້າ' : 'CRM ลูกค้า' %>
    </div>

    <a href="/crm"
       class="sidebar-link <%= currentPath.startsWith('/crm') && !currentPath.startsWith('/crm/inbox') ? 'active' : '' %>">
      <i class="fa-solid fa-headset" style="color:#818cf8;"></i>
      <span><%= lang === 'lo' ? 'ລະບົບ CRM ລູກຄ້າ' : 'ระบบ CRM ลูกค้า' %></span>
    </a>

    <% if (can.useInbox) { %>
    <a href="/crm/inbox"
       class="sidebar-link <%= currentPath.startsWith('/crm/inbox') ? 'active' : '' %>">
      <i class="fa-solid fa-inbox" style="color:#34d399;"></i>
      <span>
        <%= lang === 'lo' ? 'ກ່ອງຂໍ້ຄວາມ' : 'กล่องข้อความรวม' %>
        <%# Badge for unread count — rendered client-side via JS %>
        <span id="crm-unread-badge"
              style="display:none;margin-left:auto;background:#ef4444;color:#fff;
                     font-size:0.65rem;font-weight:700;padding:1px 6px;
                     border-radius:999px;min-width:18px;text-align:center;"
        ></span>
      </span>
    </a>
    <% } %>

    <% } %>

    <% if (can.manageBranches) { %>
    <a href="/branches"
       class="sidebar-link <%= currentPath.startsWith('/branches') ? 'active' : '' %>">
      <i class="fa-solid fa-store"></i>
      <span><%= t('nav.branches') %></span>
    </a>
    <a href="/riders"
       class="sidebar-link <%= currentPath.startsWith('/riders') ? 'active' : '' %>">
      <i class="fa-solid fa-motorcycle"></i>
      <span><%= t('nav.hqRiders') %></span>
    </a>
    <% } %>

    <% if (can.branchPortal && !can.manageBranches) { %>
    <a href="/branch/dashboard"
       class="sidebar-link <%= currentPath.startsWith('/branch') ? 'active' : '' %>">
      <i class="fa-solid fa-store"></i>
      <span>พอร์ทัลสาขา</span>
    </a>
    <% } %>

    <% if (can.viewPartner) { %>
    <a href="/partner"
       class="sidebar-link <%= currentPath.startsWith('/partner') ? 'active' : '' %>"
       title="ใบเสนอราคา Partner">
      <i class="fa-solid fa-calculator text-amber-400"></i>
      <span>Partner / ใบเสนอราคา</span>
    </a>
    <% } %>

    <% if (can.manageFreight) { %>
    <a href="/freight"
       class="sidebar-link <%= currentPath.startsWith('/freight') ? 'active' : '' %>"
       title="ร้านฝากส่ง">
      <i class="fa-solid fa-truck-ramp-box text-orange-400"></i>
      <span>ร้านฝากส่ง</span>
    </a>
    <% } %>

    <% if (can.manageUsers) { %>
    <a href="/users"
       class="sidebar-link <%= currentPath.startsWith('/users') ? 'active' : '' %>">
      <i class="fa-solid fa-user-tie"></i>
      <span><%= t('nav.users') %></span>
    </a>
    <% } %>

    <%# Section: ตั้งค่าหน้า Member — everything a customer eventually sees
        (rates, FX, banner, company profile, prohibited items, testimonials,
        online products, shops) collected in one page, kept visually apart
        from operational/back-office links above so front-of-house and
        back-office duties read as clearly separate. %>
    <% if (can.manageProducts) { %>
    <div class="sidebar-section-title"><%= lang === 'lo' ? 'ຕັ້ງຄ່າໜ້າ Member' : 'ตั้งค่าหน้า Member' %></div>

    <a href="/settings/member"
       class="sidebar-link <%= currentPath.startsWith('/settings/member') ? 'active' : '' %>"
       title="ตั้งค่าหน้าลูกค้า/สมาชิก">
      <i class="fa-solid fa-store text-amber-400"></i>
      <span><%= lang === 'lo' ? 'ຕັ້ງຄ່າໜ້າ Member' : 'ตั้งค่าหน้า Member' %></span>
    </a>
    <% } %>

    <%# Section: ระบบ %>
    <% if (['owner','admin','manager'].includes(userRole)) { %>
    <div class="sidebar-section-title"><%= lang === 'lo' ? 'ລະບົບ' : 'ระบบ' %></div>

    <a href="/whatsapp"
       class="sidebar-link <%= currentPath.startsWith('/whatsapp') ? 'active' : '' %>">
      <i class="fa-brands fa-whatsapp text-emerald-400"></i>
      <span>WhatsApp</span>
    </a>

    <% } %>

    <%# Section: อื่นๆ — มองเห็นได้ทุก role %>
    <div class="sidebar-section-title"><%= lang === 'lo' ? 'ອື່ນໆ' : 'อื่นๆ' %></div>

    <a href="/business-card" target="_blank"
       class="sidebar-link <%= currentPath === '/business-card' ? 'active' : '' %>">
      <i class="fa-solid fa-id-card"></i>
      <span><%= lang === 'lo' ? 'ນາມບັດດິຈິທັລ' : 'นามบัตรดิจิทัล' %></span>
    </a>

    <a href="/order-guide" target="_blank"
       class="sidebar-link <%= currentPath === '/order-guide' ? 'active' : '' %>">
      <i class="fa-solid fa-book-open"></i>
      <span><%= lang === 'lo' ? 'ຄູ່ມືສັ່ງຂອງອອນລາຍ' : 'คู่มือสั่งของออนไลน์' %></span>
    </a>

    <a href="/system-manual"
       class="sidebar-link <%= currentPath === '/system-manual' ? 'active' : '' %>">
      <i class="fa-solid fa-graduation-cap text-indigo-400"></i>
      <span><%= lang === 'lo' ? 'ຄູ່ມືລະບົບ (Role)' : 'คู่มือระบบ (ตำแหน่ง)' %></span>
    </a>

    <%# ── Language Toggle ────── %>
    <div class="mt-3 px-2">
      <a href="?lang=<%= otherLang %>"
         class="flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all text-sm font-semibold text-slate-300 hover:text-white">
        <span class="text-lg"><%= otherFlag %></span>
        <span><%= otherLabel %></span>
      </a>
    </div>

  </nav>

  <%# ── User Footer ──────────────────────────────────────── %>
  <div class="flex-shrink-0 p-4 border-t border-white/5">
    <div class="flex items-center gap-3">

      <%# Avatar with initials fallback %>
      <div style="position:relative;width:40px;height:40px;flex-shrink:0;overflow:hidden;border-radius:50%;">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center" style="position:absolute;inset:0;">
          <span class="text-white text-sm font-bold">
            <%= (currentUser?.name || currentUser?.username || '?').charAt(0).toUpperCase() %>
          </span>
        </div>
      </div>

      <div class="flex-1 min-w-0">
        <p class="text-white font-medium text-sm truncate">
          <%= currentUser?.name || currentUser?.username || 'ผู้ใช้' %>
        </p>
        <%# Role badge %>
        <span class="inline-block text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full mt-0.5
          <%= {
            owner:            'bg-yellow-500/20 text-yellow-300',
            admin:            'bg-red-500/20 text-red-400',
            manager:          'bg-purple-500/20 text-purple-400',
            accounting:       'bg-emerald-500/20 text-emerald-300',
            dispatcher:       'bg-blue-500/20 text-blue-400',
            finance:          'bg-emerald-500/20 text-emerald-400',
            customs:          'bg-amber-500/20 text-amber-400',
            warehouse_th:     'bg-orange-500/20 text-orange-400',
            warehouse_la:     'bg-orange-500/20 text-orange-400',
            branch_operator:  'bg-teal-500/20 text-teal-400',
            staff:            'bg-slate-500/20 text-slate-400',
            crm_admin:        'bg-indigo-500/20 text-indigo-400',
            crm_supervisor:   'bg-violet-500/20 text-violet-400',
            crm_agent:        'bg-cyan-500/20 text-cyan-400',
            sales_agent:      'bg-pink-500/20 text-pink-400',
            logistics_support:'bg-sky-500/20 text-sky-400',
            finance_support:  'bg-lime-500/20 text-lime-400',
          }[currentUser?.role] || 'bg-slate-500/20 text-slate-400' %>">
          <%= {
            owner:            '👑 Owner',
            admin:            '⚡ Admin',
            manager:          '👔 Manager',
            accounting:       '📊 บัญชี',
            dispatcher:       '🚛 Dispatcher',
            finance:          '💰 Finance',
            customs:          '🛃 Customs',
            warehouse_th:     '🏭 คลังไทย',
            warehouse_la:     '🏭 คลังลาว',
            branch_operator:  '🏪 สาขา',
            staff:            '👤 Staff',
            crm_admin:        '🛡️ CRM Admin',
            crm_supervisor:   '👁️ CRM Sup',
            crm_agent:        '💬 CRM Agent',
            sales_agent:      '💸 Sales',
            logistics_support:'🚚 Logistics',
            finance_support:  '💳 Finance',
          }[currentUser?.role] || currentUser?.role || 'User' %>
        </span>
      </div>

      <form action="/logout" method="post" class="flex-shrink-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="w-8 h-8 rounded-lg hover:bg-red-500/20 text-slate-400 hover:text-red-400 transition-all flex items-center justify-center"
                title="ออกจากระบบ">
          <i class="fa-solid fa-power-off text-sm"></i>
        </button>
      </form>
    </div>
  </div>
</aside>