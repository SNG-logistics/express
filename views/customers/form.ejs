<div class="max-w-3xl mx-auto animate-fade-in">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tight flex items-center gap-3">
                <span class="bg-amber-500 w-1.5 h-8 rounded-full inline-block"></span>
                <%= mode==='create' ? 'เพิ่มลูกค้าใหม่' : 'แก้ไขข้อมูลลูกค้า' %>
            </h1>
            <p class="text-slate-400 mt-2 ml-5 text-sm">
                <a href="/customers" class="hover:text-amber-400 transition-colors">จัดการลูกค้า</a>
                <i class="fa-solid fa-chevron-right text-[10px] mx-2 text-slate-600"></i>
                <%= mode==='create' ? 'Create' : 'Edit' %>
            </p>
        </div>
    </div>

    <% if(error) { %>
        <div
            class="p-4 mb-6 bg-red-500/10 text-red-200 border border-red-500/20 rounded-xl flex items-center gap-3 animate-pulse-once">
            <i class="fa-solid fa-circle-exclamation text-xl"></i>
            <%= error %>
        </div>
        <% } %>

            <div class="glass-panel-dark rounded-3xl shadow-2xl border border-white/5 overflow-hidden">
                <div class="p-6 border-b border-white/5 bg-black/20">
                    <h3 class="font-bold text-white flex items-center gap-2">
                        <span
                            class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-500 border border-amber-500/20">
                            <i class="fa-solid fa-circle-info"></i>
                        </span>
                        ข้อมูลลูกค้า
                    </h3>
                </div>

                <form action="/customers/<%= mode === 'edit' ? customer.id : '' %>" method="post" class="p-8 space-y-8">
                    <% if (mode==='create' ) { %>
                        <!-- Create Mode -->
                        <% } else { %>
                            <!-- Edit Mode -->
                            <input type="hidden" name="id" value="<%= customer.id %>">
                            <% } %>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <div class="grid md:grid-cols-2 gap-6">
                                    <div class="group">
                                        <label
                                            class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-amber-500 transition-colors">ประเภทลูกค้า
                                            <span class="text-amber-500">*</span></label>
                                        <div class="relative">
                                            <select name="type"
                                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white appearance-none focus:ring-amber-500 focus:border-amber-500 cursor-pointer hover:border-slate-600 transition-colors">
                                                <option value="shop" <%=customer.type==='shop' ? 'selected' : '' %>
                                                    >ร้านค้า (Shop)</option>
                                                <option value="person" <%=customer.type==='person' ? 'selected' : '' %>
                                                    >บุคคลธรรมดา (Person)</option>
                                            </select>
                                            <div
                                                class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-400">
                                                <i class="fa-solid fa-chevron-down text-xs"></i>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="group">
                                        <label
                                            class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-amber-500 transition-colors">ชื่อลูกค้า
                                            / ร้านค้า <span class="text-amber-500">*</span></label>
                                        <input type="text" name="name" value="<%= customer.name || '' %>" required
                                            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500 placeholder-slate-600 transition-colors"
                                            placeholder="เช่น ร้าน เจ๊แดง การค้า">
                                    </div>

                                    <div class="group">
                                        <label
                                            class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-amber-500 transition-colors">เลขผู้เสียภาษี
                                            (Tax ID)</label>
                                        <input type="text" name="tax_id" value="<%= customer.tax_id || '' %>"
                                            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500 placeholder-slate-600 transition-colors"
                                            placeholder="13 หลัก (ถ้ามี)">
                                    </div>

                                    <div class="group">
                                        <label
                                            class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-amber-500 transition-colors">เบอร์โทรศัพท์</label>
                                        <input type="text" name="phone" value="<%= customer.phone || '' %>"
                                            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500 placeholder-slate-600 transition-colors"
                                            placeholder="08x-xxx-xxxx">
                                    </div>

                                    <div class="md:col-span-2 group">
                                        <label
                                            class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-amber-500 transition-colors">Email</label>
                                        <input type="email" name="email" value="<%= customer.email || '' %>"
                                            class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-amber-500 focus:border-amber-500 placeholder-slate-600 transition-colors"
                                            placeholder="example@email.com">
                                    </div>
                                </div>

                                <div class="border-t border-white/5 pt-8 mt-4">
                                    <h3 class="font-bold text-white mb-6 flex items-center gap-2">
                                        <span
                                            class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center text-indigo-400 border border-indigo-500/20">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </span>
                                        ที่อยู่จัดส่ง
                                    </h3>
                                    <div class="grid md:grid-cols-2 gap-6">
                                        <div class="group">
                                            <label
                                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-indigo-400 transition-colors">ประเทศ</label>
                                            <div class="relative">
                                                <select name="country"
                                                    class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white appearance-none focus:ring-indigo-500 focus:border-indigo-500 cursor-pointer hover:border-slate-600 transition-colors">
                                                    <option value="Thailand" <%=(!customer.country ||
                                                        customer.country==='Thailand' ) ? 'selected' : '' %>>Thailand
                                                    </option>
                                                    <option value="Laos" <%=customer.country==='Laos' ? 'selected' : ''
                                                        %>>Laos</option>
                                                </select>
                                                <div
                                                    class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-400">
                                                    <i class="fa-solid fa-chevron-down text-xs"></i>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="group">
                                            <label
                                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-indigo-400 transition-colors">จังหวัด
                                                / แขวง</label>
                                            <input type="text" name="province" value="<%= customer.province || '' %>"
                                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-indigo-500 focus:border-indigo-500 placeholder-slate-600 transition-colors">
                                        </div>
                                        <div class="group">
                                            <label
                                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-indigo-400 transition-colors">เขต
                                                / อำเภอ / เมือง</label>
                                            <input type="text" name="city" value="<%= customer.city || '' %>"
                                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-indigo-500 focus:border-indigo-500 placeholder-slate-600 transition-colors">
                                        </div>
                                        <div class="md:col-span-2 group">
                                            <label
                                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2 group-focus-within:text-indigo-400 transition-colors">ที่อยู่ละเอียด</label>
                                            <textarea name="address" rows="3"
                                                class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:ring-indigo-500 focus:border-indigo-500 placeholder-slate-600 transition-colors"
                                                placeholder="บ้านเลขที่, ถนน, ซอย..."><%= customer.address || '' %></textarea>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center justify-end gap-3 pt-8 border-t border-white/5">
                                    <a href="/customers"
                                        class="px-6 py-3 rounded-xl text-slate-400 font-bold hover:bg-white/5 hover:text-white transition-all">ยกเลิก</a>
                                    <% if (mode==='edit' ) { %>
                                        <div class="flex-1"></div>
                                        <button type="button" onclick="confirmDelete('<%= customer.id %>')"
                                            class="px-6 py-3 rounded-xl text-red-400 hover:bg-red-500/10 border border-transparent hover:border-red-500/20 transition-all mr-auto font-medium">
                                            <i class="fa-solid fa-trash mr-2"></i> ลบลูกค้า
                                        </button>
                                        <% } %>
                                            <button type="submit" class="cta-primary px-8 py-3 flex items-center gap-2">
                                                <i class="fa-solid fa-save"></i> บันทึกข้อมูล
                                            </button>
                                </div>
                </form>
            </div>

            <% if (mode === 'edit') { %>
            <div id="member-link" class="glass-panel-dark rounded-3xl shadow-2xl border border-white/5 overflow-hidden mt-8">
                <div class="p-6 border-b border-white/5 bg-black/20">
                    <h3 class="font-bold text-white flex items-center gap-2">
                        <span class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-500 border border-emerald-500/20">
                            <i class="fa-solid fa-user-check"></i>
                        </span>
                        บัญชีสมาชิก (Member Portal)
                    </h3>
                </div>
                <div class="p-6">
                    <% if (memberLink.state === 'linked') { %>
                        <div class="flex items-center gap-3 text-emerald-400">
                            <i class="fa-solid fa-circle-check text-xl"></i>
                            <div>
                                <div class="font-bold">สมาชิกแล้ว ✓</div>
                                <div class="text-xs text-slate-400">
                                    <%= memberLink.account.first_name %> <%= memberLink.account.last_name || '' %>
                                    — สถานะ: <%= memberLink.account.status %>
                                </div>
                            </div>
                        </div>
                        <% if (!Number(customer.active)) { %>
                        <p class="text-xs text-amber-400 mt-3">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            ลูกค้ารายนี้ถูกปิดใช้งานแล้ว แต่ยังเชื่อมกับบัญชีสมาชิกอยู่ (เก็บประวัติไว้เผื่อกู้คืน)
                        </p>
                        <% } %>
                        <% if (user && ['owner', 'admin', 'manager'].includes(user.role)) { %>
                        <details class="mt-4">
                            <summary class="cursor-pointer text-sm text-red-300 hover:text-red-200">ยกเลิกการเชื่อมบัญชี</summary>
                            <form action="/customers/<%= customer.id %>/unlink-member" method="post"
                                onsubmit="return confirm('ยืนยันยกเลิกการเชื่อมบัญชีสมาชิกนี้กับลูกค้ารายนี้? บัญชีสมาชิกและข้อมูลลูกค้าจะไม่ถูกลบ');"
                                class="mt-2 space-y-2">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <textarea name="reason" required rows="2" placeholder="ระบุเหตุผลที่ยกเลิกการเชื่อม (จำเป็น)"
                                    class="w-full bg-slate-900/60 border border-slate-700 rounded-xl px-4 py-2.5 text-white text-sm placeholder-slate-600 focus:ring-red-500 focus:border-red-500"></textarea>
                                <button type="submit" class="px-5 py-2 rounded-xl bg-red-500/15 border border-red-500/30 text-red-300 text-sm font-bold hover:bg-red-500/25">
                                    ยืนยันยกเลิกการเชื่อม
                                </button>
                            </form>
                        </details>
                        <% } %>
                        <!-- Referral Reward Credit -->
                        <div class="border-t border-white/5 mt-5 pt-5">
                            <h4 class="text-sm font-bold text-slate-300 mb-3 flex items-center gap-2">
                                <i class="fa-solid fa-gift text-amber-400"></i>
                                เครดิตแนะนำเพื่อน (Referral Reward)
                            </h4>
                            <% const unredeemed = referralRewards || []; %>
                            <% if (unredeemed.length === 0) { %>
                                <p class="text-sm text-slate-500">ยังไม่มีเครดิตแนะนำเพื่อนที่รอใช้งาน</p>
                            <% } else { %>
                                <% const unredeemedTotal = unredeemed.reduce((sum, r) => sum + Number(r.amount_lak), 0); %>
                                <p class="text-sm text-slate-300 mb-3">
                                    คงเหลือ <strong class="text-amber-400"><%= unredeemedTotal.toLocaleString('th-TH') %> กีบ</strong>
                                    (<%= unredeemed.length %> รายการ)
                                </p>
                                <div class="space-y-2">
                                    <% unredeemed.forEach(r => { %>
                                    <div class="flex items-center justify-between bg-slate-900/60 border border-slate-700 rounded-xl px-4 py-2.5 gap-3">
                                        <div class="text-xs text-slate-400">
                                            <span class="text-white font-bold"><%= Number(r.amount_lak).toLocaleString('th-TH') %> กีบ</span>
                                            — <%= r.role === 'referrer' ? 'ผู้แนะนำ' : 'เพื่อนที่ถูกแนะนำ' %>
                                            <% if (r.triggering_job_no) { %> · งาน <%= r.triggering_job_no %><% } %>
                                            · <%= new Date(r.granted_at).toLocaleDateString('th-TH') %>
                                        </div>
                                        <form action="/customers/<%= customer.id %>/referral-rewards/<%= r.id %>/redeem" method="post"
                                              onsubmit="return confirm('ยืนยันว่าเครดิตนี้ถูกใช้แล้ว?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="px-3 py-1.5 rounded-lg bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-bold hover:bg-amber-500/25 whitespace-nowrap">
                                                ทำเครื่องหมายว่าใช้แล้ว
                                            </button>
                                        </form>
                                    </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    <% } else if (memberLink.state === 'linkable') { %>
                        <p class="text-sm text-slate-300 mb-4">
                            พบบัญชีสมาชิกที่ใช้เบอร์นี้แล้ว (<%= memberLink.account.first_name %> <%= memberLink.account.last_name || '' %>)
                            แต่ยังไม่ได้เชื่อมกับลูกค้ารายนี้
                        </p>
                        <form action="/customers/<%= customer.id %>/link-member" method="post"
                            onsubmit="return confirm('ยืนยันเชื่อมบัญชีสมาชิกนี้กับลูกค้ารายนี้?');">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="cta-primary px-6 py-2.5 text-sm">เชื่อมบัญชีที่มีอยู่</button>
                        </form>
                    <% } else if (memberLink.state === 'pending') { %>
                        <p class="text-sm text-amber-300 mb-4">
                            ลูกค้าเริ่มสมัครสมาชิกแล้วแต่ยังไม่ยืนยัน OTP ด้วยตนเอง
                            (พนักงานไม่สามารถยืนยันแทนได้ — ส่งลิงก์ให้ลูกค้ายืนยันเองอีกครั้ง)
                        </p>
                        <form action="/customers/<%= customer.id %>/invite-member" method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="cta-primary px-6 py-2.5 text-sm">ส่งลิงก์ยืนยันตัวตนอีกครั้ง</button>
                        </form>
                    <% } else if (memberLink.state === 'invitable') { %>
                        <p class="text-sm text-slate-400 mb-4">ลูกค้ารายนี้ยังไม่ได้เป็นสมาชิก ส่งคำเชิญสมัครสมาชิกผ่าน WhatsApp ได้</p>
                        <form action="/customers/<%= customer.id %>/invite-member" method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="cta-primary px-6 py-2.5 text-sm">
                                <i class="fa-brands fa-whatsapp mr-2"></i>เชิญสมัครสมาชิกทาง WhatsApp
                            </button>
                        </form>
                    <% } else if (memberLink.state === 'linked_elsewhere') { %>
                        <p class="text-sm text-red-300">เบอร์นี้เชื่อมกับลูกค้ารายอื่นในระบบสมาชิกแล้ว ไม่สามารถเชื่อมซ้ำได้ — กรุณาตรวจสอบข้อมูลลูกค้าซ้ำ</p>
                    <% } else if (memberLink.state === 'no_phone') { %>
                        <p class="text-sm text-slate-500">กรุณาระบุเบอร์โทรศัพท์ก่อน จึงจะสามารถเชิญ/เชื่อมบัญชีสมาชิกได้</p>
                    <% } else { %>
                        <p class="text-sm text-slate-500">บัญชีสมาชิกของเบอร์นี้ถูกปิดใช้งานอยู่</p>
                    <% } %>
                </div>
            </div>
            <% } %>

            <% if (mode==='edit' ) { %>
                <form id="deleteForm-<%= customer.id %>" action="/customers/<%= customer.id %>/delete" method="post"
                    class="hidden">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                </form>
                <script>
                    function confirmDelete(id) {
                        if (confirm('คุณแน่ใจหรือไม่ที่จะลบลูกค้ารายนี้?')) {
                            document.getElementById('deleteForm-' + id).submit();
                        }
                    }
                </script>
                <% } %>
</div>