<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">RESET PASSWORD</p>
    <h1>ลืมรหัสผ่าน</h1>
    <p>กรอกเบอร์โทรศัพท์ที่ลงทะเบียนไว้เพื่อรับรหัส OTP ทาง WhatsApp</p>
  </div>

  <% if (error) { %>
  <div class="portal-flash is-error">
    <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i><%= error %>
  </div>
  <% } %>

  <form class="card portal-form" action="/member/forgot-password" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>
      <span>เบอร์โทรศัพท์ (WhatsApp)</span>
      <input class="input-portal" name="phone" type="tel" placeholder="เช่น 0812345678" required autofocus>
    </label>

    <button class="btn-gold" type="submit" style="width: 100%; margin-top: 0.5rem;">
      <i class="fa-brands fa-whatsapp"></i> ส่งรหัส OTP ไปยัง WhatsApp
    </button>

    <div style="text-align: center; font-size: 0.85rem; color: var(--portal-text-dim); margin-top: 0.5rem;">
      <a href="/member/login" style="color: var(--portal-gold);"><i class="fa-solid fa-arrow-left"></i> กลับหน้าเข้าสู่ระบบ</a>
    </div>
  </form>
</section>
