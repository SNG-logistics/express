<div class="max-w-4xl mx-auto space-y-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-800 tracking-tight flex items-center gap-2">
        <i class="fa-solid fa-bolt text-yellow-500"></i> สแกนอัตโนมัติ (Auto-Scan)
      </h1>
      <p class="text-slate-500 text-sm mt-1">
        เปลี่ยนสถานะทันทีเมื่อสแกนพัสดุสำเร็จ (โหมดความเร็วสูง)
      </p>
    </div>
    <a href="/scanner" class="bg-white border border-slate-200 text-slate-600 px-4 py-2 rounded-xl text-sm font-bold shadow-sm hover:bg-slate-50 transition-colors flex items-center gap-2">
      <i class="fa-solid fa-arrow-left"></i> กลับศูนย์สแกน
    </a>
  </div>

  <!-- Settings Area -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Target Action Selection -->
      <div>
        <label class="block text-sm font-bold text-slate-700 mb-2">1. เลือกเป้าหมายการสแกน (Target Status)</label>
        <select id="targetStatus" class="w-full border border-slate-300 rounded-xl px-4 py-3 bg-slate-50 text-slate-800 font-medium focus:ring-2 focus:ring-red-500 outline-none transition-shadow" onchange="handleStatusChange()">
          <option value="">-- กรุณาเลือกสถานะ --</option>
          <% 
            const role = user.role;
            const isAdmin = ['admin','manager'].includes(role);
          %>
          
          <% if (isAdmin || role === 'warehouse_th') { %>
            <optgroup label="คลังสินค้า (ไทย)">
              <option value="RECEIVED_WH_TH">รับเข้าคลังต้นทาง (ไทย)</option>
            </optgroup>
          <% } %>
          
          <% if (isAdmin || role === 'warehouse_la') { %>
            <optgroup label="คลังสินค้า (ลาว)">
              <option value="RECEIVED_WH_LA">รับเข้าคลังต้นทาง (ลาว)</option>
            </optgroup>
          <% } %>
          
          <% if (isAdmin || ['dispatcher','driver_support'].includes(role)) { %>
            <optgroup label="พนักงานขับรถ / ขนส่ง">
              <option value="ON_TRUCK">สแกนขึ้นรถ (ON TRUCK)</option>
              <option value="OUT_FOR_DELIVERY">ออกจ่าย (OUT FOR DELIVERY)</option>
            </optgroup>
          <% } %>
          
          <% if (isAdmin || ['warehouse_th','warehouse_la','branch_operator'].includes(role)) { %>
            <optgroup label="ปลายทาง">
              <option value="AT_DEST_WH">รับลงรถเข้าคลังปลายทาง</option>
            </optgroup>
          <% } %>

          <% if (role === 'branch_operator') { %>
            <optgroup label="สาขา">
              <option value="BRANCH_RECEIVED">รับเข้าสาขา (BRANCH RECEIVED)</option>
            </optgroup>
          <% } %>

        </select>
      </div>

      <!-- Trip Selection (Conditionally visible) -->
      <div id="tripSelectionBlock" class="hidden">
        <label class="block text-sm font-bold text-slate-700 mb-2 text-blue-600">
          <i class="fa-solid fa-truck"></i> 2. เลือกรอบรถ (บังคับสำหรับขึ้นรถ)
        </label>
        <select id="tripId" class="w-full border-2 border-blue-200 rounded-xl px-4 py-3 bg-blue-50 text-blue-800 font-medium focus:ring-2 focus:ring-blue-500 outline-none">
          <option value="">-- เลือกรอบรถ (Trip) --</option>
          <% trips.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.trip_no %> (<%= t.driver_name || 'ไม่ระบุคนขับ' %>)</option>
          <% }) %>
        </select>
      </div>

    </div>
  </div>

  <!-- Scanner Modes Area -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
    
    <!-- Lock Overlay (if status not selected) -->
    <div id="scannerLock" class="absolute inset-0 bg-slate-900/10 backdrop-blur-[2px] z-10 rounded-2xl flex items-center justify-center transition-all">
      <div class="bg-white/90 px-6 py-4 rounded-2xl shadow-xl flex items-center gap-3 border border-slate-200">
        <div class="w-10 h-10 bg-red-100 text-red-600 rounded-full flex items-center justify-center animate-bounce">
          <i class="fa-solid fa-arrow-up"></i>
        </div>
        <p class="font-bold text-slate-800">กรุณาเลือกเป้าหมายการสแกนด้านบนก่อน</p>
      </div>
    </div>

    <!-- Mode 1: Barcode Reader (Laser/USB) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
      <div class="bg-slate-800 text-white p-4 flex items-center justify-between">
        <h3 class="font-bold flex items-center gap-2">
          <i class="fa-solid fa-barcode"></i> โหมดเครื่องยิงเลเซอร์
        </h3>
        <button id="btnFocusBarcode" class="bg-blue-600 hover:bg-blue-500 text-white px-3 py-1 text-xs rounded-lg font-bold transition-colors">
          เริ่มใช้งาน (Focus)
        </button>
      </div>
      <div class="p-8 flex-grow flex flex-col items-center justify-center text-center bg-slate-50 relative cursor-pointer" onclick="document.getElementById('barcodeInput').focus()">
        <div id="barcodeStatusIcon" class="w-20 h-20 bg-slate-200 text-slate-400 rounded-full flex items-center justify-center text-3xl mb-4 transition-colors">
          <i class="fa-solid fa-keyboard"></i>
        </div>
        <h4 class="font-bold text-slate-700 text-lg">พร้อมรับสัญญาณเครื่องสแกน</h4>
        <p class="text-sm text-slate-500 mt-2">คลิกที่พื้นที่นี้ แล้วใช้เครื่องยิงบาร์โค้ดยิงได้เลย</p>
        
        <!-- Hidden Input to catch scanner input -->
        <input type="text" id="barcodeInput" class="opacity-0 absolute inset-0 w-full h-full cursor-pointer z-0" autocomplete="off" autofocus>
      </div>
    </div>

    <!-- Mode 2: Camera (QR Code) -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
      <div class="bg-slate-800 text-white p-4 flex items-center justify-between">
        <h3 class="font-bold flex items-center gap-2">
          <i class="fa-solid fa-camera"></i> โหมดกล้องมือถือ
        </h3>
        <button id="btnToggleCamera" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1 text-xs rounded-lg font-bold transition-colors" onclick="toggleCamera()">
          เปิดกล้อง
        </button>
      </div>
      <div class="p-0 flex-grow bg-slate-900 relative min-h-[300px]" id="qr-reader-container">
        <!-- HTML5 QR Code Scanner mounts here -->
        <div id="qr-reader" class="w-full h-full border-none"></div>
        <div id="cameraPlaceholder" class="absolute inset-0 flex items-center justify-center text-slate-500">
          <div class="text-center">
            <i class="fa-solid fa-qrcode text-4xl mb-2 opacity-50"></i>
            <p class="text-sm">กดปุ่ม "เปิดกล้อง" เพื่อเริ่มสแกนด้วยมือถือ</p>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Status / Result Flash Area -->
  <div id="resultFlash" class="bg-slate-100 rounded-2xl p-6 text-center shadow-sm border-2 border-slate-200 transition-all duration-300">
    <div class="text-5xl mb-3" id="resultIcon"><i class="fa-solid fa-circle-notch fa-spin text-slate-400"></i></div>
    <h2 id="resultTitle" class="text-2xl font-black text-slate-700">รอการสแกน...</h2>
    <p id="resultDesc" class="text-slate-500 mt-1 font-medium">ข้อมูลพัสดุจะแสดงที่นี่</p>
  </div>

  <!-- Scan Log -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="bg-slate-50 border-b border-slate-200 px-6 py-4 flex justify-between items-center">
      <h3 class="font-bold text-slate-700">
        <i class="fa-solid fa-list-check mr-2"></i> ประวัติการสแกนอัตโนมัติ (ล่าสุด)
      </h3>
      <span class="bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded-full" id="scanCount">0 รายการ</span>
    </div>
    <div class="p-0 max-h-64 overflow-y-auto">
      <table class="w-full text-left text-sm">
        <tbody id="scanLogTable" class="divide-y divide-slate-100">
          <tr>
            <td colspan="3" class="px-6 py-8 text-center text-slate-400">ยังไม่มีข้อมูลการสแกนในรอบนี้</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Audio Assets -->
<audio id="sndSuccess" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>
<audio id="sndError" src="https://assets.mixkit.co/active_storage/sfx/2955/2955-preview.mp3" preload="auto"></audio>

<!-- Scripts -->
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
<script>
  // UI Elements
  const targetStatusObj = document.getElementById('targetStatus');
  const tripSelectionBlock = document.getElementById('tripSelectionBlock');
  const tripIdObj = document.getElementById('tripId');
  const scannerLock = document.getElementById('scannerLock');
  const barcodeInput = document.getElementById('barcodeInput');
  const barcodeStatusIcon = document.getElementById('barcodeStatusIcon');
  
  const resultFlash = document.getElementById('resultFlash');
  const resultIcon = document.getElementById('resultIcon');
  const resultTitle = document.getElementById('resultTitle');
  const resultDesc = document.getElementById('resultDesc');
  const scanLogTable = document.getElementById('scanLogTable');
  const scanCount = document.getElementById('scanCount');
  
  const sndSuccess = document.getElementById('sndSuccess');
  const sndError = document.getElementById('sndError');

  let html5QrcodeScanner = null;
  let isCameraRunning = false;
  let isProcessing = false;
  let scanCounter = 0;

  // 1. Handle Status Change
  function handleStatusChange() {
    const val = targetStatusObj.value;
    if (val) {
      scannerLock.classList.add('opacity-0', 'pointer-events-none');
      barcodeInput.focus();
    } else {
      scannerLock.classList.remove('opacity-0', 'pointer-events-none');
      barcodeInput.blur();
    }

    if (val === 'ON_TRUCK') {
      tripSelectionBlock.classList.remove('hidden');
    } else {
      tripSelectionBlock.classList.add('hidden');
      tripIdObj.value = '';
    }
  }

  // Focus Management for Barcode Input
  document.getElementById('btnFocusBarcode').addEventListener('click', () => {
    barcodeInput.focus();
  });
  
  barcodeInput.addEventListener('focus', () => {
    barcodeStatusIcon.className = 'w-20 h-20 rounded-full flex items-center justify-center text-3xl mb-4 transition-colors bg-blue-100 text-blue-600 animate-pulse';
  });
  barcodeInput.addEventListener('blur', () => {
    barcodeStatusIcon.className = 'w-20 h-20 rounded-full flex items-center justify-center text-3xl mb-4 transition-colors bg-slate-200 text-slate-400';
  });

  // 2. Barcode Input Submission
  barcodeInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const barcode = this.value.trim();
      this.value = ''; // clear immediately
      if (barcode) {
        processAutoScan(barcode);
      }
    }
  });

  // 3. Camera Toggle
  function toggleCamera() {
    if (isCameraRunning) {
      if (html5QrcodeScanner) {
        html5QrcodeScanner.clear().catch(err => console.error(err));
      }
      isCameraRunning = false;
      document.getElementById('btnToggleCamera').textContent = 'เปิดกล้อง';
      document.getElementById('btnToggleCamera').className = 'bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1 text-xs rounded-lg font-bold transition-colors';
      document.getElementById('cameraPlaceholder').classList.remove('hidden');
    } else {
      if (!targetStatusObj.value) {
        alert('กรุณาเลือกเป้าหมายการสแกนก่อนเปิดกล้อง');
        return;
      }
      
      document.getElementById('cameraPlaceholder').classList.add('hidden');
      document.getElementById('btnToggleCamera').textContent = 'ปิดกล้อง';
      document.getElementById('btnToggleCamera').className = 'bg-red-600 hover:bg-red-500 text-white px-3 py-1 text-xs rounded-lg font-bold transition-colors';
      isCameraRunning = true;

      html5QrcodeScanner = new Html5QrcodeScanner(
        "qr-reader", 
        { fps: 10, qrbox: { width: 300, height: 150 }, supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA] }, 
        false
      );

      html5QrcodeScanner.render((decodedText) => {
        // Debounce camera scans
        if (!isProcessing) {
          processAutoScan(decodedText);
        }
      }, (error) => {
        // ignore scan errors (running continuously)
      });
    }
  }

  // 4. Main Auto-Scan AJAX Logic
  async function processAutoScan(barcode) {
    if (isProcessing) return;
    
    const targetStatus = targetStatusObj.value;
    const tripId = tripIdObj.value;

    if (!targetStatus) {
      showError('ยังไม่ได้เลือกสถานะเป้าหมาย!');
      return;
    }

    if (targetStatus === 'ON_TRUCK' && !tripId) {
      showError('กรุณาเลือกรอบรถ (Trip) ก่อนสแกนขึ้นรถ!');
      return;
    }

    isProcessing = true;
    
    // Show Loading
    resultFlash.className = 'bg-blue-50 rounded-2xl p-6 text-center shadow-sm border-2 border-blue-200 transition-all duration-300';
    resultIcon.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-blue-500"></i>';
    resultTitle.className = 'text-2xl font-black text-blue-700';
    resultTitle.textContent = `กำลังประมวลผล ${barcode}...`;
    resultDesc.textContent = 'โปรดรอสักครู่';

    try {
      const res = await fetch('/scanner/auto-update', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ barcode, target_status: targetStatus, trip_id: tripId })
      });

      const data = await res.json();

      if (data.success) {
        showSuccess(data.jobNo, data.message);
        addLog(data.jobNo, data.newStatus, true, data.message);
      } else {
        showError(data.message, barcode);
        addLog(barcode, targetStatus, false, data.message);
      }
    } catch (err) {
      console.error(err);
      showError('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', barcode);
      addLog(barcode, targetStatus, false, 'Connection Error');
    } finally {
      // Re-focus the barcode input so user can keep scanning
      setTimeout(() => {
        isProcessing = false;
        if (!isCameraRunning) barcodeInput.focus();
      }, 800); // Wait almost a second before allowing next scan to prevent double rapid scans
    }
  }

  // 5. Visual & Audio Feedback
  function showSuccess(jobNo, message) {
    sndSuccess.currentTime = 0;
    sndSuccess.play().catch(e => console.log('Audio error:', e));

    resultFlash.className = 'bg-emerald-50 rounded-2xl p-6 text-center shadow-sm border-2 border-emerald-500 transition-all duration-300 transform scale-105';
    resultIcon.innerHTML = '<i class="fa-solid fa-check-circle text-emerald-500"></i>';
    resultTitle.className = 'text-3xl font-black text-emerald-700';
    resultTitle.textContent = jobNo;
    resultDesc.className = 'text-emerald-600 mt-1 font-bold';
    resultDesc.textContent = message;

    setTimeout(() => {
      resultFlash.classList.remove('scale-105');
    }, 200);
  }

  function showError(message, jobNo = 'ผิดพลาด') {
    sndError.currentTime = 0;
    sndError.play().catch(e => console.log('Audio error:', e));

    resultFlash.className = 'bg-red-50 rounded-2xl p-6 text-center shadow-sm border-2 border-red-500 transition-all duration-300 transform -translate-x-2';
    resultIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-red-500"></i>';
    resultTitle.className = 'text-2xl font-black text-red-700';
    resultTitle.textContent = jobNo;
    resultDesc.className = 'text-red-600 mt-1 font-bold';
    resultDesc.textContent = message;

    setTimeout(() => {
      resultFlash.classList.remove('-translate-x-2');
    }, 150);
    
    // If error, maybe pause camera scanner briefly to let user read
    if (isCameraRunning && html5QrcodeScanner) {
      html5QrcodeScanner.pause();
      setTimeout(() => {
        html5QrcodeScanner.resume();
      }, 3000);
    }
  }

  function addLog(jobNo, status, success, message) {
    if (scanCounter === 0) {
      scanLogTable.innerHTML = ''; // clear empty placeholder
    }
    scanCounter++;
    scanCount.textContent = `${scanCounter} รายการ`;

    const tr = document.createElement('tr');
    if (success) {
      tr.innerHTML = `
        <td class="px-6 py-3 border-b border-slate-100 font-mono font-bold text-slate-800">${jobNo}</td>
        <td class="px-6 py-3 border-b border-slate-100 text-emerald-600 font-bold"><i class="fa-solid fa-check-circle mr-1"></i> ${status}</td>
        <td class="px-6 py-3 border-b border-slate-100 text-slate-500 text-xs text-right">${new Date().toLocaleTimeString()}</td>
      `;
    } else {
      tr.innerHTML = `
        <td class="px-6 py-3 border-b border-slate-100 font-mono font-bold text-red-600">${jobNo}</td>
        <td class="px-6 py-3 border-b border-slate-100 text-red-600 font-bold" colspan="2"><i class="fa-solid fa-xmark mr-1"></i> ${message}</td>
      `;
      tr.classList.add('bg-red-50/50');
    }
    
    scanLogTable.insertBefore(tr, scanLogTable.firstChild);
  }

</script>
