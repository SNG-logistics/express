<%#
  views/scanner/screening.ejs — Screening Panel
  Data: queue[], stats{}, user

  Workflow per parcel:
  1. View order info (sender/receiver/weight/dimensions/fragile/photo)
  2. Enter actual weight (if different from declared)
  3. Select result: PASSED / CUSTOMS_REQUIRED / REJECTED
  4. Add flags: OVERSIZED, FRAGILE, HAZMAT, LIQUID, ELECTRONIC, BATTERY, FOOD
  5. AJAX submit → auto-advance to next in queue
%>

<div class="max-w-4xl mx-auto space-y-5" x-data="screeningApp()" x-init="init()">

  <%# Header + Stats %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/scanner" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all">
        <i class="fa-solid fa-arrow-left text-sm"></i>
      </a>
      <div>
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-shield-halved text-emerald-400"></i> คัดกรองพัสดุ
        </h2>
        <p class="text-slate-400 text-xs mt-0.5">ชั่งน้ำหนัก + ตรวจสภาพ + อนุมัติ/ปฏิเสธ</p>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="text-center">
        <div class="text-2xl font-black text-amber-400"><%= stats.pending || 0 %></div>
        <div class="text-[10px] text-slate-500 uppercase">รอคัดกรอง</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-black text-emerald-400"><%= stats.passed_today || 0 %></div>
        <div class="text-[10px] text-slate-500 uppercase">ผ่านวันนี้</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-black text-red-400"><%= stats.rejected_today || 0 %></div>
        <div class="text-[10px] text-slate-500 uppercase">ปฏิเสธ</div>
      </div>
    </div>
  </div>

  <% if (queue.length === 0) { %>
  <%# Empty state %>
  <div class="glass-panel-dark rounded-2xl p-12 text-center border border-white/8">
    <i class="fa-solid fa-clipboard-check text-5xl text-emerald-400/20 mb-4 block"></i>
    <h3 class="text-white font-bold text-lg mb-2">ไม่มีพัสดุรอคัดกรอง 🎉</h3>
    <p class="text-slate-400 text-sm">พัสดุทั้งหมดผ่านการคัดกรองแล้ว</p>
    <a href="/scanner" class="inline-block mt-4 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-slate-300 hover:text-white text-sm transition-all">
      ← กลับหน้าสแกน
    </a>
  </div>
  <% } else { %>

  <%# Active Screening Card %>
  <div class="glass-panel-dark rounded-2xl overflow-hidden border-2 transition-all duration-200"
       :class="processing ? 'border-amber-500/30' : 'border-emerald-500/20'">

    <%# Order Header %>
    <div class="flex items-center justify-between px-5 py-4 border-b border-white/6 bg-emerald-500/5">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-500/25 flex items-center justify-center">
          <span class="font-black text-emerald-400 text-sm" x-text="currentIndex + 1"></span>
        </div>
        <div>
          <div class="font-mono font-black text-white text-xl" x-text="current?.job_no"></div>
          <div class="text-slate-400 text-xs" x-text="current?.direction === 'TH_TO_LA' ? '🇹🇭 → 🇱🇦' : '🇱🇦 → 🇹🇭'"></div>
        </div>
      </div>
      <div class="flex items-center gap-2 text-slate-500 text-xs">
        <span x-text="currentIndex + 1"></span>/<span x-text="queue.length"></span>
      </div>
    </div>

    <%# Info Grid %>
    <div class="px-5 py-4 grid grid-cols-2 sm:grid-cols-4 gap-4 border-b border-white/5">
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ผู้ส่ง</div>
        <div class="text-white font-semibold text-sm" x-text="current?.sender_name || '–'"></div>
      </div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ผู้รับ</div>
        <div class="text-white font-semibold text-sm" x-text="current?.receiver_name || '–'"></div>
      </div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">น้ำหนักประกาศ</div>
        <div class="text-white font-bold text-sm" x-text="current?.declared_weight ? current.declared_weight + ' กก.' : '–'"></div>
      </div>
      <div>
        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">ขนาด (กxสxล)</div>
        <div class="text-white text-sm font-mono" x-text="current?.declared_size || '–'"></div>
      </div>
    </div>

    <%# Tags %>
    <div class="px-5 py-3 border-b border-white/5 flex flex-wrap gap-2">
      <template x-if="current?.source_type">
        <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">
          <i class="fa-solid fa-tag mr-1 text-slate-500"></i><span x-text="current.source_type"></span>
        </span>
      </template>
      <template x-if="current?.is_fragile">
        <span class="text-[10px] px-2 py-0.5 rounded bg-red-500/10 border border-red-500/20 text-red-300 font-bold">
          ⚠️ FRAGILE
        </span>
      </template>
      <template x-if="current?.requires_customs">
        <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/10 border border-amber-500/20 text-amber-300">
          <i class="fa-solid fa-stamp mr-1"></i>ศุลกากร
        </span>
      </template>
      <template x-if="current?.cod_amount > 0">
        <span class="text-[10px] px-2.5 py-0.5 rounded bg-amber-500/10 border border-amber-500/20 text-amber-300 font-bold">
          COD ฿<span x-text="Number(current.cod_amount).toLocaleString()"></span>
        </span>
      </template>
      <template x-if="current?.item_description">
        <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300 max-w-[200px] truncate">
          📦 <span x-text="current.item_description?.substring(0,40)"></span>
        </span>
      </template>
    </div>

    <%# Actual Weight Input %>
    <div class="px-5 py-4 border-b border-white/5">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-[10px] text-slate-500 uppercase font-bold mb-2">
            <i class="fa-solid fa-scale-balanced mr-1"></i> น้ำหนักจริง (กก.)
          </label>
          <div class="relative">
            <input type="number" step="0.01" x-model="actualWeight"
              class="w-full bg-slate-800 text-white text-xl font-bold rounded-xl border-2 border-white/10 px-4 py-3 focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500/30 focus:outline-none transition-all text-center"
              placeholder="0.00">
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm">กก.</span>
          </div>
          <template x-if="current?.declared_weight && actualWeight && Math.abs(Number(actualWeight) - Number(current.declared_weight)) > 0.5">
            <div class="mt-1.5 flex items-center gap-1 text-amber-400 text-xs">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <span>ต่างจากน้ำหนักประกาศ <span x-text="Math.abs(Number(actualWeight) - Number(current.declared_weight)).toFixed(2)"></span> กก.</span>
            </div>
          </template>
        </div>
        <div>
          <label class="block text-[10px] text-slate-500 uppercase font-bold mb-2">หมายเหตุ</label>
          <textarea x-model="note" rows="2"
            class="w-full bg-slate-800 text-white text-sm rounded-xl border border-white/10 px-3 py-2.5 focus:ring-1 focus:ring-emerald-500/50 focus:outline-none resize-none transition-all"
            placeholder="ระบุรายละเอียดเพิ่มเติม (ถ้ามี)"></textarea>
        </div>
      </div>
    </div>

    <%# Flags Selection %>
    <div class="px-5 py-4 border-b border-white/5">
      <div class="text-[10px] text-slate-500 uppercase font-bold mb-3">
        <i class="fa-solid fa-tags mr-1"></i> Flags (เลือกได้หลายอัน)
      </div>
      <div class="flex flex-wrap gap-2">
        <template x-for="f in flagOptions" :key="f.value">
          <button type="button" @click="toggleFlag(f.value)"
            :class="selectedFlags.includes(f.value)
              ? 'bg-cyan-500/20 border-cyan-500/40 text-cyan-300 ring-1 ring-cyan-500/20'
              : 'bg-white/3 border-white/10 text-slate-400 hover:bg-white/8'"
            class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer">
            <span x-text="f.icon"></span>
            <span x-text="f.label"></span>
          </button>
        </template>
      </div>
    </div>

    <%# Action Buttons %>
    <div class="px-5 py-4 flex gap-3">
      <button @click="submit('PASSED')" :disabled="processing"
        class="flex-1 py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all disabled:opacity-40
               bg-gradient-to-r from-emerald-500 to-teal-600 text-white hover:shadow-emerald-500/25 hover:shadow-lg active:scale-[0.98]">
        <template x-if="processing"><i class="fa-solid fa-spinner fa-spin"></i></template>
        <template x-if="!processing"><span>✅ ผ่าน (PASS)</span></template>
      </button>
      <button @click="submit('CUSTOMS_REQUIRED')" :disabled="processing"
        class="px-5 py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all disabled:opacity-40
               bg-amber-500/15 border border-amber-500/25 text-amber-300 hover:bg-amber-500/25 active:scale-[0.98]">
        <i class="fa-solid fa-stamp"></i> ศุลกากร
      </button>
      <button @click="submit('REJECTED')" :disabled="processing"
        class="px-5 py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all disabled:opacity-40
               bg-red-500/15 border border-red-500/25 text-red-300 hover:bg-red-500/25 active:scale-[0.98]">
        <i class="fa-solid fa-ban"></i> ปฏิเสธ
      </button>
      <button @click="skip()" :disabled="processing"
        class="px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white text-sm transition-all active:scale-[0.98]">
        ข้าม →
      </button>
    </div>
  </div>

  <%# Queue List %>
  <div class="glass-panel-dark rounded-2xl overflow-hidden border border-white/8">
    <div class="flex items-center justify-between px-5 py-3 border-b border-white/6">
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <i class="fa-solid fa-list text-slate-400"></i> คิวพัสดุ (<%= queue.length %>)
      </h3>
    </div>
    <div class="divide-y divide-white/5 max-h-60 overflow-y-auto">
      <% queue.forEach((o, i) => { %>
      <button @click="jumpTo(<%= i %>)"
        class="w-full flex items-center justify-between px-5 py-2.5 hover:bg-white/5 transition-colors text-left"
        :class="currentIndex === <%= i %> ? 'bg-emerald-500/5 border-l-2 border-emerald-400 font-bold' : ''">
        <%# Note: IDE may show false-positive JS parse errors on EJS tags inside Alpine attributes — safe to ignore %>
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-5 rounded-md bg-white/5 flex items-center justify-center text-[10px] text-slate-500 font-bold"><%= i+1 %></span>
          <span class="font-mono font-bold text-white text-xs"><%= o.job_no %></span>
          <span class="text-slate-500 text-[10px]"><%= o.sender_name %> → <%= o.receiver_name %></span>
        </div>
        <div class="flex items-center gap-2">
          <% if (o.declared_weight) { %>
          <span class="text-[10px] text-slate-500"><%= o.declared_weight %> กก.</span>
          <% } %>
          <% if (o.is_fragile) { %>
          <span class="text-[10px] text-red-400">⚠️</span>
          <% } %>
          <% if (o.cod_amount > 0) { %>
          <span class="text-[10px] text-amber-400">COD</span>
          <% } %>
        </div>
      </button>
      <% }); %>
    </div>
  </div>

  <% } %>

  <%# Toast %>
  <div x-show="toast" x-cloak x-transition
       :class="toast?.type === 'error' ? 'bg-red-500/20 border-red-500/40 text-red-300' : 'bg-emerald-500/20 border-emerald-500/40 text-emerald-300'"
       class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-5 py-3 rounded-2xl border font-semibold shadow-xl backdrop-blur-lg text-sm">
    <i class="fa-solid" :class="toast?.type === 'error' ? 'fa-circle-xmark' : 'fa-circle-check'"></i>
    <span x-text="toast?.msg"></span>
  </div>

</div>

<%# Hidden data element avoids EJS-in-script IDE parse errors %>
<div id="__screening_data__"
     data-csrf="<%= csrfToken %>"
     data-queue="<%- JSON.stringify(queue).replace(/"/g, '&quot;') %>"
     hidden></div>

<script>
// @ts-nocheck
const __d = document.getElementById('__screening_data__');
const CSRF_TOKEN = __d.dataset.csrf;
const QUEUE_DATA = JSON.parse(__d.dataset.queue);

function jumpTo(idx) {
  const el = document.querySelector('[x-data]');
  if (el?._x_dataStack) {
    el._x_dataStack[0].currentIndex = idx;
    el._x_dataStack[0].resetForm();
  }
}

function screeningApp() {
  return {
    queue: QUEUE_DATA,
    currentIndex: 0,
    actualWeight: '',
    note: '',
    selectedFlags: [],
    processing: false,
    toast: null,

    flagOptions: [
      { value:'OVERSIZED',  icon:'📐', label:'ขนาดใหญ่' },
      { value:'FRAGILE',    icon:'⚠️', label:'แตกหักง่าย' },
      { value:'HAZMAT',     icon:'☣️', label:'อันตราย' },
      { value:'LIQUID',     icon:'💧', label:'ของเหลว' },
      { value:'ELECTRONIC', icon:'🔌', label:'อิเล็กทรอนิกส์' },
      { value:'BATTERY',    icon:'🔋', label:'แบตเตอรี่' },
      { value:'FOOD',       icon:'🍱', label:'อาหาร' },
      { value:'MEDICINE',   icon:'💊', label:'ยา/เวชภัณฑ์' },
    ],

    get current() {
      return this.queue[this.currentIndex] || null;
    },

    init() {
      if (this.current?.declared_weight) {
        this.actualWeight = this.current.declared_weight;
      }
    },

    toggleFlag(val) {
      const idx = this.selectedFlags.indexOf(val);
      if (idx >= 0) this.selectedFlags.splice(idx, 1);
      else this.selectedFlags.push(val);
    },

    resetForm() {
      this.actualWeight = this.current?.declared_weight || '';
      this.note = '';
      this.selectedFlags = [];
      // Auto-add FRAGILE flag if order is marked fragile
      if (this.current?.is_fragile) {
        this.selectedFlags.push('FRAGILE');
      }
    },

    skip() {
      if (this.currentIndex < this.queue.length - 1) {
        this.currentIndex++;
        this.resetForm();
      }
    },

    async submit(result) {
      if (!this.current || this.processing) return;
      // Require note for rejection
      if (result === 'REJECTED' && !this.note.trim()) {
        this.showToast({ type: 'error', msg: 'กรุณาระบุเหตุผลที่ปฏิเสธ' });
        return;
      }

      this.processing = true;
      try {
        const body = {
          result,
          actual_weight: this.actualWeight || '',
          note: this.note,
          flags: this.selectedFlags,
        };
        const res = await fetch('/scanner/screening/' + this.current.id, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (data.success) {
          const icon = result === 'PASSED' ? '✅' : result === 'REJECTED' ? '❌' : '⚠️';
          this.showToast({ type: result === 'REJECTED' ? 'error' : 'ok', msg: icon + ' ' + data.message });

          // Remove from queue and proceed
          this.queue.splice(this.currentIndex, 1);
          if (this.currentIndex >= this.queue.length && this.queue.length > 0) {
            this.currentIndex = this.queue.length - 1;
          }
          this.resetForm();

          if (this.queue.length === 0) {
            setTimeout(() => location.reload(), 2000);
          }
        } else {
          this.showToast({ type: 'error', msg: data.message });
        }
      } catch {
        this.showToast({ type: 'error', msg: 'เกิดข้อผิดพลาดในการเชื่อมต่อ' });
      } finally {
        this.processing = false;
      }
    },

    showToast(t) {
      this.toast = t;
      setTimeout(() => { this.toast = null; }, 3500);
    },
  };
}
</script>
