<%
  // company_settings uses a _th/_la country-entity suffix, but the i18n
  // language code is 'th'/'lo' — 'lo' never matches '_la', so this mapping
  // is needed or the Lao view silently falls back to Thai company data.
  const companySuffix = lang === 'lo' ? 'la' : 'th';
  const homeMember = typeof portalCurrentUser !== 'undefined' ? portalCurrentUser : null;
  const companyName = company['company_name_' + companySuffix] || company.company_name_th || 'SNG Express';
  const companyAddress = company['company_address_' + companySuffix] || company.company_address_th || '';
  // The phone and email used to read the shared key only, so a Lao reader got
  // a Lao address next to a Thai mobile — and the numbers typed into Settings
  // changed nothing here.
  const contactPhone = companyPhone(company, lang);
  const contactEmail = companyEmail(company, lang);
%>
<section class="portal-shell home-page">
  <header class="home-hero">
    <p class="eyebrow">SNG EXPRESS</p>
    <h1><%= t('portal.heroTitle') %></h1>
    <p class="home-hero-sub"><%= t('portal.heroSubtitle') %></p>
    <ul class="home-lanes" aria-label="<%= t('portal.laneTitle') %>">
      <li><span class="lane-flag" aria-hidden="true"></span> → <span class="lane-flag is-laos" aria-hidden="true"></span> <%= t('order.thToLa') %></li>
      <li><span class="lane-flag is-laos" aria-hidden="true"></span> → <span class="lane-flag" aria-hidden="true"></span> <%= t('order.laToTh') %></li>
    </ul>
  </header>

  <form class="home-track" action="/track" method="get" data-track-form>
    <label for="home-track-q"><%= t('portal.trackLabel') %></label>
    <div class="home-track-row">
      <input
        id="home-track-q"
        class="input-portal"
        type="text"
        name="q"
        placeholder="SNG-XXXXXX"
        autocomplete="off"
        inputmode="search"
        required
      >
      <button class="home-track-button" type="submit">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span><%= t('common.search') %></span>
      </button>
    </div>
    <div class="home-recent" data-recent hidden>
      <span class="home-recent-label"><%= t('portal.recentSearches') %></span>
      <div class="home-recent-list" data-recent-list></div>
      <button class="home-recent-clear" type="button" data-recent-clear><%= t('portal.clearRecent') %></button>
    </div>
  </form>

  <%#
    Promo banner — the visual hook for the service marketing leads with. Shown
    only when staff have uploaded one: an empty 16:9 frame would be a hole in the
    middle of the home page. Links to the public catalogue rather than the member
    one, so tapping it never lands on a login wall.
  %>
  <% const homeBanner = company.home_banner_path; %>
  <% if (homeBanner) { %>
  <a class="home-banner" href="/online">
    <img src="<%= homeBanner %>" alt="<%= t('portal.bannerAlt') %>" decoding="async">
    <span class="home-banner-cta">
      <%= t('portal.bannerCta') %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </span>
  </a>
  <% } %>

  <%# Horoscope feature promo banner — shown only when staff have uploaded
      one, same as the shopping banner above. Links straight to the
      login-gated /member/horoscope; a guest who taps it is sent to log in
      first (same as tapping the account icon), which is expected since the
      horoscope page itself has no public/guest mode. %>
  <% const horoscopeBanner = company.horoscope_banner_path; %>
  <% if (horoscopeBanner) { %>
  <a class="home-banner" href="/member/horoscope">
    <img src="<%= horoscopeBanner %>" alt="<%= t('portal.horoscopeBannerAlt') %>" decoding="async">
    <span class="home-banner-cta">
      <%= t('portal.horoscopeBannerCta') %> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </span>
  </a>
  <% } %>

  <div class="home-section-heading">
    <h2><%= t('portal.servicesTitle') %></h2>
  </div>

  <%# The service marketing leads with goes first and reads as the offer, not as
      one tile among five — Part A's "shortcut card on the portal home page". %>
  <a class="home-buy-cta" href="/buy">
    <span class="home-buy-icon"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i></span>
    <span class="home-buy-text">
      <strong><%= t('buy.title') %></strong>
      <small><%= t('buy.subtitle') %></small>
    </span>
    <i class="fa-solid fa-chevron-right home-buy-arrow" aria-hidden="true"></i>
  </a>

  <nav class="home-services" aria-label="<%= t('portal.servicesTitle') %>">
    <a class="home-service" href="/track">
      <span class="home-service-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
      <span><strong><%= t('portal.track') %></strong><small><%= t('portal.trackHint') %></small></span>
    </a>
    <a class="home-service" href="/calculate">
      <span class="home-service-icon"><i class="fa-solid fa-calculator" aria-hidden="true"></i></span>
      <span><strong><%= t('portal.calculate') %></strong><small><%= t('portal.calculateHint') %></small></span>
    </a>
    <a class="home-service" href="/shops">
      <span class="home-service-icon"><i class="fa-solid fa-store" aria-hidden="true"></i></span>
      <span><strong><%= t('portal.shops') %></strong><small><%= t('portal.shopsHint') %></small></span>
    </a>
    <%# Public catalogue, same reason as the banner: this tile sits on a page
        anyone can reach, so it must not dead-end at a login form. %>
    <a class="home-service" href="/online">
      <span class="home-service-icon"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
      <span><strong><%= t('portal.online') %></strong><small><%= t('portal.onlineHint') %></small></span>
    </a>
    <a class="home-service" href="<%= homeMember ? '/member/orders' : '/member/register' %>">
      <span class="home-service-icon"><i class="fa-solid <%= homeMember ? 'fa-boxes-stacked' : 'fa-user-plus' %>" aria-hidden="true"></i></span>
      <span>
        <strong><%= homeMember ? t('member.myOrders') : t('portal.register') %></strong>
        <small><%= homeMember ? t('member.orderHistoryHint') : t('portal.memberHint') %></small>
      </span>
    </a>
  </nav>

  <section class="home-member" aria-labelledby="home-member-title">
    <div class="home-member-copy">
      <strong id="home-member-title">
        <% if (homeMember) { %>
          <%= t('member.greeting') %>, <%= homeMember.first_name || '' %>
        <% } else { %>
          <%= t('portal.memberCtaTitle') %>
        <% } %>
      </strong>
      <small><%= homeMember ? t('portal.memberBackHint') : t('portal.memberCtaHint') %></small>
    </div>
    <div class="home-member-actions">
      <% if (homeMember) { %>
        <a class="btn-gold" href="/member/profile"><%= t('portal.goToAccount') %></a>
      <% } else { %>
        <a class="btn-gold" href="/member/register"><%= t('portal.register') %></a>
        <a class="btn-outline" href="/member/login"><%= t('portal.login') %></a>
      <% } %>
    </div>
  </section>

  <section class="home-contact" aria-labelledby="home-contact-title">
    <span class="home-contact-label" id="home-contact-title"><%= t('portal.contactTitle') %></span>
    <strong><%= companyName %></strong>
    <% if (companyAddress) { %><span class="home-contact-address"><%= companyAddress %></span><% } %>
    <div class="home-contact-actions">
      <% if (contactPhone) { %>
        <a href="tel:<%= telHref(contactPhone) %>">
          <i class="fa-solid fa-phone" aria-hidden="true"></i>
          <span><%= contactPhone %></span>
        </a>
      <% } %>
      <% if (contactEmail) { %>
        <a href="mailto:<%= contactEmail %>">
          <i class="fa-regular fa-envelope" aria-hidden="true"></i>
          <span><%= contactEmail %></span>
        </a>
      <% } %>
    </div>
  </section>
</section>

<script>
  (() => {
    const STORAGE_KEY = 'sng.recentTracking';
    const MAX_ITEMS = 4;
    const form = document.querySelector('[data-track-form]');
    if (!form) return;

    const input = form.querySelector('input[name="q"]');
    const box = form.querySelector('[data-recent]');
    const list = form.querySelector('[data-recent-list]');
    const clearButton = form.querySelector('[data-recent-clear]');

    // localStorage is unavailable in private mode on some mobile browsers —
    // the whole feature degrades to "no chips" instead of throwing.
    const read = () => {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed.filter(v => typeof v === 'string') : [];
      } catch (error) {
        return [];
      }
    };

    const write = (items) => {
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      } catch (error) {
        /* ignore quota / disabled storage */
      }
    };

    const render = () => {
      const items = read();
      list.textContent = '';
      items.forEach((item) => {
        const link = document.createElement('a');
        link.className = 'home-recent-chip';
        link.href = '/track?q=' + encodeURIComponent(item);
        link.textContent = item;
        list.appendChild(link);
      });
      box.hidden = items.length === 0;
    };

    form.addEventListener('submit', () => {
      const value = (input.value || '').trim();
      if (!value) return;
      const items = [value, ...read().filter(item => item !== value)].slice(0, MAX_ITEMS);
      write(items);
    });

    clearButton.addEventListener('click', () => {
      write([]);
      render();
    });

    render();
  })();
</script>
