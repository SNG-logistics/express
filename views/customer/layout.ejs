<!doctype html>
<html lang="<%= lang || 'th' %>" data-theme="<%= theme || 'dark' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="<%= theme === 'light' ? '#faf9f6' : '#0a0a0a' %>">
  <meta name="description" content="SNG Express logistics between Thailand and Laos">
  <title><%= title || 'SNG Express' %></title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon-180x180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700;800&family=Prompt:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { corePlugins: { preflight: false } };</script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/portal.css?v=<%= assetVersion %>">
</head>
<body>
  <main class="portal-main">
    <% if (flash) { %>
      <div class="portal-flash <%= flash.type === 'error' ? 'is-error' : 'is-success' %>"><%= flash.message %></div>
    <% } %>
    <%- body %>
  </main>

  <% if (popup && popup.image) { %>
  <div class="portal-popup"
       x-data="{ dismissed: sessionStorage.getItem('sngPopupDismissed') === '1' }"
       x-show="!dismissed" x-cloak>
    <button type="button" class="portal-popup-close" aria-label="ปิด"
            @click="dismissed = true; sessionStorage.setItem('sngPopupDismissed', '1')">&times;</button>
    <% if (popup.link) { %>
    <a href="<%= popup.link %>" target="_blank" rel="noopener">
      <img src="<%= popup.image %>" alt="">
    </a>
    <% } else { %>
    <img src="<%= popup.image %>" alt="">
    <% } %>
  </div>
  <% } %>

  <%- include('./navbar') %>
  <script>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});

    document.querySelectorAll('[data-country-code]').forEach((select) => {
      const picker = select.closest('[data-country-picker]');
      const flag = picker?.querySelector('[data-country-flag]');
      const phoneInput = picker?.querySelector('[data-phone-input]');
      const placeholders = { '66': '09xxxxxxxx', '856': '020xxxxxxxx' };
      const update = () => {
        if (flag) flag.classList.toggle('is-laos', select.value === '856');
        if (phoneInput) phoneInput.placeholder = placeholders[select.value] || placeholders['66'];
      };
      update();
      select.addEventListener('change', update);
    });
  </script>
</body>
</html>
