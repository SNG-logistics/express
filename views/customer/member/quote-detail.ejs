<section class="portal-shell">
  <% if (!quote) { %>
    <div class="empty-state">
      <i class="fa-solid fa-file-circle-xmark"></i>
      <p style="font-size: 1.1rem; font-weight: 800; color: var(--portal-text); margin-top: 0.75rem;"><%= t('quoteRequest.notFound') %></p>
      <p style="font-size: 0.85rem;"><%= t('quoteRequest.notFoundHint') %></p>
      <a href="/member/quote-requests" class="btn-gold" style="margin-top: 1rem; text-decoration: none;">
        <i class="fa-solid fa-arrow-left"></i> <%= t('quoteRequest.myRequests') %>
      </a>
    </div>
  <% } else { %>
    <%
      const productThb = Number(quote.product_price_thb) || 0;
      const shippingThb = Number(quote.shipping_th_thb) || 0;
      const subtotalThb = Number(quote.subtotal_thb) || (productThb + shippingThb);
      const rate = Number(quote.exchange_rate) || 0;
      const spread = Number(quote.fx_spread_pct) || 0;
      const productLak = Math.ceil(subtotalThb * rate * (1 + spread / 100));
      const sngShippingLak = Number(quote.sng_shipping_lak) || 0;
      const serviceFeeLak = Number(quote.service_fee_lak) || 0;
      const totalLak = Number(quote.total_lak) || 0;
      const depositLak = Number(quote.deposit_required_lak) || 0;
      const paidLak = Number(quote.paid_amount_lak) || 0;
      const remainingLak = Math.max(0, depositLak - paidLak);

      const dateLocale = lang === 'lo' ? 'lo-LA' : 'th-TH';
      const fmtNum = (v) => Number(v || 0).toLocaleString(dateLocale);
      const quoteDate = quote.quote_created_at ? new Date(quote.quote_created_at).toLocaleDateString(dateLocale, { day: '2-digit', month: 'short', year: 'numeric' }) : '–';

      const statusLabels = {
        sent: t('quoteRequest.statusSent'),
        accepted: t('quoteRequest.statusAccepted'),
        purchasing: t('quoteRequest.statusPurchasing'),
        purchased: t('quoteRequest.statusPurchased'),
        ordered: t('quoteRequest.statusOrdered'),
      };
      const payLabels = { UNPAID: t('quoteRequest.payUnpaid'), PARTIAL: t('quoteRequest.payPartial'), PAID: t('quoteRequest.payPaid') };
      const canDecide = quote.status === 'sent';
    %>
    <div class="page-heading" style="margin-bottom: 1rem;">
      <p class="eyebrow">QUOTATION</p>
      <h1><%= t('quoteRequest.quotation') %></h1>
      <p><%= t('quoteRequest.quoteNo') %> <strong style="color: var(--portal-gold);"><%= quote.quote_no %></strong> · <%= quoteDate %></p>
    </div>

    <div class="card" style="padding: 1rem; margin-bottom: 0.85rem;">
      <div style="display: flex; justify-content: space-between; gap: 0.75rem; align-items: flex-start;">
        <div>
          <div style="font-weight: 800; color: var(--portal-text);"><%= quote.product_name %></div>
          <% if (quote.desired_qty > 1) { %>
          <div style="font-size: 0.8rem; color: var(--portal-text-dim); margin-top: 0.25rem;"><%= t('quoteRequest.quantity') %> <%= quote.desired_qty %> <%= t('quoteRequest.pieces') %></div>
          <% } %>
          <% if (quote.product_url) { %>
          <a href="<%= quote.product_url %>" target="_blank" rel="noopener" style="display: inline-block; color: var(--portal-gold); font-size: 0.78rem; margin-top: 0.5rem; text-decoration: none;">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> <%= t('quoteRequest.viewSourceProduct') %>
          </a>
          <% } %>
        </div>
        <span style="padding: 0.28rem 0.6rem; border-radius: 999px; background: var(--portal-badge-bg); color: var(--portal-success-text); font-size: 0.72rem; font-weight: 700; text-align: right;"><%= statusLabels[quote.status] || quote.status %></span>
      </div>
    </div>

    <%# ── Price breakdown ──────────────────────────────────────────────── %>
    <div class="card" style="padding: 1rem;">
      <div style="font-size: 0.75rem; color: var(--portal-text-dim); font-weight: 800; letter-spacing: 0.06em;"><%= t('quoteRequest.priceSummary') %></div>
      <div style="margin-top: 0.8rem; display: grid; gap: 0.7rem; font-size: 0.9rem;">
        <div style="display: flex; justify-content: space-between; gap: 1rem;"><span><%= t('quoteRequest.productAndTHShipping') %></span><strong><%= fmtNum(subtotalThb) %> THB</strong></div>
        <div style="display: flex; justify-content: space-between; gap: 1rem;"><span><%= t('quoteRequest.productLak') %></span><strong><%= fmtNum(productLak) %> LAK</strong></div>
        <div style="display: flex; justify-content: space-between; gap: 1rem;"><span><%= t('quoteRequest.sngShipping') %></span><strong><%= fmtNum(sngShippingLak) %> LAK</strong></div>
        <% if (serviceFeeLak > 0) { %>
        <div style="display: flex; justify-content: space-between; gap: 1rem;"><span><%= t('quoteRequest.serviceFee') %></span><strong><%= fmtNum(serviceFeeLak) %> LAK</strong></div>
        <% } %>
        <div style="border-top: 1px solid var(--portal-border); padding-top: 0.9rem; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;"><span style="font-weight: 800; color: var(--portal-text);"><%= t('quoteRequest.totalDue') %></span><strong style="font-size: 1.25rem; color: var(--portal-gold);"><%= fmtNum(totalLak) %> LAK</strong></div>
      </div>
    </div>

    <%# ── Deposit / payment panel ───────────────────────────────────────── %>
    <div class="card" style="padding: 1rem; margin-top: 0.85rem; border-color: rgba(255, 224, 0, 0.25);">
      <div style="font-size: 0.75rem; color: var(--portal-gold); font-weight: 800; letter-spacing: 0.06em;"><%= t('quoteRequest.depositPanelTitle') %></div>
      <p style="font-size: 0.8rem; color: var(--portal-text-dim); margin: 0.45rem 0 0.7rem;"><%= t('quoteRequest.depositHint') %></p>
      <div style="display: grid; gap: 0.5rem; font-size: 0.9rem;">
        <div style="display: flex; justify-content: space-between;"><span><%= t('quoteRequest.depositRequired') %></span><strong><%= fmtNum(depositLak) %> LAK</strong></div>
        <div style="display: flex; justify-content: space-between;"><span><%= t('quoteRequest.paidAmount') %></span><strong style="color: var(--portal-success-text);"><%= fmtNum(paidLak) %> LAK</strong></div>
        <div style="display: flex; justify-content: space-between;"><span><%= t('quoteRequest.payStatus') %></span><strong><%= payLabels[quote.payment_status] || quote.payment_status %></strong></div>
        <% if (remainingLak > 0) { %>
        <div style="display: flex; justify-content: space-between;"><span><%= t('quoteRequest.remaining') %></span><strong style="color: #ef4444;"><%= fmtNum(remainingLak) %> LAK</strong></div>
        <% } %>
      </div>

      <% if (paymentInfo && (paymentInfo.bankName || paymentInfo.promptpayNo || paymentInfo.accountNo)) { %>
      <div style="margin-top: 0.9rem; padding-top: 0.8rem; border-top: 1px solid var(--portal-border); display: grid; gap: 0.4rem; font-size: 0.88rem;">
        <div style="font-weight: 800; color: var(--portal-text);"><%= t('quoteRequest.transferTo') %></div>
        <% if (paymentInfo.bankName) { %><div><%= paymentInfo.bankName %></div><% } %>
        <% if (paymentInfo.accountNo) { %><div><%= t('quoteRequest.accountNo') %>: <strong class="font-mono"><%= paymentInfo.accountNo %></strong></div><% } %>
        <% if (paymentInfo.accountName) { %><div><%= t('quoteRequest.accountName') %>: <strong><%= paymentInfo.accountName %></strong></div><% } %>
        <% if (paymentInfo.promptpayNo) { %><div>PromptPay: <strong class="font-mono"><%= paymentInfo.promptpayNo %></strong></div><% } %>
      </div>
      <% } %>

      <% if (paymentInfo && paymentInfo.whatsappContact) { %>
      <p style="font-size: 0.82rem; margin: 0.7rem 0 0;">
        <i class="fa-brands fa-whatsapp" style="color:#25D366;"></i> <%= t('quoteRequest.sendSlipTo') %>
        <strong><%= paymentInfo.whatsappContact %></strong>
      </p>
      <% } else { %>
      <p style="font-size: 0.82rem; margin: 0.7rem 0 0;"><%= t('quoteRequest.sendSlipGeneric') %></p>
      <% } %>

      <% if (paymentInfo && paymentInfo.policyText) { %>
      <div style="margin-top: 0.8rem; padding: 0.7rem; border-radius: 0.6rem; background: var(--portal-badge-bg); font-size: 0.78rem; color: var(--portal-text-dim); white-space: pre-line;"><%= paymentInfo.policyText %></div>
      <% } %>
    </div>

    <%# ── Accept / reject (self-service) ─────────────────────────────────── %>
    <% if (canDecide) { %>
    <div class="card" style="padding: 1rem; margin-top: 0.85rem; display: grid; gap: 0.6rem;">
      <div style="font-size: 0.75rem; color: var(--portal-text-dim); font-weight: 800; letter-spacing: 0.06em;"><%= t('quoteRequest.decideTitle') %></div>
      <form action="/member/quote-requests/<%= quote.request_id %>/accept" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn-gold" type="submit" style="width: 100%;"><i class="fa-solid fa-circle-check"></i> <%= t('quoteRequest.accept') %></button>
      </form>
      <details style="font-size: 0.85rem;">
        <summary style="color: #ef4444; cursor: pointer;"><%= t('quoteRequest.reject') %></summary>
        <form action="/member/quote-requests/<%= quote.request_id %>/reject" method="POST" style="margin-top: 0.5rem; display: grid; gap: 0.45rem;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea class="input-portal" name="reason" rows="2" placeholder="<%= t('quoteRequest.rejectReasonPlaceholder') %>"></textarea>
          <button type="submit" style="width: 100%; padding: 0.55rem; border-radius: 0.6rem; background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); font-weight: 700;"><i class="fa-solid fa-ban"></i> <%= t('quoteRequest.confirmReject') %></button>
        </form>
      </details>
    </div>
    <% } %>

    <% if (quote.note) { %>
    <div class="card" style="padding: 1rem; margin-top: 0.85rem;">
      <div style="font-size: 0.75rem; color: var(--portal-text-dim); font-weight: 800; letter-spacing: 0.06em;"><%= t('quoteRequest.staffNote') %></div>
      <p style="margin: 0.55rem 0 0; white-space: pre-line;"><%= quote.note %></p>
    </div>
    <% } %>

    <a href="/member/quote-requests" style="display: inline-flex; gap: 0.4rem; align-items: center; margin-top: 1rem; color: var(--portal-gold); text-decoration: none; font-size: 0.85rem;">
      <i class="fa-solid fa-arrow-left"></i> <%= t('quoteRequest.myRequests') %>
    </a>
  <% } %>
</section>
