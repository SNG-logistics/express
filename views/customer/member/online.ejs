<%
  const PLATFORM_LABELS = {
    lazada: 'Lazada',
    shopee: 'Shopee',
    alibaba: 'Alibaba',
    tiktok_shop: 'TikTok Shop',
    makro: 'Makro',
    other: t('online.otherPlatform'),
  };
%>
<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">ONLINE DEALS</p>
    <h1><%= t('online.title') %></h1>
    <p><%= t('online.subtitle') %></p>
  </div>

  <% if (products && products.length > 0) { %>
    <div class="product-grid">
      <% products.forEach(product => {
        const badgeText = product.discount_pct
          ? `${t('online.discountPrefix')} ${Number(product.discount_pct)}%`
          : (product.badge_label || null);
        let photos = [];
        if (product.photos) {
          try {
            const parsedPhotos = typeof product.photos === 'string'
              ? JSON.parse(product.photos)
              : product.photos;
            photos = Array.isArray(parsedPhotos)
              ? parsedPhotos.filter(photo => typeof photo === 'string' && photo)
              : [];
          } catch (_err) {
            photos = [];
          }
        }
      %>
      <a href="<%= product.product_url %>" target="_blank" rel="noopener" class="card product-card">
        <div class="product-media">
          <% if (photos.length === 1) { %>
            <img src="<%= photos[0] %>" alt="<%= product.name %>">
          <% } else if (photos.length > 1) { %>
            <div
              x-data="{ i: 0 }"
              x-init="setInterval(() => i = (i + 1) % <%= photos.length %>, 3000)"
              style="width: 100%; height: 100%; position: relative;"
            >
              <% photos.forEach((photo, index) => { %>
                <img
                  src="<%= photo %>"
                  alt="<%= index === 0 ? product.name : '' %>"
                  :style="{ opacity: i === <%= index %> ? 1 : 0 }"
                  style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: <%= index === 0 ? 1 : 0 %>; transition: opacity 0.6s ease;"
                >
              <% }); %>
              <div style="position: absolute; left: 50%; bottom: 0.55rem; transform: translateX(-50%); display: flex; gap: 0.35rem; z-index: 1;" aria-hidden="true">
                <% photos.forEach((_photo, index) => { %>
                  <span
                    :style="{ opacity: i === <%= index %> ? 1 : 0.35 }"
                    style="width: 0.42rem; height: 0.42rem; border-radius: 999px; background: #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.55); opacity: <%= index === 0 ? 1 : 0.35 %>; transition: opacity 0.6s ease;"
                  ></span>
                <% }); %>
              </div>
            </div>
          <% } else { %>
            <i class="fa-solid fa-bag-shopping product-media-empty"></i>
          <% } %>
          <% if (badgeText) { %>
          <span class="product-badge" title="<%= badgeText %>">
            <i class="fa-solid fa-tag"></i> <%= badgeText %>
          </span>
          <% } %>
        </div>
        <%# Price reading: every number below comes from the product row only —
            nothing is hardcoded. price == null hides the whole price line, so
            legacy products without pricing still render exactly as before. %>
        <%
          const fmtPrice = (value) => {
            const n = Number(value);
            if (!Number.isFinite(n)) return '';
            return n % 1 === 0
              ? n.toLocaleString('en-US')
              : n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          };
          const hasPrice = product.price !== null && product.price !== undefined && String(product.price).trim() !== '';
          const hasOriginal = product.original_price !== null && product.original_price !== undefined && String(product.original_price).trim() !== '';
          const cardPriceColor = product.price_color || '#E53935';
        %>
        <div class="product-body">
          <div>
            <strong class="product-name"><%= product.name %></strong>
            <% if (hasPrice) { %>
            <div class="product-prices">
              <%# Only the colour stays inline — it is per-product data, not styling. %>
              <span class="product-price" style="color: <%- cardPriceColor %>;">฿<%= fmtPrice(product.price) %></span>
              <% if (hasOriginal) { %>
              <span class="product-price-was">฿<%= fmtPrice(product.original_price) %></span>
              <% } %>
            </div>
            <% } %>
          </div>
          <% if (product.platform) { %>
          <div class="product-platform">
            <i class="fa-solid fa-store"></i>
            <span><%= PLATFORM_LABELS[product.platform] || product.platform %></span>
          </div>
          <% } %>
        </div>
      </a>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fa-solid fa-bag-shopping"></i>
      <p style="font-size: 1.1rem; font-weight: 700; color: var(--portal-text); margin-top: 0.75rem;"><%= t('online.noProductsFound') %></p>
    </div>
  <% } %>
</section>
