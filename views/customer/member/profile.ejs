<%
  const memberLatestOrder = typeof latestOrder !== 'undefined' ? latestOrder : null;
  const orderDataUnavailable = typeof latestOrderUnavailable !== 'undefined' && latestOrderUnavailable;
  const creditAvailable = typeof referralCreditLak !== 'undefined' && referralCreditLak !== null;
  const creditValue = creditAvailable ? Number(referralCreditLak) : null;
  const numberLocale = lang === 'lo' ? 'lo-LA' : 'th-TH';
  const referralCode = account.referral_code || '';

  let orderProgress = 1;
  let orderTone = 'active';
  let showOrderProgress = true;
  let directionFlags = '';
  let directionLabel = '';

  if (memberLatestOrder) {
    const progressByStatus = {
      NEW: 1,
      RECEIVED_WH_TH: 1,
      RECEIVED_WH_LA: 1,
      READY_TO_LOAD: 1,
      ON_TRUCK: 2,
      CROSSING_BORDER: 2,
      CUSTOMS_HOLD: 2,
      CUSTOMS_CLEARED: 2,
      CUSTOMS_REJECTED: 2,
      ARRIVED_BORDER_WH: 2,
      AT_DEST_WH: 3,
      BRANCH_TRANSFER: 3,
      BRANCH_RECEIVED: 3,
      RIDER_ASSIGNED: 3,
      RIDER_ACCEPTED: 3,
      OUT_FOR_DELIVERY: 3,
      DELIVERY_FAILED: 3,
      RETURN_TO_SENDER: 3,
      RETURNED: 3,
      DELIVERED: 4,
      COD_COLLECTED: 4,
      COD_REMITTED: 4,
      CLOSED: memberLatestOrder.delivered_at ? 4 : 3,
    };
    const successStatuses = ['DELIVERED', 'COD_COLLECTED', 'COD_REMITTED'];
    const dangerStatuses = ['CUSTOMS_REJECTED', 'DELIVERY_FAILED', 'RETURN_TO_SENDER', 'RETURNED', 'CANCELLED'];
    const deliveredTerminal = successStatuses.includes(memberLatestOrder.status)
      || (memberLatestOrder.status === 'CLOSED' && memberLatestOrder.delivered_at);

    orderProgress = progressByStatus[memberLatestOrder.status] || 1;
    showOrderProgress = memberLatestOrder.status !== 'CLOSED' || Boolean(memberLatestOrder.delivered_at);
    orderTone = deliveredTerminal
      ? 'success'
      : dangerStatuses.includes(memberLatestOrder.status)
        ? 'danger'
        : memberLatestOrder.status === 'CUSTOMS_HOLD'
          ? 'warning'
          : 'active';
    directionFlags = memberLatestOrder.direction === 'LA_TO_TH' ? '🇱🇦 → 🇹🇭' : '🇹🇭 → 🇱🇦';
    directionLabel = memberLatestOrder.direction === 'LA_TO_TH' ? t('order.laToTh') : t('order.thToLa');
  }

  const progressLabels = [
    t('member.progressCreated'),
    t('member.progressTransit'),
    t('member.progressDestination'),
    t('member.progressDelivered'),
  ];
%>

<section class="portal-shell member-dashboard">
  <header class="member-summary">
    <div class="member-identity">
      <h1><%= t('member.greeting') %>, <%= account.first_name || '' %></h1>
      <p><%= account.phone_display || account.phone || '–' %></p>
      <span class="member-verified"><i class="fa-solid fa-check"></i><%= t('member.verified') %></span>
    </div>
    <div class="member-credit" aria-label="<%= t('member.referralCredit') %>">
      <span><%= t('member.referralCredit') %></span>
      <% if (creditAvailable && Number.isFinite(creditValue)) { %>
        <strong><%= creditValue.toLocaleString(numberLocale) %> <small><%= t('member.lak') %></small></strong>
      <% } else { %>
        <strong>–</strong>
        <small class="member-credit-error"><%= t('member.creditUnavailable') %></small>
      <% } %>
    </div>
  </header>

  <form class="member-track" action="/track" method="GET">
    <label for="member-track-q"><%= t('member.trackParcel') %></label>
    <div class="member-track-row">
      <input
        id="member-track-q"
        class="input-portal"
        type="text"
        name="q"
        placeholder="<%= t('member.trackPlaceholder') %>"
        autocomplete="off"
        required
      >
      <button class="member-track-button" type="submit" aria-label="<%= t('common.search') %>">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span><%= t('common.search') %></span>
      </button>
    </div>
  </form>

  <div class="member-section-heading">
    <h2><%= t('member.latestOrder') %></h2>
    <a href="/member/orders"><%= t('member.viewAll') %> <i class="fa-solid fa-arrow-right"></i></a>
  </div>

  <% if (orderDataUnavailable) { %>
    <div class="member-inline-state is-error" role="status">
      <i class="fa-solid fa-circle-exclamation"></i>
      <span><%= t('member.orderUnavailable') %></span>
    </div>
  <% } else if (memberLatestOrder) { %>
    <article class="member-latest-order">
      <div class="member-order-topline">
        <div class="member-order-title">
          <strong><%= memberLatestOrder.job_no %></strong>
          <span><%= directionFlags %> <%= directionLabel %></span>
          <% if (memberLatestOrder.receiver_city) { %>
            <span><i class="fa-solid fa-location-dot"></i> <%= memberLatestOrder.receiver_city %></span>
          <% } %>
        </div>
        <span class="member-order-status is-<%= orderTone %>"><%= t('status.' + memberLatestOrder.status) %></span>
      </div>

      <% if (showOrderProgress) { %>
        <ol class="member-order-progress is-<%= orderTone %>" aria-label="<%= t('order.status') %>">
          <% progressLabels.forEach((label, index) => { const step = index + 1; %>
            <li class="<%= step <= orderProgress ? 'is-complete' : '' %> <%= step === orderProgress ? 'is-current' : '' %>">
              <span aria-hidden="true"></span>
              <small><%= label %></small>
            </li>
          <% }); %>
        </ol>
      <% } %>

      <a class="member-order-link" href="/track/<%= encodeURIComponent(memberLatestOrder.job_no) %>">
        <%= t('member.viewJourney') %> <i class="fa-solid fa-arrow-right"></i>
      </a>
    </article>
  <% } else { %>
    <div class="member-inline-state">
      <i class="fa-solid fa-box-open"></i>
      <div>
        <strong><%= t('member.noRecentOrder') %></strong>
        <span><%= t('member.noRecentOrderHint') %></span>
      </div>
    </div>
  <% } %>

  <div class="member-section-heading member-services-heading">
    <h2><%= t('member.yourServices') %></h2>
    <a href="/member/account"><%= t('member.manageAccount') %></a>
  </div>

  <nav class="member-services" aria-label="<%= t('member.yourServices') %>">
    <a class="member-service" href="/member/orders">
      <span class="member-service-icon"><i class="fa-solid fa-boxes-stacked"></i></span>
      <span><strong><%= t('member.myOrders') %></strong><small><%= t('member.orderHistoryHint') %></small></span>
    </a>
    <a class="member-service" href="/member/quote-request">
      <span class="member-service-icon"><i class="fa-solid fa-file-circle-plus"></i></span>
      <span><strong><%= t('member.quoteRequest') %></strong><small><%= t('member.quoteRequestHint') %></small></span>
    </a>
    <a class="member-service" href="/member/quote-requests">
      <span class="member-service-icon"><i class="fa-solid fa-file-invoice"></i></span>
      <span><strong><%= t('member.quoteHistory') %></strong><small><%= t('member.quoteHistoryHint') %></small></span>
    </a>
    <a class="member-service" href="/member/account">
      <span class="member-service-icon"><i class="fa-solid fa-user-gear"></i></span>
      <span><strong><%= t('member.editProfile') %></strong><small><%= t('member.profileHint') %></small></span>
    </a>
  </nav>

  <section class="member-referral" aria-labelledby="member-referral-title">
    <div>
      <span id="member-referral-title"><%= t('member.referralCode') %></span>
      <% if (referralCode) { %>
        <strong><%= referralCode %></strong>
      <% } else { %>
        <strong class="is-empty"><%= t('member.noReferralCode') %></strong>
      <% } %>
    </div>
    <% if (referralCode) { %>
      <button
        class="member-copy-button"
        type="button"
        data-referral-code="<%= referralCode %>"
        data-copy-success="<%= t('member.copied') %>"
        data-copy-error="<%= t('member.copyFailed') %>"
      >
        <i class="fa-regular fa-copy"></i>
        <span><%= t('member.copyCode') %></span>
      </button>
    <% } %>
    <span class="member-copy-feedback" aria-live="polite"></span>
  </section>

  <a class="member-logout" href="/member/logout">
    <i class="fa-solid fa-arrow-right-from-bracket"></i><%= t('member.logout') %>
  </a>
</section>

<script>
  (() => {
    const button = document.querySelector('[data-referral-code]');
    const feedback = document.querySelector('.member-copy-feedback');
    if (!button || !feedback) return;

    const fallbackCopy = (value) => {
      const input = document.createElement('textarea');
      input.value = value;
      input.setAttribute('readonly', '');
      input.style.position = 'fixed';
      input.style.opacity = '0';
      document.body.appendChild(input);
      input.select();
      const copied = document.execCommand('copy');
      input.remove();
      if (!copied) throw new Error('copy failed');
    };

    button.addEventListener('click', async () => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(button.dataset.referralCode);
        } else {
          fallbackCopy(button.dataset.referralCode);
        }
        feedback.textContent = button.dataset.copySuccess;
        button.classList.add('is-copied');
      } catch (error) {
        feedback.textContent = button.dataset.copyError;
        button.classList.remove('is-copied');
      }
      window.setTimeout(() => {
        feedback.textContent = '';
        button.classList.remove('is-copied');
      }, 2200);
    });
  })();
</script>
