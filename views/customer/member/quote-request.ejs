<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">BUY & SHIP AGENT</p>
    <h1><%= t('quoteRequest.title') %></h1>
    <p><%= t('quoteRequest.subtitle') %></p>
  </div>

  <% if (error) { %>
  <div class="portal-flash is-error">
    <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i><%= error %>
  </div>
  <% } %>

  <form class="card portal-form" action="/member/quote-request" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <%# ── Platform picker (radio pills, same pattern as shipment direction) ── %>
    <label>
      <span><%= t('quoteRequest.platform') %></span>
    </label>
    <%
      const platforms = [
        { val: 'lazada',     icon: 'fa-bag-shopping', label: t('quoteRequest.platformLazada') },
        { val: 'shopee',     icon: 'fa-bag-shopping', label: t('quoteRequest.platformShopee') },
        { val: 'tiktok_shop',icon: 'fa-brands fa-tiktok', label: t('quoteRequest.platformTikTokShop') },
        { val: 'alibaba',    icon: 'fa-boxes-stacked', label: t('quoteRequest.platformAlibaba') },
        { val: 'makro',      icon: 'fa-store',         label: t('quoteRequest.platformMakro') },
        { val: 'other',      icon: 'fa-ellipsis',      label: t('quoteRequest.platformOther') },
      ];
      const selectedPlatform = values.platform || 'other';
    %>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.9rem;">
      <% platforms.forEach(opt => { %>
      <label style="display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.6rem 0.25rem; border-radius: 0.7rem; cursor: pointer; border: 1.5px solid var(--portal-border); background: var(--portal-card-bg, rgba(255,255,255,0.03)); text-align: center;">
        <input type="radio" name="platform" value="<%= opt.val %>" <%= selectedPlatform === opt.val ? 'checked' : '' %> style="position: absolute; opacity: 0; pointer-events: none;">
        <i class="fa-solid <%= opt.icon %>" style="font-size: 1.05rem; color: var(--portal-gold);"></i>
        <span style="font-size: 0.72rem; font-weight: 700; color: var(--portal-text); line-height: 1.2;"><%= opt.label %></span>
      </label>
      <% }) %>
    </div>

    <label>
      <span><%= t('quoteRequest.productUrl') %> (Lazada / Shopee / ອື່ນໆ)</span>
      <input class="input-portal" name="product_url" type="url" placeholder="https://..." value="<%= values.product_url || '' %>">
    </label>

    <label>
      <span><%= t('quoteRequest.productName') %> <em style="color: #ef4444;">*</em></span>
      <input class="input-portal" name="product_name" required placeholder="ເຊັ່ນ: ເກີບ Adidas size 42" value="<%= values.product_name || '' %>">
    </label>

    <label>
      <span><%= t('quoteRequest.quantity') %></span>
      <input class="input-portal" name="desired_qty" type="number" min="1" step="1" value="<%= values.desired_qty || 1 %>" placeholder="1">
    </label>

    <label>
      <span><%= t('quoteRequest.note') %></span>
      <textarea class="input-portal" name="note" rows="3" placeholder="<%= t('quoteRequest.notePlaceholder') %>"></textarea>
    </label>

    <button class="btn-gold" type="submit" style="width: 100%; margin-top: 0.5rem;">
      <i class="fa-solid fa-paper-plane"></i> <%= t('quoteRequest.submit') %>
    </button>

    <p style="font-size: 0.8rem; color: var(--portal-text-faint); text-align: center; margin: 0;">
      ເມື່ອໄດ້ຮັບຄຳຂໍ ພະນັກງານຈະຕິດຕໍ່ກັບຄືນທາງ WhatsApp ພ້ອມລາຄາລວມ ແລະ ຄ່າບໍລິການ
    </p>
  </form>

  <%# Right under the form, because this is the last moment before someone
      commits to something that might not be allowed across the border. %>
  <div style="margin-top: 1rem;">
    <%- include('../_prohibited') %>
  </div>

  <div style="text-align: center; margin-top: 1rem;">
    <a href="/member/quote-requests" style="color: var(--portal-gold); font-size: 0.85rem; text-decoration: none;">
      <i class="fa-solid fa-clock-rotate-left"></i> <%= t('quoteRequest.myRequests') %>
    </a>
  </div>
</section>
