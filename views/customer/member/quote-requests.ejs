<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">QUOTE REQUESTS</p>
    <h1><%= t('quoteRequest.myRequests') %></h1>
    <p><%= t('quoteRequest.myRequestsHint') %></p>
  </div>

  <div style="text-align: right; margin-bottom: 1rem;">
    <a href="/member/quote-request" class="btn-gold" style="padding: 0.5rem 0.9rem; font-size: 0.85rem;">
      <i class="fa-solid fa-plus"></i> <%= t('quoteRequest.newRequest') %>
    </a>
  </div>

  <% if (requests && requests.length > 0) { %>
    <div style="display: grid; gap: 0.75rem;">
      <% requests.forEach(request => {
        const statusMap = {
          new:         { label: 'รอเจ้าหน้าที่',        color: 'var(--portal-gold)' },
          in_progress: { label: 'กำลังดำเนินการ',      color: 'var(--portal-text-dim)' },
          quoted:      { label: 'มีใบเสนอราคาแล้ว',    color: 'var(--portal-success-text)' },
          closed:      { label: 'ปิดคำขอ',             color: 'var(--portal-text-faint)' },
        };
        const s = request.quote_no && !request.quote_available
          ? statusMap.in_progress
          : (statusMap[request.status] || statusMap.new);
        const dateLocale = lang === 'lo' ? 'lo-LA' : 'th-TH';
        const dt = request.created_at ? new Date(request.created_at) : null;
        const fmtDate = dt ? dt.toLocaleDateString(dateLocale, { day: '2-digit', month: 'short', year: '2-digit' }) : '–';
      %>
      <div class="card" style="padding: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap;">
          <div style="min-width: 0;">
            <div style="font-weight: 800; color: var(--portal-text);"><%= request.product_name %></div>
            <% if (request.desired_qty > 1) { %>
            <div style="font-size: 0.8rem; color: var(--portal-text-dim); margin-top: 0.2rem;">× <%= request.desired_qty %> ชิ้น</div>
            <% } %>
            <% if (request.note) { %>
            <div style="font-size: 0.8rem; color: var(--portal-text-dim); margin-top: 0.2rem;"><%= request.note %></div>
            <% } %>
            <% if (request.product_url) { %>
            <a href="<%= request.product_url %>" target="_blank" rel="noopener" style="font-size: 0.75rem; color: var(--portal-gold); text-decoration: none;">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> ลิงก์สินค้า
            </a>
            <% } %>
            <div style="font-size: 0.75rem; color: var(--portal-text-faint); margin-top: 0.3rem;"><%= fmtDate %></div>
          </div>
          <div style="text-align: right; flex-shrink: 0;">
            <span style="display: inline-block; padding: 0.25rem 0.6rem; border-radius: 999px; background: var(--portal-badge-bg); color: <%= s.color %>; font-size: 0.75rem; font-weight: 700;"><%= s.label %></span>
            <% if (request.quote_available && request.quote_no) { %>
            <a href="/member/quote-requests/<%= request.id %>/quotation" class="btn-gold" style="display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.45rem; padding: 0.38rem 0.65rem; font-size: 0.75rem; text-decoration: none;">
              <i class="fa-solid fa-file-invoice"></i> ดูใบเสนอราคา
            </a>
            <div style="font-size: 0.72rem; color: var(--portal-text-faint); margin-top: 0.35rem;"><%= request.quote_no %></div>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fa-solid fa-box-open"></i>
      <p style="font-size: 1.1rem; font-weight: 700; color: var(--portal-text); margin-top: 0.75rem;"><%= t('quoteRequest.noRequests') %></p>
      <p style="font-size: 0.85rem;">ส่งคำขอเช็คราคาสินค้าจากไทย แล้วเจ้าหน้าที่จะติดต่อกลับทาง WhatsApp</p>
      <a href="/member/quote-request" class="btn-gold" style="margin-top: 1rem;">
        <i class="fa-solid fa-paper-plane"></i> <%= t('quoteRequest.newRequest') %>
      </a>
    </div>
  <% } %>
</section>
