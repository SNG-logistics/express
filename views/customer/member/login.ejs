<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">SNG EXPRESS</p>
    <h1><%= t('portal.login') %></h1>
    <p><%= t('portal.heroSubtitle') %></p>
  </div>

  <% if (error) { %>
  <div class="portal-flash is-error">
    <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i><%= error %>
  </div>
  <% } %>

  <form class="card portal-form" action="/member/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>
      <span>เบอร์โทรศัพท์ (WhatsApp)</span>
      <div class="country-phone-row" data-country-picker>
        <span class="country-flag <%= values.country_code === '856' ? 'is-laos' : '' %>" data-country-flag aria-hidden="true"></span>
        <select class="input-portal country-code-select" name="country_code" aria-label="Country calling code" data-country-code>
          <option value="66" <%= values.country_code !== '856' ? 'selected' : '' %>>ไทย (Thailand) +66</option>
          <option value="856" <%= values.country_code === '856' ? 'selected' : '' %>>ลาว (Laos) +856</option>
        </select>
        <input class="input-portal country-phone-input" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" pattern="[0-9 ()-]+" placeholder="0812345678" value="<%= values.phone || '' %>" required autofocus>
      </div>
      <small style="display: block; margin-top: 0.4rem; color: var(--portal-text-dim);">เลือกประเทศก่อน แล้วกรอกเบอร์โทรศัพท์ในประเทศนั้น</small>
    </label>

    <label>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem;">
        <span style="margin-bottom: 0;">รหัสผ่าน</span>
        <a href="/member/forgot-password" style="color: var(--portal-gold); font-size: 0.8rem; text-decoration: none;">ลืมรหัสผ่าน?</a>
      </div>
      <input class="input-portal" name="password" type="password" required>
    </label>

    <button class="btn-gold" type="submit" style="width: 100%; margin-top: 0.5rem;">
      <i class="fa-solid fa-right-to-bracket"></i> <%= t('portal.login') %>
    </button>

    <div style="text-align: center; font-size: 0.85rem; color: var(--portal-text-dim); margin-top: 0.5rem;">
      ยังไม่มีบัญชีสมาชิก? <a href="/member/register" style="color: var(--portal-gold); font-weight: 600;"><%= t('portal.register') %></a>
    </div>
  </form>
</section>
