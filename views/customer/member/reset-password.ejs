<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">RESET PASSWORD</p>
    <h1>ตั้งรหัสผ่านใหม่</h1>
    <p>กรุณากำหนดรหัสผ่านใหม่สำหรับเข้าใช้งานระบบ</p>
  </div>

  <% if (error) { %>
  <div class="portal-flash is-error">
    <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i><%= error %>
  </div>
  <% } %>

  <form class="card portal-form" action="/member/reset-password" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>
      <span>รหัสผ่านใหม่ (ขั้นต่ำ 6 ตัว)</span>
      <input class="input-portal" name="password" type="password" required autofocus>
    </label>

    <label>
      <span>ยืนยันรหัสผ่านใหม่</span>
      <input class="input-portal" name="confirm_password" type="password" required>
    </label>

    <button class="btn-gold" type="submit" style="width: 100%; margin-top: 0.5rem;">
      <i class="fa-solid fa-key"></i> บันทึกรหัสผ่านใหม่
    </button>
  </form>
</section>
