<%#
  views/customer/track.ejs — Public Order Tracking Page

  No authentication required.
  Uses customer/layout.ejs for theme shell, responsive layout, and fonts.
%>
<section class="portal-shell">
  <div class="page-heading">
    <p class="eyebrow">TH ↔ LA</p>
    <h1><%= t('tracking.title') %></h1>
    <p><%= t('tracking.subtitle') %></p>
  </div>

  <!-- Search Box -->
  <div class="card portal-search" style="padding: 1.25rem; margin-bottom: 1.5rem;">
    <label for="track-q"><i class="fa-solid fa-magnifying-glass" style="margin-right: 4px;"></i> <%= t('tracking.searchLabel') %></label>
    <form action="/track" method="GET">
      <div>
        <input type="text" id="track-q" class="input-portal" name="q"
          placeholder="<%= t('tracking.searchHintQuote') %>"
          value="<%= order?.job_no || quotation?.quote_no || '' %>" autofocus required>
        <button type="submit" class="btn-gold"><i class="fa-solid fa-search"></i> <%= t('common.search') %></button>
      </div>
    </form>
  </div>

  <% if (error) { %>
  <div class="portal-flash is-error" style="margin-bottom: 1.5rem;">
    <i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i><%= error %>
  </div>
  <% } %>

  <%
    // Hoisted above both legs: a purchase-agent parcel may have a Thai leg to
    // render before any SNG shipment exists, and both need the same date format.
    const dateLocale = lang === 'lo' ? 'lo-LA' : 'th-TH';
    const hasSupplierLeg = Array.isArray(supplierTimeline) && supplierTimeline.length > 0;

    function fmtDate(d) {
      if (!d) return '–';
      const dt = new Date(d);
      try {
        return dt.toLocaleDateString(dateLocale, { day: '2-digit', month: 'short', year: '2-digit' })
          + ' ' + dt.toLocaleTimeString(dateLocale, { hour: '2-digit', minute: '2-digit' });
      } catch (e) {
        return dt.toLocaleDateString('th-TH', { day: '2-digit', month: 'short', year: '2-digit' })
          + ' ' + dt.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
      }
    }
  %>

  <%#
    Leg 1 — the shop's courier bringing the goods to SNG's Thai warehouse.
    Carries no courier, tracking number or shop name: the customer learns how far
    their goods have got and how many boxes landed, nothing about where they were
    bought.
  %>
  <% if (hasSupplierLeg) { %>
  <section class="card track-leg" style="margin-bottom: 1.25rem;">
    <div class="track-leg-head">
      <span class="track-leg-badge is-supplier"><i class="fa-solid fa-store"></i></span>
      <div>
        <p class="track-leg-title"><%= t('tracking.supplierLeg') %></p>
        <% if (quotation) { %>
        <p class="track-leg-sub"><%= quotation.product_name || '' %></p>
        <% } %>
      </div>
      <% if (supplierProgress && supplierProgress.expected > 1) { %>
      <span class="track-leg-count">
        <%= t('tracking.arrivedOf') %>
        <strong><%= supplierProgress.arrived %></strong> / <%= supplierProgress.expected %>
        <%= t('tracking.boxes') %>
      </span>
      <% } %>
    </div>

    <div class="track-timeline">
      <% supplierTimeline.forEach(function (step) { %>
      <div class="track-step is-supplier <%= step.current ? 'is-current' : '' %>">
        <span class="track-step-mark"><i class="<%= step.icon %>"></i></span>
        <div class="track-step-body">
          <p class="track-step-status"><%= t('supplierStatus.' + step.status) %></p>
          <p class="track-step-note"><%= t('supplierStep.' + step.status) %></p>
          <% if (step.counts) { %>
          <p class="track-step-note">
            <%= t('tracking.arrivedOf') %> <%= step.counts.arrived %> / <%= step.counts.expected %> <%= t('tracking.boxes') %>
          </p>
          <% } %>
          <p class="track-step-time"><%= fmtDate(step.at) %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </section>

  <%# The handover — the sentence that does the most work on this page. %>
  <% if (order) { %>
  <div class="track-handover">
    <i class="fa-solid fa-arrow-right-arrow-left"></i>
    <span><%= t('tracking.handover') %></span>
  </div>
  <% } %>
  <% } %>

  <% if (order) { %>
  <%
    const statusInfo = statusLabels[order.status] || { label: order.status, cssClass: 'new' };
    const dirLabel = order.direction === 'TH_TO_LA' ? t('order.thToLa') : t('order.laToTh');
    const dirFlags = order.direction === 'TH_TO_LA' ? '🇹🇭 → 🇱🇦' : '🇱🇦 → 🇹🇭';
  %>
  <!-- Hero: where the parcel is right now, answered before anything else -->
  <div class="track-hero <%= timeline[0] ? 'is-' + timeline[0].tone : '' %>">
    <div class="track-hero-icon"><i class="<%= timeline[0]?.icon || 'fa-solid fa-box' %>"></i></div>
    <div class="track-hero-body">
      <p class="track-hero-eyebrow"><%= t('tracking.currentStatus') %></p>
      <h2 class="track-hero-status"><%= t('status.' + order.status) %></h2>
      <p class="track-hero-note"><%= t('trackStep.' + order.status) %></p>
      <div class="track-hero-meta">
        <span><i class="fa-solid fa-location-dot"></i> <%= t('tracking.deliverTo') %>
          <strong><%= order.receiver_city || order.receiver_province || order.receiver_name || '–' %></strong>
        </span>
        <span><i class="fa-regular fa-clock"></i> <%= t('tracking.lastUpdate') %>
          <strong><%= fmtDate(order.updated_at || order.created_at) %></strong>
        </span>
      </div>
    </div>
  </div>

  <!-- Tracking number, copyable in one tap like every courier app does -->
  <div class="track-no-row">
    <span class="track-no-carrier"><i class="fa-solid fa-truck-fast"></i> SNG Express · <%= dirFlags %></span>
    <span class="track-no-value">
      <code id="trackNo"><%= order.job_no %></code>
      <button type="button" class="track-copy" data-copy="<%= order.job_no %>"
        data-label="<%= t('tracking.copy') %>" data-done="<%= t('tracking.copied') %>"
        aria-label="<%= t('tracking.copy') %>">
        <i class="fa-regular fa-copy"></i>
      </button>
    </span>
  </div>

  <div class="card tracking-card" style="margin-bottom: 1.5rem;">
    <!-- Order Header -->
    <div class="tracking-card-header">
      <div style="display:flex; align-items:center; justify-space-between; flex-wrap:wrap; gap:0.75rem;">
        <div>
          <div class="tracking-job"><%= order.job_no %></div>
          <div style="font-size:0.85rem; color:var(--portal-text-dim); margin-top:0.25rem;">
            <span><%= dirFlags %></span>
            <span><%= dirLabel %></span>
          </div>
        </div>
        <span class="status-badge <%= statusInfo.cssClass %>">
          <i class="fa-solid fa-circle" style="font-size: 6px; vertical-align: middle; margin-right: 4px;"></i>
          <%= t('status.' + order.status) %>
        </span>
      </div>
    </div>

    <!-- Info Grid -->
    <div class="tracking-details">
      <div>
        <small><%= t('order.sender') %></small>
        <strong><%= order.sender_name || '–' %></strong>
      </div>
      <div>
        <small><%= t('order.receiver') %></small>
        <strong><%= order.receiver_name || '–' %></strong>
      </div>
      <div>
        <small><%= t('tracking.destination') %></small>
        <strong><%= order.receiver_city || order.receiver_province || '–' %></strong>
      </div>
      <div>
        <small><%= t('order.weight') %></small>
        <strong><%= order.declared_weight ? order.declared_weight + ' kg' : '–' %></strong>
      </div>
      <% if (order.cod_amount > 0) { %>
      <div style="grid-column: 1 / -1;">
        <small>💰 <%= t('tracking.codLabel') %></small>
        <strong style="color:var(--portal-gold); font-size: 1.25rem;">฿<%= Number(order.cod_amount).toLocaleString() %></strong>
      </div>
      <% } %>
      <div>
        <small><%= t('tracking.createdAt') %></small>
        <strong><%= fmtDate(order.created_at) %></strong>
      </div>
      <div>
        <small><%= t('tracking.updatedAt') %></small>
        <strong><%= fmtDate(order.updated_at || order.created_at) %></strong>
      </div>
    </div>

    <!-- Timeline — newest first, so "where is it now" is the first thing read -->
    <div class="track-timeline">
      <div class="track-timeline-title">
        <i class="fa-solid fa-timeline"></i> <%= t('tracking.history') %>
      </div>
      <% timeline.forEach((step) => { %>
      <div class="track-step is-<%= step.tone %> <%= step.current ? 'is-current' : '' %>">
        <span class="track-step-mark"><i class="<%= step.icon %>"></i></span>
        <div class="track-step-body">
          <p class="track-step-status"><%= t('status.' + step.status) %></p>
          <p class="track-step-note"><%= t('trackStep.' + step.status) %></p>
          <p class="track-step-time"><%= fmtDate(step.at) %></p>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
  <script>
    // One-tap copy of the tracking number, the thing customers paste into chat
    // when they ask us about a parcel. navigator.clipboard needs a secure
    // context; where it is unavailable the button simply selects the number so
    // a long-press copy still works, rather than failing silently.
    document.querySelectorAll('.track-copy').forEach(btn => {
      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy;
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const node = document.getElementById('trackNo');
          if (node) {
            const range = document.createRange();
            range.selectNodeContents(node);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }
          return;
        }
        btn.classList.add('is-done');
        btn.setAttribute('aria-label', btn.dataset.done);
        const icon = btn.querySelector('i');
        if (icon) icon.className = 'fa-solid fa-check';
        setTimeout(() => {
          btn.classList.remove('is-done');
          btn.setAttribute('aria-label', btn.dataset.label);
          if (icon) icon.className = 'fa-regular fa-copy';
        }, 1600);
      });
    });
  </script>
  <% } else if (hasSupplierLeg) { %>
  <%# Goods still on the Thai leg — no SNG parcel exists yet, and saying so
      plainly beats leaving the page looking half-finished. %>
  <div class="track-pending-note">
    <i class="fa-solid fa-hourglass-half"></i>
    <span><%= t('tracking.notShippedYet') %></span>
  </div>
  <% } else if (!error) { %>
  <!-- Empty state -->
  <div class="empty-state">
    <i class="fa-solid fa-box-open"></i>
    <p style="font-size: 1.1rem; font-weight: 700; color: var(--portal-text); margin-top: 0.75rem; margin-bottom: 0.25rem;"><%= t('tracking.emptyTitle') %></p>
    <p style="font-size: 0.85rem; margin-bottom: 0;"><%= t('tracking.emptyHint') %></p>
  </div>
  <% } %>
</section>
