<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <title>เข้าสู่ระบบ | SNG Express ไทย-ลาว</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700;800;900&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --yellow: #FFE000;
      --yellow-dark: #E8C800;
      --yellow-glow: rgba(255, 224, 0, 0.25);
      --black: #0a0a0a;
      --dark: #111111;
      --dark2: #1a1a1a;
    }

    body {
      font-family: 'Prompt', 'Sarabun', sans-serif;
      background: var(--black);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }

    /* ── Animated background ── */
    .bg-layer {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }

    .bg-layer::before {
      content: '';
      position: absolute;
      top: -30%;
      left: -20%;
      width: 70%;
      height: 70%;
      background: radial-gradient(circle, rgba(255,224,0,0.12) 0%, transparent 70%);
      animation: orb1 8s ease-in-out infinite alternate;
    }

    .bg-layer::after {
      content: '';
      position: absolute;
      bottom: -20%;
      right: -10%;
      width: 60%;
      height: 60%;
      background: radial-gradient(circle, rgba(255,224,0,0.08) 0%, transparent 70%);
      animation: orb2 10s ease-in-out infinite alternate;
    }

    @keyframes orb1 {
      from { transform: translate(0,0) scale(1); }
      to   { transform: translate(5%, 8%) scale(1.1); }
    }
    @keyframes orb2 {
      from { transform: translate(0,0) scale(1); }
      to   { transform: translate(-5%,-6%) scale(1.08); }
    }

    /* Moving diagonal stripes */
    .bg-stripes {
      position: fixed;
      inset: 0;
      z-index: 0;
      background-image: repeating-linear-gradient(
        -45deg,
        transparent,
        transparent 40px,
        rgba(255,224,0,0.015) 40px,
        rgba(255,224,0,0.015) 80px
      );
    }

    /* ── Main Container ── */
    .login-wrapper {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 460px;
      padding: 1.5rem;
    }

    /* ── Brand Header ── */
    .brand-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .logo-container {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 88px;
      height: 88px;
      border-radius: 22px;
      overflow: hidden;
      margin-bottom: 1rem;
      box-shadow:
        0 0 0 3px rgba(255,224,0,0.35),
        0 0 40px rgba(255,224,0,0.20),
        0 20px 40px rgba(0,0,0,0.6);
      animation: logoFloat 4s ease-in-out infinite;
    }

    @keyframes logoFloat {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-6px); }
    }

    .logo-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-title {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      background: linear-gradient(135deg, #FFE000 0%, #FFF176 50%, #FFE000 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
    }

    .brand-subtitle {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.4);
      margin-top: 0.35rem;
      font-weight: 400;
      letter-spacing: 0.05em;
    }

    /* ── Card ── */
    .login-card {
      background: rgba(20, 20, 20, 0.90);
      border: 1px solid rgba(255,224,0,0.15);
      border-radius: 24px;
      padding: 2.5rem 2rem;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.04),
        0 40px 80px rgba(0,0,0,0.7),
        inset 0 1px 0 rgba(255,255,255,0.06);
      backdrop-filter: blur(24px);
      position: relative;
      overflow: hidden;
    }

    /* Yellow accent top line */
    .login-card::before {
      content: '';
      position: absolute;
      top: 0; left: 10%; right: 10%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #FFE000, transparent);
      border-radius: 0 0 2px 2px;
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: rgba(255,255,255,0.92);
      margin-bottom: 0.25rem;
    }

    .card-desc {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.35);
      margin-bottom: 2rem;
    }

    /* ── Form ── */
    .field-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255,255,255,0.35);
      margin-bottom: 0.4rem;
    }

    .field-wrap {
      position: relative;
      margin-bottom: 1.25rem;
    }

    .field-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255,255,255,0.25);
      font-size: 0.875rem;
      pointer-events: none;
      transition: color 0.2s;
    }

    .field-input {
      width: 100%;
      background: rgba(255,255,255,0.06) !important;
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 12px;
      padding: 0.875rem 1rem 0.875rem 2.75rem;
      color: rgba(255,255,255,0.90) !important;
      font-size: 0.9375rem;
      font-family: 'Prompt', sans-serif;
      outline: none;
      transition: all 0.2s ease;
      -webkit-text-fill-color: rgba(255,255,255,0.90) !important;
    }

    /* Override browser autofill white flash */
    .field-input:-webkit-autofill,
    .field-input:-webkit-autofill:hover,
    .field-input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 1000px rgba(20,20,20,0.95) inset !important;
      -webkit-text-fill-color: rgba(255,255,255,0.90) !important;
      border-color: rgba(255,224,0,0.30) !important;
      caret-color: #FFE000;
    }

    .field-input::placeholder {
      color: rgba(255,255,255,0.20);
    }

    .field-input:focus {
      border-color: rgba(255,224,0,0.50);
      background: rgba(255,224,0,0.04);
      box-shadow: 0 0 0 3px rgba(255,224,0,0.08);
    }

    .field-input:focus + .field-icon,
    .field-wrap:focus-within .field-icon {
      color: rgba(255,224,0,0.70);
    }

    /* ── Submit Button ── */
    .btn-login {
      width: 100%;
      padding: 1rem 1.5rem;
      background: linear-gradient(135deg, #FFE000 0%, #FFC107 100%);
      color: #0a0a0a;
      font-weight: 800;
      font-size: 1rem;
      font-family: 'Prompt', sans-serif;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.625rem;
      margin-top: 0.5rem;
      transition: all 0.25s ease;
      box-shadow: 0 8px 24px rgba(255,224,0,0.25), 0 2px 8px rgba(0,0,0,0.3);
      letter-spacing: 0.02em;
      position: relative;
      overflow: hidden;
    }

    .btn-login::after {
      content: '';
      position: absolute;
      top: -50%; left: -60%;
      width: 40%;
      height: 200%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
      transform: skewX(-20deg);
      transition: left 0.5s ease;
    }

    .btn-login:hover::after {
      left: 140%;
    }

    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 40px rgba(255,224,0,0.35), 0 4px 12px rgba(0,0,0,0.4);
      filter: brightness(1.05);
    }

    .btn-login:active {
      transform: translateY(0);
      box-shadow: 0 4px 12px rgba(255,224,0,0.20);
    }

    /* ── Flash Message ── */
    .flash {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.875rem 1rem;
      border-radius: 12px;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
    }

    .flash.error {
      background: rgba(239,68,68,0.10);
      border: 1px solid rgba(239,68,68,0.25);
      color: #fca5a5;
    }

    .flash.success {
      background: rgba(16,185,129,0.10);
      border: 1px solid rgba(16,185,129,0.25);
      color: #6ee7b7;
    }

    /* ── Footer ── */
    .login-footer {
      text-align: center;
      margin-top: 1.75rem;
    }

    .login-footer p {
      font-size: 0.7rem;
      color: rgba(255,255,255,0.18);
      letter-spacing: 0.03em;
    }

    /* Feature badges */
    .feature-badges {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      color: rgba(255,255,255,0.25);
      font-size: 0.65rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .badge i {
      font-size: 0.875rem;
      color: rgba(255,224,0,0.40);
    }

    /* Route badges — both directions */
    .route-badges {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .route-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.3rem 0.875rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .route-badge.primary {
      background: rgba(255,224,0,0.10);
      border: 1px solid rgba(255,224,0,0.25);
      color: rgba(255,224,0,0.90);
    }

    .route-badge.secondary {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.40);
    }

    .route-divider {
      font-size: 0.7rem;
      color: rgba(255,255,255,0.18);
    }
  </style>
</head>

<body>
  <div class="bg-layer"></div>
  <div class="bg-stripes"></div>

  <div class="login-wrapper">
    <!-- Brand Header -->
    <div class="brand-header">
      <div class="logo-container">
        <img src="/images/snglogo.png" alt="SNG Express Logo"
             onerror="this.style.display='none'; this.parentElement.style.background='#FFE000'; this.parentElement.innerHTML='<span style=\'font-size:2rem;font-weight:900;color:#000\'>S</span>'">
      </div>
      <div class="route-badges">
        <div class="route-badge primary">🇹🇭 ไทย → ลาว 🇱🇦</div>
        <span class="route-divider">·</span>
        <div class="route-badge secondary">🇱🇦 ลาว → ไทย 🇹🇭</div>
      </div>
      <h1 class="brand-title">SNG EXPRESS</h1>
      <p class="brand-subtitle">เอส เอ็น จี · บริการส่งพัสดุด่วน ไทย-ลาว</p>
    </div>

    <!-- Login Card -->
    <div class="login-card">
      <h2 class="card-title">เข้าสู่ระบบ</h2>
      <p class="card-desc">กรุณาลงชื่อเข้าใช้เพื่อดำเนินการต่อ</p>

      <% if (flash) { %>
      <div class="flash <%= flash.type === 'error' ? 'error' : 'success' %>">
        <i class="<%= flash.type === 'error' ? 'fa-solid fa-circle-exclamation' : 'fa-solid fa-circle-check' %> mt-0.5 flex-shrink-0"></i>
        <span><%= flash.message %></span>
      </div>
      <% } %>

      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field-wrap">
          <label class="field-label" for="username">ชื่อผู้ใช้</label>
          <input id="username" name="username" type="text"
            class="field-input" placeholder="กรอกชื่อผู้ใช้"
            required autocomplete="username" autofocus>
          <i class="fa-regular fa-user field-icon"></i>
        </div>

        <div class="field-wrap">
          <label class="field-label" for="password">รหัสผ่าน</label>
          <input id="password" name="password" type="password"
            class="field-input" placeholder="กรอกรหัสผ่าน"
            required autocomplete="current-password">
          <i class="fa-solid fa-lock field-icon"></i>
        </div>

        <button type="submit" class="btn-login">
          <i class="fa-solid fa-right-to-bracket"></i>
          เข้าสู่ระบบ
        </button>
      </form>

      <!-- Feature Badges -->
      <div class="feature-badges">
        <div class="badge">
          <i class="fa-solid fa-bolt"></i>
          <span>รวดเร็ว</span>
        </div>
        <div class="badge">
          <i class="fa-solid fa-shield-halved"></i>
          <span>ปลอดภัย</span>
        </div>
        <div class="badge">
          <i class="fa-solid fa-handshake"></i>
          <span>ไว้ใจได้</span>
        </div>
      </div>
    </div>

    <div class="login-footer">
      <p>© 2025 SNG Express · เอส เอ็น จี บริการส่งพัสดุ ไทย-ลาว</p>
      <p style="margin-top:0.25rem;">083-754-3623</p>
    </div>
  </div>
</body>
</html>
