<%# Online products list + "add new" action. Shared by the standalone
    /admin/products page and the /settings/member hub's products tab. %>
<div class="d-flex justify-content-end mb-3">
  <a href="/admin/products/new" class="btn btn-primary">
    <i class="fa-solid fa-plus"></i> เพิ่มสินค้าใหม่
  </a>
</div>

<% if (flash) { %>
<div class="alert alert-<%= flash.type === 'error' ? 'danger' : 'success' %> alert-dismissible fade show" role="alert">
  <%= flash.message %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<% } %>

<div class="card shadow mb-4">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 70px;">รูปภาพ</th>
            <th>ชื่อสินค้า</th>
            <th>ป้าย / ส่วนลด</th>
            <th>ราคา</th>
            <th>แพลตฟอร์ม</th>
            <th>สถานะ</th>
            <th style="width: 100px;">การจัดการ</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(product => {
              let productPhotos = [];
              if (product.photos) {
                try {
                  const parsedPhotos = typeof product.photos === 'string'
                    ? JSON.parse(product.photos)
                    : product.photos;
                  productPhotos = Array.isArray(parsedPhotos)
                    ? parsedPhotos.filter(photo => typeof photo === 'string' && photo)
                    : [];
                } catch (_err) {
                  productPhotos = [];
                }
              }
              const coverPhoto = productPhotos[0] || null;
            %>
            <tr>
              <td>
                <% if (coverPhoto) { %>
                  <img src="<%= coverPhoto %>" alt="" class="rounded" style="width: 48px; height: 48px; object-fit: cover;">
                <% } else { %>
                  <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-bag-shopping text-muted"></i>
                  </div>
                <% } %>
              </td>
              <td><strong class="d-block"><%= product.name %></strong></td>
              <td>
                <% if (product.discount_pct) { %>
                  <span class="badge bg-danger">ลด <%= Number(product.discount_pct) %>%</span>
                <% } else if (product.badge_label) { %>
                  <span class="badge bg-info text-dark"><%= product.badge_label %></span>
                <% } else { %>
                  <span class="text-muted">–</span>
                <% } %>
              </td>
              <td>
                <% if (product.price !== null && product.price !== undefined && product.price !== '') { %>
                  <span style="font-weight: 700; color: <%= product?.price_color || '#E53935' %>;">฿<%= Number(product.price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                  <% if (product.original_price !== null && product.original_price !== undefined && product.original_price !== '') { %>
                    <span class="text-muted" style="text-decoration: line-through; font-size: 0.85em;">฿<%= Number(product.original_price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
                  <% } %>
                <% } else { %>
                  <span class="text-muted">–</span>
                <% } %>
              </td>
              <td><%= product.platform || '–' %></td>
              <td>
                <% if (product.status === 'published') { %>
                  <span class="badge bg-success">เผยแพร่ (Published)</span>
                <% } else if (product.status === 'hidden') { %>
                  <span class="badge bg-secondary">ซ่อน (Hidden)</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark">ฉบับร่าง (Draft)</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-outline-primary me-1" title="แก้ไข">
                  <i class="fa-solid fa-pen-to-square"></i>
                </a>
                <a href="<%= product.product_url %>" target="_blank" class="btn btn-sm btn-outline-secondary me-1" title="เปิดลิงก์สินค้า">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
                <form action="/admin/products/<%= product.id %>/delete" method="post" class="d-inline"
                  onsubmit="return confirm('ลบสินค้านี้ถาวร?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="ลบสินค้า">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </form>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                ยังไม่มีสินค้าในระบบ กดปุ่ม "เพิ่มสินค้าใหม่" เพื่อเริ่มต้น
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
