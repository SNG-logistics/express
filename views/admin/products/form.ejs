<%
  let existingPhotos = [];
  if (product?.photos) {
    try {
      const parsedPhotos = typeof product.photos === 'string'
        ? JSON.parse(product.photos)
        : product.photos;
      existingPhotos = Array.isArray(parsedPhotos)
        ? parsedPhotos.filter(photo => typeof photo === 'string' && photo)
        : [];
    } catch (_err) {
      existingPhotos = [];
    }
  }
%>
<div class="container py-4" style="max-width: 720px;">
  <div class="mb-4">
    <a href="/settings/member#products" class="text-decoration-none small">
      <i class="fa-solid fa-arrow-left"></i> กลับหน้ารายการสินค้า
    </a>
    <h1 class="h3 mt-2"><%= title %></h1>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="card shadow">
    <div class="card-body">
      <form action="<%= product?.id ? '/admin/products/' + product.id : '/admin/products' %>?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label class="form-label fw-bold">ชื่อสินค้า <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="name" value="<%= product?.name || '' %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">ลิงก์สินค้า <span class="text-danger">*</span></label>
          <input type="url" class="form-control" name="product_url" placeholder="https://..." value="<%= product?.product_url || '' %>" required>
          <small class="text-muted">ลิงก์ไปยังหน้าสินค้าจริง ลูกค้าจะกดเข้าไปเช็คและซื้อเอง</small>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">ป้ายกำกับ</label>
            <input type="text" class="form-control" name="badge_label" placeholder="เช่น รีวิวสูงสุด, มาใหม่" value="<%= product?.badge_label || '' %>">
            <small class="text-muted">ใช้เมื่อไม่ใช่ส่วนลดเป็นตัวเลข — ถ้ากรอกส่วนลด % ด้านล่าง ระบบจะแสดงส่วนลดแทนป้ายนี้</small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">ส่วนลด (%)</label>
            <input type="number" step="0.01" min="0" max="100" class="form-control" name="discount_pct" placeholder="เช่น 50" value="<%= product?.discount_pct || '' %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">รูปภาพสินค้า</label>
          <% if (existingPhotos.length > 0) { %>
            <div class="mb-2 d-flex flex-wrap gap-2">
              <% existingPhotos.forEach((photo, index) => { %>
                <img src="<%= photo %>" alt="รูปสินค้า <%= index + 1 %>" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border">
              <% }); %>
            </div>
          <% } %>
          <input type="file" class="form-control" name="photos" accept="image/*" multiple>
          <small class="text-muted">เลือกได้สูงสุด 6 รูป (รูปแรก = รูปปก) ระบบจะแสดงสไลด์วนอัตโนมัติที่หน้าเว็บ — หากอัปโหลดใหม่จะแทนที่รูปเดิมทั้งหมด รองรับ JPG, PNG, WebP หรือ GIF รูปละไม่เกิน 5MB</small>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">แพลตฟอร์ม</label>
            <select class="form-select" name="platform">
              <option value="">— ไม่ระบุ —</option>
              <option value="lazada" <%= product?.platform === 'lazada' ? 'selected' : '' %>>Lazada</option>
              <option value="shopee" <%= product?.platform === 'shopee' ? 'selected' : '' %>>Shopee</option>
              <option value="tiktok_shop" <%= product?.platform === 'tiktok_shop' ? 'selected' : '' %>>TikTok Shop</option>
              <option value="alibaba" <%= product?.platform === 'alibaba' ? 'selected' : '' %>>Alibaba</option>
              <option value="makro" <%= product?.platform === 'makro' ? 'selected' : '' %>>Makro</option>
              <option value="other" <%= product?.platform === 'other' ? 'selected' : '' %>>อื่นๆ</option>
            </select>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">สถานะการแสดงผล</label>
            <select class="form-select" name="status">
              <option value="draft" <%= (!product || product?.status === 'draft') ? 'selected' : '' %>>ฉบับร่าง (Draft)</option>
              <option value="published" <%= product?.status === 'published' ? 'selected' : '' %>>เผยแพร่บนเว็บ (Published)</option>
              <option value="hidden" <%= product?.status === 'hidden' ? 'selected' : '' %>>ซ่อนไว้ (Hidden)</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">ลำดับการแสดงผล (Sort Order)</label>
          <input type="number" class="form-control" name="sort_order" value="<%= product?.sort_order || 0 %>" style="max-width: 160px;">
        </div>

        <hr class="my-4">

        <%# ── ราคาและการแสดงผล ───────────────────────────────────────────────
            Selling price, optional struck-through original price, and the
            selling-price colour. Live preview driven by Alpine (already loaded
            on the admin layout) so the admin sees exactly what the member card
            will show before saving. %>
        <h5 class="fw-bold mb-1">ราคาและการแสดงผล</h5>
        <p class="text-muted small mb-3">ราคาที่แสดงบนการ์ดสินค้าที่หน้า /online — ถ้าไม่กรอกราคา ระบบจะไม่แสดงบรรทัดราคาเลย</p>

        <div class="row"
             x-data="{
               price: '<%= product?.price ?? '' %>',
               originalPrice: '<%= product?.original_price ?? '' %>',
               priceColor: '<%= product?.price_color || '#E53935' %>',
               formatBaht(value) {
                 const n = Number(value);
                 return Number.isFinite(n) ? n.toFixed(2) : '';
               }
             }">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">ราคาขาย</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" class="form-control" name="price"
                     placeholder="เช่น 299" value="<%= product?.price ?? '' %>"
                     x-model="price">
              <span class="input-group-text">฿</span>
            </div>
            <small class="text-muted">รองรับทศนิยม เช่น 67.50 — ต้องมากกว่าหรือเท่ากับ 0</small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">ราคาปกติ <span class="text-muted fw-normal">(ไม่บังคับ)</span></label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" class="form-control" name="original_price"
                     placeholder="เช่น 699" value="<%= product?.original_price ?? '' %>"
                     x-model="originalPrice">
              <span class="input-group-text">฿</span>
            </div>
            <small class="text-muted">แสดงราคาเดิมขีดฆ่าไว้ข้างราคาขาย เช่น ฿299 <s class="text-muted">฿699</s></small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">สีราคา</label>
            <div class="d-flex align-items-center gap-2">
              <input type="color" class="form-control form-control-color" style="width: 3.25rem; height: 2.5rem;"
                     x-model="priceColor">
              <input type="text" class="form-control" name="price_color" placeholder="#E53935" maxlength="7"
                     value="<%= product?.price_color || '#E53935' %>"
                     x-model="priceColor"
                     @input="priceColor = /^#[0-9A-Fa-f]{6}$/.test($event.target.value) ? $event.target.value.toUpperCase() : priceColor">
            </div>
            <small class="text-muted">รูปแบบ HEX #RRGGBB — เลือกจากจานสีหรือพิมพ์เองก็ได้ ค่าเริ่มต้น <span style="color:#E53935; font-weight:700;">#E53935</span></small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold d-block">Preview ราคาแสดงผล</label>
            <div class="p-3 rounded border bg-white d-flex align-items-center gap-3 flex-wrap" style="min-height: 2.5rem;">
              <template x-if="formatBaht(price) !== ''">
                <span style="font-size: 1.25rem; font-weight: 800; line-height: 1;"
                      :style="{ color: /^#[0-9A-Fa-f]{6}$/.test(priceColor) ? priceColor : '#E53935' }">
                  ฿<span x-text="formatBaht(price)"></span>
                </span>
              </template>
              <template x-if="formatBaht(price) === ''">
                <span class="text-muted" style="font-size: 1rem;">฿—</span>
              </template>
              <template x-if="formatBaht(originalPrice) !== ''">
                <span class="text-muted" style="font-size: 0.95rem; font-weight: 600; text-decoration: line-through;">
                  ฿<span x-text="formatBaht(originalPrice)"></span>
                </span>
              </template>
            </div>
            <small class="text-muted">คำนวณสดตามค่าที่กรอก — ฿399 ด้านบนเป็นราคาปกติ (เทา + ขีดฆ่า)</small>
          </div>
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-end gap-2">
          <a href="/settings/member#products" class="btn btn-secondary">ยกเลิก</a>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> บันทึกข้อมูลสินค้า
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
