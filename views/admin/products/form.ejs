<%
  let existingPhotos = [];
  if (product?.photos) {
    try {
      const parsedPhotos = typeof product.photos === 'string'
        ? JSON.parse(product.photos)
        : product.photos;
      existingPhotos = Array.isArray(parsedPhotos)
        ? parsedPhotos.filter(photo => typeof photo === 'string' && photo)
        : [];
    } catch (_err) {
      existingPhotos = [];
    }
  }
%>
<div class="container py-4" style="max-width: 720px;">
  <div class="mb-4">
    <a href="/settings/member#products" class="text-decoration-none small">
      <i class="fa-solid fa-arrow-left"></i> กลับหน้ารายการสินค้า
    </a>
    <h1 class="h3 mt-2"><%= title %></h1>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <div class="card shadow">
    <div class="card-body">
      <form action="<%= product?.id ? '/admin/products/' + product.id : '/admin/products' %>?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label class="form-label fw-bold">ชื่อสินค้า <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="name" value="<%= product?.name || '' %>" required>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">ลิงก์สินค้า <span class="text-danger">*</span></label>
          <input type="url" class="form-control" name="product_url" placeholder="https://..." value="<%= product?.product_url || '' %>" required>
          <small class="text-muted">ลิงก์ไปยังหน้าสินค้าจริง ลูกค้าจะกดเข้าไปเช็คและซื้อเอง</small>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">ป้ายกำกับ</label>
            <input type="text" class="form-control" name="badge_label" placeholder="เช่น รีวิวสูงสุด, มาใหม่" value="<%= product?.badge_label || '' %>">
            <small class="text-muted">ใช้เมื่อไม่ใช่ส่วนลดเป็นตัวเลข — ถ้ากรอกส่วนลด % ด้านล่าง ระบบจะแสดงส่วนลดแทนป้ายนี้</small>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">ส่วนลด (%)</label>
            <input type="number" step="0.01" min="0" max="100" class="form-control" name="discount_pct" placeholder="เช่น 50" value="<%= product?.discount_pct || '' %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">รูปภาพสินค้า</label>
          <% if (existingPhotos.length > 0) { %>
            <div class="mb-2 d-flex flex-wrap gap-2">
              <% existingPhotos.forEach((photo, index) => { %>
                <img src="<%= photo %>" alt="รูปสินค้า <%= index + 1 %>" style="width: 80px; height: 80px; object-fit: cover;" class="rounded border">
              <% }); %>
            </div>
          <% } %>
          <input type="file" class="form-control" name="photos" accept="image/*" multiple>
          <small class="text-muted">เลือกได้สูงสุด 6 รูป (รูปแรก = รูปปก) ระบบจะแสดงสไลด์วนอัตโนมัติที่หน้าเว็บ — หากอัปโหลดใหม่จะแทนที่รูปเดิมทั้งหมด รองรับ JPG, PNG, WebP หรือ GIF รูปละไม่เกิน 5MB</small>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">แพลตฟอร์ม</label>
            <select class="form-select" name="platform">
              <option value="">— ไม่ระบุ —</option>
              <option value="lazada" <%= product?.platform === 'lazada' ? 'selected' : '' %>>Lazada</option>
              <option value="shopee" <%= product?.platform === 'shopee' ? 'selected' : '' %>>Shopee</option>
              <option value="tiktok_shop" <%= product?.platform === 'tiktok_shop' ? 'selected' : '' %>>TikTok Shop</option>
              <option value="alibaba" <%= product?.platform === 'alibaba' ? 'selected' : '' %>>Alibaba</option>
              <option value="makro" <%= product?.platform === 'makro' ? 'selected' : '' %>>Makro</option>
              <option value="other" <%= product?.platform === 'other' ? 'selected' : '' %>>อื่นๆ</option>
            </select>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">สถานะการแสดงผล</label>
            <select class="form-select" name="status">
              <option value="draft" <%= (!product || product?.status === 'draft') ? 'selected' : '' %>>ฉบับร่าง (Draft)</option>
              <option value="published" <%= product?.status === 'published' ? 'selected' : '' %>>เผยแพร่บนเว็บ (Published)</option>
              <option value="hidden" <%= product?.status === 'hidden' ? 'selected' : '' %>>ซ่อนไว้ (Hidden)</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">ลำดับการแสดงผล (Sort Order)</label>
          <input type="number" class="form-control" name="sort_order" value="<%= product?.sort_order || 0 %>" style="max-width: 160px;">
        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-end gap-2">
          <a href="/settings/member#products" class="btn btn-secondary">ยกเลิก</a>
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> บันทึกข้อมูลสินค้า
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
