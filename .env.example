# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# REQUIRED: Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_in_production

# ─── MySQL Database (Plesk Production) ────────────────────────────────────────
# DB_HOST: use 'localhost' for same-server MySQL (NOT the public IP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=snglogis_admin
DB_PASS=Aa147147+
# DB_NAME: use the exact Plesk database name (with hyphen, NOT underscore)
DB_NAME=sng-logistics
DB_SSL=false

# ─── Local Development (XAMPP) ────────────────────────────────────────────────
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=sng_logistics

# ─── Notes ────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env and fill in real values.
# 2. Never commit .env to git (it is in .gitignore).
# 3. On Plesk — set these in Node.js → Custom environment variables panel
#    OR create .env file directly via Plesk File Manager / Code Editor.
# 4. DB_NAME on Plesk uses hyphen 'sng-logistics' (not underscore).
# 5. DB_HOST must be 'localhost' — NOT the server's public IP address.
