# ─────────────────────────────────────────────────────────────────────────────
# SNG Logistics — Environment Variables Template
# Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=sng_logistics

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_64_random_hex_chars

# ── WhatsApp (Baileys) ────────────────────────────────────────────────────────
# No credentials needed in .env — Baileys uses QR scan auth stored in ./auth_info_baileys/
# To disable auto-start: create a file named DISABLE_WHATSAPP in project root
# To re-enable: DELETE the DISABLE_WHATSAPP file, then go to /whatsapp → restart

# ── Facebook Messenger Webhook ────────────────────────────────────────────────
# This token is what YOU set in Facebook Developer Console → Webhook → Verify Token
# It can be any string you choose — just must match on both sides
FB_VERIFY_TOKEN=sng_fb_webhook_2024

# Facebook Page Access Token and Page ID are stored in the DATABASE (crm_channels table)
# via the UI at /crm/channels — NOT in this .env file
# This avoids committing secrets to git.

# ── LINE OA Webhook ───────────────────────────────────────────────────────────
# LINE Channel Access Token and Channel Secret are stored in the DATABASE (crm_channels table)
# via the UI at /crm/channels — NOT in this .env file

# ── App Public URL (used for webhook URL display in /crm/channels) ─────────────
APP_URL=https://your-domain.com
