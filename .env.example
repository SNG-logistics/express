# ─── SNG Logistics environment template ───
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=change_me
DB_NAME=sng_logistics
DB_SSL=false

# Generate a value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_at_least_32_random_characters

# Baileys uses QR authentication stored outside Git in auth_info_baileys/.
# To disable auto-start, create DISABLE_WHATSAPP in the project root.

# Must match the value configured in Facebook Developer Console.
FB_VERIFY_TOKEN=your_verify_token

# Facebook and LINE access credentials are stored through /crm/channels.
APP_URL=https://your-domain.com
