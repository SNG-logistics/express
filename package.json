    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.10.0",
