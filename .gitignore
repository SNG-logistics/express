# Dependencies
node_modules/

# Environment & secrets (NEVER commit)
.env
.env.local
.env.production

# WhatsApp session data (contains auth tokens)
.wwebjs_auth/
.wwebjs_cache/
auth_info_baileys/
DISABLE_WHATSAPP

# SSH keys (if accidentally placed in project)
ssh
*.pem
*.key
id_rsa*

# PM2 / runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Build output
coverage/
dist/
build/
.gradle/
local.properties
.idea/

# Downloaded Android tooling is local build infrastructure, not application source
tmp/commandlinetools-*.zip
tmp/android-cmdline-*/

# Uploaded files (user content — serve from CDN or separate storage in production)
# Keep directory structure but ignore actual uploaded files
public/uploads/*
!public/uploads/.gitkeep

# scripts/deploy.js state — records which GitHub commit is live on this host
.deployed_commit
.deploy_download.tar.gz
