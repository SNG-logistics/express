# SNG Logistics Express — Production Environment Template
# คัดลอกไฟล์นี้เป็น .env บน Hostinger VPS แล้วแก้ไขค่าให้ถูกต้อง
# ห้าม commit ไฟล์นี้ขึ้น git ถ้ามีค่าจริง

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# ─── Database (Hostinger MySQL) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=change_me
DB_NAME=your_db_name
DB_SSL=false

# ─── Session (ต้องเปลี่ยนให้ยาว random ≥ 32 chars) ──────────────────────────
SESSION_SECRET=generate_at_least_32_random_characters

# ─── AI Automation (cometapi.com) ────────────────────────────────────────────
AI_BASE_URL=https://api.cometapi.com/v1
AI_API_KEY=your_cometapi_key
AI_MODEL=gpt-4o-mini

# ─── Facebook Messenger Webhook ──────────────────────────────────────────────
FB_VERIFY_TOKEN=your_verify_token
FB_APP_SECRET=your_facebook_app_secret
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# ─── LINE OA (ถ้ามี) ─────────────────────────────────────────────────────────
# LINE credentials เก็บใน DB ผ่าน /crm/channels (ไม่ต้องใส่ที่นี่)
