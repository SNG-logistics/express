# SNG Logistics Express — Production Environment Template
# คัดลอกไฟล์นี้เป็น .env บน Hostinger VPS แล้วแก้ไขค่าให้ถูกต้อง
# ห้าม commit ไฟล์นี้ขึ้น git ถ้ามีค่าจริง

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# ─── Database (Hostinger MySQL) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_SSL=false

# ─── Session (ต้องเปลี่ยนให้ยาว random ≥ 32 chars) ──────────────────────────
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_DO_NOT_USE_DEFAULT

# ─── AI Automation (cometapi.com) ────────────────────────────────────────────
AI_BASE_URL=https://api.cometapi.com/v1
AI_API_KEY=sk-Nnfmmihh3RlMh9OApL2f10al7S1p4azFwfuoPovkBqNxI9pL
AI_MODEL=gpt-4o-mini

# ─── Facebook Messenger Webhook ───────────────────────────────────────────────
FB_VERIFY_TOKEN=sng_webhook_secret_2024
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=

# ─── LINE OA (ถ้ามี) ─────────────────────────────────────────────────────────
# LINE credentials เก็บใน DB ผ่าน /crm/channels (ไม่ต้องใส่ที่นี่)
